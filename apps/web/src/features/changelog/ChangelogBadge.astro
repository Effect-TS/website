---
interface Props {
  readonly class?: string | undefined
}

const { class: className } = Astro.props
---

<span
  class:list={[
    "inline-flex items-center rounded bg-destructive/10 px-1.5 py-0.5 text-[10px] leading-none font-medium tracking-wider text-destructive uppercase",
    className,
  ]}
  title="This release contains breaking changes."
>
  <slot />
</span>
