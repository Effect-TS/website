---
import Eyebrow from "@/components/ui/Eyebrow.astro"

const steps = [
  {
    owner: "Kit + Astra",
    title: "Find it. Open a PR.",
    detail: "A bug report, a proposed fix, and a reproduction to investigate.",
  },
  {
    owner: "The Boys · Multica",
    title: "Work the review queue.",
    detail: "Investigate the finding, check the patch, revise the code and tests.",
  },
  {
    owner: "Tim + the maintainers",
    title: "Give the final feedback.",
    detail: "Decide on behavior, API design, test scope, and whether the change belongs.",
  },
  {
    owner: "Back through the loop",
    title: "Revise, verify, then decide.",
    detail:
      "Apply the feedback and check the result. A maintainer merges, closes, or replaces the PR.",
  },
]
---

<figure class="not-prose my-10 overflow-hidden rounded-lg border border-border bg-card/60">
  <figcaption class="border-b border-border px-5 py-4">
    <Eyebrow as="span" class="text-xs">How a finding became a merge</Eyebrow>
  </figcaption>
  <div class="divide-y divide-border">
    {
      steps.map(({ owner, title, detail }, index) => (
        <div class="flex gap-4 px-5 py-5">
          <span aria-hidden="true" class="pt-1 font-mono text-sm text-brand">
            0{index + 1}
          </span>
          <div>
            <p class="mb-1 text-xs text-muted-foreground">{owner}</p>
            <p class="mb-1 text-base font-semibold text-foreground">{title}</p>
            <p class="text-sm leading-relaxed text-prose-foreground">{detail}</p>
          </div>
        </div>
      ))
    }
  </div>
  <p class="border-t border-border bg-brand/5 px-5 py-4 text-sm font-medium text-foreground">
    Agents do the legwork. Humans make the final call.
  </p>
</figure>
