---
// With `keys`, the same story once messages have idempotency keys. The copy
// arrives with the same key as the first message, so it's a duplicate and
// isn't saved. Its save can only finish once the first one does, so the
// webhook replies to both at once: the first reply too late, the copy's in
// time. The database keeps one row.
//
// The retry as a timeline with lanes, like the crash timeline at the top of
// the post: Slack, our webhook, and two rows in the database. Sebastian
// posts, and Slack sends his message to the webhook, then waits. The webhook
// only replies once the message is saved, and the save is slow, so Slack
// hears nothing for three seconds and sends the same message again. The
// first save finishes and the reply arrives too late. Then the copy is
// saved, Slack gets its reply in time, and the database has the message
// twice.
//
// Everything sits on one grid, a track per lane and a track per step. On
// wide stages the lanes are rows and time runs left to right. On narrow
// ones the lanes turn into columns and time runs top to bottom.

import { people, warning } from "../3/palette"
import StepCallout from "@/components/blog/module-of-the-week/stepper/StepCallout.astro"
import StepControls from "@/components/blog/module-of-the-week/stepper/StepControls.astro"
import StepPills from "@/components/blog/module-of-the-week/stepper/StepPills.astro"

interface Props {
  // Messages have idempotency keys, so the copy isn't saved twice
  keys?: boolean
}
const { keys = false } = Astro.props

const steps = keys
  ? ["Post", "Send", "Retry", "Replies"]
  : ["Post", "Send", "Retry", "Too late", "Copy"]
const SEND = 1
const RETRY = 2
const LATE = 3
const COPY = 4

// Lanes, top to bottom: Slack, the webhook, then the database's two rows
const SLACK = 1
const WEBHOOK = 2
const ROW = 3
const COPY_ROW = 4

// The lanes each step's line spans, through the webhook, and what travels
// along it. With keys, both replies go back at the last step, side by side:
// the first message's, then the copy's.
type Kind = "msg" | "late" | "reply"
type Link = { lanes: [from: number, to: number]; kind: Kind }
const links: Partial<Record<number, Link & { also?: Link }>> = keys
  ? {
      [SEND]: { lanes: [SLACK, ROW], kind: "msg" },
      [RETRY]: { lanes: [SLACK, COPY_ROW], kind: "msg" },
      [LATE]: {
        lanes: [ROW, SLACK],
        kind: "late",
        also: { lanes: [COPY_ROW, SLACK], kind: "reply" },
      },
    }
  : {
      [SEND]: { lanes: [SLACK, ROW], kind: "msg" },
      [RETRY]: { lanes: [SLACK, COPY_ROW], kind: "msg" },
      [LATE]: { lanes: [ROW, SLACK], kind: "late" },
      [COPY]: { lanes: [COPY_ROW, SLACK], kind: "reply" },
    }

// The middle of a lane, down from the top on wide stages, as lane heights
// and row heights. The database's rows are shorter than the other lanes.
const center = (lane: number) => (lane <= WEBHOOK ? [lane - 0.5, 0] : [WEBHOOK, lane - 2.5])
const size = ([lanes, rows]: Array<number>) =>
  `calc(var(--rl6-lane) * ${lanes} + var(--rl6-row) * ${rows})`

// Where a step's line starts and how long it is. Wide, that's down from the
// top. Narrow, it's in lanes from the left, which are all the same width.
// The second line's, for a step with two, is the same with a 2 on the end.
const place = ({ lanes }: Link, suffix = "") => {
  const lo = Math.min(...lanes)
  const hi = Math.max(...lanes)
  const [x0, y0] = center(lo) as [number, number]
  const [x1, y1] = center(hi) as [number, number]
  return [
    `--top${suffix}: ${size([x0, y0])}`,
    `--len${suffix}: ${size([x1 - x0, y1 - y0])}`,
    `--a${suffix}: ${lo - 0.5}`,
    `--d${suffix}: ${hi - lo}`,
  ]
}
const line = (t: number) => {
  const l = links[t]
  if (!l) return ""
  return [...place(l), ...(l.also ? place(l.also, "2") : [])].join("; ")
}
const dir = (t: number) => {
  const l = links[t]
  return l && (l.lanes[0] < l.lanes[1] ? "down" : "up")
}

// Places an item at step `t` (through step `end`) in a lane
const at = (t: number, lane: number, end = t) =>
  `--t0: ${t + 2}; --t1: ${end + 3}; --n: ${end - t + 1}; --lane: ${lane}`
---

<figure
  class="rl6 st"
  data-rl6-visual
  data-keys={keys || undefined}
  aria-label={keys
    ? "Step-by-step timeline with lanes for Slack, our webhook, and the database. Sebastian posts in Slack, and Slack sends his message to the webhook, then waits up to three seconds for a reply. The webhook starts saving the message, and the save is slow. After three seconds with no reply, Slack sends the same message again. It has the same key as the first, so it's a duplicate and isn't saved. When the first save finishes, the webhook replies to both. The first reply is too late, but the reply to the copy reaches Slack in time, and the database has one row."
    : "Step-by-step timeline with lanes for Slack, our webhook, and two rows in the database. Sebastian posts in Slack, and Slack sends his message to the webhook, then waits up to three seconds for a reply. The webhook starts saving the message, and only replies once it's saved. The save is slow, so after three seconds with no reply, Slack sends the same message again. The first save finishes, and the reply reaches Slack too late. Then the copy is saved and its reply reaches Slack in time, so the database has the message twice."}
  style={[
    `--rl6-msg-light: ${people.Sebastian.light}`,
    `--rl6-msg-dark: ${people.Sebastian.dark}`,
    `--rl6-warn: ${warning.background}`,
    `--rl6-warn-ink: ${warning.text}`,
  ].join("; ")}
>
  <StepPills steps={steps} />

  <div class="rl6-stage" data-rl6-stage>
    <div class="rl6-card">
      <div class="rl6-grid">
        {/* One track per step, behind everything. It draws what travels. */}
        {
          steps.map((_, t) => (
            <div
              class:list={["rl6-step", links[t]?.also && "is-split"]}
              data-rl6-step={t}
              data-link={links[t]?.kind}
              data-dir={dir(t)}
              style={`--t0: ${t + 2}; ${line(t)}`}
            />
          ))
        }

        <p class="rl6-label" style={`--lane: ${SLACK}`}>Slack</p>
        <p class="rl6-label" style={`--lane: ${WEBHOOK}`}>Webhook</p>
        <p class="rl6-label is-table" style={`--lane: ${ROW}`}>Database</p>
        {/* The middle of each lane, for the envelopes */}
        {
          [SLACK, WEBHOOK, ROW, COPY_ROW].map((lane) => (
            <span class="rl6-anchor" data-rl6-lane={lane} style={`--lane: ${lane}`} />
          ))
        }

        <span class="rl6-item rl6-cell" data-rl6-at={0} style={at(0, SLACK)}>
          <span class="rl6-chip" data-rl6-head>Sebastian</span>
        </span>
        {/* His message heads out from his box, then down to the webhook */}
        <span class="rl6-feed" data-rl6-feed style={at(0, SLACK, SEND)}></span>

        {/* Slack's wait, from when it sends until it hears nothing back */}
        <span
          class="rl6-line is-wait"
          data-rl6-line
          data-from={SEND}
          data-to={RETRY}
          style={at(SEND, SLACK)}
        >
          <span class="rl6-line-label">waits 3s</span>
        </span>
        <span class="rl6-item rl6-cell" data-rl6-at={RETRY} data-rl6-sends style={at(RETRY, SLACK)}>
          <span class="rl6-chip is-red" data-rl6-tail>No reply</span>
        </span>
        {
          keys ? (
            <span class="rl6-item rl6-cell is-split" data-rl6-at={LATE} style={at(LATE, SLACK)}>
              <span class="rl6-chip is-red is-late">Too late</span>
              <span class="rl6-chip is-ok">On time</span>
            </span>
          ) : (
            <>
              <span class="rl6-item rl6-cell" data-rl6-at={LATE} style={at(LATE, SLACK)}>
                <span class="rl6-chip is-red is-late">Too late</span>
              </span>
              <span class="rl6-item rl6-cell" data-rl6-at={COPY} style={at(COPY, SLACK)}>
                <span class="rl6-chip is-ok">On time</span>
              </span>
            </>
          )
        }

        {/* The webhook passes each message on, and each reply back */}
        {
          steps.slice(SEND).map((_, i) => {
            const t = i + SEND
            const split = Boolean(links[t]?.also)
            return (
              <span
                class:list={["rl6-item rl6-cell", split && "is-split"]}
                data-rl6-at={t}
                data-rl6-sends
                style={at(t, WEBHOOK)}
              >
                {(split ? [0, 1] : [0]).map(() => (
                  <span class="rl6-hook" aria-hidden="true">
                    <span class="rl6-face" />
                  </span>
                ))}
              </span>
            )
          })
        }

        {/* The two saves. They start when the message arrives, and run long. */}
        <span class="rl6-save" data-rl6-save={SEND} data-done={LATE} style={at(SEND, ROW)}>
          <span class="rl6-saving">saving <span class="rl6-spin" aria-hidden="true"></span></span>
          <span class="rl6-saved">saved</span>
          {keys && <span class="rl6-key">key 1337</span>}
        </span>
        {
          /* With keys, the copy has the same key as the first message, so it's
            a duplicate from the moment it arrives. It stays until the webhook
            replies to it, along with the first. */
        }
        {
          keys ? (
            <span
              class="rl6-save is-dupe"
              data-rl6-save={RETRY}
              data-done={RETRY}
              data-until={LATE}
              style={at(RETRY, COPY_ROW)}
            >
              <span class="rl6-dupe">Duplicate</span>
              <span class="rl6-more">
                not saved <span class="rl6-key">key 1337</span>
              </span>
            </span>
          ) : (
            <span
              class="rl6-save"
              data-rl6-save={RETRY}
              data-done={COPY}
              style={at(RETRY, COPY_ROW)}
            >
              <span class="rl6-saving">
                saving <span class="rl6-spin" aria-hidden="true" />
              </span>
              <span class="rl6-saved">
                saved <span class="rl6-copy">Copy</span>
              </span>
            </span>
          )
        }
      </div>
    </div>

    <StepCallout />
  </div>

  <StepControls reset />
</figure>

<script>
  import {
    createCallout,
    createStepper,
    createTraveler,
    envelopeSvg,
    rel,
    type Anchor,
    type Point,
  } from "@/components/blog/module-of-the-week/stepper/stepper"

  // Short enough to fit the callout in two lines
  const STORY: Array<{ title: string; text: string }> = [
    { title: "Post", text: "Sebastian posts a question in Slack" },
    { title: "Send", text: "Slack waits up to 3s while the webhook persists the message" },
    { title: "Retry", text: "No reply after 3s, so Slack sends it again" },
    { title: "Too late", text: "The first save finishes, but the reply is too late" },
    { title: "Copy", text: "The copy is saved too. Now there are two." },
  ]
  // The same story, with idempotency keys
  const KEYED: Array<{ title: string; text: string }> = [
    ...STORY.slice(0, 2),
    { title: "Retry", text: "Slack retries, but the idempotency key stops a duplicate save" },
    {
      title: "Replies",
      text: "The save finishes and both get a reply, but the first is too late",
    },
  ]
  const READY = { title: "Ready", text: "Click Step, and Sebastian posts his question" }
  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches
  // The stage width where the steps get too narrow for their chips, and the
  // lanes turn into columns. Matches the container query in the styles.
  const WIDE = 600
  // How long a line or a save takes to stretch to the next step, before
  // anything travels
  const GROW_MS = 250
  // How long an envelope takes from end to end, through the webhook
  const SEND_MS = 550
  // How long Sebastian's message takes from his box to where it turns down
  const FEED_MS = 250
  const SEND = 1
  // Where a step with two replies puts them, across it. Matches the styles.
  const SPLIT = [0.3, 0.7] as const
  // The lanes each step's envelope passes through
  // What travels at each step: the lanes an envelope passes through, how far
  // across its step it goes, and what it carries if that's not the step's
  type Trip = { lanes: Array<number>; at?: number; kind?: string }
  const TRIPS: Record<number, Array<Trip>> = {
    1: [{ lanes: [1, 2, 3] }],
    2: [{ lanes: [1, 2, 4] }],
    3: [{ lanes: [3, 2, 1] }],
    4: [{ lanes: [4, 2, 1] }],
  }
  // With keys, both replies go back at once, side by side
  const KEYED_TRIPS: Record<number, Array<Trip>> = {
    1: TRIPS[1]!,
    2: TRIPS[2]!,
    3: [
      { lanes: [3, 2, 1], at: SPLIT[0], kind: "late" },
      { lanes: [4, 2, 1], at: SPLIT[1], kind: "reply" },
    ],
  }
  const ease = "cubic-bezier(0.23, 1, 0.32, 1)"

  for (const root of document.querySelectorAll<HTMLElement>("[data-rl6-visual]")) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!
    const keyed = root.hasAttribute("data-keys")
    const VIEWS = keyed ? KEYED : STORY
    const trips = keyed ? KEYED_TRIPS : TRIPS
    const stage = q<HTMLElement>("[data-rl6-stage]")
    const caption = q<HTMLElement>("[data-caption]")
    const lines = [...root.querySelectorAll<HTMLElement>("[data-rl6-line]")]
    const saves = [...root.querySelectorAll<HTMLElement>("[data-rl6-save]")]
    const steps = [...root.querySelectorAll<HTMLElement>("[data-rl6-step]")]
    const items = [...root.querySelectorAll<HTMLElement>("[data-rl6-at]")]
    const senders = items.filter((el) => el.hasAttribute("data-rl6-sends"))
    const lanes = [...root.querySelectorAll<HTMLElement>("[data-rl6-lane]")]
    const tail = q<HTMLElement>("[data-rl6-tail]")
    const head = q<HTMLElement>("[data-rl6-head]")
    const feed = q<HTMLElement>("[data-rl6-feed]")

    // The callout goes under the current step on wide stages. When time runs
    // down the page instead, there's no room, so the caption shows.
    const wide = () => stage.clientWidth >= WIDE
    const callout = createCallout(root, stage)
    const anchorFor = (k: number): Anchor | null =>
      wide() ? { el: steps[k]!, place: "below", width: 250 } : null

    // Stretches something placed at step `from` through step `to`
    const span = (el: HTMLElement, from: number, to: number) => {
      el.style.setProperty("--t1", String(to + 3))
      el.style.setProperty("--n", String(to - from + 1))
    }
    // Lines and saves run from their first step until they end: `data-to`
    // for a line, and for a save `data-until`, or else when it's done
    const from = (el: HTMLElement) => Number(el.dataset.from ?? el.dataset.rl6Save)
    const end = (el: HTMLElement) => Number(el.dataset.to ?? el.dataset.until ?? el.dataset.done)
    const stretch = (el: HTMLElement, k: number) => {
      const to = Math.max(from(el), Math.min(k, end(el)))
      span(el, from(el), to)
      el.classList.toggle("is-short", to === from(el))
      // A line stops at the edge of the chip at its end, so its label sits
      // in the middle of what shows
      if (el.dataset.to) el.classList.toggle("is-over", k >= end(el))
    }
    // Half a chip, along the way time runs
    const half = (el: HTMLElement) => (wide() ? el.offsetWidth : el.offsetHeight) / 2
    const measure = () => {
      root.style.setProperty("--rl6-tail", `${half(tail)}px`)
      root.style.setProperty("--rl6-head", `${half(head)}px`)
    }

    const lengths = (k: number) => {
      for (const el of [...lines, ...saves]) {
        stretch(el, k)
        el.classList.toggle("is-on", k >= from(el))
      }
    }
    // A save that's finished says so
    const finish = (k: number) => {
      for (const el of saves) el.classList.toggle("is-done", k >= Number(el.dataset.done))
    }

    // Says what happens at step k, and marks it in the pills and its column.
    // Stepping forward, this happens on the click, before the envelope lands.
    const pills = [...root.querySelectorAll<HTMLElement>("[data-step-pill]")]
    const box = q<HTMLElement>("[data-callout]")
    let said = ""
    const describe = (k: number) => {
      for (const [t, el] of steps.entries()) el.classList.toggle("is-current", t === k)
      for (const [t, el] of pills.entries()) {
        if (t === k) el.setAttribute("aria-current", "step")
        else el.removeAttribute("aria-current")
        el.classList.toggle("is-done", t < k)
      }
      const view = VIEWS[k] ?? READY
      caption.textContent = k < 0 ? view.text : `${k + 1}. ${view.text}`

      // The callout glides to the new step, and its words dim and come back
      const was = box.hidden ? null : box.getBoundingClientRect()
      for (const a of box.getAnimations({ subtree: true })) a.cancel()
      callout.show({ ...view, num: k < 0 ? undefined : k + 1 }, anchorFor(Math.max(0, k)))
      const changed = view.text !== said
      said = view.text
      if (!was || box.hidden || reduceMotion()) return
      const now = box.getBoundingClientRect()
      const dx = was.left - now.left
      const dy = was.top - now.top
      if (dx || dy) {
        box.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }], {
          duration: 250,
          easing: ease,
        })
      }
      if (changed) {
        for (const el of box.children) {
          el.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 200, easing: "ease-out" })
        }
      }
    }

    let current = 0
    const apply = (state: number) => {
      current = state
      const k = state - 1
      for (const el of items) el.classList.toggle("is-on", Number(el.dataset.rl6At) <= k)
      for (const [t, el] of steps.entries()) {
        el.classList.toggle("is-on", t <= k)
        el.classList.remove("is-sending")
      }
      measure()
      feed.classList.toggle("is-on", k >= SEND)
      lengths(k)
      finish(k)
      describe(k)
    }

    // The middle of a lane at a step. Lanes are rows on wide stages, and
    // columns on narrow ones.
    const middle = (el: Element): Point => {
      const r = rel(stage, el)
      return { x: (r.left + r.right) / 2, y: (r.top + r.bottom) / 2 }
    }
    // `at` is how far across the step, from its start
    const point = (lane: number, t: number, at = 0.5): Point => {
      const l = middle(lanes[lane - 1]!)
      const s = rel(stage, steps[t]!)
      return wide()
        ? { x: s.left + (s.right - s.left) * at, y: l.y }
        : { x: l.x, y: s.top + (s.bottom - s.top) * at }
    }

    // Stretches a line or a save to step `next`, then reveals the new length
    // from where it ended. A span on the grid can't animate, but a clip can.
    // The clip leaves room around a line for its label, which keeps to the
    // middle of the line and glides along as it grows.
    const traveler = createTraveler(stage)
    const growing = new Set<Animation>()
    const track = (anim: Animation) => {
      growing.add(anim)
      anim.onfinish = anim.oncancel = () => growing.delete(anim)
      return anim.finished.catch(() => {})
    }
    const grow = (el: HTMLElement, next: number) => {
      const label = el.querySelector<HTMLElement>(".rl6-line-label")
      const was = el.getBoundingClientRect()
      const labelWas = label?.getBoundingClientRect()
      const wasOn = el.classList.contains("is-on")
      el.classList.add("is-on")
      stretch(el, next)
      const now = el.getBoundingClientRect()
      const across = wide()
      // One that wasn't showing grows from nothing
      const added = across
        ? now.width - (wasOn ? was.width : 0)
        : now.height - (wasOn ? was.height : 0)
      if (added <= 0 || reduceMotion()) return
      const clip = across ? `inset(-2rem ${added}px -2rem 0)` : `inset(0 -8rem ${added}px -8rem)`
      const open = across ? "inset(-2rem 0 -2rem 0)" : "inset(0 -8rem 0 -8rem)"
      const runs = [
        track(
          el.animate([{ clipPath: clip }, { clipPath: open }], { duration: GROW_MS, easing: ease }),
        ),
      ]
      if (label && labelWas) {
        const labelNow = label.getBoundingClientRect()
        const dx = labelWas.left - labelNow.left
        const dy = labelWas.top - labelNow.top
        runs.push(
          track(
            label.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }], {
              duration: GROW_MS,
              easing: ease,
            }),
          ),
        )
      }
      return Promise.all(runs)
    }
    const extend = (next: number) =>
      Promise.all(
        [...lines, ...saves]
          // Still going, and already started
          .filter((el) => next > from(el) && next <= end(el))
          .map((el) => grow(el, next)),
      )

    const advance = async (state: number, alive: () => boolean) => {
      const next = state - 1
      describe(next)
      await extend(next)
      // A save finishes before its reply goes out
      finish(next)
      const going = trips[next]
      if (!going || !alive()) return
      for (const el of senders) {
        if (Number(el.dataset.rl6At) === next) el.classList.add("is-on")
      }
      const step = steps[next]!
      const envelope = `rl6-env is-${step.dataset.link}`
      // Sebastian's message leaves the edge of his box first, drawing its
      // line along behind it
      if (next === SEND) {
        const from = point(1, 0)
        const edge = wide()
          ? { ...from, x: from.x + half(head) }
          : { ...from, y: from.y + half(head) }
        feed.classList.add("is-on")
        if (!reduceMotion()) {
          const hidden = wide() ? "inset(0 100% 0 0)" : "inset(0 0 100% 0)"
          track(
            feed.animate([{ clipPath: hidden }, { clipPath: "inset(0)" }], {
              duration: FEED_MS,
              easing: "ease-in-out",
            }),
          )
        }
        await traveler.travel([edge, point(1, next)], envelope, envelopeSvg, FEED_MS)
        if (!alive()) return
      }
      step.classList.add("is-sending")
      await Promise.all(
        going.map((trip) =>
          traveler.travel(
            trip.lanes.map((lane) => point(lane, next, trip.at)),
            trip.kind ? `rl6-env is-${trip.kind}` : envelope,
            envelopeSvg,
            SEND_MS,
          ),
        ),
      )
    }

    createStepper({
      root,
      first: 1,
      last: VIEWS.length,
      apply,
      advance,
      stop: () => {
        traveler.cancel()
        for (const a of [...growing]) a.cancel()
      },
    })
    new ResizeObserver(() => {
      measure()
      callout.place(anchorFor(Math.max(0, current - 1)))
    }).observe(stage)
  }
</script>

<style is:global>
  .rl6 {
    --rl6-ink: #3f3f46;
    --rl6-muted: #71717a;
    --rl6-line: #d4d4d8;
    --rl6-surface: #ffffff;
    --rl6-panel: #fafafa;
    --rl6-ok: #15803d;
    --rl6-red: #dc2626;
    --rl6-msg: var(--rl6-msg-light);
    /* The lines between rows: lighter than the card's border */
    --rl6-rule: color-mix(in oklab, var(--rl6-line) 60%, transparent);
    --rl6-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --st-ink: var(--rl6-ink);
    --st-muted: var(--rl6-muted);
    --st-line: var(--rl6-line);
