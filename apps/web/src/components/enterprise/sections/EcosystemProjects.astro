---
import { Image } from "astro:assets"
import ArrowLink from "@/components/enterprise/ArrowLink.astro"
import BorderedGrid from "@/components/enterprise/BorderedGrid.astro"
import CardTitle from "@/components/enterprise/CardTitle.astro"
import GroupBar from "@/components/enterprise/GroupBar.astro"
import { ECOSYSTEM_PROJECTS } from "@/features/enterprise/showcase"
---

<GroupBar id="ecosystem" class="scroll-mt-24 border-t-0">
  <Fragment slot="label">Ecosystem projects</Fragment>
</GroupBar>
<BorderedGrid as="div" flush class="grid-cols-1 lg:grid-cols-2">
  {
    ECOSYSTEM_PROJECTS.map((project) => (
      <article class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 bg-background p-6 md:p-8">
        <div class="flex items-center gap-4">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-xl border border-border bg-card">
            <Image src={project.mark} alt="" class="size-7" />
          </span>
          <div>
            <CardTitle as="h4">{project.name}</CardTitle>
            <p class="text-sm text-muted-foreground">{project.kind}</p>
          </div>
        </div>
        <div class="flex flex-col items-start gap-2">
          {project.links.map((link) => (
            <ArrowLink href={link.href}>{link.label}</ArrowLink>
          ))}
        </div>
      </article>
    ))
  }
</BorderedGrid>
