+//! The run queue that stands in for threads on `NO_THREADS` targets (wasm32-wasip1).
+//!
+//! Where a native build starts a thread or hands work to a pool (the language server's request workers, the
+//! project background queue, timer callbacks, `Context::after_func`), a `NO_THREADS` build pushes the work here.
+//! The embedder (the single-threaded language server module, `tsrs_wasm_lsp`) drains the queue after it has
+//! dispatched an incoming message, so every task runs to completion on the calling thread before the host gets
+//! control back. Nothing here is used on native targets.
+//!
+//! Timers (`tsrs_project::background::after_func`) keep their deadlines in `TIMERS`; `fire_due_timers` moves the
+//! due callbacks onto the queue. The embedder calls it on every pump and from an explicit tick export, so a timer
+//! fires on the first pump after its deadline, never on its own.
+
+use std::cmp::Reverse;
+use std::collections::{BinaryHeap, VecDeque};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+type Task = Box<dyn FnOnce() + Send>;
+
+static QUEUE: Mutex<VecDeque<Task>> = Mutex::new(VecDeque::new());
+
+/// Queues `f` to run on the next `run_one` / `drain`.
+pub fn spawn(f: impl FnOnce() + Send + 'static) {
+    QUEUE.lock().unwrap().push_back(Box::new(f));
+}
+
+/// Runs the oldest queued task; false when the queue is empty.
+pub fn run_one() -> bool {
+    let task = QUEUE.lock().unwrap().pop_front();
+    match task {
+        Some(task) => {
+            task();
+            true
+        }
+        None => false,
+    }
+}
+
+/// Runs queued tasks (including the ones they queue) until none is left.
+pub fn drain() -> usize {
+    let mut n = 0;
+    while run_one() {
+        n += 1;
+    }
+    n
+}
+
+pub fn pending() -> usize {
+    QUEUE.lock().unwrap().len()
+}
+
+pub type TimerCallback = Arc<dyn Fn() + Send + Sync>;
+
+struct Timers {
+    heap: BinaryHeap<Reverse<(Instant, u64, u64)>>,
+    // timer id -> (generation of its pending deadline, callback)
+    pending: Vec<(u64, u64, TimerCallback)>,
+    next_id: u64,
+    next_generation: u64,
+}
+
+static TIMERS: Mutex<Timers> = Mutex::new(Timers {
+    heap: BinaryHeap::new(),
+    pending: Vec::new(),
+    next_id: 0,
+    next_generation: 0,
+});
+
+pub fn timer_new_id() -> u64 {
+    let mut t = TIMERS.lock().unwrap();
+    t.next_id += 1;
+    t.next_id
+}
+
+/// Arms (or re-arms) timer `id`; reports whether it was pending.
+pub fn timer_schedule(id: u64, d: Duration, f: TimerCallback) -> bool {
+    let mut t = TIMERS.lock().unwrap();
+    let was = timer_remove(&mut t, id);
+    t.next_generation += 1;
+    let generation = t.next_generation;
+    t.pending.push((id, generation, f));
+    t.heap.push(Reverse((Instant::now() + d, id, generation)));
+    was
+}
+
+fn timer_remove(t: &mut Timers, id: u64) -> bool {
+    match t.pending.iter().position(|(i, _, _)| *i == id) {
+        Some(i) => {
+            t.pending.swap_remove(i);
+            true
+        }
+        None => false,
+    }
+}
+
+/// Stops timer `id`; reports whether it was pending.
+pub fn timer_stop(id: u64) -> bool {
+    timer_remove(&mut TIMERS.lock().unwrap(), id)
+}
+
+/// Queues the callbacks of the timers whose deadline has passed; returns how many.
+pub fn fire_due_timers() -> usize {
+    let now = Instant::now();
+    let mut fired = Vec::new();
+    {
+        let mut t = TIMERS.lock().unwrap();
+        while let Some(Reverse((deadline, id, generation))) = t.heap.peek().copied() {
+            if deadline > now {
+                break;
+            }
+            t.heap.pop();
+            if let Some(i) = t.pending.iter().position(|(i, g, _)| *i == id && *g == generation) {
+                let (_, _, f) = t.pending.swap_remove(i);
+                fired.push(f);
+            }
+        }
+    }
+    let n = fired.len();
+    for f in fired {
+        spawn(move || f());
+    }
+    n
+}
+
+/// The time until the next pending timer, if any (lets the host schedule an `lsp_tick`).
+pub fn next_timer_in() -> Option<Duration> {
+    let t = TIMERS.lock().unwrap();
+    let now = Instant::now();
+    t.heap
+        .iter()
+        .filter(|Reverse((_, id, g))| t.pending.iter().any(|(i, pg, _)| i == id && pg == g))
+        .map(|Reverse((deadline, _, _))| deadline.saturating_duration_since(now))
+        .min()
+}
