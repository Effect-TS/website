---
// Option 3: what each side sees. On the left, Slack's delivery log for
// Sebastian's message: attempt 1, a timeout after three seconds, then
// attempt 2. On the right, our server: the messages arriving, the slow save,
// and the two rows that land in the message table.

import { AT } from "./retry"
import { people, warning } from "../3/palette"
import StepControls from "@/components/blog/module-of-the-week/stepper/StepControls.astro"
import RetryTable from "./RetryTable.astro"

const slack = [
  {
    at: AT.post,
    time: "10:00:00.0",
    text: "Sebastian posted “Why is this test flaky?” in #engineering",
  },
  {
    at: AT.send,
    time: "10:00:00.0",
    text: "Attempt 1 sent to our server. Waiting up to 3s for a reply",
  },
  { at: AT.retry, time: "10:00:03.0", text: "No reply in 3s. Attempt 1 timed out", tone: "bad" },
  { at: AT.retry, time: "10:00:03.0", text: "Attempt 2 sent (retry 1)", tag: "Again" },
  {
    at: AT.late,
    time: "10:00:04.3",
    text: "Reply to attempt 1 arrived after it timed out",
    tone: "muted",
  },
  { at: AT.copy, time: "10:00:07.3", text: "Reply to attempt 2 received", tone: "good" },
]
const server = [
  { at: AT.save, time: "10:00:00.3", text: "Attempt 1 arrived. Saving it before replying" },
  { at: AT.retry, time: "10:00:03.3", text: "Attempt 2 arrived. Saving it before replying" },
  { at: AT.late, time: "10:00:04.3", text: "Attempt 1 saved. Replied" },
  { at: AT.copy, time: "10:00:07.3", text: "Attempt 2 saved. Replied" },
]
---

<figure
  class="rg6 st"
  data-rg6-visual
  aria-label="Two logs side by side. Slack's delivery log shows Sebastian's message sent as attempt 1, timing out after three seconds with no reply, and sent again as attempt 2. Our server's log shows both attempts arriving and being saved, and the message table ends up with the same message twice."
  style={[
    `--rg6-msg-light: ${people.Sebastian.light}`,
    `--rg6-msg-dark: ${people.Sebastian.dark}`,
    `--rg6-warn: ${warning.background}`,
    `--rg6-warn-ink: ${warning.text}`,
  ].join("; ")}
>
  <div class="rg6-panels">
    <section class="rg6-panel">
      <p class="rg6-title">Slack's delivery log</p>
      <ol class="rg6-log">
        {
          slack.map((line) => (
            <li class:list={["rg6-line", line.tone && `is-${line.tone}`]} data-at={line.at}>
              <span class="rg6-time">{line.time}</span>
              <span class="rg6-text">
                {line.text}
                {line.tag && <span class="rg6-tag">{line.tag}</span>}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="rg6-panel">
      <p class="rg6-title">Our server</p>
      <ol class="rg6-log">
        {
          server.map((line) => (
            <li class="rg6-line" data-at={line.at}>
              <span class="rg6-time">{line.time}</span>
              <span class="rg6-text">{line.text}</span>
            </li>
          ))
        }
      </ol>
      <RetryTable />
    </section>
  </div>

  <StepControls reset />
</figure>

<script>
  import { STEPS, reveal } from "./retry"
  import { createStepper } from "@/components/blog/module-of-the-week/stepper/stepper"

  for (const root of document.querySelectorAll<HTMLElement>("[data-rg6-visual]")) {
    const caption = root.querySelector<HTMLElement>("[data-caption]")!
    createStepper({
      root,
      first: 0,
      last: STEPS.length - 1,
      apply: (k) => {
        reveal(root, k)
        caption.textContent = `${k + 1}. ${STEPS[k]}`
      },
    })
  }
</script>

<style is:global>
  .rg6 {
    --st-ink: #3f3f46;
    --st-muted: #71717a;
    --st-line: #d4d4d8;
    --st-surface: #ffffff;
    --rg6-red: #dc2626;
    --rg6-ok: #15803d;
    margin: 1.5rem 0;
    container: rg6 / inline-size;
  }
  html.dark .rg6 {
    --st-ink: #e4e4e7;
    --st-muted: #a1a1aa;
    --st-line: #3f3f46;
    --st-surface: #09090b;
    --rg6-red: #f87171;
    --rg6-ok: #4ade80;
  }
  .st.rg6 .rg6-panel p {
    margin: 0;
    font-size: inherit;
    line-height: 1.4;
  }

  .rg6-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .rg6-panel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.85rem;
    border: 1px solid var(--st-line);
    border-radius: var(--radius-lg, 8px);
    background: var(--st-surface);
    font-size: 0.74rem;
    color: var(--st-ink);
  }
  .st.rg6 .rg6-title {
    font-weight: 600;
  }

  .rg6 [data-at] {
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .rg6 [data-at].is-on {
    opacity: 1;
    transform: none;
  }

  .rg6-log {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The post styles list items, so these say their size */
  .st.rg6 .rg6-log li {
    margin: 0;
    padding: 0;
    font-size: 0.74rem;
    line-height: 1.4;
  }
  .rg6-log li::before,
  .rg6-log li::marker {
    content: none;
  }
  .rg6-line {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }
  .rg6-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.66rem;
    color: var(--st-muted);
  }
  /* The step that just happened stands out from the ones before it */
  .rg6-line.is-now .rg6-text {
    font-weight: 600;
  }
  .rg6-line.is-bad .rg6-text {
    color: var(--rg6-red);
  }
  .rg6-line.is-good .rg6-text {
    color: var(--rg6-ok);
  }
  .rg6-line.is-muted .rg6-text {
    color: var(--st-muted);
  }
  .rg6-tag {
    margin-left: 0.3rem;
    padding: 0 0.35rem;
    border-radius: var(--radius-sm, 4px);
    background: var(--rg6-warn);
    color: var(--rg6-warn-ink);
    font-size: 0.62rem;
    font-weight: 700;
  }
  /* The table goes to the bottom, under our server's log */
  .rg6-panel .rtb6 {
    margin-top: auto;
  }

  @container rg6 (width < 560px) {
    .rg6-panels {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rg6 [data-at] {
      transform: none;
      transition: opacity 120ms linear;
    }
  }
</style>
