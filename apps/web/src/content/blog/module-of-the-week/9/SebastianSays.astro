---
// Speech bubble for Sebastian's enthusiastic side-quest interjections.
// Uses his blue accent from Post 3's palette until an illustrated portrait is added.
---

<div class="not-prose my-6 flex items-start gap-3">
  <span
    aria-hidden="true"
    class="flex size-11 shrink-0 items-center justify-center rounded-full border border-border bg-[#0072b2] font-mono text-sm font-bold text-white"
  >
    SL
  </span>
  <div
    class="relative min-w-0 rounded-lg border border-border bg-card/60 px-4 py-3 text-base leading-relaxed text-prose-foreground"
  >
    <span class="sr-only">Sebastian says:</span>
    <slot />
  </div>
</div>
