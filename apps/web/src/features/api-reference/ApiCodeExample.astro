---
import { Code } from "astro-expressive-code/components"

import type { ApiCodeExample } from "./ApiReference"
import ApiSectionHeading from "./ApiSectionHeading.astro"

interface Props {
  example: ApiCodeExample
}

const { example } = Astro.props
---

<article>
  <ApiSectionHeading>
    Example
    {
      example.title && (
        <span class="font-sans text-base font-normal tracking-normal text-prose-foreground normal-case">
          {" "}
          {example.title}
        </span>
      )
    }
  </ApiSectionHeading>

  <div class="pt-1.5">
    <Code code={example.source} lang={example.language} meta="showLineNumbers=false" />
  </div>
</article>
