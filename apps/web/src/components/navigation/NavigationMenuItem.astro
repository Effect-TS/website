---
import { ArrowUpRight, ChevronDown } from "@lucide/astro"
import NavigationAnchor from "@/components/navigation/NavigationAnchor.astro"
import {
  isNavigationEntryActive,
  resolveNavigationMenuEntry,
  type InternalNavigationLink,
  type NavigationActiveSlug,
  type NavigationDocsSection,
} from "@/lib/navigation"

interface Props {
  readonly link: InternalNavigationLink
  readonly active: boolean
  readonly activeSlug?: NavigationActiveSlug | undefined
  readonly docsSection?: NavigationDocsSection | undefined
  readonly version?: string | undefined
}

const { link, active, activeSlug, docsSection, version } = Astro.props
const menu = link.menu ?? []
---

<div class="group/menu relative flex items-center gap-1">
  <NavigationAnchor
    link={link}
    class="text-sm font-medium no-underline transition-colors text-zinc-500 hover:text-zinc-900 group-has-[details[open]]/menu:text-zinc-900 dark:text-zinc-400 dark:hover:text-white dark:group-has-[details[open]]/menu:text-white"
    active={active}
    activeClass="text-zinc-900 dark:text-white"
  />

  <details data-nav-menu class="group/details">
    <summary
      aria-label={`${link.label} menu`}
      class="flex size-6 cursor-pointer list-none items-center justify-center rounded-sm text-zinc-500 transition-colors marker:hidden hover:text-zinc-900 group-open/details:text-zinc-900 dark:text-zinc-400 dark:hover:text-white dark:group-open/details:text-white [&::-webkit-details-marker]:hidden"
    >
      <ChevronDown
        class="size-3.5 transition-transform group-open/details:rotate-180"
        aria-hidden="true"
      />
    </summary>

    <div class="absolute top-full -left-3 w-max pt-3">
      <ul
        class="grid grid-cols-2 gap-1.5 rounded-lg border border-border bg-popover p-1.5 text-popover-foreground shadow-md"
      >
        {
          menu.map((entry) => {
            const external = entry.href.startsWith("https://")
            const { href, alternates } = resolveNavigationMenuEntry(entry, version)
            const entryActive = isNavigationEntryActive(entry, { activeSlug, docsSection })
            return (
              <li
                class:list={[
                  "flex items-start gap-1 rounded-md hover:bg-muted",
                  entryActive && "bg-accent",
                ]}
              >
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  aria-current={entryActive ? "page" : undefined}
                  class="flex flex-1 flex-col rounded-md px-3 py-2 no-underline"
                >
                  <span class="inline-flex items-center gap-1 text-sm font-medium text-foreground">
                    {entry.label}
                    {external && <ArrowUpRight size={14} aria-hidden="true" />}
                  </span>
                  <span class="text-xs whitespace-nowrap text-muted-foreground">
                    {entry.description}
                  </span>
                </a>
                {alternates.map((alternate) => (
                  <a
                    href={alternate.href}
                    aria-label={`${entry.label} ${alternate.label}`}
                    class="mt-2 mr-2 flex min-h-6 min-w-6 items-center justify-center rounded-sm border border-border px-1.5 font-mono text-xs text-muted-foreground no-underline transition-colors hover:border-border-strong hover:text-foreground"
                  >
                    {alternate.label}
                  </a>
                ))}
              </li>
            )
          })
        }
      </ul>
    </div>
  </details>
</div>

<script>
  const OPEN_DELAY_MS = 500
  const CLOSE_DELAY_MS = 250

  const menus = document.querySelectorAll<HTMLDetailsElement>("details[data-nav-menu]")
  const openMenus = () =>
    document.querySelectorAll<HTMLDetailsElement>("details[data-nav-menu][open]")

  const closeOutside = (target: EventTarget | null) => {
    for (const menu of openMenus()) {
      if (!(target instanceof Node) || !menu.contains(target)) menu.open = false
    }
  }

  for (const menu of menus) {
    const root = menu.parentElement
    if (!root) continue
    let timer: number | undefined

    const schedule = (open: boolean, delay: number) => {
      window.clearTimeout(timer)
      timer = window.setTimeout(() => {
        if (!open && menu.contains(document.activeElement)) return
        menu.open = open
      }, delay)
    }

    root.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") schedule(true, openMenus().length > 0 ? 0 : OPEN_DELAY_MS)
    })
    root.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") schedule(false, CLOSE_DELAY_MS)
    })
  }

  document.addEventListener("pointerdown", (event) => closeOutside(event.target))
  document.addEventListener("focusin", (event) => closeOutside(event.target))
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return
    for (const menu of openMenus()) {
      const hadFocus = menu.contains(document.activeElement)
      menu.open = false
      if (hadFocus) menu.querySelector("summary")?.focus()
    }
  })
</script>
