---
import { ArrowUpRight } from "@lucide/astro"
import { Image } from "astro:assets"
import ArrowLink from "@/components/enterprise/ArrowLink.astro"
import BorderedGrid from "@/components/enterprise/BorderedGrid.astro"
import CardBody from "@/components/enterprise/CardBody.astro"
import GroupBar from "@/components/enterprise/GroupBar.astro"
import { STORIES_HREF } from "@/features/enterprise/copy"
import { PRODUCTION_STORIES } from "@/features/enterprise/showcase"
---

<GroupBar>
  <Fragment slot="label">In production</Fragment>
  <ArrowLink href={STORIES_HREF}>More stories</ArrowLink>
</GroupBar>
<BorderedGrid flush class="grid-cols-1 md:grid-cols-2">
  {
    PRODUCTION_STORIES.map((story) => (
      <li>
        <a
          href={story.href}
          {...(story.href.startsWith("http")
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {})}
          class="group flex h-full flex-col bg-background px-6 py-5 no-underline transition-colors hover:bg-card hover:no-underline md:px-8"
        >
          <span class="flex items-start justify-between gap-4">
            <span class="flex h-8 items-center">
              <Image
                src={story.logo}
                alt={story.company}
                class:list={[story.logoHeight, "w-auto"]}
              />
            </span>
            <ArrowUpRight
              size={18}
              class="shrink-0 text-subtle-foreground transition-colors group-hover:text-foreground"
              aria-hidden="true"
            />
          </span>
          <CardBody class="mt-3">{story.useCase}</CardBody>
        </a>
      </li>
    ))
  }
</BorderedGrid>
