---
import { Copy, Check } from "@lucide/astro"
import { DEFAULT_PACKAGE_MANAGER, getInstallCommand, PACKAGE_MANAGERS } from "@/lib/install-command"
---

<effect-hero-command
  class="relative flex flex-wrap items-center gap-2 rounded-md border border-border-strong bg-card p-2 font-mono text-sm text-foreground"
>
  <label class="flex items-center gap-2">
    <span class="sr-only">Package manager</span>
    <select
      data-role="package-manager"
      class="min-h-9 max-w-full rounded border border-input bg-background px-2 text-foreground"
    >
      {
        PACKAGE_MANAGERS.map((pm) => (
          <option value={pm} selected={pm === DEFAULT_PACKAGE_MANAGER}>
            {pm}
          </option>
        ))
      }
    </select>
  </label>
  <button
    type="button"
    data-role="copy"
    aria-label="Copy install command"
    class="flex min-h-9 min-w-0 flex-1 items-center justify-between gap-3 rounded px-2 text-left hover:bg-muted"
  >
    <span data-role="command-text" class="min-w-0 [overflow-wrap:anywhere]"
      >{getInstallCommand(DEFAULT_PACKAGE_MANAGER)}</span
    >
    <Copy data-role="copy-icon-idle" size={16} class="shrink-0" aria-hidden="true" />
    <Check data-role="copy-icon-copied" size={16} class="hidden shrink-0" aria-hidden="true" />
  </button>
  <p role="status" data-role="status" class="sr-only"></p>
</effect-hero-command>

<script>
  import * as Schema from "effect/Schema"
  import { getInstallCommand, PACKAGE_MANAGERS } from "@/lib/install-command"

  const isPackageManager = Schema.is(Schema.Literals(PACKAGE_MANAGERS))

  class EffectHeroCommand extends HTMLElement {
    #events?: AbortController
    #timeout?: ReturnType<typeof setTimeout>

    connectedCallback() {
      this.#events = new AbortController()
      const options = { signal: this.#events.signal }
      const select = this.querySelector("select")
      const command = this.querySelector('[data-role="command-text"]')
      const status = this.querySelector('[role="status"]')
      if (!select || !command || !status) return
      select.addEventListener(
        "change",
        () => {
          if (isPackageManager(select.value)) command.textContent = getInstallCommand(select.value)
        },
        options,
      )
      this.querySelector("button")?.addEventListener(
        "click",
        async () => {
          try {
            await navigator.clipboard.writeText(command.textContent ?? "")
            status.textContent = "Copied install command"
            this.querySelector('[data-role="copy-icon-idle"]')?.classList.add("hidden")
            this.querySelector('[data-role="copy-icon-copied"]')?.classList.remove("hidden")
          } catch {
            status.textContent = "Could not copy. Select and copy the command manually."
          }
          clearTimeout(this.#timeout)
          this.#timeout = setTimeout(() => {
            this.querySelector('[data-role="copy-icon-idle"]')?.classList.remove("hidden")
            this.querySelector('[data-role="copy-icon-copied"]')?.classList.add("hidden")
            status.textContent = ""
          }, 1500)
        },
        options,
      )
    }

    disconnectedCallback() {
      this.#events?.abort()
      clearTimeout(this.#timeout)
    }
  }
  if (!customElements.get("effect-hero-command"))
    customElements.define("effect-hero-command", EffectHeroCommand)
</script>
