---
import { getCollection, render } from "astro:content"

import { ChevronDown, Menu } from "@lucide/astro"

import DocsSidebarTree from "@/components/docs/DocsSidebarTree.astro"
import TableOfContents from "@/components/ui/toc/TableOfContents.astro"
import DocShell from "@/layouts/DocShell.astro"
import { buildDocsSidebar } from "@/lib/docs-sections"

export const prerender = true

export async function getStaticPaths() {
  const entries = await getCollection("docs")
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, "") },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const currentVersion = entry.id.split("/")[0]
if (currentVersion === undefined) {
  throw new Error("Unable to generate sidebar entry without document version")
}

const { section, items } = await buildDocsSidebar(currentVersion, entry.id)
const currentLabel = entry.data.sidebar?.label ?? entry.data.title

const tocItems = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text,
    indent: heading.depth === 3,
    class: "text-sm leading-snug",
  }))
---

<DocShell
  title={entry.data.title}
  description={entry.data.description}
  activeSlug="docs"
  version={currentVersion}
  section={section}
>
  <!-- Mobile docs menu -->
  <div
    slot="mobile-nav"
    class="sticky top-[var(--sticky-header-height)] z-40 border-b border-border bg-background/95 backdrop-blur-sm lg:hidden"
  >
    <details class="group">
      <summary
        class="flex w-full cursor-pointer select-none list-none items-center gap-2 px-4 py-3 text-sm font-medium text-navigation-heading"
      >
        <Menu class="h-5 w-5 -translate-y-px" aria-hidden="true" />
        <span>Docs menu</span>
        <span class="text-muted-foreground">/</span>
        <span class="truncate text-muted-foreground">{currentLabel}</span>
        <ChevronDown
          class="ml-auto h-4 w-4 transition-transform group-open:rotate-180"
          aria-hidden="true"
        />
      </summary>
      <nav
        aria-label="Documentation navigation"
        class="max-h-[60vh] overflow-y-auto border-t border-border px-4 py-4"
      >
        <DocsSidebarTree items={items} currentId={entry.id} />
      </nav>
    </details>
  </div>

  <!-- Desktop sidebar -->
  <nav slot="sidebar" aria-label="Documentation navigation">
    <DocsSidebarTree items={items} currentId={entry.id} />
  </nav>

  <!-- Main content -->
  <article class="prose prose-effect max-w-none">
    <h1 class="mt-0!">{entry.data.title}</h1>
    <Content />
  </article>

  <!-- Right TOC -->
  {tocItems.length > 0 && <TableOfContents slot="toc" items={tocItems} />}
</DocShell>
