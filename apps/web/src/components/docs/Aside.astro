---
import { Info, Lightbulb, TriangleAlert, OctagonAlert } from "@lucide/astro"

type AsideType = "note" | "tip" | "caution" | "danger"

interface Props {
  type?: AsideType
  title?: string
}

const { type = "note", title } = Astro.props

const iconMap = {
  note: Info,
  tip: Lightbulb,
  caution: TriangleAlert,
  danger: OctagonAlert,
}

const defaultTitles: Record<AsideType, string> = {
  note: "Note",
  tip: "Tip",
  caution: "Caution",
  danger: "Danger",
}

const label = title ?? defaultTitles[type]
const Icon = iconMap[type]
---

<aside role="note" class:list={["aside", `aside--${type}`]} aria-label={label}>
  <p class="aside-title" aria-hidden="true">
    <Icon aria-hidden="true" size={16} stroke-width={2.5} />
    {label}
  </p>
  <div class="aside-content">
    <slot />
  </div>
</aside>

<style>
  .aside {
    position: relative;
    border-radius: 0.375rem;
    padding: 1.12rem 1.125rem 0.25rem;
    margin-block: 1.5rem;
  }

  .aside::before {
    position: absolute;
    inset: 0;
    border: 2px solid rgb(255 255 255 / 90%);
    border-radius: inherit;
    content: "";
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .aside-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.125rem;
    letter-spacing: normal;
    margin: 0;
  }

  .aside-title :global(svg) {
    transform: translateY(-1px);
  }

  .aside-content :global(> :first-child) {
    margin-top: 0;
  }
  .aside-content :global(> :last-child) {
    margin-bottom: 0;
  }

  .aside--note {
    background-color: color-mix(in srgb, var(--info) 8%, transparent);
  }
  .aside--note .aside-title {
    color: var(--info-foreground);
  }

  .aside--tip {
    background-color: color-mix(in srgb, var(--success) 8%, transparent);
  }
  .aside--tip .aside-title {
    color: var(--success-foreground);
  }

  .aside--caution {
    background-color: color-mix(in srgb, var(--warning) 8%, transparent);
  }
  .aside--caution .aside-title {
    color: var(--warning-foreground);
  }

  .aside--danger {
    background-color: color-mix(in srgb, var(--danger) 8%, transparent);
  }
  .aside--danger .aside-title {
    color: var(--destructive);
  }
</style>
