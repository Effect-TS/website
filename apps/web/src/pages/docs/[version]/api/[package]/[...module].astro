---
import type { GetStaticPaths } from "astro"
import { getCollection } from "astro:content"
import { Link as LinkIcon } from "@lucide/astro"

import TableOfContents from "@/components/ui/toc/TableOfContents.astro"
import ApiDeclaration from "@/features/api-reference/ApiDeclaration.astro"
import ApiMobileNavigation from "@/features/api-reference/ApiMobileNavigation.astro"
import * as ApiReference from "@/features/api-reference/ApiReference"
import ApiSidebarNav from "@/features/api-reference/ApiSidebarNav.astro"
import VersionSwitch from "@/components/ui/VersionSwitch.astro"
import { resolveApiReferenceOpenGraph } from "@/features/api-reference/open-graph"
import DocShell from "@/layouts/DocShell.astro"
import { DOCS_VERSIONS } from "@/lib/versions"

export const getStaticPaths = (async () => {
  const entries = await getCollection("apiReference")
  return entries.map((entry) => ({
    params: {
      version: entry.data.version,
      package: entry.data.packageSlug,
      module: entry.data.modulePath,
    },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const allEntries = await getCollection("apiReference")
const reflection = await ApiReference.loadReflection(entry.data)
const moduleName = entry.data.modulePath.split("/").at(-1) ?? entry.data.modulePath
const displayName = entry.data.packageName.replace("@effect/", "")
const openGraph = resolveApiReferenceOpenGraph(
  `docs/${entry.data.version}/api/${entry.data.packageSlug}/${entry.data.modulePath}`,
  [entry.data],
)
const packageEntries = allEntries
  .filter(
    (candidate) =>
      candidate.data.version === entry.data.version &&
      candidate.data.packageSlug === entry.data.packageSlug,
  )
  .toSorted((left, right) => left.data.modulePath.localeCompare(right.data.modulePath))
const moduleHref = (modulePath: string) =>
  `/docs/${entry.data.version}/api/${entry.data.packageSlug}/${modulePath}`
const packageModulePaths = new Set(packageEntries.map((candidate) => candidate.data.modulePath))
const apiModule = ApiReference.ApiReference.moduleView(reflection, {
  moduleHref: (modulePath) =>
    packageModulePaths.has(modulePath) ? moduleHref(modulePath) : undefined,
  modulePath: entry.data.modulePath,
})
const versionLinks = DOCS_VERSIONS.map(({ value: version, label }) => {
  const exact = allEntries.find(
    (candidate) =>
      candidate.data.version === version &&
      candidate.data.packageSlug === entry.data.packageSlug &&
      candidate.data.modulePath === entry.data.modulePath,
  )
  return {
    href:
      exact === undefined
        ? undefined
        : `/docs/${exact.data.version}/api/${exact.data.packageSlug}/${exact.data.modulePath}`,
    version,
    label,
  }
})
const showVersionSwitch = versionLinks.every(({ href }) => href !== undefined)
function moduleSection(modulePath: string): string {
  const parts = modulePath.split("/")
  if (entry.data.packageName === "effect" && parts[0] === "unstable") {
    return `unstable/${parts[1] ?? "other"}`
  }
  return parts.length === 1 ? "core" : (parts[0] ?? "core")
}

const groups = [...Map.groupBy(packageEntries, (module) => moduleSection(module.data.modulePath))]
const stableGroups = groups.filter(([group]) => !group.startsWith("unstable/"))
const unstableGroups = groups.filter(([group]) => group.startsWith("unstable/"))
const sections = [
  { label: undefined, groups: stableGroups },
  { label: "Unstable", groups: unstableGroups },
].filter(({ groups }) => groups.length > 0)
const sidebarVersions = versionLinks.map(({ href, version: candidate, label }) => ({
  href: href ?? "",
  label,
  active: candidate === entry.data.version,
}))
const sidebarSections = sections.map((section) => ({
  label: section.label,
  groups: section.groups.map(([group, groupModules]) => ({
    name: groupName(group),
    open: groupModules.some((candidate) => candidate.id === entry.id),
    links: groupModules
      .toSorted((left, right) => left.data.modulePath.localeCompare(right.data.modulePath))
      .map((candidate) => {
        const active = candidate.id === entry.id
        return {
          href: moduleHref(candidate.data.modulePath),
          label: sidebarModuleName(candidate.data.modulePath, group),
          active,
          data: { "data-current-module": active ? "" : undefined },
        }
      }),
  })),
}))
const mobileVersions = showVersionSwitch
  ? versionLinks.flatMap(({ href, version }) =>
      href === undefined
        ? []
        : [{ href, label: version, selected: version === entry.data.version }],
    )
  : []
const mobilePackages = Array.from(
  Map.groupBy(
    allEntries.filter((candidate) => candidate.data.version === entry.data.version),
    (candidate) => candidate.data.packageSlug,
  ),
)
  .map(([, entries]) => entries[0])
  .flatMap((candidate) =>
    candidate === undefined
      ? []
      : [
          {
            href: `/docs/${entry.data.version}/api/${candidate.data.packageSlug}`,
            label: candidate.data.packageName.replace("@effect/", ""),
            selected: candidate.data.packageSlug === entry.data.packageSlug,
          },
        ],
  )
  .toSorted((left, right) => left.label.localeCompare(right.label))
const mobileModules = packageEntries.map((candidate) => ({
  href: moduleHref(candidate.data.modulePath),
  label: candidate.data.modulePath,
  selected: candidate.id === entry.id,
}))

function groupName(group: string): string {
  const name = group.replace("unstable/", "")
  return name.replace(/[-_]/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase())
}

function sidebarModuleName(modulePath: string, group: string): string {
  if (group === "core") return modulePath
  const prefix = `${group}/`
  return modulePath.startsWith(prefix) ? modulePath.slice(prefix.length) : modulePath
}

const tocItems = apiModule.groups.map((group) => ({
  id: group.slug,
  label: group.name,
  class: "text-sm",
  emphasis: true,
  children: group.declarations.map((declaration) => ({
    id: declaration.anchor,
    label: declaration.name,
    hint: declaration.typeKind,
    class: "truncate font-mono text-xs",
    title: `${declaration.name}${declaration.typeKind === undefined ? "" : ` (${declaration.typeKind})`}`,
  })),
}))
---

<DocShell
  title={`${moduleName} API Reference | Effect`}
  description={openGraph?.description}
  ogImageVersion={entry.data.revision}
  activeSlug="api"
  version={entry.data.version}
>
  <ApiMobileNavigation
    slot="mobile-nav"
    version={entry.data.version}
    versions={mobileVersions}
    packages={mobilePackages}
    modules={mobileModules}
  />

  <nav slot="sidebar" aria-label="API reference navigation" data-api-sidebar data-module-sidebar>
    {
      showVersionSwitch && (
        <VersionSwitch versions={sidebarVersions} aria-label="API reference version" />
      )
    }

    <header class="mb-4">
      <a
        href={`/docs/${entry.data.version}/api`}
        class="mb-4 block font-mono text-sm font-semibold tracking-widest text-foreground uppercase hover:underline"
      >
        API Reference
      </a>

      <h2 class="mb-1 font-mono text-lg font-semibold tracking-tight">{displayName}</h2>
      <p class="font-mono text-xs text-muted-foreground">
        {entry.data.packageVersion}
      </p>
    </header>

    <ApiSidebarNav sections={sidebarSections} />
  </nav>

  <article class="prose prose-effect max-w-4xl">
    <nav
      aria-label="Breadcrumb"
      class="mb-5 flex flex-wrap items-center gap-3 font-mono text-xs tracking-wider text-muted-foreground uppercase not-prose lg:mb-8"
    >
      <a
        href={`/docs/${entry.data.version}/api`}
        class="text-muted-foreground transition-colors hover:text-foreground"
      >
        API Reference
      </a>
      <span aria-hidden="true">/</span>
      <a
        href={`/docs/${entry.data.version}/api`}
        class="text-muted-foreground transition-colors hover:text-foreground"
      >
        {entry.data.version}
      </a>
      <span aria-hidden="true">/</span>
      <a
        href={`/docs/${entry.data.version}/api/${entry.data.packageSlug}`}
        class="text-muted-foreground transition-colors hover:text-foreground"
      >
        {displayName}
      </a>
      <span aria-hidden="true">/</span>
      <span>{moduleName}</span>
    </nav>

    <header class="mb-8 lg:mb-12">
      <h1 class="mb-4! font-mono md:mb-6!">{moduleName}</h1>
      {apiModule.commentHtml && <div class="mb-6" set:html={apiModule.commentHtml} />}
      <div
        class="not-prose flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm text-muted-foreground"
      >
        <span>{apiModule.declarationCount} exports</span>
        {apiModule.since && <span>Added in v{apiModule.since}</span>}
        {
          apiModule.sourceUrl && (
            <a
              href={apiModule.sourceUrl}
              target="_blank"
              class="inline-flex items-center gap-2 transition-colors hover:text-foreground"
            >
              <i class="ri-github-fill text-base" aria-hidden="true" /> Source
            </a>
          )
        }
      </div>
    </header>

    <div class="not-prose space-y-4">
      {
        apiModule.groups.map((group) => (
          <section id={group.slug} class="scroll-mt-24">
            <h2 class="mb-0 text-2xl font-semibold tracking-tight text-foreground">
              <a
                href={`#${group.slug}`}
                class="group relative inline-block text-inherit no-underline!"
              >
                <LinkIcon
                  class="absolute top-1/2 right-full mr-2 size-4 -translate-y-1/2 text-subtle-foreground opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                  aria-hidden="true"
                />
                {group.name}
              </a>
            </h2>
            <div>
              {group.declarations.map((declaration) => (
                <ApiDeclaration declaration={declaration} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </article>

  {tocItems.length > 0 && <TableOfContents slot="toc" items={tocItems} />}
</DocShell>

<script>
  const moduleSidebar = document.querySelector<HTMLElement>("[data-module-sidebar]")
  const currentModuleLink = moduleSidebar?.querySelector<HTMLElement>("[data-current-module]")

  if (moduleSidebar !== null && currentModuleLink !== undefined && currentModuleLink !== null) {
    const details = currentModuleLink.closest("details")
    if (details instanceof HTMLDetailsElement) details.open = true

    // DocShell owns the scrolling rail; use it rather than the navigation
    // element so the active module is centered after the shared layout change.
    const sidebarScroller = moduleSidebar.closest<HTMLElement>("[data-doc-rail]") ?? moduleSidebar

    requestAnimationFrame(() => {
      const sidebarBounds = sidebarScroller.getBoundingClientRect()
      const linkBounds = currentModuleLink.getBoundingClientRect()
      const isVisible =
        linkBounds.top >= sidebarBounds.top && linkBounds.bottom <= sidebarBounds.bottom
      if (isVisible) return

      sidebarScroller.scrollTop +=
        linkBounds.top - sidebarBounds.top - (sidebarScroller.clientHeight - linkBounds.height) / 2
    })
  }
</script>
