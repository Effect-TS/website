---
import Eyebrow from "@/components/ui/Eyebrow.astro"
import LinkedText from "@/components/blog/LinkedText.astro"

interface Props {
  title: string
  textLinks?: Record<string, string>
  steps: Array<{
    owner: string
    title: string
    detail: string
  }>
  footer?: string
}

const { title, steps, footer, textLinks = {} } = Astro.props
---

<figure class="not-prose my-10 overflow-hidden rounded-lg border border-border bg-card/60">
  <figcaption class="border-b border-border px-5 py-4">
    <Eyebrow as="span" class="text-xs">{title}</Eyebrow>
  </figcaption>
  <div class="divide-y divide-border">
    {
      steps.map(({ owner, title, detail }, index) => (
        <div class="flex gap-4 px-5 py-5">
          <span aria-hidden="true" class="pt-1 font-mono text-sm text-brand">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div>
            <p class="mb-1 text-xs text-muted-foreground">
              <LinkedText text={owner} links={textLinks} />
            </p>
            <p class="mb-1 text-base font-semibold text-foreground">{title}</p>
            <p class="text-sm leading-relaxed text-prose-foreground">{detail}</p>
          </div>
        </div>
      ))
    }
  </div>
  {
    footer && (
      <p class="border-t border-border bg-brand/5 px-5 py-4 text-sm font-medium text-foreground">
        {footer}
      </p>
    )
  }
</figure>
