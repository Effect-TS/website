---
// Option 1: what Slack and our server say to each other, as a chat. Slack
// passes on Sebastian's message and asks to hear back within three seconds.
// Our server saves the message first, so it stays quiet. Slack decides the
// message got lost and sends it again, and both copies get saved.

import { AT } from "./retry"
import { people, warning } from "../3/palette"
import StepControls from "@/components/blog/module-of-the-week/stepper/StepControls.astro"
import RetryTable from "./RetryTable.astro"

const question = "Why is this test flaky?"
---

<figure
  class="rh6 st"
  data-rh6-visual
  aria-label="A conversation. Sebastian posts in Slack. Slack passes the message on to our server and asks to hear back within three seconds. Our server saves the message before replying, and the save is slow. After three seconds with no reply, Slack decides the message got lost and sends it again. Our first reply arrives too late, and both copies end up in the message table."
  style={[
    `--rh6-msg-light: ${people.Sebastian.light}`,
    `--rh6-msg-dark: ${people.Sebastian.dark}`,
    `--rh6-avatar: ${people.Sebastian.avatar}`,
    `--rh6-warn: ${warning.background}`,
    `--rh6-warn-ink: ${warning.text}`,
  ].join("; ")}
>
  <div class="rh6-card">
    {/* Where the message starts: Sebastian, in Slack */}
    <div class="rh6-post" data-at={AT.post}>
      <span class="rh6-avatar" aria-hidden="true">S</span>
      <p>
        <span class="rh6-name">Sebastian</span>
        <span class="rh6-channel">in #engineering</span>
        <span class="rh6-said">{question}</span>
      </p>
    </div>

    <p class="rh6-divider" data-at={AT.send}>What Slack and our server say to each other</p>

    <ol class="rh6-chat">
      <li class="rh6-line is-slack" data-at={AT.send}>
        <span class="rh6-who">Slack <span class="rh6-time">0s</span></span>
        <p class="rh6-bubble">
          New message from Sebastian: “{question}” Let me know within 3 seconds that you got it.
        </p>
      </li>
      <li class="rh6-line is-server is-aside" data-at={AT.save}>
        <span class="rh6-who">Our server <span class="rh6-time">0.3s</span></span>
        <p class="rh6-bubble">(Saving it to the database first. This is taking a while…)</p>
      </li>
      <li class="rh6-line is-slack" data-at={AT.retry}>
        <span class="rh6-who">Slack <span class="rh6-time">3s</span></span>
        <p class="rh6-bubble">
          No answer. It must have got lost. Sending it again: “{question}”
          <span class="rh6-tag is-again">Again</span>
        </p>
      </li>
      <li class="rh6-line is-server" data-at={AT.late}>
        <span class="rh6-who">Our server <span class="rh6-time">4.3s</span></span>
        <p class="rh6-bubble">
          Got it! <span class="rh6-tag is-late">Too late</span>
        </p>
      </li>
      <li class="rh6-line is-server" data-at={AT.copy}>
        <span class="rh6-who">Our server <span class="rh6-time">7.3s</span></span>
        <p class="rh6-bubble">Got it!</p>
      </li>
    </ol>

    <RetryTable />
  </div>

  <StepControls reset />
</figure>

<script>
  import { STEPS, reveal } from "./retry"
  import { createStepper } from "@/components/blog/module-of-the-week/stepper/stepper"

  for (const root of document.querySelectorAll<HTMLElement>("[data-rh6-visual]")) {
    const caption = root.querySelector<HTMLElement>("[data-caption]")!
    createStepper({
      root,
      first: 0,
      last: STEPS.length - 1,
      apply: (k) => {
        reveal(root, k)
        caption.textContent = `${k + 1}. ${STEPS[k]}`
      },
    })
  }
</script>

<style is:global>
  .rh6 {
    --st-ink: #3f3f46;
    --st-muted: #71717a;
    --st-line: #d4d4d8;
    --st-surface: #ffffff;
    --rh6-panel: #f4f4f5;
    --rh6-msg: var(--rh6-msg-light);
    --rh6-red: #dc2626;
    margin: 1.5rem 0;
  }
  html.dark .rh6 {
    --st-ink: #e4e4e7;
    --st-muted: #a1a1aa;
    --st-line: #3f3f46;
    --st-surface: #09090b;
    --rh6-panel: #18181b;
    --rh6-msg: var(--rh6-msg-dark);
    --rh6-red: #f87171;
  }
  .st.rh6 .rh6-card p {
    margin: 0;
    font-size: inherit;
    line-height: 1.4;
  }
  .rh6-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--st-line);
    border-radius: var(--radius-lg, 8px);
    background: var(--st-surface);
    font-size: 0.78rem;
    color: var(--st-ink);
  }

  /* Things show up when their step comes */
  .rh6 [data-at] {
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .rh6 [data-at].is-on {
    opacity: 1;
    transform: none;
  }

  .rh6-post {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .rh6-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: var(--radius-md, 6px);
    background: var(--rh6-avatar);
    color: #fff;
    font-weight: 700;
  }
  .rh6-name {
    font-weight: 700;
  }
  .rh6-channel {
    margin-left: 0.3rem;
    color: var(--st-muted);
    font-size: 0.7rem;
  }
  .rh6-said {
    display: block;
  }

  .st.rh6 .rh6-divider {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    color: var(--st-muted);
  }
  .rh6-divider::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--st-line);
  }

  .rh6-chat {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rh6-chat li {
    margin: 0;
    padding: 0;
  }
  .rh6-chat li::before,
  .rh6-chat li::marker {
    content: none;
  }
  /* Slack on the left, our server on the right */
  .rh6-line {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 78%;
  }
  .rh6-line.is-server {
    align-self: flex-end;
    align-items: flex-end;
  }
  .rh6-who {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--st-muted);
  }
  .rh6-time {
    margin-left: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 400;
  }
  /* The post styles paragraphs in list items, so this one says its size */
  .st.rh6 .rh6-chat .rh6-bubble {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-lg, 8px);
    background: var(--rh6-panel);
  }
  .rh6-line.is-server .rh6-bubble {
    background: color-mix(in oklab, var(--rh6-msg) 16%, var(--st-surface));
  }
  /* Our server thinking to itself, rather than saying anything to Slack */
  .rh6-line.is-aside .rh6-bubble {
    border: 1px dashed var(--st-line);
    background: none;
    color: var(--st-muted);
    font-style: italic;
  }
  .rh6-tag {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0 0.35rem;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 700;
    vertical-align: 0.05em;
  }
  .rh6-tag.is-again {
    background: var(--rh6-warn);
    color: var(--rh6-warn-ink);
  }
  .rh6-tag.is-late {
    border: 1px solid var(--rh6-red);
    color: var(--rh6-red);
  }

  @media (prefers-reduced-motion: reduce) {
    .rh6 [data-at] {
      transform: none;
      transition: opacity 120ms linear;
    }
  }
</style>
