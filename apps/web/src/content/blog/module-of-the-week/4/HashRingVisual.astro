---
// Consistent hashing, drawn as a ring. Runners drop points on the ring, shards
// land on it too, and each shard belongs to the nearest runner point.
//
// The post builds the idea up in stages, each one the previous plus one thing:
//
// - line: the hash values laid out flat, before they get bent into a ring.
//   Nearest point wins with no wrap, so the runner with the lowest point gets
//   everything below it
// - points: three runners, one point each, gray shards, and a line from Dad's
//   shard to the nearest runner point
// - territory: the ring split into the stretch each runner owns
// - join: a switch adds Runner 4; the shards it takes turn its color and the
//   rest go muted
// - virtual: a slider for points per runner (1 to 128, doubling) and bars
//   for the three runners
// - full: the slider, plus bar rows that add or remove runners 1 to 6
// - weight: three runners at 128 points each, and a picker for Runner 1's
//   weight. Weight w means round(128 × w) points, keyed `:1` up to `:128w`,
//   so raising it keeps the existing points and adds more
//
// The ring draws every tenth shard (with Dad's in place of 275); the counts
// cover all 300.
//
// Positions are real: each one is Effect's `Hash.string` of the same strings
// Cluster hashes (`runner-1:34431:1`, ..., and `shard-0` for shard 1).
// `Hash.string` copies bit 31 into bit 30, so its results fall in
// [-2^30, 2^30). That range is the whole ring.
//
// This is the textbook version: the nearest point wins, and the ring wraps.
// The post covers Cluster's no-wrap detail separately. With 128 points per
// runner it gives the same answer for Dad's shard as Cluster does (Runner 3,
// then Runner 4).

import * as Hash from "effect/Hash"
import { arcsFor, C, markerFor, ownerOf, pointsFor, polar, R, SIZE } from "./hashRing"

type Stage = "line" | "points" | "territory" | "join" | "virtual" | "full" | "weight"
interface Props {
  stage?: Stage
}
const { stage = "full" } = Astro.props

const colored = stage !== "points"
const isLine = stage === "line"
const hasSlider = stage === "virtual" || stage === "full"
const isWeight = stage === "weight"
const hasBars = hasSlider || isWeight
const toggles = stage === "full"

const STOPS = [1, 2, 4, 8, 16, 32, 64, 128]
const RUNNERS = [1, 2, 3, 4, 5, 6]
const START_RUNNERS = [1, 2, 3]
const SHARDS = 300
const DAD_SHARD = 276
// The weight stage: which runner gets the weight, and the weights to pick from
const WEIGHTED = 1
const WEIGHTS = [0.5, 1, 2, 3]
const BASE_POINTS = 128
const weightLabel = (w: number) => (w === 0.5 ? "½" : String(w))

const hashAngle = (input: string) => ((Hash.string(input) + 2 ** 30) / 2 ** 31) * 360

// Only the weighted runner needs points past the 128th
const pointCount = (k: number) =>
  isWeight && k === WEIGHTED
    ? Math.round(BASE_POINTS * Math.max(...WEIGHTS))
    : STOPS[STOPS.length - 1]!
const angles = RUNNERS.map((k) =>
  Array.from({ length: pointCount(k) }, (_, i) => hashAngle(`runner-${k}:34431:${i + 1}`)),
)
const shardAngles = Array.from({ length: SHARDS }, (_, i) => hashAngle(`shard-${i}`))
// Every tenth shard, with Dad's shard standing in for its neighbor 275.
const drawn = Array.from({ length: 30 }, (_, i) => (i * 10 + 5 === 275 ? DAD_SHARD : i * 10 + 5))

// The starting picture, so the page makes sense before the script runs.
const startPoints = pointsFor(angles, START_RUNNERS, isWeight ? BASE_POINTS : 1)
const startOwners = shardAngles.map((a) => ownerOf(a, startPoints))
const startCounts = RUNNERS.map((k) => startOwners.filter((o) => o === k).length)
const fair = SHARDS / START_RUNNERS.length
const markers = RUNNERS.map((k) => ({ k, ...markerFor(angles[k - 1]![0]!) }))
const barRunners = toggles ? RUNNERS : START_RUNNERS

const dad = polar(shardAngles[DAD_SHARD - 1]!, R - 8)
const dadLabel = polar(shardAngles[DAD_SHARD - 1]!, R - 46)
const f = (n: number) => n.toFixed(2)

// The "points" stage draws the hop from Dad's shard to the nearest runner
// point, along the inside of the ring the short way round.
const dadAngle = shardAngles[DAD_SHARD - 1]!
const dadOwner = startOwners[DAD_SHARD - 1]!
const nearest = (() => {
  const to = angles[dadOwner - 1]![0]!
  let d = (((to - dadAngle) % 360) + 360) % 360
  if (d > 180) d -= 360
  const r = R - 14
  const a = polar(dadAngle, r)
  const b = polar(dadAngle + d, r)
  return `M${f(a.x)} ${f(a.y)} A${r} ${r} 0 0 ${d > 0 ? 1 : 0} ${f(b.x)} ${f(b.y)}`
})()

// The "line" stage: the same hashes, the same three runner points and the
// same 30 shards, laid along a line instead. Nearest point wins, and nothing
// wraps, so each end belongs to whichever runner sits closest to it.
const LW = 400
const LH = 124
const X0 = 22
const X1 = 378
const LY = 58
const lx = (angle: number) => X0 + (angle / 360) * (X1 - X0)
const lineOwner = (angle: number) =>
  startPoints.reduce((best, p) =>
    Math.abs(angle - p.angle) < Math.abs(angle - best.angle) ? p : best,
  ).runner
const lineSegments = (() => {
  const sorted = [...startPoints].sort((a, b) => a.angle - b.angle)
  return sorted.map((p, i) => {
    const prev = sorted[i - 1]
    const next = sorted[i + 1]
    return {
      runner: p.runner,
      from: prev ? lx((prev.angle + p.angle) / 2) : X0,
      to: next ? lx((p.angle + next.angle) / 2) : X1,
    }
  })
})()
const lineMarkers = START_RUNNERS.map((k) => ({ k, x: lx(angles[k - 1]![0]!) }))
const lineDad = { x: lx(dadAngle), owner: lineOwner(dadAngle) }

const labels: Record<Stage, string> = {
  line: "Every hash value laid out on a line, with one point for each of three runners and 30 sample shards colored by the nearest runner. Runner 2 has the lowest point, so it gets everything below it",
  points:
    "A hash ring with one point for each of three runners and 30 sample shards. A dashed line runs from Dad's shard to the nearest runner point",
  territory:
    "A hash ring split into the stretch each of three runners owns, with 30 sample shards colored by owner",
  join: "A hash ring with three runners. A switch adds Runner 4, which takes only the shards nearest its point",
  virtual:
    "A hash ring with three runners and 30 sample shards colored by owner, next to a bar chart of shards per runner",
  full: "A hash ring with runner points and 30 sample shards, each shard colored by the runner that owns it",
  weight:
    "A hash ring with three runners at 128 points each and 30 sample shards colored by owner. Buttons set Runner 1's weight, which gives it more or fewer points, and bars show shards per runner",
}
---

<figure
  class:list={["hr", `hr--${stage}`, { "hr--plain": !colored, "hr--solo": !hasBars }]}
  data-hash-ring
  data-stage={stage}
>
  <div class="hr-body">
    {
      hasSlider && (
        <label class="hr-points">
          <span class="hr-label">Points per runner</span>
          <span class="hr-slider" style={`--stops: ${STOPS.length - 1}`}>
            <input type="range" min="0" max={STOPS.length - 1} step="1" value="0" data-points />
            <span class="hr-ticks" aria-hidden="true">
              {STOPS.map((n, i) => (
                <span style={`--i: ${i}`}>{n}</span>
              ))}
            </span>
          </span>
        </label>
      )
    }
    {
      stage === "join" && (
        <div class="hr-points hr-join">
          <button
            type="button"
            class="hr-switch hr-c4"
            role="switch"
            aria-checked="false"
            data-join
          >
            <span class="hr-track-ui" aria-hidden="true">
              <span class="hr-knob" />
            </span>
            Add Runner 4
          </button>
          <p class="hr-aside" aria-live="polite">
            <span class="hr-stat">
              <strong data-moved>0</strong> shards moved
            </span>
            <span class="hr-key">
              <span class="hr-key-dot" aria-hidden="true" />
              Didn't move
            </span>
          </p>
        </div>
      )
    }
    {
      isWeight && (
        <div class="hr-points hr-join">
          <div class="hr-weight">
            <span class="hr-weight-label">Runner {WEIGHTED} weight</span>
            <div
              class={`hr-weights hr-c${WEIGHTED}`}
              role="radiogroup"
              aria-label={`Runner ${WEIGHTED} weight`}
            >
              {WEIGHTS.map((w) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={w === 1 ? "true" : "false"}
                  data-weight={w}
                >
                  {weightLabel(w)}
                </button>
              ))}
            </div>
          </div>
          <p class="hr-aside" aria-live="polite">
            <span class="hr-stat">
              <strong data-moved>0</strong>{" "}
              <span class="hr-stat-labels">
                <span data-moved-label="add">shards added to Runner {WEIGHTED}</span>
                <span data-moved-label="remove">shards removed from Runner {WEIGHTED}</span>
              </span>
            </span>
            <span class="hr-key">
              <span class="hr-key-dot" aria-hidden="true" />
              Didn't move
            </span>
          </p>
        </div>
      )
    }
    {
      isLine && (
        <svg
          viewBox={`0 0 ${LW} ${LH}`}
          class="hr-svg hr-line"
          role="img"
          aria-label={labels[stage]}
        >
          <line x1={X0} y1={LY} x2={X1} y2={LY} class="hr-track" />
          {lineSegments.map((g) => (
            <line x1={f(g.from)} y1={LY} x2={f(g.to)} y2={LY} class={`hr-arc hr-c${g.runner}`} />
          ))}
          <line x1={X0} y1={LY + 6} x2={X0} y2={LY + 12} class="hr-wrap-tick" />
          <line x1={X1} y1={LY + 6} x2={X1} y2={LY + 12} class="hr-wrap-tick" />
          <text x={X0} y={LY + 22} class="hr-wrap">
            lowest hash
          </text>
          <text x={X1} y={LY + 22} class="hr-wrap" text-anchor="end">
            highest hash
          </text>
          {lineMarkers.map((m) => (
            <g class={`hr-marker hr-c${m.k}`}>
              <line x1={f(m.x)} y1={LY - 10} x2={f(m.x)} y2={LY + 10} class="hr-tick" />
              <circle cx={f(m.x)} cy={LY - 26} r="11" class="hr-badge" />
              <text x={f(m.x)} y={LY - 26} class="hr-badge-text" text-anchor="middle" dy="0.35em">
                {m.k}
              </text>
            </g>
          ))}
          <line x1={f(lineDad.x)} y1={LY + 8} x2={f(lineDad.x)} y2={LY + 26} class="hr-leader" />
          <text x={f(lineDad.x)} y={LY + 40} class="hr-dad" text-anchor="middle">
            <tspan x={f(lineDad.x)} class="hr-dad-name">
              Dad for #engineering
            </tspan>
            <tspan x={f(lineDad.x)} dy="1.2em" class="hr-dad-owner">
              Shard {DAD_SHARD} · Runner {lineDad.owner}
            </tspan>
          </text>
          {drawn.map((id) => {
            const a = shardAngles[id - 1]!
            return (
              <circle
                cx={f(lx(a))}
                cy={LY}
                r={id === DAD_SHARD ? 6 : 4.5}
                class={`hr-dot hr-c${lineOwner(a)}`}
              >
                <title>
                  Shard {id}, Runner {lineOwner(a)}
                </title>
              </circle>
            )
          })}
        </svg>
      )
    }
    {
      !isLine && (
        <svg viewBox={`0 0 ${SIZE} ${SIZE}`} class="hr-svg" role="img" aria-label={labels[stage]}>
          <circle cx={C} cy={C} r={R} class="hr-track" />
          <g data-arcs>
            {colored &&
              arcsFor(startPoints).map((a) => <path d={a.d} class={`hr-arc hr-c${a.runner}`} />)}
          </g>
          <text x={C} y={C - R + 22} class="hr-wrap" text-anchor="middle">
            hash wraps here
          </text>
          <line x1={C} y1={C - R + 6} x2={C} y2={C - R + 12} class="hr-wrap-tick" />

          <g data-ticks>
            {RUNNERS.map((k) => (
              <path class={`hr-vnodes hr-c${k}`} data-ticks-for={k} d="" />
            ))}
          </g>
          {markers.map((m) => (
            <g
              class:list={["hr-marker", `hr-c${m.k}`, { "is-off": !START_RUNNERS.includes(m.k) }]}
              data-marker={m.k}
            >
              <line x1={m.x1} y1={m.y1} x2={m.x2} y2={m.y2} class="hr-tick" />
              <circle cx={m.cx} cy={m.cy} r="11" class="hr-badge" />
              <text x={m.cx} y={m.cy} class="hr-badge-text" text-anchor="middle" dy="0.35em">
                {m.k}
              </text>
            </g>
          ))}

          {stage === "points" && <path d={nearest} class="hr-nearest" />}
          <line
            x1={f(dad.x)}
            y1={f(dad.y)}
            x2={f(dadLabel.x)}
            y2={f(dadLabel.y + 4)}
            class="hr-leader"
          />
          <text x={f(dadLabel.x)} y={f(dadLabel.y - 14)} class="hr-dad" text-anchor="middle">
            <tspan x={f(dadLabel.x)} class="hr-dad-name">
              Dad for #engineering
            </tspan>
            <tspan x={f(dadLabel.x)} dy="1.2em" class="hr-dad-owner">
              Shard {DAD_SHARD} · <tspan data-dad-owner>Runner {startOwners[DAD_SHARD - 1]}</tspan>
            </tspan>
          </text>

          {drawn.map((id) => {
            const p = polar(shardAngles[id - 1]!, R)
            return (
              <g class:list={["hr-shard", { "is-dad": id === DAD_SHARD }]} data-shard={id}>
                <circle cx={f(p.x)} cy={f(p.y)} r="9" class="hr-moved" />
                <circle
                  cx={f(p.x)}
                  cy={f(p.y)}
                  r={id === DAD_SHARD ? 6 : 4.5}
                  class={colored ? `hr-dot hr-c${startOwners[id - 1]}` : "hr-dot"}
                  data-dot
                />
                <title data-shard-title>
                  {colored ? `Shard ${id}, Runner ${startOwners[id - 1]}` : `Shard ${id}`}
                </title>
              </g>
            )
          })}
        </svg>
      )
    }

    {
      hasBars && (
        <div class="hr-side">
          <p class="hr-side-title">
            Shards per runner {toggles && <span>· click to add or remove</span>}
          </p>
          <ul class="hr-legend">
            {barRunners.map((k) => {
              const on = START_RUNNERS.includes(k)
              const count = startCounts[k - 1]!
              const inner = (
                <>
                  <span class="hr-swatch" aria-hidden="true">
                    {k}
                  </span>
                  <span class="hr-name">
                    Runner {k}
                    {isWeight && k === WEIGHTED && <span class="hr-weight-tag" data-weight-tag />}
                  </span>
                  <span class="hr-bar" aria-hidden="true">
                    <span style={`width: ${(count / (2 * fair)) * 100}%`} data-bar />
                  </span>
                  <span class="hr-count" data-count>
                    {on ? count : ""}
                  </span>
                </>
              )
              return (
                <li>
                  {toggles ? (
                    <button
                      type="button"
                      class={`hr-runner hr-c${k}`}
                      aria-pressed={on ? "true" : "false"}
                      data-runner={k}
                    >
                      {inner}
                      <span class="hr-action" aria-hidden="true">
                        {on ? "×" : "+"}
                      </span>
                    </button>
                  ) : (
                    <div class={`hr-runner hr-c${k}`} data-runner={k}>
                      {inner}
                    </div>
                  )}
                </li>
              )
            })}
          </ul>
        </div>
      )
    }
  </div>

  <script
    type="application/json"
    data-hr-data
    set:html={JSON.stringify({
      stops: STOPS,
      angles,
      shardAngles,
      drawn,
      start: START_RUNNERS,
      dad: DAD_SHARD,
      weighted: WEIGHTED,
      basePoints: BASE_POINTS,
    })}
  />
</figure>

<script>
  import { arcsFor, ownerOf, pointsFor, ticksFor } from "./hashRing"

  type Data = {
    stops: Array<number>
    angles: Array<Array<number>>
    shardAngles: Array<number>
    drawn: Array<number>
    start: Array<number>
    dad: number
    weighted: number
    basePoints: number
  }
  const SVG = "http://www.w3.org/2000/svg"

  for (const root of document.querySelectorAll<HTMLElement>("[data-hash-ring]")) {
    // The first two stages are pictures; the build already drew them.
    const stage = root.dataset.stage
    if (stage === "line" || stage === "points" || stage === "territory") continue

    const data = JSON.parse(root.querySelector("[data-hr-data]")!.textContent!) as Data
    const slider = root.querySelector<HTMLInputElement>("[data-points]")
    const join = root.querySelector<HTMLButtonElement>("[data-join]")
    const weightButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-weight]")]
    const weightTag = root.querySelector<HTMLElement>("[data-weight-tag]")
    const movedEl = root.querySelector<HTMLElement>("[data-moved]")
    const movedLabels = [...root.querySelectorAll<HTMLElement>("[data-moved-label]")]
    const arcsEl = root.querySelector<SVGGElement>("[data-arcs]")!
    const tickEls = [...root.querySelectorAll<SVGPathElement>("[data-ticks-for]")]
    const markerEls = [...root.querySelectorAll<SVGGElement>("[data-marker]")]
    const shardEls = [...root.querySelectorAll<SVGGElement>("[data-shard]")]
    const rows = [...root.querySelectorAll<HTMLElement>("[data-runner]")]
    const dadOwner = root.querySelector<SVGTSpanElement>("[data-dad-owner]")!

    // Points per runner. The weight stage gives every runner 128, times the
    // weighted runner's weight.
    let n = slider ? data.stops[Number(slider.value)]! : stage === "weight" ? data.basePoints : 1
    let weight = 1
    const countFor = (k: number) => (k === data.weighted ? Math.round(n * weight) : n)
    const active = new Set(data.start)
    let previous: Array<number> | null = null
    // The weight stage compares against weight 1, so stepping back toward it
    // clears circles instead of drawing new ones
    let baseline: Array<number> | null = null

    // `highlight` marks the shards that changed owner. Only adding a runner
    // asks for it, so the circled shards are the ones the newcomer took.
    // Removing a runner would circle shards in their new owners' colors, and
    // the points slider reshuffles too much to be useful. In the join stage
    // the shards that stayed put also fade back, like the modulo visual. The
    // weight stage circles the shards that differ from weight 1 instead.
    const render = (highlight: boolean) => {
      const runners = [...active].sort((a, b) => a - b)
      const points = runners.flatMap((k) => pointsFor(data.angles, [k], countFor(k)))
      const owners = data.shardAngles.map((a) => ownerOf(a, points))

      arcsEl.replaceChildren(
        ...arcsFor(points).map((a) => {
          const path = document.createElementNS(SVG, "path")
          path.setAttribute("d", a.d)
          path.setAttribute("class", `hr-arc hr-c${a.runner}`)
          return path
        }),
      )
      tickEls.forEach((el, i) => {
        el.setAttribute("d", active.has(i + 1) ? ticksFor(data.angles[i]!, countFor(i + 1)) : "")
      })
      markerEls.forEach((el, i) => {
        el.classList.toggle("is-off", !active.has(i + 1))
      })

      if (stage === "weight" && baseline === null) baseline = owners
      const against = stage === "weight" ? baseline : previous
      const changed = owners.map((o, i) => against !== null && against[i] !== o)
      const still = highlight && (stage === "join" || stage === "weight")
      root.classList.toggle("has-moves", still)
      // The weight stage shows its count whenever the weight isn't 1, even
      // when it has nothing to circle
      root.classList.toggle("has-count", stage === "weight" && weight !== 1)
      if (movedEl) movedEl.textContent = String(changed.filter(Boolean).length)
      // Every shard that moves goes to or from the weighted runner, so the
      // count is how many it gained or gave away compared to weight 1
      for (const label of movedLabels) {
        label.classList.toggle(
          "is-on",
          label.dataset.movedLabel === (weight < 1 ? "remove" : "add"),
        )
      }

      for (const el of shardEls) {
        const id = Number(el.dataset.shard)
        const owner = owners[id - 1]!
        const moved = highlight && changed[id - 1]!
        const wasMoved = el.classList.contains("is-moved")
        el.querySelector("[data-dot]")!.setAttribute("class", `hr-dot hr-c${owner}`)
        el.querySelector("[data-shard-title]")!.textContent =
          `Shard ${id}, Runner ${owner}` +
          (moved ? (stage === "weight" ? " (moved from weight 1)" : " (just moved)") : "")
        el.classList.toggle("is-moved", moved)
        el.classList.toggle("is-still", still && !moved)
        // Shards already circled keep their circle without pulsing again
        if (stage === "weight" && moved && wasMoved) continue
        el.classList.remove("is-pulse")
        if (moved) {
          void el.getBoundingClientRect()
          el.classList.add("is-pulse")
        }
      }
      dadOwner.textContent = `Runner ${owners[data.dad - 1]}`
      if (weightTag)
        weightTag.textContent = weight === 1 ? "" : ` ×${weight === 0.5 ? "½" : weight}`
      for (const b of weightButtons)
        b.setAttribute("aria-checked", String(Number(b.dataset.weight) === weight))

      // Bars are drawn so a fair share sits halfway along.
      const fair = owners.length / runners.length
      for (const row of rows) {
        const k = Number(row.dataset.runner)
        const on = active.has(k)
        const count = owners.filter((o) => o === k).length
        row.querySelector("[data-count]")!.textContent = on ? String(count) : ""
        row.querySelector<HTMLElement>("[data-bar]")!.style.width =
          `${Math.min(1, count / (2 * fair)) * 100}%`
        if (row instanceof HTMLButtonElement) {
          row.setAttribute("aria-pressed", String(on))
          row.disabled = on && active.size === 1
          row.querySelector(".hr-action")!.textContent = on ? "×" : "+"
          row.title = on ? `Remove Runner ${k}` : `Add Runner ${k}`
        }
      }
      previous = owners
    }

    slider?.addEventListener("input", () => {
      n = data.stops[Number(slider.value)]!
      render(false)
    })
    join?.addEventListener("click", () => {
      const adding = !active.has(4)
      if (adding) active.add(4)
      else active.delete(4)
      join.setAttribute("aria-checked", String(adding))
      render(adding)
    })
    for (const b of weightButtons) {
      b.addEventListener("click", () => {
        const next = Number(b.dataset.weight)
        if (next === weight) return
        weight = next
        // Only gains are circled. Below weight 1 the shards Runner 1 gives
        // away would be circled in other runners' colors.
        render(weight > 1)
      })
    }
    for (const row of rows) {
      if (!(row instanceof HTMLButtonElement)) continue
      row.addEventListener("click", () => {
        const k = Number(row.dataset.runner)
        const adding = !active.has(k)
        if (adding) active.add(k)
        else if (active.size > 1) active.delete(k)
        render(adding)
      })
    }
    render(false)
  }
</script>

<style is:global>
  .hr {
    --hr-ink: #3f3f46;
    --hr-muted: #71717a;
    --hr-line: #d4d4d8;
    --hr-surface: #ffffff;
    --hr-r1: #0072b2;
    --hr-r2: #d55e00;
    --hr-r3: #007a5e;
    --hr-r4: #a3527f;
