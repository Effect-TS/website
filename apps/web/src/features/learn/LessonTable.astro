---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"table">
---

<!--
  A lesson's markdown table, in its own horizontal scroll box: a table too
  wide for a phone scrolls inside the lesson instead of widening the page.
-->
<div class="overflow-x-auto">
  <table {...Astro.props}><slot /></table>
</div>
