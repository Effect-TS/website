---
import { Code } from "astro-expressive-code/components"

import type { ApiCodeExample } from "./ApiReference"

interface Props {
  example: ApiCodeExample
}

const { example } = Astro.props
---

<figure>
  <figcaption class="mb-2 flex flex-wrap items-baseline gap-1.5">
    <span class="text-base font-semibold text-foreground">Example</span>
    {example.title && <span class="text-sm text-muted-foreground">({example.title})</span>}
  </figcaption>

  <Code code={example.source} lang={example.language} meta="showLineNumbers=false" />
</figure>
