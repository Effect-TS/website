new file mode 100644
index 0000000..1007c74
--- /dev/null
+++ b/crates/tsrs_core/src/threadstack.rs
@@ -0,0 +1,26 @@
+/// The stack size to give a thread that runs compiler code: `native` everywhere but wasm. On wasm (wasi-threads) a
+/// thread's stack is carved out of the shared 4 GiB linear memory, so 512 MB stacks run out after a handful of threads;
+/// there it is `TSRS_WASM_THREAD_STACK_MB` MiB, default 16. (The engine's own native stack, which holds the wasm call
+/// frames, is set by the host, not here.)
+pub fn thread_stack_size(native: usize) -> usize {
+    #[cfg(target_family = "wasm")]
+    {
+        let _ = native;
+        std::env::var("TSRS_WASM_THREAD_STACK_MB")
+            .ok()
+            .and_then(|v| v.parse::<usize>().ok())
+            .map_or(16 << 20, |mb| mb << 20)
+    }
+    #[cfg(not(target_family = "wasm"))]
+    native
+}
+
+/// `std::thread::available_parallelism()` as a count, at least 1. On wasm std cannot know the core count (wasi has no
+/// call for it), so the host passes it as `TSRS_WASM_PARALLELISM` (a browser: `navigator.hardwareConcurrency`).
+pub fn available_parallelism() -> usize {
+    #[cfg(target_family = "wasm")]
+    if let Some(n) = std::env::var("TSRS_WASM_PARALLELISM").ok().and_then(|v| v.parse::<usize>().ok()) {
+        return n.max(1);
+    }
+    std::thread::available_parallelism().map_or(1, std::num::NonZero::get)
+}
