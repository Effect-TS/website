---
// Permanent site-wide banner sharing the navbar's sticky wrapper. Not
// dismissible. The home hero dispatches `hero-grid-pulse-complete`; the banner then glints
// along its bottom border. Hovering the link plays a sweep, reversed on leave.
---

<effect-announcement
  data-announcement
  role="region"
  aria-label="Announcement"
  class="group relative flex min-h-10 items-center justify-center border-b border-zinc-700/60 bg-zinc-900 px-10 py-2 text-zinc-100 transition-colors has-[a:hover]:bg-zinc-800"
>
  <span
    aria-hidden="true"
    class="announcement-sweep pointer-events-none absolute inset-x-0 bottom-0 h-px bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.9)_50%,transparent_100%)] opacity-0"
  ></span>
  <span
    aria-hidden="true"
    class="announcement-glint pointer-events-none absolute inset-x-0 bottom-[-1px] hidden h-px bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.9),transparent)] group-data-[glint]:block motion-reduce:hidden"
  ></span>

  <a
    href="/effect-days"
    aria-label="Effect Days 2026: December 9–11 in Livorno, Italy"
    class="absolute inset-0"></a>

  <div
    class="pointer-events-none flex min-w-0 items-center justify-center gap-2 whitespace-nowrap font-mono text-[12.5px] font-normal tracking-wider text-zinc-300 uppercase transition-colors group-has-[a:hover]:text-white"
  >
    <span class="text-zinc-400">//</span>
    <span>EFFECT DAYS 2026<span class="hidden sm:inline"> · LIVORNO, DEC 9–11</span></span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="currentColor"
      class="ri-arrow-right-line shrink-0 text-zinc-400"
      aria-hidden="true"
    >
      <path
        d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"
      ></path>
    </svg>
  </div>
</effect-announcement>

<style is:global>
  /* Sweep (~1.9s), fade, then stay quiet for the rest of the 12s cycle.
     Animates transform + opacity only, so it stays off the layout path. */
  @keyframes announcement-glint {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    18% {
      transform: scaleX(1);
      opacity: 1;
    }
    28% {
      transform: scaleX(1);
      opacity: 0;
    }
    28.1%,
    100% {
      transform: scaleX(0);
      opacity: 0;
    }
  }
  [data-announcement][data-glint] .announcement-glint {
    animation: announcement-glint 12s ease-out 0.1s infinite both;
  }
</style>

<script>
  const SWEEP_KEYFRAMES: Keyframe[] = [
    { transform: "scaleX(0)", opacity: 0, offset: 0 },
    { opacity: 1, offset: 0.45 },
    { transform: "scaleX(1)", opacity: 0, offset: 1 },
  ]

  class AnnouncementElement extends HTMLElement {
    #resize = new ResizeObserver(() => {
      const height = this.getBoundingClientRect().height
      document.documentElement.style.setProperty("--announcement-height", `${height}px`)
    })

    #glint = () => this.setAttribute("data-glint", "")

    #sweep: Animation | undefined

    #play = (rate: 1 | -1) => () => {
      const sweep = this.#sweep
      if (!sweep) return
      if (rate === 1 && sweep.playState === "finished") sweep.currentTime = 0
      sweep.playbackRate = rate
      sweep.play()
    }

    #enter = this.#play(1)
    #leave = this.#play(-1)

    connectedCallback() {
      this.#resize.observe(this)
      document.addEventListener("hero-grid-pulse-complete", this.#glint)

      const el = this.querySelector<HTMLElement>(".announcement-sweep")
      const link = this.querySelector("a")
      if (el && link && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        this.#sweep = el.animate(SWEEP_KEYFRAMES, {
          duration: 1600,
          easing: "ease-in-out",
          fill: "both",
        })
        this.#sweep.pause()
        link.addEventListener("pointerenter", this.#enter)
        link.addEventListener("pointerleave", this.#leave)
      }
    }

    disconnectedCallback() {
      this.#resize.disconnect()
      document.removeEventListener("hero-grid-pulse-complete", this.#glint)
      this.#sweep?.cancel()
    }
  }

  if (!customElements.get("effect-announcement")) {
    customElements.define("effect-announcement", AnnouncementElement)
  }
</script>
