---
import type { GetStaticPaths } from "astro"
import { getCollection, type CollectionEntry } from "astro:content"
import { ChevronDown, Search } from "@lucide/astro"

import Eyebrow from "@/components/ui/Eyebrow.astro"
import ApiMobileNavigation from "@/features/api-reference/ApiMobileNavigation.astro"
import { resolveApiReferenceOpenGraph } from "@/features/api-reference/open-graph"
import DocShell from "@/layouts/DocShell.astro"

export const getStaticPaths = (async () => {
  const entries = await getCollection("apiReference")

  const entriesByVersion = entries.reduce((groups, entry) => {
    const group = groups.get(entry.data.version)
    if (group === undefined) {
      groups.set(entry.data.version, [entry])
    } else {
      group.push(entry)
    }
    return groups
  }, new Map<string, Array<CollectionEntry<"apiReference">>>())

  return Array.from(entriesByVersion).map(([version, entries]) => ({
    params: { version },
    props: { entries, version },
  }))
}) satisfies GetStaticPaths

const { entries, version } = Astro.props
const openGraph = resolveApiReferenceOpenGraph(
  `docs/${version}/api`,
  entries.map((entry) => entry.data),
)

const groupNames: Record<string, Record<string, string>> = {
  v3: {
    effect: "Core",
    "@effect/platform": "Platform",
    "@effect/platform-browser": "Platform",
    "@effect/platform-bun": "Platform",
    "@effect/platform-node": "Platform",
    "@effect/platform-node-shared": "Platform",
    "@effect/cluster": "Clustering",
    "@effect/workflow": "Workflows",
    "@effect/sql": "SQL",
    "@effect/sql-clickhouse": "SQL",
    "@effect/sql-d1": "SQL",
    "@effect/sql-drizzle": "SQL",
    "@effect/sql-kysely": "SQL",
    "@effect/sql-libsql": "SQL",
    "@effect/sql-mssql": "SQL",
    "@effect/sql-mysql2": "SQL",
    "@effect/sql-pg": "SQL",
    "@effect/sql-sqlite-bun": "SQL",
    "@effect/sql-sqlite-do": "SQL",
    "@effect/sql-sqlite-node": "SQL",
    "@effect/sql-sqlite-react-native": "SQL",
    "@effect/sql-sqlite-wasm": "SQL",
    "@effect/ai": "AI",
    "@effect/ai-amazon-bedrock": "AI",
    "@effect/ai-anthropic": "AI",
    "@effect/ai-google": "AI",
    "@effect/ai-openai": "AI",
    "@effect/ai-openrouter": "AI",
    "@effect/opentelemetry": "Telemetry",
    "@effect/cli": "CLI",
    "@effect/printer": "Printing",
    "@effect/printer-ansi": "Printing",
    "@effect/vitest": "Testing",
    "@effect/experimental": "Other",
    "@effect/typeclass": "Other",
  },
  v4: {
    effect: "Core",
    "@effect/platform-browser": "Platform",
    "@effect/platform-bun": "Platform",
    "@effect/platform-node-shared": "Platform",
    "@effect/platform-node": "Platform",
    "@effect/opentelemetry": "Telemetry",
    "@effect/sql-clickhouse": "SQL",
    "@effect/sql-d1": "SQL",
    "@effect/sql-libsql": "SQL",
    "@effect/sql-mssql": "SQL",
    "@effect/sql-mysql2": "SQL",
    "@effect/sql-pg": "SQL",
    "@effect/sql-pglite": "SQL",
    "@effect/sql-sqlite-bun": "SQL",
    "@effect/sql-sqlite-do": "SQL",
    "@effect/sql-sqlite-node": "SQL",
    "@effect/sql-sqlite-react-native": "SQL",
    "@effect/sql-sqlite-wasm": "SQL",
    "@effect/ai-anthropic": "AI",
    "@effect/ai-openai-compat": "AI",
    "@effect/ai-openai": "AI",
    "@effect/ai-openrouter": "AI",
    "@effect/atom-react": "Reactivity",
    "@effect/atom-solid": "Reactivity",
    "@effect/atom-vue": "Reactivity",
    "@effect/docgen": "Tooling",
    "@effect/openapi-generator": "Tooling",
    "@effect/vitest": "Testing",
  },
}

const groupOrdering = [
  "Core",
  "Platform",
  "SQL",
  "AI",
  "Clustering",
  "Workflows",
  "Reactivity",
  "Telemetry",
  "CLI",
  "Printing",
  "Testing",
  "Tooling",
  "Other",
]

function inferGroup(packageName: string): string {
  if (packageName.includes("/sql-") || packageName === "@effect/sql") {
    return "SQL"
  }
  if (packageName.includes("/ai-") || packageName === "@effect/ai") {
    return "AI"
  }
  if (packageName.includes("platform")) {
    return "Platform"
  }
  return "Other"
}

const packageEntries = Map.groupBy(entries, (entry) => entry.data.packageName)
const packages = Array.from(packageEntries).map(([name, modules]) => {
  const first = modules[0]

  if (first === undefined) {
    throw new Error(`Package "${name}" has no modules`)
  }

  const displayName = name.replace("@effect/", "")
  const entries = modules.toSorted((left, right) =>
    left.data.modulePath.localeCompare(right.data.modulePath),
  )
  const group = groupNames[version]?.[name] ?? inferGroup(name)

  return {
    ...first.data,
    displayName,
    entries,
    group,
  }
})
const groupedPackages = Map.groupBy(packages, (info) => info.group)
const sidebarGroups = Array.from(groupedPackages)
  .map(([name, packages]) => ({ name, packages }))
  .toSorted((left, right) => {
    const leftIndex = groupOrdering.indexOf(left.name)
    const rightIndex = groupOrdering.indexOf(right.name)
    const leftOrder = leftIndex < 0 ? groupOrdering.length : leftIndex
    const rightOrder = rightIndex < 0 ? groupOrdering.length : rightIndex
    const nameOrder = left.name.localeCompare(right.name)
    return leftOrder - rightOrder || nameOrder
  })
const mobileVersions = ["v3", "v4"].map((candidate) => ({
  href: `/docs/${candidate}/api`,
  label: candidate,
  selected: candidate === version,
}))
const mobilePackages = [
  { disabled: true, href: "", label: "Packages", selected: true },
  ...packages
    .toSorted((left, right) => left.displayName.localeCompare(right.displayName))
    .map((info) => ({
      href: `/docs/${version}/api/${info.packageSlug}`,
      label: info.displayName,
    })),
]
---

<DocShell
  title={`Effect ${version} API Reference`}
  description={openGraph?.description}
  ogImageVersion={openGraph?.revision}
  activeSlug="api"
>
  <ApiMobileNavigation
    slot="mobile-nav"
    version={version}
    versions={mobileVersions}
    packages={mobilePackages}
  />

  <nav
    slot="sidebar"
    aria-label="API reference navigation"
    data-api-sidebar
    class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-8"
  >
    <a
      href={`/docs/${version}/api`}
      aria-current="page"
      class="mb-6 block font-mono text-sm font-medium tracking-wider text-foreground uppercase hover:underline"
    >
      API Reference
    </a>

    <div
      role="group"
      aria-label="API reference version"
      class="mb-4 grid grid-cols-2 gap-1 rounded-md border border-border p-1"
    >
      {
        ["v3", "v4"].map((candidate) => (
          <a
            href={`/docs/${candidate}/api`}
            aria-current={candidate === version ? "page" : undefined}
            class:list={[
              "rounded px-2 py-1 text-center font-mono text-xs transition-colors",
              candidate === version
                ? "bg-accent font-semibold text-foreground"
                : "text-muted-foreground hover:bg-muted hover:text-foreground",
            ]}
          >
            {candidate}
          </a>
        ))
      }
    </div>

    <ul class="flex flex-col gap-0.5">
      {
        sidebarGroups.map((group) => (
          <li class="mb-1 last:mb-0">
            <details open class="group">
              <summary class="flex cursor-pointer select-none list-none items-center justify-between rounded py-2.5 font-mono text-sm font-medium tracking-wider text-muted-foreground uppercase transition-colors hover:text-foreground">
                <span>{group.name}</span>
                <ChevronDown
                  class="h-4 w-4 transition-transform group-open:rotate-180"
                  aria-hidden="true"
                />
              </summary>
              <ul class="flex flex-col gap-0.5">
                {group.packages.map((info) => (
                  <li>
                    <a
                      href={`/docs/${version}/api/${info.displayName}`}
                      data-package-link={info.packageSlug}
                      class="block truncate rounded-md py-1.5 pl-3 font-mono text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                    >
                      {info.displayName}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ul>
  </nav>

  <article class="prose prose-effect max-w-4xl">
    <h1 class="mb-4! md:mb-6!">API Reference</h1>

    <!-- Search -->
    <label for="search" class="relative block not-prose mt-4 mb-6 md:mt-8 md:mb-10">
      <span class="sr-only">Search packages</span>
      <Search
        class="pointer-events-none absolute top-1/2 left-4 h-4 w-4 -translate-y-1/2 text-muted-foreground"
        aria-hidden="true"
      />
      <input
        id="search"
        type="search"
        aria-label="Search packages"
        placeholder="Search packages…"
        autocomplete="off"
        data-package-search
        class="w-full rounded-lg border border-input bg-transparent py-2 pr-4 pl-11 font-mono text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-border-strong"
      />
    </label>

    <div class="space-y-4 md:space-y-8">
      {
        sidebarGroups.map((group) => (
          <section data-package-group class="not-prose">
            <Eyebrow as="h2" class="mb-4">
              {group.name}
            </Eyebrow>
            <div class="grid gap-4 md:grid-cols-2">
              {group.packages.map((info) => (
                <div
                  data-package-card
                  data-package-name={info.packageName}
                  class="group relative rounded-lg border border-border bg-card/40 p-4 transition-colors hover:border-border-strong hover:bg-muted/70 focus-within:border-border-strong focus-within:ring-2 focus-within:ring-subtle-foreground/30 dark:bg-card/30 dark:hover:bg-card/70"
                >
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="truncate font-mono text-sm font-semibold transition-colors group-hover:text-foreground">
                      <a
                        href={`/docs/${version}/api/${info.packageSlug}`}
                        class="focus:outline-none after:absolute after:inset-0 after:content-['']"
                      >
                        {info.packageName}
                      </a>
                    </h3>
                    <span class="shink-0 font-mono text-xs text-muted-foreground">
                      {info.packageModuleCount} modules
                    </span>
                  </div>
                  <p class="mt-2 line-clamp-2 leading-relaxed text-sm text-muted-foreground">
                    {info.packageDescription}
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <p data-empty-state class="hidden py-16 text-center font-mono text-sm text-muted-foreground">
      No matching packages.
    </p>
  </article>
</DocShell>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-package-search]")
  const groups = document.querySelectorAll<HTMLElement>("[data-package-group]")
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]")

  function normalize(value: string) {
    return value
      .toLowerCase()
      .replace(/^@effect\//, "")
      .replace(/[^a-z0-9]/g, "")
  }

  function fuzzyMatch(value: string, query: string) {
    const candidate = normalize(value)
    const normalizedQuery = normalize(query)
    if (candidate.includes(normalizedQuery)) return true

    let queryIndex = 0
    for (const character of candidate) {
      if (character === normalizedQuery[queryIndex]) queryIndex += 1
    }
    return queryIndex === normalizedQuery.length
  }

  if (input !== null && emptyState !== null) {
    input.addEventListener("input", () => {
      const query = input.value.trim()
      let visiblePackages = 0

      for (const group of groups) {
        let visibleInGroup = 0
        for (const card of group.querySelectorAll<HTMLElement>("[data-package-card]")) {
          const matches = fuzzyMatch(card.dataset.packageName ?? "", query)
          card.hidden = !matches
          if (matches) {
            visibleInGroup += 1
          }
        }
        group.hidden = visibleInGroup === 0
        visiblePackages += visibleInGroup
      }

      emptyState.classList.toggle("hidden", visiblePackages > 0)
    })
  }
</script>
