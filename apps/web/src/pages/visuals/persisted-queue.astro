---
import PersistedQueueDemo from "@/components/blog/module-of-the-week/persisted-queue/PersistedQueueDemo"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { PAGE_TITLE_ID } from "@/lib/constants/skip-link"

// A standalone frame of the Module of the Week visual, shared outside the blog
// post. No navigation, kept out of search results; it follows the visitor's
// stored theme like the post it belongs to.
---

<BaseLayout
  title="PersistedQueue · Module of the week"
  description="Work across processes: one shared queue connects independent producers and consumers."
  noindex
>
  <main id={PAGE_TITLE_ID} tabindex="-1">
    <header>
      <p class="eyebrow">EFFECT OFFICE HOURS <span>/</span> MODULE OF THE WEEK</p>
      <h1>Work across processes.</h1>
      <p class="intro">
        One shared queue connects independent producers and consumers.<br />Follow three image jobs
        from upload to thumbnail.
      </p>
    </header>
    <PersistedQueueDemo client:load />
    <footer>
      <span>01 / PersistedQueue</span><span>Follow the jobs. Switch topology to compare.</span>
    </footer>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 64px 24px 40px;
  }
  header {
    margin-bottom: 36px;
  }
  .eyebrow {
    font:
      10px ui-monospace,
      monospace;
    letter-spacing: 1.5px;
    color: var(--muted-foreground);
    margin: 0 0 26px;
  }
  .eyebrow span {
    margin: 0 12px;
  }
  h1 {
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 450;
    letter-spacing: -1.5px;
    margin: 0 0 16px;
  }
  .intro {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 1.65;
    margin: 0;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    color: var(--muted-foreground);
    font:
      11px ui-monospace,
      monospace;
  }
  @media (max-width: 600px) {
    main {
      padding: 36px 16px;
    }
    footer {
      flex-direction: column;
    }
  }
</style>
