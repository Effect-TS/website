---
import { ArrowRight, Search, X } from "@lucide/astro"
import latest from "virtual:latest-release"
import AnnouncementBanner from "@/components/AnnouncementBanner.astro"
import NavigationDesktopActions from "@/components/navigation/NavigationDesktopActions.astro"
import NavigationLogo from "@/components/navigation/NavigationLogo.astro"
import { SearchDialog } from "@/components/navigation/SearchDialog"
import { formatReleaseDate } from "@/features/changelog/format"
import { cn } from "@/lib/utils"
import { DOCS_VERSIONS, defaultDocsVersion } from "@/lib/versions"
import type { DocsNavSection } from "@/lib/docs-sections"

interface Props {
  readonly section: DocsNavSection
  readonly version?: string | undefined
}

const { section, version = defaultDocsVersion } = Astro.props

const DOCS_HOME = { href: `/docs/${version}`, label: "Docs" }

const SECTION_LINKS: ReadonlyArray<{ key: DocsNavSection; label: string; href: string }> = [
  { key: "onboarding", label: "Onboarding", href: `/docs/${version}` },
  { key: "guides", label: "Guides", href: `/docs/${version}/guides` },
  { key: "api", label: "Reference", href: `/docs/${version}/api` },
]

const navItemClass = (active: boolean) =>
  cn(
    "text-sm font-medium text-zinc-500 no-underline transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white",
    active && "text-zinc-900 dark:text-white",
  )
---

<div class="sticky top-0 z-100 w-full">
  <AnnouncementBanner />

  <div
    class="w-full border-b border-zinc-200 bg-zinc-50/85 backdrop-blur-sm dark:border-zinc-800 dark:bg-zinc-950/85"
  >
    <header class="relative mx-auto w-full max-w-352 px-4">
      <nav class="flex h-16 items-center">
        <NavigationLogo />

        <div class="ml-8 hidden items-center gap-4 sm:flex">
          <a
            href={DOCS_HOME.href}
            class="text-sm font-medium text-zinc-900 no-underline dark:text-white"
          >
            {DOCS_HOME.label}
          </a>
          <div class="hidden h-4.5 w-px bg-zinc-300 md:block dark:bg-zinc-700" aria-hidden="true">
          </div>
        </div>

        <div class="ml-4 hidden items-center gap-6 md:flex">
          {
            SECTION_LINKS.map((link) => (
              <a
                href={link.href}
                class={navItemClass(link.key === section)}
                aria-current={link.key === section ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <docs-version-switch
          class="ml-6 hidden shrink-0 gap-1 rounded-md border border-zinc-300 bg-zinc-100 p-0.5 md:inline-flex dark:border-zinc-700 dark:bg-zinc-900"
        >
          {
            DOCS_VERSIONS.map(({ value, label }) => (
              <div
                class="group relative flex"
                data-role={value === defaultDocsVersion ? "release" : undefined}
              >
                <a
                  href={section === "api" ? `/docs/${value}/api` : `/docs/${value}`}
                  aria-label={`Effect ${label} documentation`}
                  aria-current={version === value ? "page" : undefined}
                  aria-describedby={
                    value === defaultDocsVersion && latest !== null ? "latest-release" : undefined
                  }
                  class:list={[
                    "rounded-sm px-3 py-1 text-center font-mono text-xs transition-colors",
                    version === value
                      ? "bg-zinc-200 font-semibold text-zinc-900 dark:bg-zinc-700 dark:text-white"
                      : "text-zinc-600 hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white",
                  ]}
                >
                  {label}
                </a>

                {/* Baked in at build time. Without changelog data there is no page to link to. */}
                {value === defaultDocsVersion && latest !== null && (
                  <>
                    {/* Opens on hover and keyboard focus; invisible keeps it out of the tab order. Escape sets data-dismissed. */}
                    <div class="invisible absolute top-full left-0 z-110 w-full pt-2.5 opacity-0 transition-opacity motion-reduce:transition-none group-data-dismissed:invisible! group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                      <div class="-ml-0.75 w-52 rounded-lg border border-border bg-popover p-4 text-popover-foreground shadow-lg shadow-zinc-950/10 dark:shadow-black/40">
                        <div id="latest-release" class="mb-3">
                          <p class="font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase">
                            Latest release
                          </p>
                          <p class="mt-2 flex items-baseline gap-2 font-mono">
                            <span class="text-lg font-semibold text-foreground">
                              {latest.version}
                            </span>
                            {latest.date !== undefined && (
                              <time datetime={latest.date} class="text-xs text-muted-foreground">
                                {formatReleaseDate(latest.date)}
                              </time>
                            )}
                          </p>
                        </div>
                        <a
                          href={`/docs/${value}/changelog`}
                          class="inline-flex items-center gap-1 text-sm font-medium text-foreground no-underline transition-colors hover:text-muted-foreground"
                        >
                          View changelog
                          <ArrowRight class="size-3.5" aria-hidden="true" />
                        </a>
                      </div>
                      <span
                        aria-hidden="true"
                        class="absolute top-1 left-1/2 size-3 -translate-x-1/2 rotate-45 border-t border-l border-border bg-popover"
                      />
                    </div>
                  </>
                )}
              </div>
            ))
          }
        </docs-version-switch>

        <docs-mobile-menu class="ml-auto flex items-center md:hidden">
          <button
            type="button"
            data-role="toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="docs-mobile-panel"
            class="-mr-2 flex h-10 w-10 items-center justify-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-white"
          >
            <svg
              data-role="icon-open"
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M3 4H21V6H3V4ZM3 11H15V13H3V11ZM3 18H21V20H3V18Z"></path>
            </svg>
            <X data-role="icon-close" class="hidden h-6 w-6" aria-hidden="true" />
          </button>

          <div
            id="docs-mobile-panel"
            data-role="panel"
            class="fixed inset-x-0 top-full z-90 hidden border-t border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950"
          >
            <ul class="mx-auto w-full max-w-352 px-4 py-3">
              <li class="pb-3">
                <button
                  type="button"
                  data-role="search"
                  aria-label="Open search"
                  class="flex w-full appearance-none items-center gap-3 rounded-md border border-zinc-300 bg-transparent px-3 py-2.5 text-zinc-500 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-600 dark:text-zinc-400 dark:hover:border-zinc-500 dark:hover:text-white"
                >
                  <Search class="h-4.5 w-4.5" aria-hidden="true" />
                  <span class="text-sm">Search</span>
                  <kbd
                    data-role="search-kbd"
                    aria-hidden="true"
                    class="ml-auto inline-flex items-center gap-0.5 text-xs text-muted-foreground"
                  ></kbd>
                </button>
              </li>
              <li class="border-b border-zinc-200 dark:border-zinc-800">
                <a
                  href={DOCS_HOME.href}
                  data-role="link"
                  class="block py-3 text-base font-semibold text-zinc-900 dark:text-white"
                >
                  {DOCS_HOME.label}
                </a>
              </li>
              {
                SECTION_LINKS.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      data-role="link"
                      aria-current={link.key === section ? "page" : undefined}
                      class={cn("block py-3", navItemClass(link.key === section))}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </docs-mobile-menu>

        <div class="ml-auto hidden items-center gap-4.5 md:flex">
          <NavigationDesktopActions showThemeToggle />
        </div>
      </nav>
    </header>
  </div>
</div>

<SearchDialog client:load version={version} />

<script>
  import { NAVIGATION_EVENTS } from "@/lib/navigation"

  const isApplePlatform = (): boolean => {
    const userAgentData = Reflect.get(navigator, "userAgentData") as
      | {
          platform?: string
        }
      | undefined

    const platform = (userAgentData?.platform ?? navigator.platform).toLowerCase()
    const userAgent = navigator.userAgent.toLowerCase()

    return (
      platform.includes("mac") ||
      platform.includes("iphone") ||
      platform.includes("ipad") ||
      platform.includes("ipod") ||
      userAgent.includes("mac os") ||
      userAgent.includes("iphone") ||
      userAgent.includes("ipad")
    )
  }

  class DocsMobileMenuElement extends HTMLElement {
    #toggle: HTMLButtonElement | null = null
    #iconOpen: SVGElement | null = null
    #iconClose: SVGElement | null = null
    #panel: HTMLElement | null = null
    #search: HTMLButtonElement | null = null
    #open = false

    connectedCallback() {
      this.#toggle = this.querySelector("[data-role='toggle']")
      this.#iconOpen = this.querySelector("[data-role='icon-open']")
      this.#iconClose = this.querySelector("[data-role='icon-close']")
      this.#panel = this.querySelector("[data-role='panel']")
      this.#search = this.querySelector("[data-role='search']")

      if (!(this.#toggle instanceof HTMLButtonElement)) return
      if (!(this.#panel instanceof HTMLElement)) return

      const searchKbd = this.querySelector("[data-role='search-kbd']")
      if (this.#search instanceof HTMLButtonElement && searchKbd) {
        searchKbd.textContent = isApplePlatform() ? "⌘K" : "Ctrl+K"
        this.#search.setAttribute("aria-keyshortcuts", isApplePlatform() ? "Meta+K" : "Control+K")
        this.#search.addEventListener("click", this.#onSearchClick)
      }

      this.#toggle.addEventListener("click", this.#onToggle)
      this.#panel.querySelectorAll("[data-role='link']").forEach((link) => {
        link.addEventListener("click", this.#onLinkClick)
      })
      document.addEventListener("mousedown", this.#onOutsidePointer)
      document.addEventListener("keydown", this.#onKeyDown)
    }

    disconnectedCallback() {
      this.#toggle?.removeEventListener("click", this.#onToggle)
      this.#search?.removeEventListener("click", this.#onSearchClick)
      this.#panel?.querySelectorAll("[data-role='link']").forEach((link) => {
        link.removeEventListener("click", this.#onLinkClick)
      })
      document.removeEventListener("mousedown", this.#onOutsidePointer)
      document.removeEventListener("keydown", this.#onKeyDown)
    }

    #setOpen = (open: boolean) => {
      if (!this.#toggle || !this.#panel) return
      this.#open = open
      this.#toggle.setAttribute("aria-expanded", String(open))
      this.#toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu")
      this.#iconOpen?.classList.toggle("hidden", open)
      this.#iconClose?.classList.toggle("hidden", !open)
      this.#panel.classList.toggle("hidden", !open)
    }

    #onToggle = () => this.#setOpen(!this.#open)
    #onLinkClick = () => this.#setOpen(false)

    #onSearchClick = () => {
      this.#setOpen(false)
      window.dispatchEvent(
        new CustomEvent(NAVIGATION_EVENTS.SEARCH_OPEN, { detail: { source: "mobile" } }),
      )
    }

    #onOutsidePointer = (event: MouseEvent) => {
      if (this.#open && event.target instanceof Node && !this.contains(event.target)) {
        this.#setOpen(false)
      }
    }

    #onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && this.#open) this.#setOpen(false)
    }
  }

  if (!customElements.get("docs-mobile-menu")) {
    customElements.define("docs-mobile-menu", DocsMobileMenuElement)
  }

  class DocsVersionSwitchElement extends HTMLElement {
    get #release() {
      return this.querySelector<HTMLElement>("[data-role='release']")
    }

    // Escape closes the popover until both pointer and focus leave and return.
    #dismiss = (event: KeyboardEvent) => {
      const release = this.#release
      if (event.key !== "Escape" || !release?.matches(":hover, :focus-within")) return
      const trigger = release.querySelector<HTMLElement>(":scope > a")
      if (document.activeElement !== trigger && release.contains(document.activeElement)) {
        trigger?.focus()
      }
      release.dataset.dismissed = ""
    }

    connectedCallback() {
      document.addEventListener("keydown", this.#dismiss)
      const release = this.#release
      release?.addEventListener("pointerleave", () => {
        if (!release.matches(":focus-within")) delete release.dataset.dismissed
      })
      release?.addEventListener("focusout", (event) => {
        const next = event.relatedTarget
        if (next instanceof Node && release.contains(next)) return
        if (!release.matches(":hover")) delete release.dataset.dismissed
      })
    }

    disconnectedCallback() {
      document.removeEventListener("keydown", this.#dismiss)
    }
  }

  if (!customElements.get("docs-version-switch")) {
    customElements.define("docs-version-switch", DocsVersionSwitchElement)
  }
</script>
