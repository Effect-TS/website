---
import SocialLink from "@/components/SocialLink.astro"
import SearchTriggerIsland from "@/components/navigation/SearchTriggerIsland"
import ThemeToggle from "@/components/ui/ThemeToggle"

interface Props {
  readonly showThemeToggle?: boolean
}

const { showThemeToggle = false } = Astro.props
---

<SearchTriggerIsland client:only="react" mode="desktop" />

<div class="h-4.5 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true"></div>

<div class="flex items-center gap-4">
  <SocialLink variant="github" />
  <SocialLink variant="discord" />
</div>

{
  showThemeToggle && (
    <>
      <div class="h-4.5 w-px bg-zinc-200 dark:bg-zinc-700" aria-hidden="true" />
      <ThemeToggle client:load className="text-muted-foreground hover:text-foreground" />
    </>
  )
}
