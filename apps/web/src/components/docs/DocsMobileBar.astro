---
import DocsVersionMenu from "@/components/navigation/DocsVersionMenu.astro"
import type { DocsVersionLink } from "@/lib/versions"

/**
 * The bar pinned under the navbar on docs pages while the sidebar is hidden.
 * The page's own navigation fills the bar; the version menu sits at its right
 * end, and moves up into the navbar from `lg`, where this bar is gone.
 */
interface Props {
  readonly versionLinks: ReadonlyArray<DocsVersionLink>
}

const { versionLinks } = Astro.props
---

<nav
  aria-label="Docs"
  class="sticky top-[var(--sticky-header-height)] z-40 flex items-center gap-2 border-b border-border bg-background/95 pr-4 backdrop-blur-sm lg:hidden"
>
  <div class="min-w-0 flex-1">
    <slot />
  </div>
  <DocsVersionMenu id="docs-version-menu-mobile" links={versionLinks} />
</nav>
