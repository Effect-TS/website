---
import { ArrowRight } from "@lucide/astro"

import GridBackground from "@/components/GridBackground.astro"
import HeroCommandPanel from "../blocks/HeroCommandPanel.astro"
import HeroGridPulse from "../blocks/HeroGridPulse.astro"
import ThemedLogo, { type ThemedLogoDefinition } from "../blocks/ThemedLogo.astro"
import CloudflareLogoDark from "@/assets/logos/cloudflare/cloudflare-dark-mode.svg"
import CloudflareLogoLight from "@/assets/logos/cloudflare/cloudflare-light-mode.svg"
import OpencodeLogoDark from "@/assets/company-logos/opencode-wordmark-dark.svg"
import OpencodeLogoLight from "@/assets/company-logos/opencode-wordmark-light.svg"
import MasterclassLogo from "@/assets/company-logos/masterclass-noM.svg"
import MasterclassLogoLight from "@/assets/logos/masterclass/Masterclass-light.svg"
import T3LogoDark from "@/assets/company-logos/t3-dark.svg"
import T3LogoLight from "@/assets/company-logos/t3-light.svg"
import XLogo from "@/assets/company-logos/x-logo.svg"

type SocialProofLogo = ThemedLogoDefinition & { readonly name: string }

const SOCIAL_PROOF_LOGOS: ReadonlyArray<SocialProofLogo> = [
  {
    name: "Cloudflare",
    dark: CloudflareLogoDark,
    light: CloudflareLogoLight,
    // The lockup is stacked (cloud above the wordmark), so it is taller than the others.
    className: "h-10 w-auto",
  },
  { name: "X", mono: XLogo, className: "h-5 w-auto translate-y-0.5" },
  {
    name: "opencode",
    dark: OpencodeLogoDark,
    light: OpencodeLogoLight,
    className: "h-5 w-auto translate-y-0.5",
  },
  { name: "T3", dark: T3LogoLight, light: T3LogoDark, className: "h-4 w-auto" },
  {
    name: "MasterClass",
    dark: MasterclassLogo,
    light: MasterclassLogoLight,
    className: "h-4 w-auto",
  },
]
---

<section class="hero-section relative w-full">
  <GridBackground />
  <HeroGridPulse />
  <div aria-hidden="true" class="hero-glow pointer-events-none absolute inset-x-0 top-0 h-150">
  </div>
  <div class="relative mx-auto w-full max-w-295 px-4 pt-20 pb-24">
    <div class="max-w-4xl text-left md:mx-auto md:text-center">
      <a
        href="/blog/releases/effect/40"
        class="group mb-4 inline-flex items-center gap-2 font-mono text-sm tracking-wider text-prose-foreground uppercase transition-colors hover:text-foreground"
      >
        <span class="text-subtle-foreground group-hover:text-muted-foreground">//</span>
        <span>
          Effect
          <span class="hero-flip" aria-label="4.0">
            <span class="hero-flip-reel" aria-hidden="true"><span>3</span><span>4</span></span>
            <span aria-hidden="true">.</span>
            <span class="hero-flip-reel hero-flip-reel--late" aria-hidden="true">
              <span>9</span><span>0</span>
            </span>
          </span>: Out now
        </span>
        <ArrowRight
          class="text-subtle-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-prose-foreground"
          size={16}
          aria-hidden="true"
        />
      </a>

      <h1
        class="hero-title bg-clip-text text-4xl font-bold text-transparent leading-tighter md:text-[3.4rem]"
      >
        Reliable TypeScript for the AI era
      </h1>

      <p class="mt-6 text-lg text-muted-foreground max-w-3xl leading-snug md:mx-auto">
        Build production-ready systems your team can ship, customers can depend on, and AI agents
        can work with.
      </p>

      <div class="mx-auto mt-8 max-w-xl">
        <HeroCommandPanel />
      </div>

      <div class="mt-14 flex flex-col items-center gap-5">
        <p class="font-mono text-sm font-medium tracking-wider text-muted-foreground uppercase">
          // In production at
        </p>
        <ul class="flex flex-wrap items-end justify-center gap-x-8 gap-y-5 text-foreground">
          {
            SOCIAL_PROOF_LOGOS.map((logo) => (
              <li class="flex items-end">
                <ThemedLogo logo={logo} name={logo.name} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    --hero-glow-gradient:
      radial-gradient(ellipse 50% 80% at 70% -20%, var(--hero-glow-a) 0%, transparent 40%),
      radial-gradient(ellipse 30% 50% at 80% 0%, var(--hero-glow-b) 0%, transparent 30%);
  }

  @keyframes hero-glow-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }

  .hero-glow {
    background: var(--hero-glow-gradient);
    animation: hero-glow-pulse 4s ease-in-out infinite;
    will-change: opacity;
  }

  .hero-flip {
    display: inline-flex;
    overflow: hidden;
    height: 1.3em;
    line-height: 1.3em;
    vertical-align: 0.1em;
  }

  @keyframes hero-flip-roll {
    to {
      transform: translateY(-1.3em);
    }
  }

  .hero-flip-reel {
    display: flex;
    flex-direction: column;
    animation: hero-flip-roll 650ms cubic-bezier(0.65, 0, 0.35, 1) 500ms both;
  }

  .hero-flip-reel--late {
    animation-delay: 640ms;
  }

  /* Shine that follows the letter shapes: the text is the gradient, so a soft
     dim-to-foreground edge wipes across it and rests on the foreground colour. */
  .hero-title {
    background-image: linear-gradient(
      255deg,
      var(--subtle-foreground) 0%,
      var(--subtle-foreground) 33%,
      var(--foreground) 50%,
      var(--foreground) 100%
    );
    background-size: 300% 100%;
    background-position: 0% 0;
    animation: hero-title-shine 1.6s ease-out 500ms 1 both;
  }

  @keyframes hero-title-shine {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
    }

    .hero-title {
      animation: none;
    }

    .hero-flip-reel {
      animation: none;
      transform: translateY(-1.3em);
    }
  }
</style>
