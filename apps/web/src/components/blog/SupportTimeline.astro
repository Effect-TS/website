---
import ChartCard from "@/components/blog/ChartCard.astro"

interface Props {
  title: string
  /** Name of the supported version. */
  version: string
  /** Release month of the supported version, as `YYYY-MM`. */
  release: string
  /** Name of the next major version, used to label its release marker. */
  next: string
  /** Guaranteed support from `release`, in years. */
  minimum: number
  /** Bug fix support after the next major version ships, in years. */
  bugFixes: number
  /** Security fix support after the next major version ships, in years. */
  securityFixes: number
  /** Possible release months of the next major version, as `YYYY-MM`. */
  scenarios: Array<string>
  note?: string
}

const { title, version, release, next, minimum, bugFixes, securityFixes, scenarios, note } =
  Astro.props

// Dates are counted in months so that yearly offsets stay exact.
const toMonth = (date: string) => {
  const [year, month] = date.split("-").map(Number)
  return year! * 12 + month! - 1
}
const formatMonth = (month: number) =>
  new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(
    new Date(Date.UTC(Math.floor(month / 12), month % 12)),
  )

const start = toMonth(release)
const floor = start + minimum * 12
const rows = scenarios.map((scenario) => {
  const shipped = toMonth(scenario)
  return {
    shipped,
    bugFixesUntil: Math.max(floor, shipped + bugFixes * 12),
    securityFixesUntil: Math.max(floor, shipped + securityFixes * 12),
  }
})

const describe = (row: (typeof rows)[number]) =>
  row.securityFixesUntil === row.bugFixesUntil
    ? `${version} gets bug and security fixes until ${formatMonth(row.bugFixesUntil)}`
    : `${version} gets bug fixes until ${formatMonth(row.bugFixesUntil)} and security fixes until ${formatMonth(row.securityFixesUntil)}`

const years = Math.ceil((Math.max(...rows.map((row) => row.securityFixesUntil)) - start) / 12)
const ticks = Array.from({ length: years + 1 }, (_, index) => Math.floor(start / 12) + index)
const x = (month: number) => ((month - start) / (years * 12)) * 100
---

<ChartCard title={title} note={note}>
  <span
    slot="legend"
    class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[13px] text-muted-foreground"
    aria-hidden="true"
  >
    <span class="flex items-center gap-1.5">
      <span class="full inline-block size-2.5 rounded-[2px]"></span>Bug and security fixes
    </span>
    <span class="flex items-center gap-1.5">
      <span class="security inline-block size-2.5 rounded-[2px]"></span>Security fixes only
    </span>
  </span>
  <div
    class="grid grid-cols-[auto_1fr] gap-x-3 border-t border-border pt-5 pr-6 pb-6 pl-6 sm:grid-cols-[109px_1fr] sm:gap-x-4 sm:pr-[35px]"
  >
    <span class="max-w-14 self-start text-sm leading-5 text-muted-foreground sm:max-w-none">
      If {next} ships in
    </span>
    <div class="relative h-6" aria-hidden="true">
      {
        ticks.map((tick, index) => (
          <span
            class:list={[
              "absolute top-0 font-mono text-[13px] leading-5 whitespace-nowrap text-muted-foreground",
              index === ticks.length - 1 ? "-translate-x-full" : index > 0 && "-translate-x-1/2",
              index % 2 === 1 && index < ticks.length - 1 && "hidden sm:inline",
            ]}
            style={{ left: `${(index / years) * 100}%` }}
          >
            {tick}
          </span>
        ))
      }
    </div>
    <div
      class="pointer-events-none relative col-start-2 row-start-2"
      style={{ gridRow: `2 / span ${rows.length + 1}` }}
      aria-hidden="true"
    >
      {
        ticks.map((_, index) => (
          <span
            class="absolute inset-y-0 w-px bg-border/60"
            style={{ left: `${(index / years) * 100}%` }}
          />
        ))
      }
      <span class="floor absolute top-0 -bottom-[11px]" style={{ left: `${x(floor)}%` }}></span>
      <span
        class="absolute -bottom-[6px] ml-2 font-mono text-[13px] leading-5 whitespace-nowrap text-muted-foreground"
        style={{ left: `${x(floor)}%` }}
      >
        {minimum}-year minimum
      </span>
    </div>
    {
      rows.map((row, index) => (
        <>
          <span
            class="col-start-1 h-[76px] pt-5 font-mono text-sm leading-5 whitespace-nowrap text-muted-foreground"
            style={{ gridRow: index + 2 }}
          >
            {formatMonth(row.shipped)}
          </span>
          <div class="relative col-start-2 h-[76px]" style={{ gridRow: index + 2 }}>
            <span class="sr-only">{describe(row)}</span>
            <div aria-hidden="true">
              <span class="absolute inset-x-0 top-[26px] h-2 rounded-full bg-muted/70" />
              <span
                class="full absolute top-[26px] left-0 h-2 rounded-full"
                style={{ width: `${x(row.bugFixesUntil)}%` }}
              />
              {row.securityFixesUntil > row.bugFixesUntil && (
                <span
                  class="security absolute top-[26px] h-2 rounded-full"
                  style={{
                    left: `calc(${x(row.bugFixesUntil)}% + 2px)`,
                    width: `calc(${x(row.securityFixesUntil) - x(row.bugFixesUntil)}% - 2px)`,
                  }}
                />
              )}
              <span
                class="absolute top-1 hidden font-mono text-[13px] leading-5 whitespace-nowrap text-muted-foreground sm:block"
                style={{ right: `calc(${100 - x(row.bugFixesUntil)}% + 8px)` }}
              >
                {formatMonth(row.bugFixesUntil)}
              </span>
              {row.securityFixesUntil > row.bugFixesUntil && (
                <span
                  class="absolute top-1 hidden font-mono text-[13px] leading-5 whitespace-nowrap text-muted-foreground sm:block"
                  style={{ right: `calc(${100 - x(row.securityFixesUntil)}% + 8px)` }}
                >
                  {formatMonth(row.securityFixesUntil)}
                </span>
              )}
              <span
                class="marker absolute top-[39px] -translate-x-1/2"
                style={{ left: `${x(row.shipped)}%` }}
              />
              <span
                class="absolute top-[35px] font-mono text-[13px] leading-5 whitespace-nowrap text-muted-foreground"
                style={
                  x(row.shipped) > 80
                    ? { right: `calc(${100 - x(row.shipped)}% + 8px)` }
                    : { left: `calc(${x(row.shipped)}% + 8px)` }
                }
              >
                {next} ships
              </span>
            </div>
          </div>
        </>
      ))
    }
  </div>
</ChartCard>

<style>
  .full {
    background-color: var(--brand);
  }

  .security {
    background-color: color-mix(in srgb, var(--brand) 20%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 75%, transparent);
  }

  .marker {
    width: 0;
    height: 0;
    border-inline: 4px solid transparent;
    border-bottom: 6px solid color-mix(in srgb, var(--foreground) 75%, transparent);
  }

  .floor {
    border-left: 1px dotted color-mix(in srgb, var(--foreground) 75%, transparent);
  }
</style>
