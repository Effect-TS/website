---
import BorderedGrid from "./BorderedGrid.astro"
import CardBody from "./CardBody.astro"
import CardTitle from "./CardTitle.astro"
import ContactMenu from "./ContactMenu"
import EnterpriseSection from "./EnterpriseSection.astro"
import Icon from "./Icon.astro"
import SupportFlow from "./SupportFlow.astro"
import { CONTACT_HREF, SUPPORT_OPTIONS } from "@/features/enterprise/copy"
import type { ContactMember } from "@/features/enterprise/domain"
import { Image } from "astro:assets"
import EffectMark from "@/assets/logos/effect/logo-symbol/svg/effect-logomark-white.svg"
import EffectfulLogo from "@/assets/effect-days/Effectful-white.svg"
import ZivergeLogo from "@/assets/logos/ziverge.svg"
import Eyebrow from "@/components/ui/Eyebrow.astro"

interface Props {
  readonly members: ReadonlyArray<ContactMember>
}

const { members } = Astro.props

const nodeClass = "relative h-full overflow-hidden border bg-background p-6 md:p-8"

const effectful = [
  "Evaluation and adoption planning",
  "Enterprise support, NDA and SLAs",
  "Private Slack or Discord channel",
]
const maintainers = ["Releases", "Security fixes"]
const ziverge = ["Implementation", "Consulting", "Team extension", "Training"]
---

<EnterpriseSection id="support" eyebrow="Support" title="Support for your company">
  <ContactMenu slot="action" client:load members={members} emailHref={CONTACT_HREF} />
  <BorderedGrid class="grid-cols-1 lg:grid-cols-3">
    {
      SUPPORT_OPTIONS.map((option) => (
        <li class="flex flex-col bg-background p-6 md:p-8">
          <Icon name={option.icon} size={24} />
          <CardTitle class="mt-6">{option.title}</CardTitle>
          <CardBody class="mt-3">{option.body}</CardBody>
        </li>
      ))
    }
  </BorderedGrid>
  <div class="mt-16">
    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_72px_minmax(0,1.15fr)_72px_minmax(0,1fr)]"
    >
      <div class="lg:order-3">
        <div class:list={[nodeClass, "border-foreground/60 bg-card"]}>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-foreground to-transparent"
          >
          </div>
          <div class="flex h-10 items-center">
            <Image src={EffectfulLogo} alt="Effectful" class="h-7 w-auto" />
          </div>
          <Eyebrow class="mt-5 text-xs">Your point of contact</Eyebrow>
          <ul class="mt-3 space-y-2">
            {
              effectful.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-prose-foreground">
                  <span aria-hidden="true" class="size-1 shrink-0 rounded-full bg-foreground" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:order-2">
        <div aria-hidden="true" class="relative flex h-full items-center justify-center">
          <div class="relative hidden h-px w-full overflow-hidden bg-border-strong lg:block">
            <span
              class="absolute motion-reduce:hidden inset-y-0 w-6 bg-linear-to-l from-transparent to-foreground [animation:hub-left_2.8s_cubic-bezier(0.4,0,0.2,1)_infinite]"
            >
            </span>
          </div>
          <div class="h-8 w-px bg-border-strong lg:hidden"></div>
        </div>
      </div>

      <div class="lg:order-1">
        <div class:list={[nodeClass, "border-border"]}>
          <div class="flex h-10 items-center gap-2.5">
            <Image src={EffectMark} alt="" class="size-6" />
            <span class="text-lg font-semibold text-foreground">Maintainers</span>
          </div>
          <Eyebrow class="mt-5 text-xs">Open source</Eyebrow>
          <ul class="mt-3 space-y-2">
            {
              maintainers.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-prose-foreground">
                  <span
                    aria-hidden="true"
                    class="size-1 shrink-0 rounded-full bg-subtle-foreground"
                  />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:order-4">
        <div aria-hidden="true" class="relative flex h-full items-center justify-center">
          <div class="relative hidden h-px w-full overflow-hidden bg-border-strong lg:block">
            <span
              class="absolute motion-reduce:hidden inset-y-0 w-6 bg-linear-to-r from-transparent to-foreground [animation:hub-right_2.8s_cubic-bezier(0.4,0,0.2,1)_infinite]"
            >
            </span>
          </div>
          <div class="h-8 w-px bg-border-strong lg:hidden"></div>
        </div>
      </div>

      <div class="lg:order-5">
        <div class:list={[nodeClass, "border-border"]}>
          <div class="flex h-10 items-center">
            <Image src={ZivergeLogo} alt="Ziverge" class="h-6 w-auto" />
          </div>
          <Eyebrow class="mt-5 text-xs">Adoption partner</Eyebrow>
          <ul class="mt-3 space-y-2">
            {
              ziverge.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-prose-foreground">
                  <span
                    aria-hidden="true"
                    class="size-1 shrink-0 rounded-full bg-subtle-foreground"
                  />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</EnterpriseSection>

<style is:global>
  @keyframes hub-right {
    0% {
      left: -1.5rem;
    }
    100% {
      left: 100%;
    }
  }
  @keyframes hub-left {
    0% {
      left: 100%;
    }
    100% {
      left: -1.5rem;
    }
  }
</style>
