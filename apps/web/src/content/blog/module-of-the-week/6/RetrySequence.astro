---
// Option 2: a sequence diagram, with time running down the page. Sebastian
// posts in Slack, and Slack sends the message across to our server, then
// waits three seconds on its own line. Our server's save runs past that, so
// Slack sends the same message again at the three-second mark, and our
// reply to the first one arrives too late. Both copies are saved.

import { AT } from "./retry"
import { people, warning } from "../3/palette"
import StepControls from "@/components/blog/module-of-the-week/stepper/StepControls.astro"
import RetryTable from "./RetryTable.astro"

// Seconds after Slack first sends
const at = (t: number) => `--t: ${t}`
---

<figure
  class="rq6 st"
  data-rq6-visual
  aria-label="Sequence diagram with Slack on the left and our server on the right, and time running down. Sebastian posts in Slack, and Slack sends his message to our server, then waits three seconds for a reply. Our server is still saving the message when the three seconds run out, so Slack sends the same message again. Our reply to the first one arrives too late, the copy is saved too, and the message table has the same message twice."
  style={[
    `--rq6-msg-light: ${people.Sebastian.light}`,
    `--rq6-msg-dark: ${people.Sebastian.dark}`,
    `--rq6-avatar: ${people.Sebastian.avatar}`,
    `--rq6-warn: ${warning.background}`,
    `--rq6-warn-ink: ${warning.text}`,
  ].join("; ")}
>
  <div class="rq6-card">
    <div class="rq6-post" data-at={AT.post}>
      <span class="rq6-avatar" aria-hidden="true">S</span>
      <p>
        <span class="rq6-name">Sebastian</span>
        <span class="rq6-channel">in #engineering</span>
        <span class="rq6-said">Why is this test flaky?</span>
      </p>
    </div>

    <div class="rq6-diagram">
      <p class="rq6-head is-slack">Slack</p>
      <p class="rq6-head is-server">Our server</p>
      <span class="rq6-life is-slack"></span>
      <span class="rq6-life is-server"></span>

      {/* Slack waits for a reply, on its own line, until it gives up */}
      <span class="rq6-wait" data-at={AT.send} style={at(0)}>
        <span class="rq6-wait-label">waits 3s</span>
      </span>
      <span class="rq6-deadline" data-at={AT.retry} style={at(3)}>
        <span>Gives up</span>
      </span>

      <span class="rq6-arrow is-right" data-at={AT.send} style={at(0)}>
        <span class="rq6-label">Sebastian's message</span>
      </span>
      <span class="rq6-save" data-at={AT.save} style={`${at(0.3)}; --len: 4`}>
        <span class="rq6-save-label">saving</span>
      </span>

      <span class="rq6-arrow is-right is-again" data-at={AT.retry} style={at(3)}>
        <span class="rq6-label">The same message, again</span>
      </span>
      <span class="rq6-save is-copy" data-at={AT.retry} style={`${at(3.3)}; --len: 4`}>
        <span class="rq6-save-label">saving the copy</span>
      </span>

      <span class="rq6-arrow is-left is-late" data-at={AT.late} style={at(4.3)}>
        <span class="rq6-label">Got it! <span class="rq6-tag is-late">Too late</span></span>
      </span>
      <span class="rq6-arrow is-left" data-at={AT.copy} style={at(7.3)}>
        <span class="rq6-label">Got it!</span>
      </span>
    </div>

    <RetryTable />
  </div>

  <StepControls reset />
</figure>

<script>
  import { STEPS, reveal } from "./retry"
  import { createStepper } from "@/components/blog/module-of-the-week/stepper/stepper"

  for (const root of document.querySelectorAll<HTMLElement>("[data-rq6-visual]")) {
    const caption = root.querySelector<HTMLElement>("[data-caption]")!
    createStepper({
      root,
      first: 0,
      last: STEPS.length - 1,
      apply: (k) => {
        reveal(root, k)
        caption.textContent = `${k + 1}. ${STEPS[k]}`
      },
    })
  }
</script>

<style is:global>
  .rq6 {
    --st-ink: #3f3f46;
    --st-muted: #71717a;
    --st-line: #d4d4d8;
    --st-surface: #ffffff;
    --rq6-panel: #f4f4f5;
    --rq6-msg: var(--rq6-msg-light);
    --rq6-red: #dc2626;
    --rq6-ok: #15803d;
    /* Where the two lifelines are, and how far down a second is */
    --rq6-slack: 22%;
    --rq6-server: 70%;
    --rq6-second: 1.75rem;
    --rq6-top: 3.25rem;
    margin: 1.5rem 0;
  }
  html.dark .rq6 {
    --st-ink: #e4e4e7;
    --st-muted: #a1a1aa;
    --st-line: #3f3f46;
    --st-surface: #09090b;
    --rq6-panel: #18181b;
    --rq6-msg: var(--rq6-msg-dark);
    --rq6-red: #f87171;
    --rq6-ok: #4ade80;
  }
  .st.rq6 .rq6-card p {
    margin: 0;
    font-size: inherit;
    line-height: 1.4;
  }
  .rq6-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid var(--st-line);
    border-radius: var(--radius-lg, 8px);
    background: var(--st-surface);
    font-size: 0.75rem;
    color: var(--st-ink);
  }

  .rq6 [data-at] {
    opacity: 0;
    transition: opacity 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .rq6 [data-at].is-on {
    opacity: 1;
  }

  .rq6-post {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .rq6-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: var(--radius-md, 6px);
    background: var(--rq6-avatar);
    color: #fff;
    font-weight: 700;
  }
  .rq6-name {
    font-weight: 700;
  }
  .rq6-channel {
    margin-left: 0.3rem;
    color: var(--st-muted);
    font-size: 0.7rem;
  }
  .rq6-said {
    display: block;
  }

  /* The diagram: two lifelines, and everything placed at a time down them */
  .rq6-diagram {
    position: relative;
    height: calc(var(--rq6-top) + var(--rq6-second) * 8);
  }
  .rq6-diagram > * {
    position: absolute;
  }
  .st.rq6 .rq6-head {
    top: 0;
    width: 7rem;
    padding: 0.35rem 0;
    border: 1px solid var(--st-line);
    border-radius: var(--radius-md, 6px);
    background: var(--rq6-panel);
    font-weight: 600;
    text-align: center;
    transform: translateX(-50%);
  }
  .rq6-head.is-slack,
  .rq6-life.is-slack {
    left: var(--rq6-slack);
  }
  .rq6-head.is-server,
  .rq6-life.is-server {
    left: var(--rq6-server);
  }
  .rq6-life {
    top: 2.1rem;
    bottom: 0;
    border-left: 1.5px dashed var(--st-line);
  }
  /* Down from the top of the timeline, at time --t */
  .rq6-wait,
  .rq6-deadline,
  .rq6-arrow,
  .rq6-save {
    top: calc(var(--rq6-top) + var(--t) * var(--rq6-second));
  }

  /* Slack's wait: a bracket just left of its line, three seconds long */
  .rq6-wait {
    left: calc(var(--rq6-slack) - 0.55rem);
    height: calc(var(--rq6-second) * 3);
    border-left: 3px solid color-mix(in oklab, var(--st-ink) 35%, transparent);
    border-radius: 2px;
  }
  .rq6-wait-label {
    position: absolute;
    top: 50%;
    right: 0.45rem;
    transform: translateY(-50%);
    color: var(--st-muted);
    white-space: nowrap;
  }
  .rq6-deadline {
    left: calc(var(--rq6-slack) - 3.75rem);
    width: 3.75rem;
    border-top: 1.5px dashed var(--rq6-red);
  }
  .rq6-deadline span {
    position: absolute;
    right: 0.45rem;
    top: 0.15rem;
    font-weight: 700;
    color: var(--rq6-red);
    white-space: nowrap;
  }

  /* A message between the lifelines, with its arrowhead at the receiver */
  .rq6-arrow {
    left: var(--rq6-slack);
    width: calc(var(--rq6-server) - var(--rq6-slack));
    border-top: 1.5px solid var(--rq6-msg);
  }
  .rq6-arrow::after {
    content: "";
    position: absolute;
    top: -5px;
    border: 4.5px solid transparent;
  }
  .rq6-arrow.is-right::after {
    right: -1px;
    border-left: 7px solid var(--rq6-msg);
    border-right: none;
  }
  .rq6-arrow.is-left::after {
    left: -1px;
    border-right: 7px solid var(--rq6-msg);
    border-left: none;
  }
  .rq6-arrow.is-left {
    border-top-color: var(--rq6-ok);
  }
  .rq6-arrow.is-left::after {
    border-right-color: var(--rq6-ok);
  }
  .rq6-arrow.is-late {
    border-top-style: dashed;
    border-top-color: var(--st-muted);
  }
  .rq6-arrow.is-late::after {
    border-right-color: var(--st-muted);
  }
  .rq6-label {
    position: absolute;
    bottom: 0.2rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .rq6-tag {
    margin-left: 0.25rem;
    padding: 0 0.35rem;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.62rem;
    font-weight: 700;
  }
  .rq6-tag.is-late {
    border: 1px solid var(--rq6-red);
    color: var(--rq6-red);
  }

  /* The saves, down our server's line. They overlap, so the copy sits beside. */
  .rq6-save {
    left: calc(var(--rq6-server) - 0.3rem);
    width: 0.6rem;
    height: calc(var(--len) * var(--rq6-second));
    border: 1.5px solid var(--rq6-msg);
    border-radius: 3px;
    background: color-mix(in oklab, var(--rq6-msg) 22%, var(--st-surface));
  }
  .rq6-save.is-copy {
    left: calc(var(--rq6-server) + 0.45rem);
  }
  .rq6-save-label {
    position: absolute;
    top: 0.1rem;
    left: calc(100% + 0.35rem);
    color: var(--st-muted);
    white-space: nowrap;
  }
  /* Closer together on phones, leaving room for the labels */
  @media (max-width: 640px) {
    .rq6 {
      --rq6-slack: 26%;
      --rq6-server: 66%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rq6 [data-at] {
      transition: opacity 120ms linear;
    }
  }
</style>
