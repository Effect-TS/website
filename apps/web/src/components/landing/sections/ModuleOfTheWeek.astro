---
import { ArrowRight, Play } from "@lucide/astro"
import ModuleSummary from "@/components/landing/blocks/ModuleSummary.astro"
import { getLatestModules } from "@/features/module-of-the-week/http"

const [latest, ...older] = await getLatestModules()
const recent = older.slice(0, 4)
const video = latest?.post.data.video

// Every module is a card that opens its blog post: `ModuleSummary` stretches
// the Blog post link over the card, so each card must be positioned.
const cardClass =
  "group/card relative flex min-w-0 flex-col bg-zinc-950 transition-colors hover:bg-zinc-900/60 has-[a:focus-visible]:bg-zinc-900/60"
---

{
  latest !== undefined && (
    <section
      id="module-of-the-week"
      aria-labelledby="module-of-the-week-heading"
      class="relative w-full py-24 md:pt-40 md:pb-24"
    >
      <div class="mx-auto w-full max-w-295 px-4">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="mb-3 font-mono text-sm font-medium tracking-wider text-zinc-400 uppercase">
              // Module of the Week
            </p>
            <h2
              id="module-of-the-week-heading"
              class="text-2xl leading-tighter font-semibold text-white md:text-3xl"
            >
              One Effect module, every week
            </h2>
          </div>
          <a
            href="/module-of-the-week"
            class="group inline-flex items-center gap-2 self-start rounded-md border border-zinc-700 bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:border-zinc-500 hover:bg-zinc-800 hover:no-underline lg:self-auto"
          >
            All modules
            <ArrowRight
              class="size-4 transition-transform motion-safe:group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </a>
        </div>
        <div
          class:list={[
            "mt-12 grid grid-cols-1 gap-px border border-zinc-800 bg-zinc-800",
            recent.length > 0 && "lg:grid-cols-2",
          ]}
        >
          <article class={cardClass}>
            {video !== undefined ? (
              // The video's thumbnail. It sits above the card's Blog post
              // layer so it keeps its own destination.
              <a
                href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Watch ${latest.title} on YouTube (opens in a new tab)`}
                class="relative z-10 block aspect-video overflow-hidden bg-zinc-900"
              >
                <img
                  src={`https://i.ytimg.com/vi/${video.youtubeId}/sddefault.jpg`}
                  alt=""
                  loading="lazy"
                  width="1280"
                  height="720"
                  class="h-full w-full object-cover"
                />
                <span class="absolute right-2 bottom-2 inline-flex items-center gap-1 rounded-sm bg-zinc-950/80 py-0.5 pr-1.5 pl-1 font-mono text-xs text-white tabular-nums">
                  <Play class="size-3 fill-current" aria-hidden="true" />
                  {video.duration}
                </span>
              </a>
            ) : (
              // Until the video is out, a title card in the thumbnail's place.
              // The card already opens the post and names the module below,
              // so this is decorative.
              <div
                aria-hidden="true"
                class="flex aspect-video flex-col justify-end bg-zinc-900 bg-[radial-gradient(120%_90%_at_85%_0%,var(--color-zinc-800),transparent_60%)] p-6 lg:p-8"
              >
                <p class="font-mono text-xs font-medium tracking-wider text-zinc-400 uppercase">
                  Module of the Week #{latest.number}
                </p>
                <p class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-balance text-white md:text-4xl">
                  {latest.title}
                </p>
              </div>
            )}
            <div class="flex flex-1 flex-col gap-4 border-t border-zinc-800 p-5 lg:px-6">
              <ModuleSummary module={latest} featured />
            </div>
          </article>
          {recent.length > 0 && (
            <div class="grid min-w-0 grid-cols-1 gap-px bg-zinc-800 lg:auto-rows-fr">
              {recent.map((module) => (
                <article class:list={[cardClass, "justify-between gap-3 p-5 lg:px-6"]}>
                  <ModuleSummary module={module} />
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
