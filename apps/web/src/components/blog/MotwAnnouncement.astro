---
import ModuleCard from "@/components/module-of-the-week/ModuleCard.astro"
import { getModule } from "@/features/module-of-the-week/http"

interface Props {
  readonly id: number | string
}

const { post, number } = await getModule(Astro.props.id)
---

<ModuleCard post={post} entry={number} layout="stacked" class="not-prose my-8" />
