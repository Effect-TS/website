---
import { ArrowRight, ArrowUpRight, FileText } from "@lucide/astro"
import { getCollection } from "astro:content"
import YouTubeLogo from "@/assets/icons/fa7-brands/youtube.svg"
import ModuleCard from "@/components/module-of-the-week/ModuleCard.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"
import { FormattedDate } from "@/components/ui/FormattedDate"

const modules = (await getCollection("blog"))
  .filter(
    (post) =>
      post.data.tags.some((tag) => tag.id === "module-of-the-week") &&
      post.filePath?.startsWith("src/content/blog/module-of-the-week/") &&
      post.filePath.endsWith("/index.mdx"),
  )
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .map((post, index) => ({ post, number: index + 1 }))
  .reverse()

const [latest, ...others] = modules
const shortTitle = (title: string) => title.replace(/^Module of the Week\s*-\s*/, "")
const linkClass =
  "group inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground no-underline transition-colors hover:text-foreground hover:no-underline"
---

{
  latest !== undefined && (
    <section id="module-of-the-week" class="relative w-full py-24">
      <div class="mx-auto w-full max-w-295 px-4">
        <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
          <div>
            <Eyebrow class="mb-3">// Module of the Week</Eyebrow>
            <h2 class="max-w-2xl text-2xl leading-tighter font-semibold text-foreground md:text-3xl">
              One Effect module, every week
            </h2>
          </div>
          <a
            href="/module-of-the-week"
            class="group inline-flex items-center gap-2 font-mono text-sm text-muted-foreground no-underline transition-colors hover:text-foreground hover:no-underline"
          >
            All modules
            <ArrowRight
              class="size-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
        </div>
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
          <ModuleCard
            post={latest.post}
            entry={latest.number}
            latest
            layout="stacked"
            class="lg:col-span-7"
          />
          <ol class="flex flex-col lg:col-span-5">
            {others.slice(0, 6).map(({ post, number }) => (
              <li class="border-t border-border first:border-t-0 first:pt-0 py-5 first:lg:pt-0">
                <div class="flex items-center gap-2 font-mono text-xs">
                  <span class="font-medium text-foreground tabular-nums">
                    {String(number).padStart(2, "0")}
                  </span>
                  {post.data.packageName && (
                    <>
                      <span aria-hidden="true" class="h-3 w-px bg-border-strong" />
                      <span class="truncate text-muted-foreground">
                        from "{post.data.packageName}"
                      </span>
                    </>
                  )}
                  <FormattedDate
                    date={post.data.date}
                    className="ml-auto shrink-0 text-muted-foreground tabular-nums"
                  />
                </div>
                <h3 class="mt-2 text-lg leading-snug font-semibold text-foreground">
                  {shortTitle(post.data.title)}
                </h3>
                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                  {post.data.video && (
                    <a
                      href={`https://www.youtube.com/watch?v=${post.data.video.youtubeId}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={linkClass}
                    >
                      <YouTubeLogo class="size-4" aria-hidden="true" />
                      Video
                      <ArrowUpRight class="size-3.5" aria-hidden="true" />
                    </a>
                  )}
                  <a href={`/blog/${post.id}`} class={linkClass}>
                    <FileText class="size-4" aria-hidden="true" />
                    Blog post
                  </a>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
