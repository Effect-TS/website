  Cross-Origin-Opener-Policy: same-origin

# Scratchpad in-browser language server (@website/tsrs-lsp-wasm). The names are
# content-hashed by Vite, so they can be cached for good. No COOP/COEP: the
# module runs single-threaded and needs no cross-origin isolation.
/_astro/tsrs-effect-lsp.*
  Cache-Control: public, max-age=31536000, immutable

/_astro/effect-types.pack.*
  Cache-Control: public, max-age=31536000, immutable
