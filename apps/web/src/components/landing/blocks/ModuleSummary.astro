---
import { ArrowUpRight } from "@lucide/astro"
import { FormattedDate } from "@/components/ui/FormattedDate"
import type { Module } from "@/features/module-of-the-week/domain"

/**
 * The metadata, title and links of one module. Rendered directly into a
 * positioned card: the Blog post link stretches over the whole card, so
 * clicking anywhere on it opens the post, while the Video link sits above
 * that layer and keeps its own destination.
 */
interface Props {
  readonly module: Module
  /** The latest module: a larger title and its excerpt. */
  readonly featured?: boolean | undefined
  /** Off when the card's heading is already shown elsewhere, as in the hero's title card. */
  readonly showTitle?: boolean | undefined
}

const { module, featured = false, showTitle = true } = Astro.props
const { post, number, title } = module
const video = post.data.video

const linkClass =
  "group/link inline-flex items-center gap-1 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground hover:no-underline"
const arrowClass = "size-3.5 transition-transform"
// The Blog post arrow answers a hover anywhere on the card, the Video arrow
// only its own link.
const cardArrowClass =
  "motion-safe:group-hover/card:translate-x-0.5 motion-safe:group-hover/card:-translate-y-0.5"
const linkArrowClass =
  "motion-safe:group-hover/link:translate-x-0.5 motion-safe:group-hover/link:-translate-y-0.5"
---

<div class="flex items-baseline justify-between gap-4 font-mono text-xs text-muted-foreground">
  <div class="flex min-w-0 items-baseline gap-3">
    <span class="shrink-0 font-medium tabular-nums">{String(number).padStart(2, "0")}</span>
    {post.data.packageName && <span class="truncate">from "{post.data.packageName}"</span>}
  </div>
  <FormattedDate date={post.data.date} className="shrink-0 whitespace-nowrap tabular-nums" />
</div>
<div class="flex flex-col gap-2">
  {
    showTitle && (
      <h3
        class:list={[
          "leading-snug font-semibold text-balance text-foreground",
          featured ? "text-lg" : "text-base",
        ]}
      >
        {title}
      </h3>
    )
  }
  {
    featured && (
      <p class="text-base leading-relaxed text-pretty text-muted-foreground">{post.data.excerpt}</p>
    )
  }
</div>
<div class:list={["flex flex-wrap items-center gap-x-4 gap-y-2", featured && "mt-auto pt-2"]}>
  {
    video && (
      <a
        href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[linkClass, "relative z-10"]}
      >
        Video
        <span class="sr-only">: {title} on YouTube (opens in a new tab)</span>
        <ArrowUpRight class:list={[arrowClass, linkArrowClass]} aria-hidden="true" />
      </a>
    )
  }
  <a
    href={`/blog/${post.id}`}
    class:list={[
      linkClass,
      "group-hover/card:text-foreground after:absolute after:inset-0 after:content-['']",
    ]}
  >
    Blog post
    <span class="sr-only">: {title}</span>
    <ArrowUpRight class:list={[arrowClass, cardArrowClass]} aria-hidden="true" />
  </a>
</div>
