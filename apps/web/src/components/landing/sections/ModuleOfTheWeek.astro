---
import { ArrowRight } from "@lucide/astro"
import ModuleSummary from "@/components/landing/blocks/ModuleSummary.astro"
import { getLatestModules } from "@/features/module-of-the-week/http"

const [latest, ...older] = await getLatestModules()
const recent = older.slice(0, 4)

// The recent modules fill a row at lg, so the column count follows how many
// there are; at md an odd one out spans both columns. Otherwise the grid's
// border-coloured background would show through the unused cells.
const recentColumns = {
  1: "lg:grid-cols-1",
  2: "lg:grid-cols-2",
  3: "lg:grid-cols-3",
  4: "lg:grid-cols-4",
}[recent.length]
const lastSpansRow = recent.length % 2 === 1
// Three or four cards across leave no room for the date beside the package.
const compact = recent.length >= 3

// Every module is a card that opens its blog post: `ModuleSummary` stretches
// the Blog post link over the card, so each card must be positioned.
const cardClass =
  "group/card relative flex min-w-0 flex-col gap-4 bg-zinc-950 p-5 transition-colors hover:bg-zinc-900/60 has-[a:focus-visible]:bg-zinc-900/60 lg:px-6"
---

{
  latest !== undefined && (
    <section
      id="module-of-the-week"
      aria-labelledby="module-of-the-week-heading"
      class="relative w-full py-24 md:pt-40 md:pb-24"
    >
      <div class="mx-auto w-full max-w-295 px-4">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="mb-3 font-mono text-sm font-medium tracking-wider text-zinc-400 uppercase">
              // Module of the Week
            </p>
            <h2
              id="module-of-the-week-heading"
              class="text-2xl leading-tighter font-semibold text-white md:text-3xl"
            >
              One Effect module, every week
            </h2>
          </div>
          <a
            href="/module-of-the-week"
            class="group inline-flex items-center gap-2 self-start rounded-md border border-zinc-700 bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:border-zinc-500 hover:bg-zinc-800 hover:no-underline lg:self-auto"
          >
            All modules
            <ArrowRight
              class="size-4 transition-transform motion-safe:group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </a>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-px border border-zinc-800 bg-zinc-800">
          <article class:list={[cardClass, "lg:py-6"]}>
            <ModuleSummary module={latest} featured />
          </article>
          {recent.length > 0 && (
            <div
              class:list={[
                "grid min-w-0 grid-cols-1 gap-px bg-zinc-800 md:grid-cols-2",
                recentColumns,
              ]}
            >
              {recent.map((module, index) => (
                <article
                  class:list={[
                    cardClass,
                    "justify-between",
                    lastSpansRow && index === recent.length - 1 && "md:col-span-2 lg:col-span-1",
                  ]}
                >
                  <ModuleSummary module={module} compact={compact} />
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
