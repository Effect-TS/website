---
import { ArrowRight } from "@lucide/astro"
import ModuleSummary from "@/components/landing/blocks/ModuleSummary.astro"
import { getLatestModules } from "@/features/module-of-the-week/http"

const [latest, ...older] = await getLatestModules()
const recent = older.slice(0, 3)

// Every module is a card that opens its blog post: `ModuleSummary` stretches
// the Blog post link over the card, so each card must be positioned.
const cardClass =
  "group/card relative flex min-w-0 flex-col bg-background transition-colors hover:bg-muted/60 has-[a:focus-visible]:bg-muted/60 dark:hover:bg-card/60 dark:has-[a:focus-visible]:bg-card/60"
---

{
  latest !== undefined && (
    <section
      id="module-of-the-week"
      aria-labelledby="module-of-the-week-heading"
      class="relative w-full py-24 md:pt-40 md:pb-24"
    >
      <div class="mx-auto w-full max-w-295 px-4">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="mb-3 font-mono text-sm font-medium tracking-wider text-muted-foreground uppercase">
              // Module of the Week
            </p>
            {/* The reference was set in Inter's text cut; the variable font's
                display optical size at this size paints about 7% narrower. */}
            <h2
              id="module-of-the-week-heading"
              class="text-2xl leading-tighter font-semibold text-foreground [font-optical-sizing:none] md:text-3xl"
            >
              One Effect module, every week
            </h2>
          </div>
          <a
            href="/module-of-the-week"
            class="group inline-flex items-center gap-2 self-start rounded-md border border-border-strong bg-card px-5 py-2.5 text-sm font-medium text-foreground no-underline transition-colors hover:border-subtle-foreground hover:bg-muted hover:no-underline lg:self-auto"
          >
            All modules
            <ArrowRight
              class="size-4 transition-transform motion-safe:group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </a>
        </div>
        <div
          class:list={[
            "mt-12 grid grid-cols-1 gap-px border border-border bg-border",
            recent.length > 0 && "lg:grid-cols-2",
          ]}
        >
          <article class:list={[cardClass, "p-5 lg:p-8"]}>
            {/* The site's bordered mono tag, with the brand dot of a status light. */}
            <p class="inline-flex items-center gap-2 self-start border border-border-strong px-2 py-0.5 font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase">
              <span class="size-1.5 rounded-full bg-brand" aria-hidden="true" />
              Latest
            </p>
            {/* Anchored to the bottom of the card, however tall the column beside it. */}
            <div class="mt-auto flex flex-col pt-12 lg:pt-19">
              <ModuleSummary module={latest} featured />
            </div>
          </article>
          {recent.length > 0 && (
            <div class="grid min-w-0 grid-cols-1 gap-px bg-border lg:auto-rows-fr">
              {recent.map((module) => (
                <article class:list={[cardClass, "p-5 lg:px-6"]}>
                  <ModuleSummary module={module} />
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
