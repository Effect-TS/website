---
interface Props {
  stats: Array<{
    value: string
    label: string
  }>
}

const { stats } = Astro.props
---

<dl
  class:list={[
    "m-0 grid gap-px border-t border-border bg-border",
    stats.length === 2 ? "grid-cols-2" : "grid-cols-3",
  ]}
>
  {
    stats.map(({ value, label }) => (
      <div class="flex flex-col gap-2 bg-background px-4 py-5 sm:px-5 sm:py-6">
        <dt class="order-2 text-xs text-muted-foreground">{label}</dt>
        <dd class="highlight m-0 font-mono text-2xl font-semibold tracking-tight tabular-nums sm:text-3xl">
          {value}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .highlight {
    color: color-mix(in srgb, var(--brand) 60%, var(--foreground));
  }
</style>
