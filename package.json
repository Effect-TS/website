{
  "name": "website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "vp run dev:web",
    "dev": "vp run dev:web",
    "stop": "vp -C apps/web exec astro dev stop",
    "prepare": "vp config && effect-language-service patch",
    "doctest": "vitest run --config vitest.docs.ts",
    "doctest:file": "vitest run --config vitest.docs.ts",
    "vendor:foldkit": "node scripts/vendor-foldkit.mjs",
    "vendor:verify": "tsc --noEmit -p apps/web && vp test run"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:alchemy",
    "@effect/doctest": "catalog:effect",
    "@effect/language-service": "^0.87.3",
    "@foldkit/oxlint-plugin": "^0.15.4",
    "@mixedbread/cli": "2.4.0",
    "@types/node": "catalog:",
    "@website/alchemy-mixedbread": "workspace:*",
    "@website/api-reference": "workspace:*",
    "@website/icon-generator": "workspace:*",
    "@website/mixedbread": "workspace:*",
    "alchemy": "catalog:alchemy",
    "@alchemy.run/cloudflare": "catalog:alchemy",
    "@alchemy.run/github": "catalog:alchemy",
    "effect": "catalog:effect",
    "hono": "^4.12.14",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "ts-patch": "^4.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^5.0.3"
  }
}
