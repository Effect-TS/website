---
import { Menu } from "@lucide/astro"
import AnnouncementBanner from "@/components/AnnouncementBanner.astro"
import NavigationDesktopActions from "@/components/navigation/NavigationDesktopActions.astro"
import NavigationLogo from "@/components/navigation/NavigationLogo.astro"
import { SearchDialog } from "@/components/navigation/SearchDialog"
import SearchTriggerIsland from "@/components/navigation/SearchTriggerIsland"
import Disclosure from "@/components/ui/Disclosure.astro"
import ThemeToggle from "@/components/ui/ThemeToggle"
import { DOCS_VERSIONS, defaultDocsVersion } from "@/lib/versions"
import type { DocsNavSection } from "@/lib/docs-sections"

interface Props {
  readonly section: DocsNavSection
  readonly version?: string | undefined
}

const { section, version = defaultDocsVersion } = Astro.props
const links = [
  { key: "onboarding", href: `/docs/${version}`, label: "Onboarding" },
  { key: "guides", href: `/docs/${version}/guides`, label: "Guides" },
  { key: "api", href: `/docs/${version}/api`, label: "Reference" },
]
const linkClass =
  "text-sm text-muted-foreground no-underline hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:font-semibold"
---

<div data-site-header class="sticky top-0 z-100 w-full">
  <AnnouncementBanner />
  <header class="@container/navigation relative border-b border-border bg-background/95">
    <nav aria-label="Documentation" class="mx-auto flex h-16 max-w-352 items-center gap-3 px-4">
      <NavigationLogo />
      <div class="hidden items-center gap-6 @min-[70rem]/navigation:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              class={linkClass}
              aria-current={link.key === section ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <div
          class="flex gap-1 rounded-md border border-border p-1"
          aria-label="Documentation version"
          role="group"
        >
          {
            DOCS_VERSIONS.map(({ value, label }) => (
              <a
                href={section === "api" ? `/docs/${value}/api` : `/docs/${value}`}
                class="rounded px-3 py-1 text-sm text-muted-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground"
                aria-label={`Effect ${label} documentation`}
                aria-current={version === value ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
      <div class="ml-auto hidden items-center gap-4 @min-[70rem]/navigation:flex">
        <NavigationDesktopActions showThemeToggle />
      </div>
      <div class="ml-auto flex items-center gap-2 @min-[70rem]/navigation:hidden">
        <SearchTriggerIsland client:load mode="desktop" compact />
        <ThemeToggle client:load className="size-[40px] text-muted-foreground" />
        <Disclosure
          label="Documentation menu"
          triggerClass="flex size-[40px] items-center justify-center text-muted-foreground"
          panelClass="absolute inset-x-0 top-full max-h-[calc(100dvh_-_var(--sticky-header-height))] overflow-y-auto border-b border-border bg-background p-4 shadow-lg"
        >
          <Menu slot="trigger" aria-hidden="true" />
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={["block py-3", linkClass]}
                aria-current={link.key === section ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
          <div class="flex flex-wrap gap-3 border-t border-border pt-3">
            {
              DOCS_VERSIONS.map(({ value, label }) => (
                <a
                  href={section === "api" ? `/docs/${value}/api` : `/docs/${value}`}
                  class="rounded px-3 py-2 text-sm text-muted-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground"
                  aria-label={`Effect ${label} documentation`}
                  aria-current={version === value ? "page" : undefined}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </Disclosure>
      </div>
    </nav>
  </header>
</div>
<SearchDialog client:load version={version} />
