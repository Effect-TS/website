---
import type { CollectionEntry } from "astro:content"
import { getCollection, getEntry, render } from "astro:content"

import { ChevronDown, Menu } from "@lucide/astro"

import DocsSidebarTree from "@/components/docs/DocsSidebarTree.astro"
import TableOfContents from "@/components/ui/toc/TableOfContents.astro"
import VersionSwitch from "@/components/ui/VersionSwitch.astro"
import DocShell from "@/layouts/DocShell.astro"

export async function getStaticPaths() {
  const entries = await getCollection("docs")
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, "") },
    props: { entry, entries },
  }))
}

const { entry, entries } = Astro.props
const { Content, headings } = await render(entry)

const currentId = entry.id
const currentVersion = currentId.split("/")[0]
const currentLabel = entryLabel(entry)
const versions = ["v4", "v3"] as const

if (currentVersion === undefined) {
  throw new Error("Unable to generate sidebar entry without document version")
}

const sidebarEntry = await getEntry("docsSidebar", currentVersion)
const groupConfig: Record<string, number> = sidebarEntry?.data ?? {}

function entryLabel(e: CollectionEntry<"docs">): string {
  return e.data.sidebar?.label ?? e.data.title
}

function entryOrder(e: CollectionEntry<"docs">): number {
  return e.data.sidebar?.order ?? Infinity
}

interface SidebarGroup {
  dir: string
  label: string
  entries: CollectionEntry<"docs">[]
  isOpen: boolean
}

type SidebarItem =
  { kind: "entry"; entry: CollectionEntry<"docs"> } | { kind: "group"; group: SidebarGroup }

function groupOrder(g: SidebarGroup): number {
  const configuredOrder = groupConfig[g.dir]
  if (configuredOrder !== undefined) {
    return configuredOrder
  }
  const min = Math.min(...g.entries.map(entryOrder).filter(isFinite))
  return isFinite(min) ? min : Infinity
}

function sortByOrderLabel<T>(items: T[], order: (t: T) => number, label: (t: T) => string): T[] {
  return [...items].sort((a, b) => {
    const diff = order(a) - order(b)
    return diff !== 0 ? diff : label(a).localeCompare(label(b))
  })
}

// Build sidebar for current version
const roots: CollectionEntry<"docs">[] = []
const groupMap = new Map<string, CollectionEntry<"docs">[]>()

for (const e of entries.filter((e) => e.id.startsWith(`${currentVersion}/`))) {
  const parts = e.id.slice(currentVersion.length + 1).split("/")
  if (parts.length === 1) {
    roots.push(e)
  } else {
    const dir = parts[0]
    if (dir !== undefined) {
      const entries = groupMap.get(dir)
      if (entries !== undefined) {
        entries.push(e)
      } else {
        groupMap.set(dir, [e])
      }
    }
  }
}

const groups: SidebarGroup[] = [...groupMap.entries()].map(([dir, es]) => ({
  dir,
  label: dir
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" "),
  entries: sortByOrderLabel(es, entryOrder, entryLabel),
  isOpen: es.some((e) => e.id === currentId),
}))

const sidebarItems = sortByOrderLabel<SidebarItem>(
  [
    ...roots.map((e) => ({ kind: "entry" as const, entry: e })),
    ...groups.map((g) => ({ kind: "group" as const, group: g })),
  ],
  (item) => (item.kind === "entry" ? entryOrder(item.entry) : groupOrder(item.group)),
  (item) => (item.kind === "entry" ? entryLabel(item.entry) : item.group.label),
)

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3)
const tocItems = tocHeadings.map((heading) => ({
  id: heading.slug,
  label: heading.text,
  indent: heading.depth === 3,
  class: "text-sm leading-snug",
}))
---

<DocShell
  title={entry.data.title}
  description={entry.data.description}
  activeSlug="docs"
  version={currentVersion}
>
  <!-- Mobile docs menu -->
  <div
    slot="mobile-nav"
    class="sticky top-16 z-40 border-b border-border bg-background/95 backdrop-blur-sm lg:hidden"
  >
    <details class="group">
      <summary
        class="flex w-full cursor-pointer select-none list-none items-center gap-2 px-6 py-3 text-sm font-medium text-navigation-heading"
      >
        <Menu class="h-5 w-5" aria-hidden="true" />
        <span>Docs menu</span>
        <span class="truncate text-muted-foreground">/ {currentLabel}</span>
        <ChevronDown
          class="ml-auto h-4 w-4 transition-transform group-open:rotate-180"
          aria-hidden="true"
        />
      </summary>
      <nav
        aria-label="Documentation navigation"
        class="max-h-[60vh] overflow-y-auto border-t border-border px-6 py-4"
      >
        <DocsSidebarTree items={sidebarItems} currentId={currentId} />
      </nav>
    </details>
  </div>

  <!-- Desktop sidebar -->
  <nav slot="sidebar" aria-label="Documentation navigation">
    <VersionSwitch
      versions={versions.map((v) => ({
        href: `/docs/${v}`,
        label: v === "v4" ? "v4 (rc)" : v,
        active: currentVersion === v,
      }))}
    />
    <DocsSidebarTree items={sidebarItems} currentId={currentId} />
  </nav>

  <!-- Main content -->
  <article class="prose prose-effect max-w-none">
    <h1 class="mt-0!">{entry.data.title}</h1>
    <Content />
  </article>

  <!-- Right TOC -->
  {tocItems.length > 0 && <TableOfContents slot="toc" items={tocItems} />}
</DocShell>
