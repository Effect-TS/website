---
import { ArrowRight } from "@lucide/astro"

// Permanent site-wide banner sharing the navbar's sticky wrapper. Not
// dismissible. The home hero dispatches `hero-grid-pulse-complete`; the banner
// answers with a light sweep along its bottom border.
---

<effect-announcement
  data-announcement
  role="region"
  aria-label="Announcement"
  class="group relative flex min-h-10 items-center justify-center border-b border-zinc-700/60 bg-zinc-900 px-10 py-2 text-zinc-100 transition-colors has-[a:hover]:bg-zinc-800"
>
  <span
    aria-hidden="true"
    class="announcement-sweep pointer-events-none absolute inset-x-0 bottom-0 h-px bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.9)_50%,transparent_100%)] opacity-0"
  ></span>
  <span
    aria-hidden="true"
    class="announcement-glint pointer-events-none absolute inset-x-0 bottom-[-1px] hidden h-px bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.9),transparent)] group-data-[glint]:block motion-reduce:hidden"
  ></span>

  <a
    href="/blog/releases/effect/40"
    aria-label="Effect 4.0 is here: read the announcement"
    class="absolute inset-0"></a>

  <div
    class="pointer-events-none flex min-w-0 items-center justify-center gap-2 text-sm font-medium"
  >
    <span class="truncate">Effect 4.0 is here. One ecosystem. Zero dependencies.</span>
    <ArrowRight
      size={16}
      class="shrink-0 transition-transform group-hover:translate-x-0.5"
      aria-hidden="true"
    />
  </div>
</effect-announcement>

<style is:global>
  @keyframes announcement-sweep {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  [data-announcement]:has(a:hover) .announcement-sweep {
    animation: announcement-sweep 1600ms ease-in-out;
  }

  /* Sweep (~1.9s), fade, then stay quiet for the rest of the 12s cycle.
     Animates transform + opacity only, so it stays off the layout path. */
  @keyframes announcement-glint {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    18% {
      transform: scaleX(1);
      opacity: 1;
    }
    28% {
      transform: scaleX(1);
      opacity: 0;
    }
    28.1%,
    100% {
      transform: scaleX(0);
      opacity: 0;
    }
  }
  [data-announcement][data-glint] .announcement-glint {
    animation: announcement-glint 12s ease-out 0.1s infinite both;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-announcement]:has(a:hover) .announcement-sweep {
      animation: none;
    }
  }
</style>

<script>
  class AnnouncementElement extends HTMLElement {
    #resize = new ResizeObserver(() => {
      const height = this.getBoundingClientRect().height
      document.documentElement.style.setProperty("--announcement-height", `${height}px`)
      document.documentElement.style.setProperty(
        "--sticky-header-height",
        `calc(4rem + ${height}px)`,
      )
    })

    #glint = () => this.setAttribute("data-glint", "")

    connectedCallback() {
      this.#resize.observe(this)
      document.addEventListener("hero-grid-pulse-complete", this.#glint)
    }

    disconnectedCallback() {
      this.#resize.disconnect()
      document.removeEventListener("hero-grid-pulse-complete", this.#glint)
    }
  }

  if (!customElements.get("effect-announcement")) {
    customElements.define("effect-announcement", AnnouncementElement)
  }
</script>
