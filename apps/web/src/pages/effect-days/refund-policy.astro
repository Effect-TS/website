---
import LegalPage from "@/components/effect-days/LegalPage.astro"
import LegalClause from "@/components/effect-days/LegalClause.astro"
import InlineLink from "@/components/effect-days/InlineLink.astro"

const LAST_UPDATED = "August 30, 2024"
---

<LegalPage
  title="Ticket Refund Policy - Effect Days"
  description="How refunds are handled for Effect Days Conference tickets: eligibility, how to request one, processing fees, and event cancellation."
  heading="Ticket Refund Policy"
  lastUpdated={LAST_UPDATED}
>
  <div class="space-y-4">
    <p class="text-base leading-relaxed text-zinc-300">
      This policy explains how refunds are handled for Effect Days Conference tickets, sold by
      Effectful Technologies Inc.
    </p>
  </div>

  <LegalClause
    title="1. General policy"
    body="All ticket sales for Effect Days Conference are final and non-refundable unless stated otherwise. Refund requests are evaluated individually and require approval from Effectful Technologies Inc."
  />
  <LegalClause
    title="2. Refund eligibility"
    body="Effectful Technologies Inc. determines who qualifies for a refund. Approved refunds may be subject to processing fees, which will be deducted from the refund amount."
  />
  <LegalClause title="3. Requesting a refund">
    <p class="text-base leading-relaxed text-zinc-400">
      To request a refund, contact the team at{" "}
      <InlineLink href="mailto:contact@effectful.co?subject=Effect Days - Refund Request">
        contact@effectful.co
      </InlineLink>{" "}
      and include your order confirmation or ticket number. Additional information may be required to
      process your request.
    </p>
  </LegalClause>
  <LegalClause
    title="4. Processing fees"
    body="If a refund is approved, processing fees may be deducted from the refund amount. Fee amounts vary by ticket type and payment method."
  />
  <LegalClause
    title="5. Timing"
    body="Refunds are issued at the discretion of Effectful Technologies Inc. and take a reasonable amount of time to process."
  />
  <LegalClause
    title="6. Event cancellation"
    body="If Effect Days Conference is canceled or rescheduled, registered attendees may be eligible for a full or partial refund."
  />
  <LegalClause
    title="7. Changes to this policy"
    body="This policy may change. The current version is always the one published on this page and shown during purchase, along with the date at the top."
  />
</LegalPage>
