---
import VisualEffects from "@/features/visual-effect/components/VisualEffects"
---

<section id="examples" class="relative w-full pb-8">
  <div class="mx-auto w-full max-w-295">
    <VisualEffects client:only="react" />
    <p
      class="mt-4 px-4 text-center font-mono text-xs font-medium tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
    >
      Inspired by Kit Langton's{" "}
      <a
        href="https://effect.kitlangton.com/"
        class="text-foreground underline decoration-foreground underline-offset-4 duration-200 hover:decoration-transparent"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visual Effect
      </a>
    </p>
    <noscript>
      <div class="mt-6 border border-zinc-800 bg-zinc-950/70 p-4 text-sm text-zinc-400">
        Interactive examples require JavaScript.
      </div>
    </noscript>
  </div>
</section>
