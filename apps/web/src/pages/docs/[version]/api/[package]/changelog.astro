---
import type { GetStaticPaths } from "astro"
import { getCollection, render, type CollectionEntry } from "astro:content"

import { isSemver } from "@website/domain/Changelog"

import GitHubLogo from "@/assets/icons/fa7-brands/github.svg"
import DocShell from "@/layouts/DocShell.astro"

interface StaticPathEntry {
  readonly params: {
    readonly version: string
    readonly package: string
  }
  readonly props: {
    readonly entry: CollectionEntry<"changelog">
  }
}

export const prerender = true

export const getStaticPaths = (async () => {
  const entries = await getCollection("changelog")
  return entries.map<StaticPathEntry>((entry) => {
    const [version, slug] = entry.id.split("/")
    return {
      params: { version: version!, package: slug! },
      props: { entry },
    }
  })
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { version, package: packageSlug } = Astro.params
const { Content, headings } = await render(entry)

const displayName = entry.data.package.replace("@effect/", "")
const versions = headings
  .filter((heading) => heading.depth === 2 && isSemver(heading.text))
  .map((heading) => ({ label: heading.text, href: `#${heading.slug}` }))
---

<DocShell
  title={`${entry.data.package} Changelog | Effect`}
  description={`Changelog for ${entry.data.package}`}
  activeSlug="api"
  version={version}
>
  <nav slot="sidebar" aria-label="Changelog navigation" data-changelog-sidebar>
    <header class="mb-4">
      <a
        href={`/docs/${version}/api/${packageSlug}`}
        class="mb-4 block font-mono text-sm font-medium tracking-wider text-foreground uppercase hover:underline"
      >
        Changelog
      </a>
      <h2 class="mb-1 font-mono text-lg font-semibold tracking-tight">{displayName}</h2>
      <p class="font-mono text-xs text-muted-foreground">{entry.data.packageVersion}</p>
    </header>

    <h3 class="mb-2 font-mono text-sm font-semibold tracking-widest text-foreground uppercase">
      Version
    </h3>
    <ul class="space-y-1">
      {
        versions.map((item) => (
          <li>
            <a
              href={item.href}
              class="block truncate rounded px-2 py-1 font-mono text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <article class="prose prose-effect max-w-4xl">
    <nav
      aria-label="Breadcrumb"
      class="mb-5 flex items-center gap-3 font-mono text-xs tracking-wider text-muted-foreground uppercase not-prose lg:mb-8"
    >
      <a
        href={`/docs/${version}/api`}
        class="text-muted-foreground transition-colors hover:text-foreground"
      >
        API Reference
      </a>
      <span aria-hidden="true">/</span>
      <a
        href={`/docs/${version}/api/${packageSlug}`}
        class="text-muted-foreground transition-colors hover:text-foreground"
      >
        {displayName}
      </a>
      <span aria-hidden="true">/</span>
      <span>Changelog</span>
    </nav>

    <h1 class="mb-4! md:mb-6! font-mono">{entry.data.package}</h1>

    <div
      class="not-prose mb-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm text-muted-foreground"
    >
      <a
        href={entry.data.sourceUrl}
        target="_blank"
        class="transition-colors hover:text-foreground"
      >
        <GitHubLogo class="mr-1 inline size-4" aria-hidden="true" /> Source
      </a>
    </div>

    <div class="changelog-body">
      <Content />
    </div>
  </article>
</DocShell>

<style is:global>
  .changelog-body :is(h2, h3) {
    scroll-margin-top: 6rem;
  }
</style>
