---
// Permanent site-wide banner sharing the navbar's sticky wrapper. Not
// dismissible. Its glow waits for the hero grid pulse, then expands once and stays.
---

<effect-announcement
  data-announcement
  role="region"
  aria-label="Announcement"
  class="group relative flex min-h-10 items-center justify-center border-b border-zinc-700/60 bg-zinc-900 px-10 py-2 text-zinc-100 transition-colors has-[a:hover]:bg-zinc-800"
>
  <span
    aria-hidden="true"
    class="announcement-glow pointer-events-none absolute inset-x-0 -bottom-px h-px"
  ></span>

  <a
    href="/effect-days"
    aria-label="Effect Days 2026: December 9–11 in Livorno, Italy"
    class="absolute inset-0"></a>

  <div
    class="pointer-events-none flex min-w-0 items-center justify-center gap-2 whitespace-nowrap font-mono text-[12.5px] font-normal tracking-wider text-zinc-300 uppercase transition-colors group-has-[a:hover]:text-white"
  >
    <span class="text-zinc-400">//</span>
    <span>EFFECT DAYS 2026<span class="hidden sm:inline"> · LIVORNO, DEC 9–11</span></span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="currentColor"
      class="ri-arrow-right-line shrink-0 text-zinc-400"
      aria-hidden="true"
    >
      <path d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z" />
    </svg>
  </div>
</effect-announcement>

<style is:global>
  @keyframes announcement-glow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  [data-announcement] .announcement-glow {
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.9) 50%, transparent 100%);
    transform-origin: center;
    transform: scaleX(0);
    opacity: 0;
  }

  [data-announcement][data-glow] .announcement-glow {
    animation: announcement-glow 1200ms ease-in-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-announcement] .announcement-glow {
      animation: none;
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>

<script>
  class AnnouncementElement extends HTMLElement {
    #glow = () => this.setAttribute("data-glow", "")

    #ready = () => {
      const pulse = document.querySelector<HTMLElement>("[data-hero-grid-pulse]")
      if (!pulse || pulse.hasAttribute("data-complete")) this.#glow()
    }

    #resize = new ResizeObserver(() => {
      const height = this.getBoundingClientRect().height
      document.documentElement.style.setProperty("--announcement-height", `${height}px`)
      document.documentElement.style.setProperty(
        "--sticky-header-height",
        `calc(4rem + ${height}px)`,
      )
    })

    connectedCallback() {
      this.#resize.observe(this)
      document.addEventListener("hero-grid-pulse-complete", this.#glow, { once: true })
      if (document.readyState === "complete") this.#ready()
      else window.addEventListener("load", this.#ready, { once: true })
    }

    disconnectedCallback() {
      this.#resize.disconnect()
      document.removeEventListener("hero-grid-pulse-complete", this.#glow)
      window.removeEventListener("load", this.#ready)
    }
  }

  if (!customElements.get("effect-announcement")) {
    customElements.define("effect-announcement", AnnouncementElement)
  }
</script>
