---
import { Flag } from "@lucide/astro"

interface Props {
  number: number
  total: number
  title: string
}

const { number, total, title } = Astro.props
---

<section class="tutorial-checkpoint not-prose my-8 rounded-lg border p-5">
  <div
    class="tutorial-checkpoint-label flex items-center gap-2 text-xs font-semibold tracking-wider uppercase"
  >
    <Flag size={15} aria-hidden="true" />
    <span>Checkpoint {number} of {total}</span>
  </div>

  <p class="mt-3 mb-0 text-base font-semibold text-zinc-950 dark:text-white">
    {title}
  </p>
  <div class="mt-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
    <slot />
  </div>
</section>

<style>
  .tutorial-checkpoint {
    border-color: var(--docs-tutorial-border);
    background: var(--docs-tutorial-surface);
  }

  .tutorial-checkpoint-label {
    color: var(--docs-tutorial-text);
  }
</style>
