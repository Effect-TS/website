---
import type { GetStaticPaths } from "astro"
import { getCollection, type CollectionEntry } from "astro:content"

import ApiMobileNavigation from "@/features/api-reference/ApiMobileNavigation.astro"
import ApiSidebarNav from "@/features/api-reference/ApiSidebarNav.astro"
import { versionIndexDigest } from "@/features/api-reference/cache-key"
import { compareGroups, packageGroup } from "@/features/api-reference/package-groups"
import PackageIndex from "@/features/api-reference/PackageIndex.astro"
import { resolveApiReferenceOpenGraph } from "@/features/api-reference/open-graph"
import DocShell from "@/layouts/DocShell.astro"
import { DOCS_VERSIONS } from "@/lib/versions"

export const prerender = true

export const getStaticPaths = (async () => {
  const entries = await getCollection("apiReference")

  const entriesByVersion = entries.reduce((groups, entry) => {
    const group = groups.get(entry.data.version)
    if (group === undefined) {
      groups.set(entry.data.version, [entry])
    } else {
      group.push(entry)
    }
    return groups
  }, new Map<string, Array<CollectionEntry<"apiReference">>>())

  return Array.from(entriesByVersion).map(([version, versionEntries]) => ({
    params: { version },
    props: { entries: versionEntries, version },
    // This page renders only the version's package grid, so the package-level
    // metadata digest is the complete set of inputs.
    cacheKey: versionIndexDigest(entries, version),
  }))
}) satisfies GetStaticPaths

const { entries, version } = Astro.props
const openGraph = resolveApiReferenceOpenGraph(
  `docs/${version}/api`,
  entries.map((entry) => entry.data),
)

const packageEntries = Map.groupBy(entries, (entry) => entry.data.packageName)
const packages = Array.from(packageEntries).map(([name, modules]) => {
  const first = modules[0]

  if (first === undefined) {
    throw new Error(`Package "${name}" has no modules`)
  }

  const displayName = name.replace("@effect/", "")
  const entries = modules.toSorted((left, right) =>
    left.data.modulePath.localeCompare(right.data.modulePath),
  )
  const group = packageGroup(version, name)

  return {
    ...first.data,
    displayName,
    entries,
    group,
  }
})
const groupedPackages = Map.groupBy(packages, (info) => info.group)
const sidebarGroups = Array.from(groupedPackages)
  .map(([name, packages]) => ({ name, packages }))
  .toSorted((left, right) => compareGroups(left.name, right.name))
const sidebarSections = [
  {
    groups: sidebarGroups.map((group) => ({
      name: group.name,
      open: true,
      links: group.packages.map((info) => ({
        href: `/docs/${version}/api/${info.displayName}`,
        label: info.displayName,
        data: { "data-package-link": info.packageSlug },
      })),
    })),
  },
]
const mobileVersions = DOCS_VERSIONS.map(({ value, label }) => ({
  href: `/docs/${value}/api`,
  label,
  selected: value === version,
}))
const mobilePackages = [
  { disabled: true, href: "", label: "Packages", selected: true },
  ...packages
    .toSorted((left, right) => left.displayName.localeCompare(right.displayName))
    .map((info) => ({
      href: `/docs/${version}/api/${info.packageSlug}`,
      label: info.displayName,
    })),
]
---

<DocShell
  title={`Effect ${version} API Reference`}
  description={openGraph?.description}
  ogImageVersion={versionIndexDigest(entries, version)}
  activeSlug="api"
  version={version}
>
  <ApiMobileNavigation
    slot="mobile-nav"
    version={version}
    versions={mobileVersions}
    packages={mobilePackages}
  />

  <nav slot="sidebar" aria-label="API reference navigation" data-api-sidebar>
    <a
      href={`/docs/${version}/api`}
      aria-current="page"
      class="mb-6 block font-mono text-sm font-medium tracking-wider text-foreground uppercase hover:underline"
    >
      API Reference
    </a>

    <ApiSidebarNav sections={sidebarSections} />
  </nav>

  <article class="prose prose-effect max-w-4xl">
    <h1 class="mb-4! md:mb-6!">API Reference</h1>

    <PackageIndex
      groups={sidebarGroups.map((group) => ({
        name: group.name,
        packages: group.packages.map((info) => ({
          description: info.packageDescription,
          href: `/docs/${version}/api/${info.packageSlug}`,
          meta: `${info.packageModuleCount} modules`,
          name: info.packageName,
        })),
      }))}
    />
  </article>
</DocShell>
