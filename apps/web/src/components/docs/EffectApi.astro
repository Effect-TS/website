---
import { ArrowRight, Braces } from "@lucide/astro"

interface Props {
  name: string
  href?: string
}

const { name, href } = Astro.props
---

<aside
  class="effect-api not-prose my-5 overflow-hidden rounded-lg border border-violet-200 bg-violet-50/50 dark:border-violet-900 dark:bg-violet-950/25"
  aria-label={`${name} API`}
>
  <header
    class="flex flex-wrap items-center justify-between gap-3 border-b border-violet-200/80 px-4 py-3 dark:border-violet-900"
  >
    <div class="flex items-center gap-2 text-violet-800 dark:text-violet-200">
      <Braces class="size-4" aria-hidden="true" />
      <code class="font-mono text-sm font-semibold">{name}</code>
    </div>

    {
      href && (
        <a
          href={href}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-violet-700 no-underline transition-colors hover:text-violet-950 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500 dark:text-violet-300 dark:hover:text-white"
        >
          API reference
          <ArrowRight class="size-3.5" aria-hidden="true" />
        </a>
      )
    }
  </header>

  <div class="effect-api-description px-4 py-3 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
    <slot />
  </div>
</aside>

<style>
  .effect-api:has(+ .effect-api) {
    margin-bottom: 0;
    border-bottom-width: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
  }

  .effect-api + .effect-api {
    margin-top: 0;
    border-top-right-radius: 0;
    border-top-left-radius: 0;
  }

  .effect-api-description :global(> :first-child) {
    margin-top: 0;
  }

  .effect-api-description :global(> :last-child) {
    margin-bottom: 0;
  }

  .effect-api-description :global(p) {
    margin-block: 0.4rem;
  }

  .effect-api-description :global(code) {
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-violet-500) 10%, transparent);
    padding: 0.1rem 0.3rem;
    font-size: 0.875em;
  }
</style>
