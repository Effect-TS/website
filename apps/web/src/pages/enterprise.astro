<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-template]").forEach((button) => {
    const label = button.querySelector("[data-copy-label]")
    const idle = button.querySelector("[data-copy-idle]")
    const done = button.querySelector("[data-copy-done]")
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyTemplate ?? "")
      } catch {
        return
      }
      if (label) label.textContent = "Copied"
      idle?.classList.add("hidden")
      done?.classList.remove("hidden")
      setTimeout(() => {
        if (label) label.textContent = "Copy proposal template"
        idle?.classList.remove("hidden")
        done?.classList.add("hidden")
      }, 1500)
    })
  })
</script>
