---
// The reader interrupts to ask the question they're probably already thinking.
---

<div class="not-prose my-6 flex items-start gap-3">
  <span
    aria-hidden="true"
    class="flex size-10 shrink-0 items-center justify-center rounded-full border border-border bg-card text-xl"
  >
    🙋
  </span>
  <div
    class="relative min-w-0 rounded-lg border border-border bg-card/60 px-4 py-3 text-base italic leading-relaxed text-prose-foreground"
  >
    <span class="sr-only">You ask:</span>
    <slot />
  </div>
</div>
