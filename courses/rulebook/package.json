{
  "name": "rulebook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "doctor": "tsx tools/doctor.ts",
    "viewer": "tsx tools/viewer.ts",
    "receiver": "tsx tools/receiver.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "cli": "tsx src/cli/main.ts",
    "checkpoint": "tsx tools/checkpoint.ts",
    "lesson": "tsx tools/lesson.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "fmt": "dprint fmt"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/sql-sqlite-node": "4.1.1",
    "effect": "4.1.1"
  },
  "devDependencies": {
    "@dprint/json": "0.25.2",
    "@dprint/typescript": "0.96.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "22.20.5",
    "dprint": "0.64.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
