---
import { ArrowUpRight } from "@lucide/astro"
import { FormattedDate } from "@/components/ui/FormattedDate"
import type { Module } from "@/features/module-of-the-week/domain"

interface Props {
  readonly module: Module
  /** The latest module: a larger title and its excerpt. */
  readonly featured?: boolean | undefined
}

const { module, featured = false } = Astro.props
const { post, number, title } = module
const video = post.data.video

const linkClass =
  "group/link inline-flex items-center gap-1 text-sm text-zinc-400 no-underline transition-colors hover:text-white hover:no-underline"
const arrowClass =
  "size-3.5 transition-transform motion-safe:group-hover/link:translate-x-0.5 motion-safe:group-hover/link:-translate-y-0.5"
---

<div class="flex items-baseline justify-between gap-4 font-mono text-xs text-zinc-400">
  <div class="flex min-w-0 items-baseline gap-3">
    <span class="shrink-0 font-medium tabular-nums">{String(number).padStart(2, "0")}</span>
    {post.data.packageName && <span class="truncate">from "{post.data.packageName}"</span>}
  </div>
  <FormattedDate date={post.data.date} className="shrink-0 whitespace-nowrap tabular-nums" />
</div>
<div>
  <h3
    class:list={[
      "leading-snug font-semibold text-balance text-white",
      featured ? "text-lg" : "text-base",
    ]}
  >
    {title}
  </h3>
  {
    featured && (
      <p class="mt-2 text-base leading-relaxed text-pretty text-zinc-400">{post.data.excerpt}</p>
    )
  }
</div>
<div class:list={["flex flex-wrap items-center gap-x-4 gap-y-2", featured && "mt-auto pt-2"]}>
  {
    video && (
      <a
        href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
        class={linkClass}
      >
        Video
        <span class="sr-only">: {title} on YouTube (opens in a new tab)</span>
        <ArrowUpRight class={arrowClass} aria-hidden="true" />
      </a>
    )
  }
  <a href={`/blog/${post.id}`} class={linkClass}>
    Blog post
    <span class="sr-only">: {title}</span>
    <ArrowUpRight class={arrowClass} aria-hidden="true" />
  </a>
</div>
