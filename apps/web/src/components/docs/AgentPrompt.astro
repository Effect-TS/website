---
import { Bot, Check, Copy } from "@lucide/astro"

interface Props {
  label: string
  prompt: string
}

const { label, prompt } = Astro.props
---

<copy-agent-prompt class="not-prose my-5 block">
  <button
    type="button"
    data-role="copy"
    data-label={label}
    class="inline-flex min-h-11 cursor-pointer items-center gap-2.5 rounded-md border border-zinc-300 bg-white px-4 py-2.5 text-base font-medium text-zinc-800 transition-colors hover:border-zinc-500 hover:bg-zinc-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-500 dark:hover:bg-zinc-800"
  >
    <Bot size={18} aria-hidden="true" />
    <span data-role="label">{label}</span>
    <Copy data-role="copy-icon" size={17} aria-hidden="true" />
    <Check data-role="check-icon" class="hidden" size={17} aria-hidden="true" />
  </button>
  <textarea data-role="prompt" hidden readonly aria-hidden="true">{prompt}</textarea>
  <span data-role="status" class="sr-only" role="status" aria-live="polite"></span>
</copy-agent-prompt>

<script>
  const COPY_RESET_TIMEOUT_MS = 2000

  class CopyAgentPromptElement extends HTMLElement {
    #resetTimeout: ReturnType<typeof setTimeout> | undefined

    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("[data-role='copy']")
      button?.addEventListener("click", this.#copy)
    }

    disconnectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("[data-role='copy']")
      button?.removeEventListener("click", this.#copy)
      if (this.#resetTimeout !== undefined) clearTimeout(this.#resetTimeout)
    }

    #setFeedback = (state: "idle" | "copied" | "error") => {
      const button = this.querySelector<HTMLButtonElement>("[data-role='copy']")
      const label = this.querySelector<HTMLElement>("[data-role='label']")
      const copyIcon = this.querySelector<HTMLElement>("[data-role='copy-icon']")
      const checkIcon = this.querySelector<HTMLElement>("[data-role='check-icon']")
      const status = this.querySelector<HTMLElement>("[data-role='status']")
      if (!button || !label || !copyIcon || !checkIcon || !status) return

      const copied = state === "copied"
      label.textContent =
        state === "copied"
          ? "Prompt copied"
          : state === "error"
            ? "Could not copy prompt"
            : (button.dataset.label ?? "Copy prompt")
      copyIcon.classList.toggle("hidden", copied)
      checkIcon.classList.toggle("hidden", !copied)
      status.textContent = state === "idle" ? "" : label.textContent
    }

    #copy = async () => {
      const prompt = this.querySelector<HTMLTextAreaElement>("[data-role='prompt']")
      if (!prompt) return

      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(prompt.value)
        } else {
          const fallback = document.createElement("textarea")
          fallback.value = prompt.value
          fallback.style.position = "fixed"
          fallback.style.opacity = "0"
          document.body.append(fallback)
          fallback.select()
          const copied = document.execCommand("copy")
          fallback.remove()
          if (!copied) throw new Error("Copy failed")
        }
        this.#showTemporaryFeedback("copied")
      } catch {
        this.#showTemporaryFeedback("error")
      }
    }

    #showTemporaryFeedback = (state: "copied" | "error") => {
      this.#setFeedback(state)
      if (this.#resetTimeout !== undefined) clearTimeout(this.#resetTimeout)
      this.#resetTimeout = setTimeout(() => {
        this.#setFeedback("idle")
        this.#resetTimeout = undefined
      }, COPY_RESET_TIMEOUT_MS)
    }
  }

  if (!customElements.get("copy-agent-prompt")) {
    customElements.define("copy-agent-prompt", CopyAgentPromptElement)
  }
</script>
