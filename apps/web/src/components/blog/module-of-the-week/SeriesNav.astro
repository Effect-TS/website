---
import Eyebrow from "@/components/ui/Eyebrow.astro"

interface Props {
  readonly currentId: string
  readonly modules: ReadonlyArray<{ readonly id: string; readonly title: string }>
}

const { currentId, modules }: Props = Astro.props

const shortTitle = (title: string) => title.replace(/^Module of the Week\s*-\s*/, "")
---

<nav aria-label="Module of the Week series" class="rounded-md border border-border bg-card/40 p-5">
  <Eyebrow as="p" class="text-xs">
    <a href="/module-of-the-week" class="transition-colors hover:text-foreground">
      Module of the Week
    </a>
  </Eyebrow>
  <ol class="mt-3 flex flex-col gap-1">
    {
      modules.map((module, index) => {
        const current = module.id === currentId
        return (
          <li>
            <a
              href={`/blog/${module.id}`}
              aria-current={current ? "page" : undefined}
              class:list={[
                "flex gap-3 rounded-md px-2 py-1.5 text-sm leading-snug transition-colors",
                current
                  ? "bg-muted font-medium text-foreground"
                  : "text-muted-foreground hover:text-foreground",
              ]}
            >
              <span class="font-mono tabular-nums">{index + 1}</span>
              <span>{shortTitle(module.title)}</span>
            </a>
          </li>
        )
      })
    }
  </ol>
</nav>
