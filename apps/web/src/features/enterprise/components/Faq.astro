---
import FrequentlyAskedQuestions from "@/components/landing/blocks/FrequentlyAskedQuestions.astro"
import ButtonLink from "@/components/ui/ButtonLink.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"

// Answers are HTML: the shared FAQ block renders them as is.
const faqs = [
  {
    question: "Can we try Effect in part of an existing application?",
    answer:
      "<p>Yes. Start with a bounded use case and assess how it fits your existing code, team, and delivery process.</p>",
  },
  {
    question: "What support can our company arrange?",
    answer:
      "<p>Contact us to discuss your needs. We can talk through company support, private communication, and introductions to adoption partners. Any service levels and coverage are defined in an agreement.</p>",
  },
  {
    question: "Where can individual developers ask questions?",
    answer: `<p>Join our <a href="https://discord.gg/effect-ts" target="_blank" rel="noopener noreferrer">public Discord</a>. It is open to everyone, including engineers using Effect at work.</p>`,
  },
]
---

<section
  id="faq"
  class="relative w-full scroll-mt-16 border-t border-border py-24 md:pt-40 md:pb-24"
>
  <div class="mx-auto w-full max-w-295">
    <div class="flex flex-col lg:flex-row">
      <div class="w-full px-4 lg:w-1/2">
        <Eyebrow class="mb-3">// FAQ</Eyebrow>
        <h2 class="text-2xl leading-tighter font-semibold text-foreground md:text-3xl">
          Adopting Effect
        </h2>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
          Something we haven't covered? Ask us directly.
        </p>
        <ButtonLink href="#contact" class="mt-6">Talk to the Effect team</ButtonLink>
      </div>
      <div class="mt-8 w-full px-4 lg:mt-0 lg:w-1/2 lg:pt-28 lg:pr-4 lg:pl-3">
        <FrequentlyAskedQuestions items={faqs} />
      </div>
    </div>
  </div>
</section>
