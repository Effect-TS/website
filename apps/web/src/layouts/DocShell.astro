---
import DocsNavigation from "@/components/navigation/DocsNavigation.astro"
import Footer from "@/components/Footer.astro"
import SidebarScrollMemory from "@/components/ui/sidebar/SidebarScrollMemory.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Main from "@/components/layout/Main.astro"
import StickySubnav from "@/components/navigation/StickySubnav.astro"
import type { DocsNavSection } from "@/lib/docs-sections"
import type { NavigationActiveSlug } from "@/lib/navigation"

/**
 * Three-column documentation shell (sidebar / main / table-of-contents) shared
 * by Docs and API Reference. Columns adapt to the slots that are filled:
 *   - `sidebar` present  → left rail from `lg`
 *   - `toc` present      → right rail from `xl`
 *   - `mobile-nav`       → rendered above the grid (page supplies its own)
 * The shell owns the desktop rail positioning, scrolling, padding, and the main
 * content spacing so Docs and API Reference cannot drift apart.
 * See apps/web/DESIGN.md.
 */
interface Props {
  readonly title?: string | undefined
  readonly description?: string | undefined
  readonly activeSlug?: NavigationActiveSlug | undefined
  readonly ogImageVersion?: string | undefined
  readonly version?: string | undefined
  readonly section?: DocsNavSection | undefined
}

const { title, description, activeSlug = "docs", ogImageVersion, version, section } = Astro.props

const navSection: DocsNavSection = section ?? (activeSlug === "api" ? "api" : "guides")

const hasSidebar = Astro.slots.has("sidebar")
const hasToc = Astro.slots.has("toc")

const gridCols = hasToc
  ? "lg:grid-cols-[240px_1fr] xl:grid-cols-[240px_1fr_240px]"
  : "lg:grid-cols-[240px_1fr]"
const railClass =
  "sticky top-[var(--sticky-header-height)] max-h-[calc(100vh_-_var(--sticky-header-height))] overflow-y-auto px-4 py-8"
---

<BaseLayout
  {...title ? { title } : undefined}
  {...description ? { description } : undefined}
  {...ogImageVersion ? { ogImageVersion } : undefined}
>
  <DocsNavigation section={navSection} version={version} />

  <div class="relative w-full">
    <StickySubnav><slot name="mobile-nav" /></StickySubnav>

    <div class:list={["mx-auto grid w-full max-w-352 grid-cols-1", gridCols]}>
      {
        hasSidebar && (
          <aside aria-label="Documentation sidebar" class="hidden border-r border-border lg:block">
            <div data-doc-sidebar-rail class={railClass}>
              <slot name="sidebar" />
            </div>
          </aside>
        )
      }

      <Main class="@container/prose min-w-0 px-6 py-12 lg:px-12 lg:py-16">
        <slot />
      </Main>

      {
        hasToc && (
          <aside aria-label="Page contents" class="hidden border-l border-border xl:block">
            <div class={railClass}>
              <slot name="toc" />
            </div>
          </aside>
        )
      }
    </div>

    <Footer />
  </div>

  {hasSidebar && <SidebarScrollMemory storageKey={`docShellSidebarScroll:${activeSlug}`} />}
</BaseLayout>
