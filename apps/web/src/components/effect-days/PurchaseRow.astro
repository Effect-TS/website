---
import { ArrowUpRight } from "@lucide/astro"

/**
 * A full-width purchase row inside a ticket card: the payer label, the price,
 * and a trailing arrow that marks the row as leaving for Stripe.
 */
interface Props {
  readonly href: string
  readonly label: string
  readonly price: string
  readonly ariaLabel: string
}

const { href, label, price, ariaLabel } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  class="inline-flex w-full cursor-pointer items-center justify-between gap-2 rounded-md inset-ring inset-ring-border-strong bg-card/50 px-4 py-4 text-base font-medium text-foreground transition-all hover:bg-muted hover:inset-ring-zinc-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground md:px-6"
>
  <span class="flex items-baseline gap-2">
    {label}
    {/* The separator sits back from the words it divides. */}
    <span class="text-subtle-foreground" aria-hidden="true">·</span>
    <span class="text-base font-semibold">{price}</span>
  </span>
  <ArrowUpRight class="shrink-0 text-muted-foreground" aria-hidden="true" />
</a>
