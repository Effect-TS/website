---
import ArrowLink from "@/components/enterprise/ArrowLink.astro"
import GroupBar from "@/components/enterprise/GroupBar.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"
import {
  CHANGELOG_HREF,
  POLICY_UPDATED,
  RELEASE_COLUMNS,
  RELEASES,
} from "@/features/enterprise/copy"
---

<GroupBar>
  <Fragment slot="label">Release lines</Fragment>
  <ArrowLink href={CHANGELOG_HREF}>Changelog</ArrowLink>
</GroupBar>

<div class="hidden overflow-x-auto border border-t-0 border-border md:block">
  <table class="w-full text-left text-sm">
    <thead class="bg-card">
      <tr>
        {
          RELEASE_COLUMNS.map((column) => (
            <th
              scope="col"
              class="px-4 py-3 align-bottom font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase"
            >
              {column}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {
        RELEASES.map((release) => (
          <tr class="align-middle">
            <th scope="row" class="px-4 py-4 font-mono text-base font-semibold text-foreground">
              {release.line}
            </th>
            <td class="px-4 py-4">
              <span class="inline-flex items-center gap-2 text-sm font-medium whitespace-nowrap text-foreground">
                <span
                  aria-hidden="true"
                  class:list={[
                    "size-2 rounded-full",
                    release.current ? "bg-brand" : "border border-subtle-foreground bg-transparent",
                  ]}
                />
                {release.status}
              </span>
            </td>
            <td class="px-4 py-4 text-prose-foreground">{release.stable}</td>
            <td class="px-4 py-4">
              <ArrowLink href={release.upgrade.href} class="whitespace-nowrap">
                {release.upgrade.label}
              </ArrowLink>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="space-y-px border border-t-0 border-border bg-border md:hidden">
  {
    RELEASES.map((release) => (
      <dl class="divide-y divide-border bg-background">
        <div class="flex items-center justify-between px-4 py-3">
          <dt class="font-mono text-base font-semibold text-foreground">{release.line}</dt>
          <dd class="inline-flex items-center gap-2 text-sm font-medium text-foreground">
            <span
              aria-hidden="true"
              class:list={[
                "size-2 rounded-full",
                release.current ? "bg-brand" : "border border-subtle-foreground bg-transparent",
              ]}
            />
            {release.status}
          </dd>
        </div>
        <div class="flex items-center justify-between gap-4 px-4 py-3 text-sm">
          <Eyebrow as="dt" class="text-xs">
            Stable since
          </Eyebrow>
          <dd class="text-prose-foreground">{release.stable}</dd>
        </div>
        <div class="px-4 py-3">
          <ArrowLink href={release.upgrade.href}>{release.upgrade.label}</ArrowLink>
        </div>
      </dl>
    ))
  }
</div>

<Eyebrow class="mt-3 text-right text-xs">Last updated · {POLICY_UPDATED}</Eyebrow>
