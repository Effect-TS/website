---
import { Info, Lightbulb, TriangleAlert, OctagonAlert } from "@lucide/astro"

type AsideType = "note" | "tip" | "caution" | "danger"

interface Props {
  type?: AsideType
  title?: string
}

const { type = "note", title } = Astro.props

const iconMap = {
  note: Info,
  tip: Lightbulb,
  caution: TriangleAlert,
  danger: OctagonAlert,
}

const defaultTitles: Record<AsideType, string> = {
  note: "Note",
  tip: "Tip",
  caution: "Caution",
  danger: "Danger",
}

const label = title ?? defaultTitles[type]
const Icon = iconMap[type]
---

<aside class:list={["aside", `aside--${type}`]} aria-label={label}>
  <p class="aside-title" aria-hidden="true">
    <Icon aria-hidden="true" size={16} stroke-width={2.5} />
    {label}
  </p>
  <div class="aside-content">
    <slot />
  </div>
</aside>

<style>
  .aside {
    /* Per-type accent drives every color below; tint sets bg strength. */
    --aside-accent: var(--muted-foreground);
    --aside-tint: 7%;

    border: 1px solid color-mix(in oklab, var(--aside-accent) 22%, transparent);
    border-left: 3px solid var(--aside-accent);
    border-radius: var(--radius-md);
    background-color: color-mix(in oklab, var(--aside-accent) var(--aside-tint), var(--background));
    padding: 1rem 1.125rem;
    margin-block: 1.5rem;
  }

  .aside-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: normal;
    margin: 0 0 0.5rem;
    color: var(--aside-accent);
  }

  .aside-title :global(svg) {
    transform: translateY(-1px);
  }

  .aside-content :global(> :first-child) {
    margin-top: 0;
  }
  .aside-content :global(> :last-child) {
    margin-bottom: 0;
  }

  /* Light-theme accents (Tailwind 500, oklch — matches @theme scale). */
  .aside--note {
    --aside-accent: oklch(0.623 0.214 259.815); /* blue-500 */
  }
  .aside--tip {
    --aside-accent: oklch(0.696 0.17 162.48); /* emerald-500 (brand) */
  }
  .aside--caution {
    --aside-accent: oklch(0.769 0.188 70.08); /* amber-500 */
  }
  .aside--danger {
    --aside-accent: oklch(0.637 0.237 25.331); /* red-500 */
  }

  /* Dark theme: lighter accents (Tailwind 400) + stronger tint for contrast. */
  :global(.dark) .aside {
    --aside-tint: 14%;
  }
  :global(.dark) .aside--note {
    --aside-accent: oklch(0.707 0.165 254.624); /* blue-400 */
  }
  :global(.dark) .aside--tip {
    --aside-accent: oklch(0.765 0.177 163.223); /* emerald-400 */
  }
  :global(.dark) .aside--caution {
    --aside-accent: oklch(0.828 0.189 84.429); /* amber-400 */
  }
  :global(.dark) .aside--danger {
    --aside-accent: oklch(0.704 0.191 22.216); /* red-400 */
  }
</style>
