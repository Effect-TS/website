---
import { cn } from "@/lib/utils"

/**
 * The bordered dark tile used across the Effect Days pages. Pass `class` to
 * override the padding or border (e.g. the featured ticket card), merged with
 * `cn` so later utilities win.
 */
interface Props {
  readonly class?: string | undefined
}

const { class: className } = Astro.props
---

<div class={cn("border border-zinc-800 bg-zinc-950 p-6", className)}>
  <slot />
</div>
