---
import { CircleAlert } from "@lucide/astro"

interface Props {
  title?: string
}

const { title } = Astro.props
const hasTitleSlot = Astro.slots.has("title")
---

<section
  class="not-prose my-8 rounded-lg border border-amber-200 bg-amber-50/60 p-5 dark:border-amber-900 dark:bg-amber-950/30"
  aria-label="Pain point"
>
  <div
    class="flex items-center gap-2 text-xs font-semibold tracking-wider text-amber-700 uppercase dark:text-amber-300"
  >
    <CircleAlert size={15} aria-hidden="true" />
    <span>Pain point</span>
  </div>

  {
    hasTitleSlot ? (
      <p class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-100">
        <slot name="title" />
      </p>
    ) : title ? (
      <p class="mt-2 text-base font-semibold text-zinc-950 dark:text-zinc-100">{title}</p>
    ) : null
  }

  <div class="mt-2 space-y-3 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
    <slot />
  </div>
</section>
