---
import { Image } from "astro:assets"
import { getCollection, getEntries, render } from "astro:content"
import { ArrowRightIcon, ArrowUpRightIcon, ChevronLeftIcon, ChevronRightIcon } from "@lucide/astro"
import LinkedInLogo from "@/assets/logos/linkedin/LinkedIn.svg"
import TwitterLogo from "@/assets/logos/twitter/TwitterWhite.svg"
import CopyLinkButton from "@/components/blog/CopyLinkButton"
import GridBackground from "@/components/GridBackground.astro"
import TableOfContents from "@/components/blog/TableOfContents"
import PageLayout from "@/layouts/PageLayout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const [tags, authors, allPosts] = await Promise.all([
  getEntries(post.data.tags),
  getEntries(post.data.authors),
  getCollection("blog"),
])

const avatars = import.meta.glob<{ default: ImageMetadata }>("../../assets/authors/*.png", {
  eager: true,
})

const sortedPosts = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id)
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null
const nextPost =
  currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null

const sortedTags = [...tags].sort((a, b) => a.data.name.localeCompare(b.data.name))

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
}

function authorAvatar(id: string): ImageMetadata | undefined {
  return avatars[`../../assets/authors/${id}.png`]?.default
}

const proseClass =
  "prose prose-zinc dark:prose-invert max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-14 prose-h2:mb-3 prose-h3:mt-8 prose-h3:mb-4 prose-h3:tracking-normal prose-h4:mt-7 prose-h4:mb-2.5 prose-h4:tracking-normal prose-p:my-5 prose-p:text-[1.0625rem] prose-p:leading-[1.6] prose-a:text-zinc-900 prose-a:underline prose-a:decoration-zinc-300 prose-a:underline-offset-4 prose-a:transition-colors prose-a:hover:no-underline prose-strong:text-zinc-900 prose-code:rounded-md prose-code:bg-zinc-200/60 prose-code:px-2 prose-code:py-1 prose-code:font-mono prose-code:text-sm prose-code:text-zinc-800 prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-xl prose-ul:my-5 prose-ol:my-5 prose-li:my-0 prose-li:text-[1.0625rem] prose-li:leading-[1.6] prose-li:marker:text-zinc-400 prose-blockquote:my-10 prose-blockquote:border-none prose-blockquote:p-0 prose-blockquote:not-italic prose-blockquote:font-semibold prose-blockquote:text-[1.5rem] prose-blockquote:leading-[1.33] prose-blockquote:tracking-[-0.012em] prose-blockquote:text-zinc-900 [&_blockquote_p]:text-zinc-700 dark:prose-blockquote:text-zinc-200 dark:[&_blockquote_p]:text-zinc-400 prose-figure:my-12 prose-figcaption:mt-2 prose-figcaption:text-sm prose-figcaption:text-zinc-500 prose-table:my-8 prose-table:text-base prose-th:text-left prose-th:font-semibold prose-th:text-zinc-900 prose-th:tracking-normal prose-td:text-zinc-700 prose-hr:my-12 prose-hr:border-zinc-200 dark:prose-p:text-zinc-400 dark:prose-li:text-zinc-400 dark:prose-a:text-zinc-200 dark:prose-a:decoration-zinc-400 dark:prose-strong:text-zinc-200 dark:prose-code:bg-zinc-800 dark:prose-code:text-zinc-200 dark:prose-li:marker:text-zinc-500 dark:prose-figcaption:text-zinc-400 dark:prose-th:text-zinc-200 dark:prose-td:text-zinc-400 dark:prose-hr:border-zinc-800"

const shareShellClass =
  "inline-flex h-8 w-8 items-center justify-center rounded-md border border-zinc-300 text-zinc-700 transition-colors hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-white dark:hover:text-white"
---

<PageLayout
  title={`${post.data.title} | Effect Blog`}
  description={post.data.excerpt}
  activeSlug="blog"
  themeable
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <div class="blog-post-grid-offset relative h-full">
        <GridBackground />
      </div>

      <div aria-hidden="true" class="absolute inset-0">
        <div
          class="absolute inset-0 opacity-100 transition-opacity duration-[250ms] ease-out dark:opacity-0"
          style="background: linear-gradient(to bottom, #ffffff 0%, transparent 20%, transparent 60%, #ffffff 100%);"
        >
        </div>
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-[250ms] ease-out dark:opacity-100"
          style="background: linear-gradient(to bottom, #09090b 0%, transparent 20%, transparent 60%, #09090b 100%);"
        >
        </div>
      </div>

      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-[400px] opacity-0 dark:opacity-100"
        style="background: radial-gradient(ellipse 50% 80% at 70% -20%, rgb(255 255 255 / 0.12) 0%, transparent 50%);"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-295 px-4">
      <nav
        aria-label="Breadcrumb"
        class="flex flex-wrap items-center gap-x-3 gap-y-2 pt-16 pb-1 font-mono text-sm tracking-wider uppercase md:pt-24"
      >
        <a
          href="/blog"
          class="text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >Blog</a
        >
        <span class="text-zinc-400 dark:text-zinc-500" aria-hidden="true">//</span>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          {
            sortedTags.map((tag) => (
              <a
                href={`/blog?category=${tag.id}`}
                class="text-zinc-800 transition-colors hover:text-zinc-950 dark:text-zinc-200 dark:hover:text-white"
              >
                {tag.data.name}
              </a>
            ))
          }
        </div>
      </nav>

      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-x-6">
        <div class="pt-3 pb-20 md:col-span-8">
          <h1
            class="leading-tighter text-3xl font-bold tracking-tight text-zinc-900 md:text-4xl dark:text-white"
          >
            {post.data.title}
          </h1>
          <p class="mt-4 text-base leading-relaxed text-zinc-600 md:text-lg dark:text-zinc-400">
            {post.data.excerpt}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4 md:hidden">
            {
              authors.map((author) => {
                const avatar = authorAvatar(author.id)
                return (
                  <a
                    href={author.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/byline flex items-center gap-3 no-underline"
                  >
                    {avatar && (
                      <Image
                        src={avatar}
                        alt={author.data.name}
                        class="h-10 w-10 rounded-md object-cover"
                      />
                    )}
                    <span class="flex min-w-0 flex-col">
                      <span class="truncate text-base font-medium text-zinc-800 group-hover/byline:underline dark:text-zinc-200">
                        {author.data.name}
                      </span>
                      <span class="mt-0.5 truncate text-xs text-zinc-500 dark:text-zinc-400">
                        {author.data.title}
                      </span>
                    </span>
                  </a>
                )
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="h-px w-full bg-zinc-200 dark:bg-zinc-800"></div>

  <section class="relative">
    <div class="mx-auto w-full max-w-295 px-4">
      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-x-6">
        <aside class="hidden md:col-start-10 md:col-span-3 md:row-start-1 md:block md:pt-8">
          <div class="mb-8 flex flex-col gap-4">
            {
              authors.map((author) => {
                const avatar = authorAvatar(author.id)
                return (
                  <a
                    href={author.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/byline flex items-center gap-3 no-underline"
                  >
                    {avatar && (
                      <Image
                        src={avatar}
                        alt={author.data.name}
                        class="h-12 w-12 rounded-md object-cover"
                      />
                    )}
                    <span class="flex min-w-0 flex-col">
                      <span class="truncate text-base font-medium text-zinc-800 group-hover/byline:underline dark:text-zinc-200">
                        {author.data.name}
                      </span>
                      <span class="mt-0.5 truncate text-sm text-zinc-500 dark:text-zinc-400">
                        {author.data.title}
                      </span>
                    </span>
                  </a>
                )
              })
            }
          </div>

          <div class="sticky top-[5.5rem]">
            <TableOfContents client:load headings={headings} className="static" />

            <div class="mt-6">
              <div class="flex items-center gap-3">
                <span
                  class="font-mono text-xs font-medium tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
                >
                  Share
                </span>
                <div class="flex items-center gap-2">
                  <a
                    href={xUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on X"
                    class={shareShellClass}
                  >
                    <TwitterLogo class="size-4" />
                  </a>
                  <a
                    href={linkedInUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on LinkedIn"
                    class={shareShellClass}
                  >
                    <LinkedInLogo class="size-4" />
                  </a>
                  <CopyLinkButton client:load />
                </div>
              </div>
              <div class="mt-5 border-t border-zinc-200 pt-5 dark:border-zinc-800"></div>
              <p class="flex flex-col gap-0.5">
                <span
                  class="font-mono text-[10px] tracking-[0.12em] text-zinc-500 uppercase dark:text-zinc-400"
                >
                  Last updated
                </span>
                <time class="font-mono text-xs text-zinc-700 tabular-nums dark:text-zinc-300">
                  {formatDate(post.data.date)}
                </time>
              </p>
            </div>
          </div>
        </aside>

        <article class="min-w-0 pb-20 md:col-span-8 md:row-start-1">
          <div class="mt-10 mb-10 block md:hidden">
            <TableOfContents client:load headings={headings} className="static" />
          </div>

          <div class:list={[proseClass, "blog-article mt-8"]}>
            <Content />
          </div>

          <div
            class="mt-12 flex flex-col gap-6 border-t border-zinc-200 pt-8 md:hidden dark:border-zinc-800"
          >
            <div class="flex items-center gap-3">
              <span
                class="font-mono text-xs font-medium tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
              >
                Share
              </span>
              <div class="flex items-center gap-2">
                <a
                  href={xUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on X"
                  class={shareShellClass}
                >
                  <TwitterLogo class="size-4" />
                </a>
                <a
                  href={linkedInUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on LinkedIn"
                  class={shareShellClass}
                >
                  <LinkedInLogo class="size-4" />
                </a>
                <CopyLinkButton client:load />
              </div>
            </div>
            <p class="flex flex-col gap-0.5">
              <span
                class="font-mono text-[10px] tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
              >
                Last updated
              </span>
              <time class="font-mono text-xs text-zinc-700 tabular-nums dark:text-zinc-300">
                {formatDate(post.data.date)}
              </time>
            </p>
          </div>

          {
            (prevPost || nextPost) && (
              <div class="mt-16 grid grid-cols-1 gap-4 border-t border-zinc-200 pt-10 sm:grid-cols-2 dark:border-zinc-800">
                {prevPost ? (
                  <a
                    href={`/blog/${prevPost.id}`}
                    class="group flex flex-col rounded-md border border-zinc-200 p-4 transition-colors duration-200 hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
                  >
                    <span class="flex items-center gap-1.5 font-mono text-xs tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
                      <ChevronLeftIcon class="size-3.5 transition-transform duration-200 group-hover:-translate-x-0.5" />
                      Previous
                    </span>
                    <span class="mt-1.5 line-clamp-1 text-sm font-medium text-zinc-800 transition-colors group-hover:text-zinc-900 dark:text-zinc-200 dark:group-hover:text-white">
                      {prevPost.data.title}
                    </span>
                  </a>
                ) : (
                  <div />
                )}
                {nextPost ? (
                  <a
                    href={`/blog/${nextPost.id}`}
                    class="group flex flex-col items-end rounded-md border border-zinc-200 p-4 text-right transition-colors duration-200 hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
                  >
                    <span class="flex items-center gap-1.5 font-mono text-xs tracking-wider text-zinc-500 uppercase dark:text-zinc-400">
                      Next
                      <ChevronRightIcon class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
                    </span>
                    <span class="mt-1.5 line-clamp-1 text-sm font-medium text-zinc-800 transition-colors group-hover:text-zinc-900 dark:text-zinc-200 dark:group-hover:text-white">
                      {nextPost.data.title}
                    </span>
                  </a>
                ) : (
                  <div />
                )}
              </div>
            )
          }
        </article>
      </div>
    </div>
  </section>

  <div class="h-px w-full bg-zinc-200 dark:bg-zinc-800"></div>

  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <div class="blog-cta-grid-offset relative h-full">
        <GridBackground />
      </div>

      <div aria-hidden="true" class="absolute inset-0">
        <div
          class="absolute inset-0 opacity-100 transition-opacity duration-[250ms] ease-out dark:opacity-0"
          style="background: linear-gradient(to bottom, #ffffff 0%, transparent 20%, transparent 60%, #ffffff 100%);"
        >
        </div>
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-[250ms] ease-out dark:opacity-100"
          style="background: linear-gradient(to bottom, #09090b 0%, transparent 20%, transparent 60%, #09090b 100%);"
        >
        </div>
      </div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-295 px-4">
      <div
        class="grid grid-cols-1 items-center gap-6 py-12 md:grid-cols-12 md:gap-x-6 md:gap-y-8 md:py-20"
      >
        <div class="md:col-span-8">
          <p
            class="mb-3 font-mono text-sm font-medium tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
          >
            // Effect Community
          </p>
          <h2
            class="text-xl font-semibold tracking-tight text-zinc-900 md:text-2xl dark:text-white"
          >
            Join the conversation on Discord
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
            Meet engineers running Effect in production.
          </p>
        </div>
        <div class="md:col-start-9 md:col-span-4">
          <div
            class="relative mx-auto flex max-w-xs flex-col items-center gap-3 px-6 py-6 md:max-w-none"
          >
            <span
              class="absolute top-0 left-0 h-3 w-3 border-t border-l border-zinc-300 dark:border-zinc-700"
            ></span>
            <span
              class="absolute top-0 right-0 h-3 w-3 border-t border-r border-zinc-300 dark:border-zinc-700"
            ></span>
            <span
              class="absolute bottom-0 left-0 h-3 w-3 border-b border-l border-zinc-300 dark:border-zinc-700"
            ></span>
            <span
              class="absolute right-0 bottom-0 h-3 w-3 border-r border-b border-zinc-300 dark:border-zinc-700"
            ></span>
            <a
              href="https://discord.gg/effect-ts"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
            >
              Join the Discord
              <ArrowRightIcon class="size-4" />
            </a>
            <a
              href="https://discord.gg/effect-ts"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs text-zinc-500 transition-colors hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200"
            >
              discord.gg/effect-ts
              <ArrowUpRightIcon class="size-3.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .blog-post-grid-offset {
    transform: translateY(-1rem);
  }

  .blog-cta-grid-offset :global(.grid-bg) {
    background-position-y: 147px;
  }
</style>
