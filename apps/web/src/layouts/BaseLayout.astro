---
import "../styles/global.css"

import { Font } from "astro:assets"
import { SEO } from "astro-seo"
import openGraphRendererVersion from "virtual:open-graph-renderer-version"

import SkipLink from "@/components/SkipLink.astro"
import {
  OPENGRAPH_IMAGE_HEIGHT,
  OPENGRAPH_IMAGE_WIDTH,
} from "@/features/open-graph/constants"

interface Props {
  readonly title?: string | undefined
  readonly description?: string | undefined
  readonly forceDark?: boolean | undefined
  readonly ogImageVersion?: string | undefined
  readonly feed?: { readonly title: string; readonly href: string } | undefined
  /** Keep the page out of search results (standalone embeds). */
  readonly noindex?: boolean | undefined
}

const {
  title = "Effect | Production Grade TypeScript",
  description,
  forceDark = false,
  ogImageVersion,
  feed,
  noindex = false,
} = Astro.props

const getOgImagePath = () => {
  const pathname = Astro.url.pathname
  let slug = pathname.replace(/^\//, "").replace(/\/$/, "")
  if (slug.length === 0) slug = "index"
  return `/og/${slug}.png`
}

const ogImagePath = getOgImagePath()
const ogImageUrl = new URL(ogImagePath, Astro.url.origin)
// `v` makes the image immutable at the edge, so it must change whenever the
// image does. The image is drawn from the page's own metadata (covered by its
// title, description and `ogImageVersion`) and the renderer. Never key it on
// the deploy revision: that changes every prerendered page on every commit,
// which defeats the incremental build and re-uploads every HTML asset.
const ogImageDigest = await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(
    JSON.stringify([
      openGraphRendererVersion,
      title,
      description ?? null,
      ogImageVersion ?? null,
    ]),
  ),
)
ogImageUrl.searchParams.set(
  "v",
  Array.from(new Uint8Array(ogImageDigest).slice(0, 8), (byte) =>
    byte.toString(16).padStart(2, "0"),
  ).join(""),
)

const pagePathname = Astro.url.pathname.replace(/\/$/, "")
const canonicalUrl = new URL(pagePathname, Astro.site)

// v4 docs pages are also served as markdown at `<url>.md` (see
// `pages/docs/[version]/[...markdown].ts`); API reference pages are not.
const markdownHref = /^\/docs\/v4\/(?!api(?:\/|$))/.test(pagePathname)
  ? `${pagePathname}.md`
  : undefined
---

<!doctype html>
<html
  lang="en"
  class:list={[{ dark: forceDark }]}
  data-route={Astro.routePattern}
  {...forceDark ? { "data-force-dark": "" } : {}}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <script>
      import { startBrowserTelemetry } from "@/lib/maple-browser"
      startBrowserTelemetry()
    </script>

    {/* Tint Firefox's initial canvas before first paint (bug 1488384). */}
    <meta name="color-scheme" content={forceDark ? "dark" : "light dark"} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />

    {/* Critical paint styles applied before the bundle loads. */}
    <style is:inline>
      html {
        background: oklch(1 0 0);
        font-family: var(--font-inter, ui-sans-serif, system-ui, sans-serif);
      }
      html.dark {
        background: oklch(0.141 0.005 285.823);
        color-scheme: dark;
      }
      [data-skip-link]:not(:focus) {
        transform: translateY(-200%);
      }
    </style>


    <script is:inline>
      ;(function () {
        var force = document.documentElement.hasAttribute("data-force-dark")
        if (force) {
          document.documentElement.classList.add("dark")
          document.documentElement.dataset.theme = "dark"
          return
        }
        var stored = localStorage.getItem("theme")
        if (stored) { try { stored = JSON.parse(stored) } catch (_) {} }
        var isDark
        if (stored === "light") {
          isDark = false
        } else if (stored === "dark") {
          isDark = true
        } else if (stored === "system") {
          isDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        } else {
          isDark = true
        }
        document.documentElement.classList.toggle("dark", isDark)
        document.documentElement.dataset.theme = isDark ? "dark" : "light"
        // Follow live OS changes only while "system" is still the stored
        // choice; an explicit choice made later must win over the OS.
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (event) {
          var current = localStorage.getItem("theme")
          if (current) { try { current = JSON.parse(current) } catch (_) {} }
          if (current === "system") document.documentElement.classList.toggle("dark", event.matches)
        })
        new MutationObserver(function () {
          var dark = document.documentElement.classList.contains("dark")
          document.documentElement.dataset.theme = dark ? "dark" : "light"
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        })
      })()
    </script>

    <SEO
      title={title}
      noindex={noindex}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          type: "website",
          url: canonicalUrl,
          title,
          image: ogImageUrl.toString(),
        },
        image: {
          height: OPENGRAPH_IMAGE_HEIGHT,
          width: OPENGRAPH_IMAGE_WIDTH,
        },
        optional: {
          siteName: "Effect",
          ...(description ? { description } : undefined),
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        image: ogImageUrl,
        ...(description ? { description } : undefined),
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          ...(markdownHref
            ? [{ rel: "alternate", type: "text/markdown", href: markdownHref, title: "Markdown" }]
            : []),
          ...(feed ? [{ rel: "alternate", type: "application/rss+xml", ...feed }] : []),
        ],
      }}
      {...description ? { description } : undefined}
    />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <SkipLink />
    <slot />
  </body>
</html>
