---
import ArticleLink from "@/components/blog/ArticleLink.astro"

interface Props {
  people: Array<{
    name: string
    description: string
    profile: {
      label: string
      href: string
    }
  }>
}

const { people } = Astro.props
---

<dl class="not-prose my-6 grid grid-cols-1 gap-x-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    people.map(({ name, description, profile }) => (
      <div class="min-w-0 border-t border-border py-4">
        <dt class="flex flex-wrap items-baseline gap-x-3 gap-y-1 sm:flex-col sm:items-start">
          <span class="text-base font-semibold text-foreground">{name}</span>
          <ArticleLink
            href={profile.href}
            class="font-mono text-sm text-foreground underline underline-offset-4 hover:no-underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
          >
            {profile.label}
          </ArticleLink>
        </dt>
        <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">{description}</dd>
      </div>
    ))
  }
</dl>
