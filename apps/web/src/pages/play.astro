---
import Navigation from "@/components/navigation/Navigation.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import Main from "@/components/layout/Main.astro"
import { CodeEditor } from "@/features/playground/index"

export const prerender = false

Astro.response.headers.set("Cross-Origin-Embedder-Policy", "require-corp")
Astro.response.headers.set("Cross-Origin-Opener-Policy", "same-origin")
---

<BaseLayout title="Playground" description="Effect Playground">
  <div
    class="relative flex h-dvh min-h-[calc(40rem_+_var(--sticky-header-height))] flex-col overflow-hidden bg-background text-foreground antialiased"
  >
    <Navigation activeSlug="playground" />

    <Main aria-label="Effect Playground" class="flex min-h-0 flex-1 overflow-hidden">
      <h1 class="sr-only">Effect Playground</h1>
      <div class="js-editor h-full w-full">
        <CodeEditor client:only="react" />
      </div>
    </Main>
  </div>
</BaseLayout>
