---
/**
 * Standard Effect Days content section: the shared vertical rhythm and the
 * centred, padded container in one wrapper. Anchor sections stay reachable
 * below the sticky nav via `scroll-mt-16`.
 *
 * The hero and the closing CTA lay out their own shells and do not use this.
 */
interface Props {
  readonly id?: string | undefined
  readonly class?: string | undefined
}

const { id, class: className } = Astro.props
---

<section id={id} class:list={["scroll-mt-16 pt-16 pb-16 md:pt-40 md:pb-24", className]}>
  <div class="mx-auto w-full max-w-295 px-4">
    <slot />
  </div>
</section>
