---
import { getCollection, getEntry, render } from "astro:content"

import { ChevronDown, Menu } from "@lucide/astro"

import DocsMobileBar from "@/components/docs/DocsMobileBar.astro"
import DocsSectionSwitch from "@/components/docs/DocsSectionSwitch.astro"
import DocsSidebarTree from "@/components/docs/DocsSidebarTree.astro"
import PrevNextNav from "@/components/ui/PrevNextNav.astro"
import TableOfContents from "@/components/ui/toc/TableOfContents.astro"
import DocShell from "@/layouts/DocShell.astro"
import { cacheKey, digest, sortedRows } from "@/lib/cache-key"
import { buildDocsSidebar, docsNeighbors } from "@/lib/docs-sections"
import { DOCS_VERSIONS, docsVersionLinks } from "@/lib/versions"

export const prerender = true

export async function getStaticPaths() {
  // Declared inside getStaticPaths: Astro extracts this export into its own
  // chunk, so it can only reach imports, not other frontmatter declarations.
  const docVersion = (id: string): string => id.split("/")[0] ?? ""

  const entries = await getCollection("docs")
  const entryIds = new Set(entries.map((entry) => entry.id))

  // Every page renders its version's whole sidebar, so a page goes stale when a
  // sibling's label or order changes, or when either config file changes — none
  // of which touch the page's own digest. The `file()` loader sets no digest,
  // so hash the config data itself.
  const sidebarDigests = new Map<string, string>()
  for (const version of new Set(entries.map((entry) => docVersion(entry.id)))) {
    const [sidebar, onboarding] = await Promise.all([
      getEntry("docsSidebar", version),
      getEntry("docsOnboarding", version),
    ])
    sidebarDigests.set(
      version,
      digest({
        sidebar: sidebar?.data ?? null,
        onboarding: onboarding?.data ?? null,
        entries: sortedRows(
          entries
            .filter((entry) => docVersion(entry.id) === version)
            .map((entry) => [
              entry.id,
              entry.data.sidebar?.label ?? entry.data.title,
              entry.data.sidebar?.order ?? null,
            ]),
        ),
      }),
    )
  }

  return entries.map((entry) => {
    // The versions that have this same page, which the version menu links to.
    const pagePath = entry.id.slice(docVersion(entry.id).length)
    const twinVersions = DOCS_VERSIONS.map(({ value }) => value).filter((version) =>
      entryIds.has(`${version}${pagePath}`),
    )
    return {
      params: { slug: entry.id.replace(/\/index$/, "") },
      props: { entry, pagePath, twinVersions },
      cacheKey: cacheKey(
        entry.digest,
        sidebarDigests.get(docVersion(entry.id)),
        twinVersions.join(","),
      ),
    }
  })
}

const { entry, pagePath, twinVersions } = Astro.props
const { Content, headings } = await render(entry)

const currentVersion = entry.id.split("/")[0]
if (currentVersion === undefined) {
  throw new Error("Unable to generate sidebar entry without document version")
}

const { section, items } = await buildDocsSidebar(currentVersion, entry.id)
const currentLabel = entry.data.sidebar?.label ?? entry.data.title

const { prev, next } = docsNeighbors(items, entry.id)
const docHref = (id: string): string => `/docs/${id.replace(/\/index$/, "")}`
const versionLinks = docsVersionLinks(currentVersion, (version) =>
  twinVersions.includes(version) ? docHref(`${version}${pagePath}`) : `/docs/${version}`,
)
const prevLink = prev ? { href: docHref(prev.id), label: prev.label } : null
const nextLink = next ? { href: docHref(next.id), label: next.label } : null

const tocItems = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text,
    indent: heading.depth === 3,
    class: "text-sm leading-snug",
  }))
---

<DocShell
  title={entry.data.title}
  description={entry.data.description}
  activeSlug="docs"
  version={currentVersion}
  versionLinks={versionLinks}
  section={section}
>
  <!-- Mobile docs menu -->
  <DocsMobileBar slot="mobile-nav" versionLinks={versionLinks}>
    {/* Named so the tree's own groups don't rotate their chevrons with this one. */}
    <details class="group/docs-menu">
      <summary
        class="flex w-full cursor-pointer select-none list-none items-center gap-2 px-4 py-3 text-sm font-medium text-navigation-heading"
      >
        <Menu class="h-5 w-5 -translate-y-px" aria-hidden="true" />
        <span>Docs menu</span>
        <span class="text-muted-foreground">/</span>
        <span class="truncate text-muted-foreground">{currentLabel}</span>
        <ChevronDown
          class="ml-auto h-4 w-4 transition-transform group-open/docs-menu:rotate-180"
          aria-hidden="true"
        />
      </summary>
      {/* Positioned against the bar, so it spans the full width under it. */}
      <nav
        aria-label="Documentation navigation"
        class="absolute inset-x-0 top-full max-h-[60vh] overflow-y-auto border-y border-border bg-background px-4 py-4"
      >
        <DocsSectionSwitch section={section} version={currentVersion} />
        <hr class="my-4 border-border" />
        <DocsSidebarTree items={items} currentId={entry.id} />
      </nav>
    </details>
  </DocsMobileBar>

  <!-- Desktop sidebar -->
  <nav slot="sidebar" aria-label="Documentation navigation">
    <DocsSidebarTree items={items} currentId={entry.id} />
  </nav>

  <!-- Main content -->
  <article class="prose prose-effect max-w-none">
    <h1 class="mt-0!">{entry.data.title}</h1>
    <Content />
  </article>

  <PrevNextNav prev={prevLink} next={nextLink} label="Document navigation" />

  <!-- Right TOC -->
  {tocItems.length > 0 && <TableOfContents slot="toc" items={tocItems} />}
</DocShell>
