---
import {
  ArrowDown,
  ArrowUpRight,
  Briefcase,
  CalendarCheck,
  ChartLine,
  CircleCheck,
  ClipboardList,
  FileSearch,
  FileText,
  FolderGit,
  GitBranch,
  GraduationCap,
  HeartHandshake,
  LifeBuoy,
  MapPin,
  ShieldCheck,
} from "@lucide/astro"
import { getImage, Image } from "astro:assets"
import { getCollection } from "astro:content"
import AlchemyMark from "@/assets/logos/alchemy/alchemy-mark-dark.svg"
import FoldkitMark from "@/assets/logos/foldkit/foldkit-mark-white.svg"
import MasterclassLogo from "@/assets/company-logos/masterclass-noM.svg"
import OpencodeLogo from "@/assets/company-logos/opencode-wordmark-dark.svg"
import OpenRouterLogo from "@/assets/logos/openrouter-v2-on-dark.svg"
import WarpLogo from "@/assets/company-logos/warp.svg"
import ArrowLink from "@/components/enterprise/ArrowLink.astro"
import BorderedGrid from "@/components/enterprise/BorderedGrid.astro"
import EnterpriseSection from "@/components/enterprise/EnterpriseSection.astro"
import GroupBar from "@/components/enterprise/GroupBar.astro"
import SupportTimeline from "@/components/blog/SupportTimeline.astro"
import SupportFlow from "@/components/enterprise/SupportFlow.astro"
import TrendChart from "@/components/blog/TrendChart.astro"
import CompanyLogoGrid from "@/components/CompanyLogoGrid.astro"
import GridBackground from "@/components/GridBackground.astro"
import FrequentlyAskedQuestions from "@/components/landing/blocks/FrequentlyAskedQuestions.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"
import ContactDialog from "@/components/enterprise/contact/ContactDialog"
import ContactMenu from "@/components/enterprise/contact/ContactMenu"
import ButtonLink from "@/components/ui/ButtonLink.astro"
import { effect4Support } from "@/data/effect-4-support"
import { getWeeklyDownloads } from "@/lib/npm-downloads"
import PageLayout from "@/layouts/PageLayout.astro"

const avatarModules = import.meta.glob<{ default: ImageMetadata }>("../assets/authors/*.png", {
  eager: true,
})
const authors = await getCollection("blogAuthors")
const [effectPackage] = await getCollection(
  "apiReference",
  ({ data }) => data.version === "v4" && data.packageName === "effect",
)
if (!effectPackage) throw new Error("Missing v4 effect entry in the API reference dataset")
const scheduleUrl = (scheduleId: string) =>
  `https://calendar.google.com/calendar/appointments/schedules/${scheduleId}?gv=true`

const CONTACT_MEMBERS: ReadonlyArray<{ id: string; scheduleId: string }> = [
  { id: "michael_arnaldi", scheduleId: "TODO" },
  { id: "maxwell_brown", scheduleId: "TODO" },
  { id: "sebastian_lorenz", scheduleId: "TODO" },
  { id: "tim_smart", scheduleId: "TODO" },
]

const members = await Promise.all(
  CONTACT_MEMBERS.map(async ({ id, scheduleId }) => {
    const author = authors.find((entry) => entry.id === id)
    const avatar = avatarModules[`../assets/authors/${id}.png`]?.default
    if (!author?.data.timezone || !avatar) throw new Error(`Incomplete contact member "${id}"`)
    return {
      id,
      name: author.data.name,
      title: author.data.title,
      timezone: author.data.timezone,
      scheduleUrl: scheduleUrl(scheduleId),
      avatar: (await getImage({ src: avatar, width: 96, height: 96, format: "webp" })).src,
    }
  }),
)

const downloads = await getWeeklyDownloads("effect", "2024-04-15")
const [firstWeek, firstDownloads] = downloads[0]!
const [lastWeek, lastDownloads] = downloads[downloads.length - 1]!
const compact = new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 })
const weekLabel = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
})

const CONTACT_EMAIL = "contact@effectful.co"
const CONTACT_HREF = `mailto:${CONTACT_EMAIL}?subject=Effect%20for%20enterprise`
const DISCORD_URL = "https://discord.gg/effect-ts"
const POLICY_UPDATED = "Oct 01, 2026"

const PAGE_QUESTIONS = [
  { href: "#support", label: "Who can help us adopt and operate it?" },
  { href: "#security", label: "What happens with a security issue?" },
  { href: "#adoption-guide", label: "How do we propose it internally?" },
]

const FACTS = [
  { label: "License", value: "MIT" },
  { label: "Current release", value: `v${effectPackage.data.packageVersion}` },
  { label: "Enterprise support", value: "NDA and SLAs" },
  { label: "Private channels", value: "Slack or Discord" },
]

const RELEASE_PRACTICES = [
  {
    icon: GitBranch,
    title: "Versioning",
    body: "Semantic versioning. Stable modules break only in a new major; effect/unstable/* can change in a minor.",
  },
  {
    icon: ShieldCheck,
    title: "Long-term support",
    body: "Each major line is supported on a published LTS schedule. 4.x is the current LTS.",
  },
  {
    icon: CalendarCheck,
    title: "Release cadence",
    body: "How often minor and patch releases ship, and how schedule changes are announced.",
    tbd: true,
  },
  {
    icon: LifeBuoy,
    title: "Maintenance",
    body: "Supported lines receive fixes and security patches until end of life. 3.x stays in maintenance alongside 4.x.",
  },
]

const RELEASE_COLUMNS = ["Release", "Status", "Stable since", "Upgrade guide"]

const RELEASES = [
  {
    line: "4.x",
    status: "Current, LTS",
    active: true,
    stable: "Oct 2026",
    upgrade: {
      label: "Migrating from 3.x",
      href: "/blog/releases/effect/40",
    },
  },
  {
    line: "3.x",
    status: "Maintenance",
    active: false,
    stable: "Apr 2024",
    upgrade: {
      label: "Changelog",
      href: "https://github.com/Effect-TS/effect/releases",
    },
  },
]

const PRODUCTION = [
  {
    company: "OpenCode",
    logo: OpencodeLogo,
    logoClass: "max-h-6",
    useCase: "Migrating a large TypeScript codebase to Effect",
    href: "https://www.youtube.com/watch?v=-mL7VVvkLGM",
  },
  {
    company: "OpenRouter",
    logo: OpenRouterLogo,
    logoClass: "h-6",
    useCase: "Internal tooling and infrastructure",
    href: "https://youtu.be/AVJIqQi11lM",
  },
  {
    company: "Warp",
    logo: WarpLogo,
    logoClass: "max-h-6",
    useCase: "Reliable payment and payroll systems",
    href: "/podcast/episodes/reliable-payroll-systems-in-typescript-with-effect-with-adam-rankin",
  },
  {
    company: "MasterClass",
    logo: MasterclassLogo,
    logoClass: "max-h-5",
    useCase: "Real-time voice AI orchestration",
    href: "https://www.youtube.com/watch?v=x2bUuOZ-htU&list=PLDf3uQLaK2B_jaZ5Fy7IPNq0FIViV_CQl&index=6",
  },
]

const ECOSYSTEM = [
  {
    name: "Alchemy",
    kind: "Infrastructure as Code",
    mark: AlchemyMark,
    links: [
      { label: "Get started", href: "https://alchemy.run/getting-started" },
      { label: "Source", href: "https://github.com/alchemy-run/alchemy" },
    ],
  },
  {
    name: "Foldkit",
    kind: "Frontend framework",
    mark: FoldkitMark,
    links: [
      { label: "Get started", href: "https://foldkit.dev/get-started" },
      { label: "Source", href: "https://github.com/foldkit/foldkit" },
    ],
  },
]

const SUPPORT_OPTIONS = [
  {
    icon: FileSearch,
    title: "Talk through adoption",
    body: "Bring us your technical questions and plans for using Effect.",
  },
  {
    icon: LifeBuoy,
    title: "Establish a support relationship",
    body: "A support agreement with a mutual NDA, service levels, and escalation. Private channels are arranged separately.",
  },
  {
    icon: GraduationCap,
    title: "Get hands-on help",
    body: "Implementation, consulting, or training through an adoption partner like Ziverge.",
  },
]

const SECURITY_LINKS = [
  {
    icon: FolderGit,
    title: "Source and license",
    body: "Developed in public, MIT licensed.",
    href: "https://github.com/Effect-TS/effect",
  },
  {
    icon: ShieldCheck,
    title: "Security reporting and advisories",
    body: "Private reports, public advisories.",
    href: "https://github.com/Effect-TS/effect/security",
  },
  {
    icon: ChartLine,
    title: "npm package",
    body: "Versions, release history, and weekly downloads.",
    href: "https://www.npmjs.com/package/effect",
  },
]

const PROPOSAL_TEMPLATE = `# Proposal to adopt Effect

## Problem we want to solve
Describe the current problem and why it matters.

## Proposed use of Effect
Where Effect is introduced and its integration boundaries.

## Pilot and success criteria
A bounded trial, how it is evaluated, and the decision after.

## Team preparation
Learning, training, review, and ownership needs.

## Maintenance plan
Release line, support window, upgrade expectations.

## Security and licensing
License, advisory process, internal review.

## Support and staffing
Internal owners, Effect support, partner help.

## Tradeoffs and exit plan
Adoption costs, open questions, how we'd change course.

## Recommendation
Next step, owner, and review date.`

const FAQS = [
  {
    question: "Can we try Effect in part of an existing application?",
    answer:
      "<p>Yes. Start with a bounded use case and assess how it fits your existing code, team, and delivery process.</p>",
  },
  {
    question: "What support can our company arrange?",
    answer:
      "<p>Contact us to discuss your needs. We can talk through company support, private communication, and introductions to adoption partners. Any service levels and coverage are defined in an agreement.</p>",
  },
  {
    question: "Where can individual developers ask questions?",
    answer: `<p>Join our <a href="${DISCORD_URL}" target="_blank" rel="noopener noreferrer">public Discord</a>. It is open to everyone, including engineers using Effect at work.</p>`,
  },
]

const tileIcon = "text-muted-foreground"
const cardTitle = "text-lg font-semibold text-foreground"
const cardBody = "mt-1 text-sm leading-normal text-muted-foreground"
const routeLink =
  "inline-flex items-center gap-2 text-sm font-medium text-muted-foreground no-underline transition-colors hover:text-foreground hover:no-underline"
---

<PageLayout
  title="Effect for enterprise"
  description="Evaluate Effect with your team, plan your adoption, and get help from the people building it."
>
  <section class="relative w-full overflow-hidden">
    <GridBackground />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to bottom, var(--background) 0%, transparent 20%, transparent 60%, var(--background) 100%)"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-100"
      style="background: radial-gradient(ellipse 50% 80% at 50% -20%, var(--hero-glow-a) 0%, transparent 50%)"
    >
    </div>
    <div
      class="relative mx-auto grid w-full max-w-295 grid-cols-1 items-center gap-12 px-4 pt-32 pb-20 md:pt-40 md:pb-24 lg:grid-cols-12"
    >
      <div class="lg:col-span-7">
        <Eyebrow class="mb-3">// Enterprise</Eyebrow>
        <h1 class="text-4xl leading-tighter font-bold tracking-tight text-foreground md:text-5xl">
          Effect for enterprise
        </h1>
        <p class="mt-4 max-w-xl text-lg text-muted-foreground">
          Evaluate Effect with your team. Plan for production.
          <br class="hidden lg:inline" />
          Get help from the people building it.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <ContactMenu
            client:load
            members={members}
            emailHref={CONTACT_HREF}
            variant="primary"
            size="lg"
          />
          <ButtonLink href="#releases" size="lg">Review releases and support</ButtonLink>
        </div>
      </div>

      <nav aria-label="On this page" class="lg:col-span-4 lg:col-start-9 lg:self-end">
        <Eyebrow class="text-xs">This page answers</Eyebrow>
        <ol class="mt-4 border-t border-border">
          {
            PAGE_QUESTIONS.map((q, i) => (
              <li class="border-b border-border">
                <a
                  href={q.href}
                  class="group flex items-baseline gap-4 py-3 text-sm text-prose-foreground no-underline transition-colors hover:text-foreground hover:no-underline"
                >
                  <span class="font-mono text-xs text-subtle-foreground">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="flex-1">{q.label}</span>
                  <ArrowDown
                    size={14}
                    class="shrink-0 text-subtle-foreground transition-colors group-hover:text-foreground"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto w-full max-w-295 px-4">
      <BorderedGrid as="dl" class="grid-cols-2 border-0 lg:grid-cols-4">
        {
          FACTS.map((fact) => (
            <div class="flex flex-col gap-1 bg-background px-6 py-6">
              <Eyebrow as="dt" class="text-xs">
                {fact.label}
              </Eyebrow>
              <dd class="text-lg font-semibold text-foreground">{fact.value}</dd>
            </div>
          ))
        }
      </BorderedGrid>
    </div>
  </section>

  <EnterpriseSection
    id="releases"
    eyebrow="Release management"
    title="Plan your adoption and upgrades"
    subtitle="How Effect versions, supports, and ships releases."
  >
    <BorderedGrid class="grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        RELEASE_PRACTICES.map((item) => (
          <li class="flex flex-col bg-background px-6 py-5">
            <span class="flex items-center gap-3">
              <item.icon size={20} class={`shrink-0 ${tileIcon}`} aria-hidden="true" />
              <span class="text-base font-semibold text-foreground">{item.title}</span>
            </span>
            <p class={`${cardBody} mt-2 text-pretty`}>
              {item.body}
              {item.tbd && (
                <span class="ml-1 inline-flex items-center rounded-sm border border-dashed border-border-strong px-1.5 py-0.5 font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase">
                  TBD
                </span>
              )}
            </p>
          </li>
        ))
      }
    </BorderedGrid>

    <div class="mt-16">
      <SupportTimeline {...effect4Support} />
    </div>

    <GroupBar class="mt-16">
      <Fragment slot="label">Release lines</Fragment>
      <ArrowLink href="https://github.com/Effect-TS/effect/releases">Changelog</ArrowLink>
    </GroupBar>

    <div class="hidden overflow-x-auto border border-t-0 border-border md:block">
      <table class="w-full text-left text-sm">
        <thead class="bg-card">
          <tr>
            {
              RELEASE_COLUMNS.map((col) => (
                <th
                  scope="col"
                  class="px-4 py-3 align-bottom font-mono text-xs font-medium tracking-wider text-muted-foreground uppercase"
                >
                  {col}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            RELEASES.map((row) => (
              <tr class="align-middle">
                <th scope="row" class="px-4 py-4 font-mono text-base font-semibold text-foreground">
                  {row.line}
                </th>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center gap-2 text-sm font-medium whitespace-nowrap text-foreground">
                    <span
                      aria-hidden="true"
                      class:list={[
                        "size-2 rounded-full",
                        row.active ? "bg-brand" : "border border-subtle-foreground bg-transparent",
                      ]}
                    />
                    {row.status}
                  </span>
                </td>
                <td class="px-4 py-4 text-prose-foreground">{row.stable}</td>
                <td class="px-4 py-4">
                  <ArrowLink href={row.upgrade.href} class="whitespace-nowrap">
                    {row.upgrade.label}
                  </ArrowLink>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="space-y-px border border-t-0 border-border bg-border md:hidden">
      {
        RELEASES.map((row) => (
          <dl class="divide-y divide-border bg-background">
            <div class="flex items-center justify-between px-4 py-3">
              <dt class="font-mono text-base font-semibold text-foreground">{row.line}</dt>
              <dd class="inline-flex items-center gap-2 text-sm font-medium text-foreground">
                <span
                  aria-hidden="true"
                  class:list={[
                    "size-2 rounded-full",
                    row.active ? "bg-brand" : "border border-subtle-foreground bg-transparent",
                  ]}
                />
                {row.status}
              </dd>
            </div>
            <div class="flex items-center justify-between gap-4 px-4 py-3 text-sm">
              <Eyebrow as="dt" class="text-xs">
                Stable since
              </Eyebrow>
              <dd class="text-prose-foreground">{row.stable}</dd>
            </div>
            <div class="px-4 py-3">
              <ArrowLink href={row.upgrade.href}>{row.upgrade.label}</ArrowLink>
            </div>
          </dl>
        ))
      }
    </div>

    <Eyebrow class="mt-3 text-right text-xs">Last updated · {POLICY_UPDATED}</Eyebrow>
  </EnterpriseSection>

  <EnterpriseSection
    id="production"
    eyebrow="Adoption"
    title="Effect in the real world"
    subtitle="See where teams use Effect and the problems they are solving."
  >
    <GroupBar>
      <Fragment slot="label">In production</Fragment>
      <ArrowLink href="https://www.youtube.com/playlist?list=PLDf3uQLaK2lbPLQT6I6xkiV_W3NxnPXRE">
        More stories
      </ArrowLink>
    </GroupBar>
    <BorderedGrid flush class="grid-cols-1 md:grid-cols-2">
      {
        PRODUCTION.map((story) => (
          <li>
            <a
              href={story.href}
              {...(story.href.startsWith("http")
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
              class="group flex h-full flex-col bg-background px-6 py-5 no-underline transition-colors hover:bg-card hover:no-underline md:px-8"
            >
              <span class="flex items-start justify-between gap-4">
                <span class="flex h-8 items-center">
                  <Image
                    src={story.logo}
                    alt={story.company}
                    class:list={[story.logoClass, "w-auto"]}
                  />
                </span>
                <ArrowUpRight
                  size={18}
                  class="shrink-0 text-subtle-foreground transition-colors group-hover:text-foreground"
                  aria-hidden="true"
                />
              </span>
              <span class={`${cardBody} mt-3`}>{story.useCase}</span>
            </a>
          </li>
        ))
      }
    </BorderedGrid>

    <GroupBar class="border-t-0">
      <Fragment slot="label">More teams using Effect</Fragment>
      <ArrowLink href="/effect-jobs">Effect Jobs</ArrowLink>
    </GroupBar>
    <CompanyLogoGrid class="border border-t-0 border-border" />

    <TrendChart
      label="effect"
      title="Weekly npm downloads"
      description={`Weekly downloads of the effect package grew from ${firstDownloads.toLocaleString("en")} in the week of ${weekLabel.format(new Date(firstWeek))} to ${lastDownloads.toLocaleString("en")} in the week of ${weekLabel.format(new Date(lastWeek))}.`}
      data={downloads}
      stats={[
        {
          value: compact.format(lastDownloads),
          label: `Downloads in the week of ${weekLabel.format(new Date(lastWeek))}`,
        },
        { value: `${Math.round(lastDownloads / firstDownloads)}×`, label: "Growth since 3.x" },
      ]}
    />

    <GroupBar id="ecosystem" class="scroll-mt-24 border-t-0">
      <Fragment slot="label">Ecosystem projects</Fragment>
    </GroupBar>
    <BorderedGrid as="div" flush class="grid-cols-1 lg:grid-cols-2">
      {
        ECOSYSTEM.map((project) => (
          <article class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 bg-background p-6 md:p-8">
            <div class="flex items-center gap-4">
              <span class="flex size-14 shrink-0 items-center justify-center rounded-xl border border-border bg-card">
                <Image src={project.mark} alt="" class="size-7" />
              </span>
              <div>
                <h4 class={cardTitle}>{project.name}</h4>
                <p class="text-sm text-muted-foreground">{project.kind}</p>
              </div>
            </div>
            <div class="flex flex-col items-start gap-2">
              {project.links.map((l) => (
                <ArrowLink href={l.href}>{l.label}</ArrowLink>
              ))}
            </div>
          </article>
        ))
      }
    </BorderedGrid>
  </EnterpriseSection>

  <EnterpriseSection id="support" eyebrow="Support" title="Support for your company">
    <ContactMenu slot="action" client:load members={members} emailHref={CONTACT_HREF} />
    <BorderedGrid class="grid-cols-1 lg:grid-cols-3">
      {
        SUPPORT_OPTIONS.map((o) => (
          <li class="flex flex-col bg-background p-6 md:p-8">
            <o.icon size={24} class={tileIcon} aria-hidden="true" />
            <h3 class={`${cardTitle} mt-6`}>{o.title}</h3>
            <p class={`${cardBody} mt-3`}>{o.body}</p>
          </li>
        ))
      }
    </BorderedGrid>
    <div class="mt-16">
      <SupportFlow />
    </div>
  </EnterpriseSection>

  <EnterpriseSection
    id="security"
    eyebrow="Security"
    title="Security and stewardship"
    subtitle="Open source, maintained by the Effect team at Effectful Technologies."
  >
    <BorderedGrid class="grid-cols-1 md:grid-cols-3">
      {
        SECURITY_LINKS.map((l) => (
          <li class="bg-background">
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full items-start gap-3 px-6 py-5 no-underline transition-colors hover:bg-card hover:no-underline md:px-8"
            >
              <l.icon size={20} class={`mt-0.5 shrink-0 ${tileIcon}`} aria-hidden="true" />
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="text-base font-semibold text-foreground">{l.title}</span>
                <span class="text-sm leading-normal text-pretty text-muted-foreground">
                  {l.body}
                </span>
              </span>
              <ArrowUpRight
                size={18}
                class="mt-0.5 shrink-0 text-subtle-foreground transition-colors group-hover:text-foreground"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </BorderedGrid>
  </EnterpriseSection>

  <EnterpriseSection
    id="adoption-guide"
    eyebrow="Adoption guide"
    title="Bring Effect to your team"
    subtitle="Preparing an internal proposal? Start with our template."
  >
    <div
      class="flex flex-col gap-6 border border-border bg-background p-6 md:flex-row md:items-center md:justify-between md:p-8"
    >
      <div class="flex items-start gap-4">
        <FileText size={24} class={`mt-0.5 shrink-0 ${tileIcon}`} aria-hidden="true" />
        <div>
          <h3 class={cardTitle}>Proposal template</h3>
          <p class={`${cardBody} max-w-xl`}>
            Problem, pilot, maintenance plan, security, and tradeoffs. Ready to adapt for your
            architecture review.
          </p>
        </div>
      </div>
      <ButtonLink
        variant="primary"
        data-copy-template={PROPOSAL_TEMPLATE}
        class="shrink-0 self-start md:self-auto"
      >
        <ClipboardList size={16} data-copy-idle aria-hidden="true" />
        <CircleCheck size={16} data-copy-done class="hidden" aria-hidden="true" />
        <span data-copy-label aria-live="polite">Copy proposal template</span>
      </ButtonLink>
    </div>
  </EnterpriseSection>

  <section
    id="faq"
    class="relative w-full scroll-mt-16 border-t border-border py-24 md:pt-40 md:pb-24"
  >
    <div class="mx-auto w-full max-w-295">
      <div class="flex flex-col lg:flex-row">
