---
// TellJoke running next to its journal, one beat per Step, like the recipe
// visual earlier in the post. Each journal row sits level with the line that
// asks for it. Every activity asks the journal for its name before it does
// anything: its name in the code and that name in the journal light up. If
// there's nothing there, the activity does the work, its result turns up on
// the line as a comment, and an arrow takes it into the journal. If there
// is, a green arrow brings that same result back to the line.
//
// Just after WriteJoke, the runner crashes. The code fades, but the journal
// doesn't. The next Step starts the workflow again from the top. The clock
// line isn't an activity, so it really does run again, and gets a different
// time. WriteJoke finds its joke in the journal. PostJoke doesn't find
// anything, so it runs for the first time.

import StepControls from "@/components/blog/module-of-the-week/stepper/StepControls.astro"
import { warning } from "../3/palette"

// The code, in tokens, coloured like the post's code blocks: [kind, text],
// where the kind is a keyword, a constant, a function, a string, or plain
type Token = [kind: "k" | "c" | "f" | "s" | "p", text: string]
const clockLine: Array<Token> = [
  ["k", "const"],
  ["p", " "],
  ["c", "now"],
  ["p", " = "],
  ["k", "new"],
  ["p", " "],
  ["f", "Date"],
  ["p", "()"],
]
const jokeAssign: Array<Token> = [
  ["k", "const"],
  ["p", " "],
  ["c", "joke"],
  ["p", " = "],
]
// An activity call, in three parts so it can go on three lines when it
// needs to
const call = (name: string): Array<Array<Token>> => [
  [
    ["k", "yield*"],
    ["p", " Activity."],
    ["f", "make"],
    ["p", "({"],
  ],
  [
    ["p", "name: "],
    ["s", `"${name}"`],
  ],
  [["p", "})"]],
]

// The code as HTML, built here rather than in the markup, where a formatter
// would add whitespace between the tokens and it would show up in the code
const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
const tokens = (ts: Array<Token>) =>
  ts.map(([kind, text]) => `<span class="t-${kind}">${escape(text)}</span>`).join("")
// An activity's name, marked so it can light up along with the journal row
// it looks up
const nameToken = (name: string) =>
  `<span class="t-s rp7-name" data-rp7-name>"${escape(name)}"</span>`
// An activity call, on three lines, with a place after its closing brace for
// a comment saying what it returned
const activity = (name: string) => {
  const [open, arg, close] = call(name)
  const note = `<span class="rp7-note" data-rp7-note></span>`
  return [
    `<span>${tokens(open!)}</span>`,
    `<span class="rp7-break rp7-arg">${tokens(arg!.slice(0, 1))}${nameToken(name)}</span>`,
    `<span class="rp7-break">${tokens(close!)}${note}</span>`,
  ].join("")
}
const clockHtml = tokens(clockLine)
const writeHtml = tokens(jokeAssign) + activity("WriteJoke")
const postHtml = activity("PostJoke")
---

<figure
  class="rp7 st"
  data-rp7-visual
  aria-label="The TellJoke workflow next to its journal. Each activity asks the journal for its name before doing anything. On the first run WriteJoke isn't found, so it runs and its joke goes in the journal. Then the runner crashes. The workflow runs again from the top: the clock line runs again and gets a different time, WriteJoke finds its joke in the journal and returns it without running, and PostJoke isn't found, so it runs."
  style={`--rp7-warn: ${warning.background}; --rp7-warn-ink: ${warning.text}`}
>
  <div class="rp7-stage" data-rp7-stage>
    <p class="rp7-title rp7-fades" style="--r: 1">Workflow</p>
    <p class="rp7-title is-journal" style="--r: 1; --mr: 5">Journal</p>
    <p class="rp7-aside" style="--r: 2">Not an activity, so it isn't journaled</p>

    <span class="rp7-pointer" data-rp7-pointer aria-hidden="true"></span>
    <span class="rp7-spinner" data-rp7-spinner aria-hidden="true" hidden></span>
    <svg class="rp7-arrows" data-rp7-arrows aria-hidden="true"></svg>

    {/* The workflow's body, trimmed to what this is about */}
    <div class="rp7-row rp7-line rp7-fades" data-rp7-line style="--r: 2">
      <code set:html={clockHtml} />
      <span class="rp7-comment" data-rp7-clock></span>
    </div>
    <div class="rp7-row rp7-line rp7-fades" data-rp7-line style="--r: 3">
      <code set:html={writeHtml} />
    </div>
    <div class="rp7-row rp7-line rp7-fades" data-rp7-line style="--r: 4">
      <code set:html={postHtml} />
    </div>

    {/* The journal, a row per activity, level with the line that asks for it */}
    <div class="rp7-row rp7-entry" data-rp7-entry style="--r: 3; --mr: 6">
      <span class="rp7-key" data-rp7-key>WriteJoke</span>
      <span class="rp7-result" data-rp7-result>–</span>
    </div>
    <div class="rp7-row rp7-entry" data-rp7-entry style="--r: 4; --mr: 7">
      <span class="rp7-key" data-rp7-key>PostJoke</span>
      <span class="rp7-result" data-rp7-result>–</span>
    </div>

    <p class="rp7-crash" aria-hidden="true">✕ Crash</p>
  </div>

  <StepControls reset />
</figure>

<script>
  import { rel } from "@/components/blog/module-of-the-week/stepper/stepper"
  import { drawArrow } from "./arrow"

  const NAMES = ["WriteJoke", "PostJoke"]
  // What each activity leaves in the journal
  const RESULTS = ["I'd tell you a UDP joke, but you might not get it.", "posted"]
  // What the code says it got back, as a comment
  const RETURNED = [`"I'd tell you a UDP joke…"`, "posted"]
  // The line after which the runner crashes on the first run
  const CRASH_AFTER = 1
  // Running for real is work, so it takes a while, and the replay feels
  // quicker for it
  const WORK_MS = 1000
  // A terminal spinner, in the corner of an activity's line while it does its
  // work
  const SPINNER = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
  const SPIN_MS = 80
  // How long the journal's answer sits before the activity acts on it
  const LOOK_MS = 450

  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const pause = (ms: number) => new Promise((r) => setTimeout(r, reduceMotion() ? 0 : ms))
  const clock = (d: Date) =>
    d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", second: "2-digit" })

  for (const root of document.querySelectorAll<HTMLElement>("[data-rp7-visual]")) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!
    const stage = q<HTMLElement>("[data-rp7-stage]")
    const arrows = q<SVGSVGElement>("[data-rp7-arrows]")
    const pointer = q<HTMLElement>("[data-rp7-pointer]")
    const spinner = q<HTMLElement>("[data-rp7-spinner]")
    const clockEl = q<HTMLElement>("[data-rp7-clock]")
    const lines = [...root.querySelectorAll<HTMLElement>("[data-rp7-line]")]
    const notes = [...root.querySelectorAll<HTMLElement>("[data-rp7-note]")]
    const entries = [...root.querySelectorAll<HTMLElement>("[data-rp7-entry]")]
    const keys = [...root.querySelectorAll<HTMLElement>("[data-rp7-key]")]
    const results = [...root.querySelectorAll<HTMLElement>("[data-rp7-result]")]
    const names = [...root.querySelectorAll<HTMLElement>("[data-rp7-name]")]
    const caption = q<HTMLElement>("[data-caption]")
    const stepBtn = q<HTMLButtonElement>("[data-step]")
    const resetBtn = q<HTMLButtonElement>("[data-reset]")

    // The line about to run. What's in the journal lives outside the runner,
    // so a crash doesn't touch it.
    let at = 0
    let run = 1
    let recorded = [false, false]
    let firstTime: Date | null = null
    let crashed = false
    let busy = false
    // Bumped on reset, so a step that's still going knows to stop
    let generation = 0

    // The arrow between an activity's line and its journal row, the same as
    // the recipe's: the journal sits beside the code, or under it on a
    // narrow screen, where the arrow goes around inside the right edge.
    // Writing is ink, and reading back is the same arrow the other way, in
    // green.
    const arrow = (line: Element, entry: Element, back: boolean) => {
      const stacked = rel(stage, entry).top > rel(stage, lines.at(-1)!).bottom
      return drawArrow({
        stage,
        layer: arrows,
        from: line,
        to: entry,
        back,
        stacked,
        className: "rp7-arrow",
        gutter: stacked ? stage.clientWidth - 6 : undefined,
      })
    }

    // A spinner in the line's top right corner while it works
    let spinning = 0
    const spin = (line: HTMLElement) => {
      let frame = 0
      spinner.textContent = SPINNER[0]!
      spinner.style.top = `${line.offsetTop}px`
      spinner.style.left = `${line.offsetLeft + line.offsetWidth}px`
      spinner.hidden = false
      if (reduceMotion()) return
      spinning = window.setInterval(() => {
        frame = (frame + 1) % SPINNER.length
        spinner.textContent = SPINNER[frame]!
      }, SPIN_MS)
    }
    const stopSpinning = () => {
      window.clearInterval(spinning)
      spinner.hidden = true
    }

    const render = () => {
      stage.classList.toggle("is-crashed", crashed)
      const finished = at === lines.length
      for (const [i, line] of lines.entries()) {
        line.classList.toggle("is-current", !crashed && !busy && !finished && i === at)
      }
      for (const [i, el] of results.entries()) {
        if (recorded[i]) el.textContent = RESULTS[i]!
      }
      const line = lines[Math.min(at, lines.length - 1)]!
      pointer.style.top = `${line.offsetTop + line.offsetHeight / 2}px`
      pointer.hidden = crashed || finished
      stepBtn.disabled = busy || finished
    }

    // Runs a beat with the controls off, unless Reset comes along first
    const beat = async (fn: (alive: () => boolean) => Promise<void>) => {
      const gen = generation
      busy = true
      render()
      await fn(() => gen === generation)
      if (gen !== generation) return
      busy = false
      render()
    }

    const step = () => {
      // Back up after the crash: a new run, from the top, with every call
      // back in the code
      if (crashed) {
        crashed = false
        run = 2
        at = 0
        for (const note of notes) note.textContent = ""
        caption.textContent = "The workflow runs again, from the top"
        return render()
      }

      // The clock line isn't an activity, so it just runs, every time
      if (at === 0) {
        const now = new Date()
        if (run === 1) {
          firstTime = now
          clockEl.className = "rp7-comment"
          clockEl.textContent = `// ${clock(now)}`
          caption.textContent = `The clock says ${clock(now)}`
        } else {
          // At least a second on, so the two times never look the same
          const later = new Date(Math.max(now.getTime(), firstTime!.getTime() + 1000))
          clockEl.className = "rp7-comment is-again"
          clockEl.innerHTML = `// <s>${clock(firstTime!)}</s> ${clock(later)}`
          caption.textContent = `Reading the clock isn't an activity, so it runs again, and this time it says ${clock(later)}`
        }
        at = 1
        return render()
      }

      // The crash comes once WriteJoke is in the journal
      if (run === 1 && at === CRASH_AFTER + 1) {
        crashed = true
        caption.textContent = "The runner crashes. The code stops, but the journal is still there."
        return render()
      }

      const i = at - 1
      const name = NAMES[i]!
      const line = lines[at]!
      const entry = entries[i]!
      const key = keys[i]!

      // One beat: the activity looks itself up in the journal by name. If
      // there's a result there, an arrow brings it back. If not, the activity
      // does its work, and an arrow takes its result to the journal.
      return void beat(async (alive) => {
        // The name in the code and the name in the journal light up
        // together, which is how the lookup works
        names[i]!.classList.add("is-lit")
        key.classList.add("is-lit")
        entry.classList.add(recorded[i] ? "is-found" : "is-missing")
        await pause(LOOK_MS)
        if (!alive()) return
        if (recorded[i]) {
          // Found: the result that went in on the first run comes back
          await arrow(line, entry, true)
          if (!alive()) return
          notes[i]!.className = "rp7-note is-journal"
          notes[i]!.textContent = `// ${RETURNED[i]}`
          entry.classList.remove("is-found")
          caption.textContent = `${name} finds its result in the journal, so it doesn't run`
        } else {
          // Not found: it does the work, then its result goes in the journal
          line.classList.add("is-working")
          spin(line)
          await pause(WORK_MS)
          stopSpinning()
          line.classList.remove("is-working")
          if (!alive()) return
          notes[i]!.className = "rp7-note"
          notes[i]!.textContent = `// ${RETURNED[i]}`
          await arrow(line, entry, false)
          if (!alive()) return
          entry.classList.remove("is-missing")
          recorded[i] = true
          entry.classList.add("is-written")
          setTimeout(() => entry.classList.remove("is-written"), 400)
          caption.textContent = `${name} isn't in the journal, so it runs for real and writes its result there`
        }
        names[i]!.classList.remove("is-lit")
        key.classList.remove("is-lit")
        at++
        if (at === lines.length) caption.textContent = "The workflow finishes"
      })
    }

    stepBtn.addEventListener("click", () => {
      if (!busy) step()
    })

    resetBtn.addEventListener("click", () => {
      generation++
      stopSpinning()
      arrows.replaceChildren()
      for (const line of lines) line.classList.remove("is-working")
      for (const note of notes) note.textContent = ""
      for (const entry of entries) entry.classList.remove("is-found", "is-missing", "is-written")
      for (const el of results) el.textContent = "–"
      for (const el of [...names, ...keys]) el.classList.remove("is-lit")
      clockEl.className = "rp7-comment"
      clockEl.textContent = ""
      at = 0
      run = 1
      recorded = [false, false]
      firstTime = null
      crashed = busy = false
      caption.textContent = "Click Step to run the workflow"
      render()
    })
    resetBtn.click()
    // The pointer is placed from the layout, which changes between wide and
    // narrow
    new ResizeObserver(() => render()).observe(stage)
  }
</script>

<style is:global>
  .rp7 {
    --rp7-ink: #3f3f46;
    --rp7-muted: #71717a;
    --rp7-line: #d4d4d8;
    --rp7-surface: #ffffff;
    --rp7-ok: #15803d;
    --rp7-red: #dc2626;
    --rp7-code-bg: #f6f8fa;
    --rp7-t-keyword: #d73a49;
    --rp7-t-constant: #005cc5;
    --rp7-t-function: #6f42c1;
    --rp7-t-string: #032f62;
    --rp7-t-plain: #24292e;
    --rp7-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --st-ink: var(--rp7-ink);
    --st-muted: var(--rp7-muted);
    --st-line: var(--rp7-line);
    --st-surface: var(--rp7-surface);
    margin: 1.5rem 0;
  }
  html.dark .rp7 {
    --rp7-ink: #e4e4e7;
    --rp7-muted: #a1a1aa;
    --rp7-line: #3f3f46;
    --rp7-surface: #09090b;
    --rp7-ok: #4ade80;
    --rp7-red: #f87171;
    --rp7-code-bg: #0d1117;
    --rp7-t-keyword: #f97583;
    --rp7-t-constant: #79b8ff;
    --rp7-t-function: #b392f0;
    --rp7-t-string: #9ecbff;
    --rp7-t-plain: #e1e4e8;
  }
  .rp7 p {
    margin: 0;
  }

  /* One grid: the code down the left, and each journal row on the same row
     as the line that asks for it, with room between for what moves across */
  .rp7-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    column-gap: 2.75rem;
    row-gap: 0.35rem;
    align-items: center;
    color: var(--rp7-ink);
  }
  .rp7-stage > * {
    grid-row: var(--r);
    grid-column: 1;
  }
  .rp7-stage > .is-journal,
  .rp7-stage > .rp7-entry {
    grid-column: 2;
  }
  .rp7 .rp7-title {
    margin-bottom: 0.15rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .rp7-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    min-height: 2.3rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rp7-line);
    border-radius: 0.4rem;
    background: var(--rp7-surface);
    font-size: 0.85rem;
    color: var(--rp7-muted);
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      color 200ms ease,
      opacity 250ms ease;
  }
  .rp7 .rp7-row code {
    min-width: 0;
    padding: 0;
    background: none;
    font-size: 0.82rem;
    color: inherit;
    white-space: nowrap;
  }
  /* The line about to run */
  .rp7-row.is-current {
    border-color: var(--rp7-ink);
    color: var(--rp7-ink);
  }

  /* The code's colours, from the GitHub themes the post's code blocks use */
  .rp7 .t-k {
    color: var(--rp7-t-keyword);
  }
  .rp7 .t-c {
    color: var(--rp7-t-constant);
  }
  .rp7 .t-f {
    color: var(--rp7-t-function);
  }
  .rp7 .t-s {
    color: var(--rp7-t-string);
  }
  .rp7 .t-p {
    color: var(--rp7-t-plain);
  }
  /* Code rows look like code, and the lines that aren't running step back */
  .rp7-line {
    background: var(--rp7-code-bg);
  }
  .rp7-line code {
    opacity: 0.7;
    transition: opacity 200ms ease;
  }
  .rp7-line.is-current code {
    opacity: 1;
  }

  /* An activity call, formatted the way you'd write it: the call opens on
     the line's first row, and its argument and closing brace get rows of
     their own, indented from the line's start */
  .rp7-break {
    display: block;
  }
  .rp7-arg {
    padding-left: 2ch;
  }
  /* What the call returned, as a comment after its closing brace: muted
     when it ran, green when it came from the journal. It takes up a line
     that's already there, so nothing moves. */
  .rp7-note:not(:empty) {
    margin-left: 1ch;
    color: var(--rp7-muted);
  }
  .rp7-note.is-journal {
    color: var(--rp7-ok);
  }

  /* The clock line's value, as a comment. Run again, it's different. */
  .rp7-comment {
    flex: none;
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: var(--rp7-muted);
    white-space: nowrap;
  }
  .rp7-comment:empty {
    display: none;
  }
  .rp7-comment.is-again {
    padding: 0 0.3rem;
    border-radius: 0.25rem;
    background: var(--rp7-warn);
    color: var(--rp7-warn-ink);
  }
  .rp7-comment s {
    opacity: 0.6;
  }

  /* The journal: a row as tall as the line that asks for it, with the
     activity's name over what's recorded for it */
  .rp7-stage > .rp7-entry {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.2rem;
    align-self: stretch;
    /* The same space on every side */
    padding: 0.65rem;
  }
  .rp7-key {
    flex: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    color: var(--rp7-muted);
  }
  .rp7-result {
    min-width: 0;
    color: var(--rp7-ink);
    line-height: 1.35;
  }
  /* Beside the clock line, there's nothing in the journal, and that's the
     point */
  .rp7 .rp7-aside {
    grid-column: 2;
    padding-left: 0.65rem;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--rp7-muted);
  }
  .rp7-entry.is-found {
    border-color: var(--rp7-ok);
    background: color-mix(in oklab, var(--rp7-ok) 12%, var(--rp7-surface));
  }
  .rp7-entry.is-missing {
    border-style: dashed;
  }
  .rp7-entry.is-missing .rp7-result {
    font-style: italic;
    color: var(--rp7-muted);
  }

  /* The line about to run, pointed at from the margin */
  .rp7-stage > .rp7-pointer {
    position: absolute;
    left: -0.85rem;
    width: 0;
    height: 0;
    border-block: 0.3rem solid transparent;
    border-left: 0.4rem solid var(--rp7-ink);
    transform: translateY(-50%);
    transition: top 300ms var(--rp7-ease);
  }
  .rp7-pointer[hidden] {
    display: none;
  }

  /* The arrows between the code and the journal, over everything, the same
     as the recipe's. Writing is ink, and reading back is green. */
  .rp7-arrows {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .rp7-arrow path {
    fill: none;
    stroke: var(--rp7-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rp7-arrow.is-back path {
    stroke: var(--rp7-ok);
  }
  .rp7-arrow.is-gone {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  /* Running for real: the line stays lit, with a spinner in its top right
     corner while it works */
  .rp7-line.is-working {
    border-color: var(--rp7-ink);
  }
  .rp7-line.is-working code {
    opacity: 1;
  }
  .rp7-stage > .rp7-spinner {
    position: absolute;
    z-index: 2;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--rp7-ink);
    /* Placed at the line's top right corner, then pulled inside it */
    transform: translate(calc(-100% - 0.55rem), 0.45rem);
  }
  .rp7-spinner[hidden] {
    display: none;
  }
  /* The name being looked up, lit in the code and in the journal at once */
  .rp7-name,
  .rp7-key {
    border-radius: 0.2rem;
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease;
  }
  .rp7-name.is-lit,
  .rp7-key.is-lit {
    background: color-mix(in oklab, var(--rp7-ink) 16%, transparent);
    box-shadow: 0 0 0 0.15rem color-mix(in oklab, var(--rp7-ink) 16%, transparent);
  }
  /* A result just written to the journal */
  .rp7-entry.is-written {
    border-color: var(--rp7-ink);
  }
  /* The row whose name the question stopped at */
  .rp7-entry.is-found .rp7-key,
  .rp7-entry.is-found .rp7-result {
    color: var(--rp7-ok);
  }

  /* The crash: the code fades, the journal doesn't */
