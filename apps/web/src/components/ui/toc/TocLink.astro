---
import ClassIcon from "@/assets/icons/api-kind/class.svg"
import FunctionIcon from "@/assets/icons/api-kind/function.svg"
import InterfaceIcon from "@/assets/icons/api-kind/interface.svg"
import NamespaceIcon from "@/assets/icons/api-kind/namespace.svg"
import TypeIcon from "@/assets/icons/api-kind/type.svg"
import VariableIcon from "@/assets/icons/api-kind/variable.svg"

/**
 * TOC link — owns the single reusable "On this page" link treatment shared by
 * Docs, API Reference and Blog: resting navigation text, hover → foreground, and the
 * active state driven by `aria-current="location"`. The active attribute is set
 * by the shared scroll-spy in `TableOfContents.astro`, never here.
 *
 * Structural classes (size, `font-mono`, `truncate`, indentation) come from the
 * caller via `class`; extra attributes (e.g. `title`) are spread onto the `<a>`.
 * A `hint` matching a known API kind (class, interface, type, function,
 * namespace, variable) renders as a monochromatic letter badge — the kind's
 * initial inside a rounded border — before the label so the row stays compact
 * and the letter can't be mistaken for part of the name; any other hint keeps
 * the legacy trailing `(hint)` form so generic callers don't lose information. Without a hint the label renders
 * inline and wraps (or truncates if the caller opts in).
 * Set `emphasis` for a section heading in a nested TOC.
 */
interface Props {
  readonly id: string
  readonly label: string
  readonly hint?: string | undefined
  readonly emphasis?: boolean | undefined
  readonly class?: string | undefined
  readonly [key: string]: unknown
}

const { id, label, hint, emphasis = false, class: className, ...rest } = Astro.props

const KIND_ICONS = {
  class: ClassIcon,
  function: FunctionIcon,
  interface: InterfaceIcon,
  namespace: NamespaceIcon,
  type: TypeIcon,
  variable: VariableIcon,
} as const

const KindIcon = hint !== undefined ? KIND_ICONS[hint as keyof typeof KIND_ICONS] : undefined

// The single source of the TOC link treatment.
const base = emphasis
  ? "block font-semibold text-foreground transition-colors hover:text-foreground aria-[current=location]:text-foreground"
  : "block text-navigation-foreground transition-colors hover:text-foreground aria-[current=location]:font-semibold aria-[current=location]:text-foreground"
---

<a
  href={`#${id}`}
  data-toc-link={id}
  class:list={[base, hint !== undefined && "flex min-w-0 items-baseline gap-1.5", className]}
  {...rest}
>
  {
    KindIcon !== undefined ? (
      <Fragment>
        <span
          class="flex size-4 shrink-0 items-center justify-center self-center rounded-sm border border-border text-muted-foreground"
          aria-hidden="true"
        >
          <KindIcon class="size-3" />
        </span>
        <span class="truncate">{label}</span>
      </Fragment>
    ) : hint === undefined ? (
      label
    ) : (
      <Fragment>
        <span class="truncate">{label}</span>
        <span class="shrink-0">({hint})</span>
      </Fragment>
    )
  }
</a>
