---
interface Props {
  text: string
}

const { text } = Astro.props
---

<div class="not-prose my-8">
  <blockquote
    class="m-0 border-s-2 border-border-strong ps-5 text-base leading-relaxed font-normal text-prose-foreground not-italic"
  >
    <p class="m-0 whitespace-normal">{text}</p>
  </blockquote>
</div>
