---
import NavigationMenu from "@/components/navigation/NavigationMenu.astro"
import { PRIMARY_NAVIGATION, type NavigationActiveSlug } from "@/lib/navigation"

interface Props {
  readonly activeSlug?: NavigationActiveSlug | undefined
}

const { activeSlug } = Astro.props
---

{
  PRIMARY_NAVIGATION.map((entry) =>
    entry.kind === "menu" ? (
      <NavigationMenu menu={entry} activeSlug={activeSlug} />
    ) : (
      <a
        href={entry.href}
        aria-current={entry.id === activeSlug ? "page" : undefined}
        class="text-sm font-medium text-navigation-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline aria-[current=page]:text-foreground"
      >
        {entry.label}
      </a>
    ),
  )
}
