---
/**
 * Sidebar section label — the small amber status label used for the API
 * Reference "Unstable" section. Amber is an intentional status color, kept out
 * of the neutral token set on purpose.
 */
interface Props {
  readonly class?: string
}

const { class: className } = Astro.props
---

<p
  class:list={[
    "font-mono text-xs font-semibold tracking-wider text-amber-600 uppercase dark:text-amber-400",
    className,
  ]}
>
  <slot />
</p>
