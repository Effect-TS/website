{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tools",
    "test",
    "checkpoints",
    "lessons/part1",
    "vitest.config.ts"
  ],
  // The end of lesson 8 fails to typecheck by design: its run line still needs a RuleStore.
  "exclude": [
    "lessons/part1/08-*/solution",
    "lessons/part1/09-*/start"
  ]
}
