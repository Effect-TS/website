---
import NavigationMobileMenu from "@/components/navigation/NavigationMobileMenu.astro"
import NavigationLogo from "@/components/navigation/NavigationLogo.astro"
import NavigationDesktopActions from "@/components/navigation/NavigationDesktopActions.astro"
import NavigationLinks from "@/components/navigation/NavigationLinks.astro"
import { SearchDialog } from "@/components/navigation/SearchDialog"
import {
  getNavigationLinks,
  type NavigationActiveSlug,
  type NavigationLink,
} from "@/lib/navigation"

interface Props {
  readonly activeSlug?: NavigationActiveSlug | undefined
  readonly version?: string | undefined
}

const { activeSlug, version } = Astro.props

const showThemeToggle =
  activeSlug === "playground" ||
  activeSlug === "docs" ||
  activeSlug === "api" ||
  activeSlug === "blog"

const withVersion = (links: ReadonlyArray<NavigationLink>) =>
  version === undefined
    ? links
    : links.map((link): NavigationLink => {
        if (link.kind !== "internal") return link
        if (link.id === "docs") return { ...link, href: `/docs/${version}` as `/${string}` }
        if (link.id === "api") return { ...link, href: `/docs/${version}/api` as `/${string}` }
        return link
      })

const mobilePrimaryLinks = withVersion(getNavigationLinks("mobile", "primary"))
const mobileSocialLinks = getNavigationLinks("mobile", "social")
---

<div
  class="sticky top-0 z-100 w-full will-change-transform backdrop-blur-sm border-b border-zinc-200 bg-zinc-50/85 dark:border-zinc-800 dark:bg-zinc-950/85"
>
  <div class="w-full">
    <header class="relative mx-auto w-full max-w-352 px-4">
      <nav class="flex h-16 items-center">
        <NavigationLogo />

        <div class="ml-8 hidden items-center gap-6 md:flex">
          <NavigationLinks activeSlug={activeSlug} version={version} />
        </div>

        <NavigationMobileMenu
          primaryLinks={mobilePrimaryLinks}
          socialLinks={mobileSocialLinks}
          activeSlug={activeSlug}
          showThemeToggle={showThemeToggle}
        />

        <div class="ml-auto hidden items-center gap-4.5 md:flex">
          <NavigationDesktopActions showThemeToggle={showThemeToggle} />
        </div>
      </nav>
    </header>
  </div>
</div>

<SearchDialog client:load />
