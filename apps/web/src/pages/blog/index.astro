---
import { Struct } from "effect"
import { Image } from "astro:assets"
import { getCollection, getEntries, type CollectionEntry } from "astro:content"

import BlogControls from "@/components/blog/BlogControls"
import type { SerializedPost, SerializedTag } from "@/components/blog/PostCard"
import { TWIEScrollRail } from "@/components/blog/TWIEScrollRail"
import GridBackground from "@/components/GridBackground.astro"
import PageLayout from "@/layouts/PageLayout.astro"

const [blogCollection, tagCollection] = await Promise.all([
  getCollection("blog"),
  getCollection("blogTags"),
])

const allPosts = await Promise.all(
  blogCollection.map(async (post) => {
    const tags = await getEntries(post.data.tags)

    return Struct.assign(post, {
      tags: tags,
    })
  }),
).then((posts) => posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()))

const isTWIE = (tag: CollectionEntry<"blogTags">) => tag.id === "this-week-in-effect"

const twiePosts = allPosts.filter((post) => post.tags.some(isTWIE))
const nonTwiePosts = allPosts.filter((post) => !post.tags.some(isTWIE))

const featuredCandidates = allPosts
  .filter((post) => post.data.featured && !post.tags.some(isTWIE))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

if (import.meta.env.DEV && featuredCandidates.length > 1) {
  console.warn(
    `[blog] multiple posts marked featured (${featuredCandidates.length}): ` +
      featuredCandidates.map((p) => p.id).join(", ") +
      ` — using newest`,
  )
}

const featuredPost = featuredCandidates[0]

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
}

function tagCount(id: string): number {
  if (id === "all") {
    return nonTwiePosts.length
  }
  return allPosts.filter((post) => post.tags.some((tag) => tag.id === id)).length
}

const serializedTags: SerializedTag[] = tagCollection
  .map((tag) => ({
    id: tag.id,
    name: tag.data.name,
    count: tagCount(tag.id),
  }))
  .sort((a, b) => (a.id === "all" ? -1 : b.id === "all" ? 1 : b.count - a.count))

const serializedTwiePosts: SerializedPost[] = twiePosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: formatDate(post.data.date),
  dateMs: post.data.date.getTime(),
  href: `/blog/${post.id}`,
  tags: post.tags.map((t) => ({ id: t.id, name: t.data.name })),
}))

const serializedPosts: SerializedPost[] = allPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: formatDate(post.data.date),
  dateMs: post.data.date.getTime(),
  href: `/blog/${post.id}`,
  tags: post.tags.map((t) => ({ id: t.id, name: t.data.name })),
}))
---

<PageLayout
  title="Blog | Effect"
  description="Get with the latest updates from the Effect ecosystem"
  activeSlug="blog"
  themeable
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="blog-grid-offset relative h-full">
        <GridBackground />
      </div>
    </div>

    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div
        class="absolute inset-0 opacity-100 transition-opacity duration-[250ms] ease-out dark:opacity-0"
        style="background: linear-gradient(to bottom, #ffffff 0%, transparent 30%, transparent 50%, #ffffff 100%);"
      >
      </div>
      <div
        class="absolute inset-0 opacity-0 transition-opacity duration-[250ms] ease-out dark:opacity-100"
        style="background: linear-gradient(to bottom, #09090b 0%, transparent 30%, transparent 50%, #09090b 100%);"
      >
      </div>
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[500px] opacity-0 dark:opacity-100"
      style="background: radial-gradient(ellipse 50% 80% at 50% -20%, rgb(255 255 255 / 0.08) 0%, transparent 50%), radial-gradient(ellipse 30% 50% at 70% 0%, rgba(255, 255, 255, 0.05) 0%, transparent 40%);"
    >
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 h-[500px] opacity-0 mix-blend-overlay dark:opacity-[0.12]"
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;); background-repeat: repeat;"
    >
    </div>

    <div class="relative mx-auto w-full max-w-295 px-4">
      <div class="pt-16 pb-8 md:pt-24">
        <p
          class="mb-4 font-mono text-sm font-medium tracking-wider text-zinc-600 uppercase dark:text-zinc-400"
        >
          // Effect Blog
        </p>
        <h1
          class="max-w-3xl text-3xl font-bold leading-tighter tracking-tight text-zinc-900 md:text-4xl dark:text-white"
        >
          Notes from the Effect team
        </h1>
      </div>

      {
        featuredPost && (
          <div class="pb-4">
            <a
              href={`/blog/${featuredPost.id}`}
              class="group relative block overflow-hidden rounded-md border border-zinc-300 bg-[#F7F7F8] transition-colors duration-200 hover:border-[#BABAC1] hover:bg-[#F4F4F5] dark:border-zinc-700 dark:bg-[#141315] dark:hover:border-zinc-600 dark:hover:bg-[#0F0F11]"
            >
              <div class="relative grid grid-cols-1 gap-4 p-6 md:grid-cols-12 md:items-center md:gap-10 md:p-8">
                <div class="min-w-0 md:col-span-7">
                  <div class="mb-3 flex flex-wrap items-center gap-2">
                    {featuredPost.tags.map((tag) => (
                      <span class="inline-flex items-center rounded-md border border-zinc-400 px-2 py-0.5 font-mono text-xs text-zinc-800 dark:text-zinc-200">
                        {tag.data.name}
                      </span>
                    ))}
                  </div>

                  <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
                    {featuredPost.data.title}
                  </h2>

                  <p class="mt-3 line-clamp-3 max-w-xl text-base text-zinc-700 dark:text-zinc-400">
                    {featuredPost.data.excerpt}
                  </p>
                </div>

                <div class="hidden md:col-span-5 md:flex md:flex-col md:items-center md:gap-3">
                  {featuredPost.data.featuredImage ? (
                    <div class="relative aspect-2/1 w-full overflow-hidden rounded-md border border-zinc-200/50 dark:border-zinc-800/50">
                      <Image
                        src={featuredPost.data.featuredImage}
                        alt={featuredPost.data.title}
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                      />
                      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-zinc-900/60 to-transparent" />
                    </div>
                  ) : (
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border border-zinc-300 text-zinc-700 transition-colors duration-200 group-hover:border-zinc-900 group-hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:group-hover:border-white dark:group-hover:text-white">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </div>
                  )}
                </div>

                {featuredPost.data.featuredImage && (
                  <div class="relative aspect-video overflow-hidden rounded-md border border-zinc-200/50 dark:border-zinc-800/50 md:hidden">
                    <Image
                      src={featuredPost.data.featuredImage}
                      alt={featuredPost.data.title}
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  </div>
                )}
              </div>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <div class="h-px w-full bg-zinc-200 dark:bg-zinc-800"></div>

  {
    twiePosts.length > 0 && (
      <>
        <section class="relative">
          <div class="mx-auto w-full max-w-295 px-4">
            <TWIEScrollRail
              client:load
              posts={serializedTwiePosts}
              viewAllHref="/blog?category=this-week-in-effect#blog-grid"
            />
          </div>
        </section>
        <div class="h-px w-full bg-zinc-200 dark:bg-zinc-800" />
      </>
    )
  }

  <section id="blog-grid" class="relative">
    <div class="mx-auto w-full max-w-295 px-4">
      <BlogControls
        client:load
        posts={serializedPosts}
        tags={serializedTags}
        twieTagId="this-week-in-effect"
      />
    </div>
  </section>
</PageLayout>

<style>
  .blog-grid-offset {
    transform: translateY(-1rem);
  }
</style>
