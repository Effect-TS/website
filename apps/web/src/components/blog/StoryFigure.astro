---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  src: ImageMetadata
  alt: string
  caption: string
}

const { src, alt, caption } = Astro.props
---

<figure class="not-prose mx-auto my-10 w-full max-w-xl">
  <Image
    src={src}
    alt={alt}
    class="m-0 h-auto w-full rounded-lg border border-border"
    loading="lazy"
  />
  <figcaption class="mt-3 text-center text-sm leading-relaxed text-muted-foreground">
    {caption}
  </figcaption>
</figure>
