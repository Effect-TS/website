---
import type { CollectionEntry } from "astro:content"
import { getCollection } from "astro:content"
import { Search } from "@lucide/astro"
import Navigation from "@/components/navigation/Navigation.astro"
import ApiCodeExample from "@/features/api-reference/ApiCodeExample.astro"
import { ApiReference } from "@/features/api-reference/ApiReference"
import BaseLayout from "@/layouts/BaseLayout.astro"

export async function getStaticPaths() {
  if (!import.meta.env.DEV) {
    return []
  }

  const entries = await getCollection("apiReference")
  return entries.map((entry) => ({
    params: {
      version: entry.data.version,
      package: entry.data.packageSlug,
      module: entry.data.modulePath,
    },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<"apiReference">
}

interface ReflectionSummary {
  id: number
  kind: number
  name: string
}

const { entry } = Astro.props
const reflection = await ApiReference.loadReflection(entry.data)
const packageEntries = (await getCollection("apiReference"))
  .filter(
    ({ data }) =>
      data.version === entry.data.version && data.packageName === entry.data.packageName,
  )
  .sort((left, right) => left.data.modulePath.localeCompare(right.data.modulePath))
const moduleReflection = firstRecord(reflection.children)
const declarations = reflectionSummaries(moduleReflection?.children)
const codeExamples = ApiReference.codeExamples(reflection)
const exampleOwners = [...new Set(codeExamples.map(({ ownerName }) => ownerName))].sort()
const selectedExampleOwner =
  entry.data.modulePath === "Effect" && exampleOwners.includes("cachedInvalidateWithTTL")
    ? "cachedInvalidateWithTTL"
    : exampleOwners[0]
const selectedExamples = codeExamples.filter(({ ownerName }) => ownerName === selectedExampleOwner)
const sourceUrl = firstSourceUrl(moduleReflection)
const rawJson = JSON.stringify(reflection, null, 2)

function firstRecord(value: unknown): Record<string, unknown> | undefined {
  return Array.isArray(value) ? value.find(isRecord) : undefined
}

function firstSourceUrl(value: Record<string, unknown> | undefined): string | undefined {
  const source = firstRecord(value?.sources)
  return typeof source?.url === "string" ? source.url : undefined
}

function reflectionSummaries(value: unknown): ReadonlyArray<ReflectionSummary> {
  if (!Array.isArray(value)) {
    return []
  }

  return value.flatMap((candidate) => {
    if (
      !isRecord(candidate) ||
      typeof candidate.id !== "number" ||
      typeof candidate.kind !== "number" ||
      typeof candidate.name !== "string"
    ) {
      return []
    }
    return [{ id: candidate.id, kind: candidate.kind, name: candidate.name }]
  })
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function entryHref(candidate: CollectionEntry<"apiReference">): string {
  return `/docs/api/${candidate.data.version}/${candidate.data.packageSlug}/${candidate.data.modulePath}`
}
---

<BaseLayout title={`${entry.data.modulePath} | API reference`}>
  <Navigation activeSlug="docs" wide />

  <div class="min-h-screen bg-zinc-50 pt-16 text-zinc-950 dark:bg-zinc-950 dark:text-zinc-100">
    <div class="border-b border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-950">
      <div class="mx-auto flex max-w-400 items-center gap-3 px-5 py-3 lg:px-8">
        <span
          class="rounded-full bg-amber-100 px-2.5 py-1 font-mono text-xs font-semibold tracking-wide text-amber-900 uppercase dark:bg-amber-950 dark:text-amber-200"
        >
          Local prototype
        </span>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          This explorer is available only while running Astro in development mode.
        </p>
      </div>
    </div>

    <div class="mx-auto grid max-w-400 lg:grid-cols-[300px_minmax(0,1fr)]">
      <aside
        class="border-b border-zinc-200 bg-white lg:min-h-[calc(100vh-7.25rem)] lg:border-r lg:border-b-0 dark:border-zinc-800 dark:bg-zinc-950"
      >
        <div class="sticky top-16 p-5 lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto lg:p-6">
          <div class="mb-5">
            <p class="font-mono text-xs tracking-widest text-zinc-500 uppercase">Package</p>
            <h2 class="mt-1 font-mono text-base font-semibold">{entry.data.packageName}</h2>
            <p class="mt-1 font-mono text-xs text-zinc-500">{entry.data.packageVersion}</p>
          </div>

          <label class="relative block">
            <span class="sr-only">Filter modules</span>
            <Search
              class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-zinc-400"
              aria-hidden="true"
            />
            <input
              id="api-module-filter"
              type="search"
              placeholder="Filter modules"
              class="w-full rounded-lg border border-zinc-200 bg-zinc-50 py-2 pr-3 pl-9 text-sm outline-none focus:border-sky-500 dark:border-zinc-800 dark:bg-zinc-900"
            />
          </label>

          <nav class="mt-4" aria-label="API modules">
            <ul id="api-module-list" class="space-y-0.5">
              {
                packageEntries.map((candidate) => (
                  <li data-api-module={candidate.data.modulePath.toLowerCase()}>
                    <a
                      href={entryHref(candidate)}
                      aria-current={candidate.id === entry.id ? "page" : undefined}
                      class:list={[
                        "block rounded-md px-2.5 py-1.5 font-mono text-xs break-all transition-colors",
                        candidate.id === entry.id
                          ? "bg-sky-100 text-sky-950 dark:bg-sky-950 dark:text-sky-100"
                          : "text-zinc-600 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white",
                      ]}
                    >
                      {candidate.data.modulePath}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </aside>

      <main class="min-w-0 px-5 py-8 sm:px-8 lg:px-12 lg:py-12">
        <div class="mb-10 border-b border-zinc-200 pb-8 dark:border-zinc-800">
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500">
            <span>{entry.data.version}</span>
            <span>/</span>
            <span>{entry.data.packageSlug}</span>
          </div>
          <h1 class="mt-3 font-mono text-2xl font-semibold tracking-tight sm:text-3xl">
            {entry.data.modulePath}
          </h1>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600 dark:text-zinc-400">
            <span
              ><strong class="text-zinc-900 dark:text-zinc-200">Export:</strong>
              {entry.data.exportPath}</span
            >
            <span
              ><strong class="text-zinc-900 dark:text-zinc-200">Declarations:</strong>
              {declarations.length}</span
            >
            <span
              ><strong class="text-zinc-900 dark:text-zinc-200">Examples:</strong>
              {codeExamples.length}</span
            >
            {
              sourceUrl && (
                <a class="text-sky-700 hover:underline dark:text-sky-400" href={sourceUrl}>
                  View source
                </a>
              )
            }
          </div>
        </div>

        <details
          class="rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
        >
          <summary
            class="cursor-pointer px-4 py-3 font-mono text-sm font-semibold tracking-wider uppercase select-none"
          >
            Top-level reflections ({declarations.length})
          </summary>
          {
            declarations.length > 0 ? (
              <div class="grid gap-2 border-t border-zinc-200 p-4 sm:grid-cols-2 xl:grid-cols-3 dark:border-zinc-800">
                {declarations.map((declaration) => (
                  <div class="min-w-0 rounded-lg border border-zinc-200 bg-white px-3 py-2.5 dark:border-zinc-800 dark:bg-zinc-900">
                    <p class="truncate font-mono text-sm font-medium" title={declaration.name}>
                      {declaration.name}
                    </p>
                    <p class="mt-1 font-mono text-[11px] text-zinc-500">
                      kind {declaration.kind} · id {declaration.id}
                    </p>
                  </div>
                ))}
              </div>
            ) : (
              <p class="mt-4 text-sm text-zinc-500">No top-level reflections were found.</p>
            )
          }
        </details>

        {
          selectedExampleOwner && (
            <section
              class="mt-12 border-t border-zinc-200 pt-10 dark:border-zinc-800"
              aria-labelledby="examples-heading"
            >
              <div class="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div>
                  <h2
                    id="examples-heading"
                    class="font-mono text-sm font-semibold tracking-wider uppercase"
                  >
                    Rendered examples
                  </h2>
                  <p class="mt-2 text-sm text-zinc-500">
                    Extracted from the declaration's TypeDoc comment data.
                  </p>
                </div>
                <p class="font-mono text-xs text-zinc-500">
                  Declaration
                  <br />
                  <strong class="mt-1 block text-sm text-zinc-800 dark:text-zinc-200">
                    {selectedExampleOwner}
                  </strong>
                </p>
              </div>

              <div class="space-y-10">
                {selectedExamples.map((example) => (
                  <ApiCodeExample example={example} />
                ))}
              </div>
            </section>
          )
        }

        <details
          class="mt-10 rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
        >
          <summary class="cursor-pointer px-4 py-3 font-mono text-sm font-semibold select-none">
            Complete TypeDoc JSON ({rawJson.length.toLocaleString()} characters)
          </summary>
          <pre
            class="max-h-[70vh] overflow-auto border-t border-zinc-200 p-4 text-xs leading-relaxed dark:border-zinc-800"><code>{rawJson}</code></pre>
        </details>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLInputElement>("#api-module-filter")
  const modules = document.querySelectorAll<HTMLElement>("[data-api-module]")

  filter?.addEventListener("input", () => {
    const query = filter.value.trim().toLowerCase()
    for (const module of modules) {
      module.hidden = query.length > 0 && !module.dataset.apiModule?.includes(query)
    }
  })
</script>
