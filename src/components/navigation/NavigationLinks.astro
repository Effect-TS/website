---
import NavigationAnchor from "@/components/navigation/NavigationAnchor.astro"
import { getNavigationLinks, type NavigationActiveSlug } from "@/lib/navigation"

interface Props {
  readonly activeSlug?: NavigationActiveSlug | undefined
}

const { activeSlug } = Astro.props

const links = getNavigationLinks("desktop", "primary")
---

{
  links.map((link) => (
    <NavigationAnchor
      link={link}
      class="text-sm font-medium no-underline transition-colors text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
      active={link.id === activeSlug}
      activeClass="text-zinc-900 dark:text-white"
    />
  ))
}
