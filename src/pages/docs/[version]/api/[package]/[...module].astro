---
import type { GetStaticPaths } from "astro"
import { getCollection } from "astro:content"
import { ChevronDown, Link as LinkIcon } from "@lucide/astro"

import Footer from "@/components/Footer.astro"
import Navigation from "@/components/navigation/Navigation.astro"
import ApiDeclaration from "@/features/api-reference/ApiDeclaration.astro"
import ApiMobileNavigation from "@/features/api-reference/ApiMobileNavigation.astro"
import * as ApiReference from "@/features/api-reference/ApiReference"
import { resolveApiReferenceOpenGraph } from "@/features/api-reference/open-graph"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { PAGE_TITLE_ID } from "@/lib/constants/skip-link"

export const getStaticPaths = (async () => {
  const entries = await getCollection("apiReference")
  return entries.map((entry) => ({
    params: {
      version: entry.data.version,
      package: entry.data.packageSlug,
      module: entry.data.modulePath,
    },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const allEntries = await getCollection("apiReference")
const reflection = await ApiReference.loadReflection(entry.data)
const apiModule = await ApiReference.ApiReference.moduleView(reflection)
const moduleName = entry.data.modulePath.split("/").at(-1) ?? entry.data.modulePath
const displayName = entry.data.packageName.replace("@effect/", "")
const openGraph = resolveApiReferenceOpenGraph(
  `docs/${entry.data.version}/api/${entry.data.packageSlug}/${entry.data.modulePath}`,
  [entry.data],
)
const packageEntries = allEntries
  .filter(
    (candidate) =>
      candidate.data.version === entry.data.version &&
      candidate.data.packageSlug === entry.data.packageSlug,
  )
  .toSorted((left, right) => left.data.modulePath.localeCompare(right.data.modulePath))
const versionLinks = ["v3", "v4"].map((version) => {
  const exact = allEntries.find(
    (candidate) =>
      candidate.data.version === version &&
      candidate.data.packageSlug === entry.data.packageSlug &&
      candidate.data.modulePath === entry.data.modulePath,
  )
  return {
    href:
      exact === undefined
        ? undefined
        : `/docs/${exact.data.version}/api/${exact.data.packageSlug}/${exact.data.modulePath}`,
    version,
  }
})
const showVersionSwitch = versionLinks.every(({ href }) => href !== undefined)
const moduleHref = (modulePath: string) =>
  `/docs/${entry.data.version}/api/${entry.data.packageSlug}/${modulePath}`

function moduleSection(modulePath: string): string {
  const parts = modulePath.split("/")
  if (entry.data.packageName === "effect" && parts[0] === "unstable") {
    return `unstable/${parts[1] ?? "other"}`
  }
  return parts.length === 1 ? "core" : (parts[0] ?? "core")
}

const groups = [...Map.groupBy(packageEntries, (module) => moduleSection(module.data.modulePath))]
const stableGroups = groups.filter(([group]) => !group.startsWith("unstable/"))
const unstableGroups = groups.filter(([group]) => group.startsWith("unstable/"))
const sections = [
  { label: undefined, groups: stableGroups },
  { label: "Unstable", groups: unstableGroups },
].filter(({ groups }) => groups.length > 0)
const mobileVersions = showVersionSwitch
  ? versionLinks.flatMap(({ href, version }) =>
      href === undefined
        ? []
        : [{ href, label: version, selected: version === entry.data.version }],
    )
  : []
const mobilePackages = Array.from(
  Map.groupBy(
    allEntries.filter((candidate) => candidate.data.version === entry.data.version),
    (candidate) => candidate.data.packageSlug,
  ),
)
  .map(([, entries]) => entries[0])
  .flatMap((candidate) =>
    candidate === undefined
      ? []
      : [
          {
            href: `/docs/${entry.data.version}/api/${candidate.data.packageSlug}`,
            label: candidate.data.packageName.replace("@effect/", ""),
            selected: candidate.data.packageSlug === entry.data.packageSlug,
          },
        ],
  )
  .toSorted((left, right) => left.label.localeCompare(right.label))
const mobileModules = packageEntries.map((candidate) => ({
  href: moduleHref(candidate.data.modulePath),
  label: candidate.data.modulePath,
  selected: candidate.id === entry.id,
}))

function groupName(group: string): string {
  const name = group.replace("unstable/", "")
  return name.replace(/[-_]/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase())
}

function sidebarModuleName(modulePath: string, group: string): string {
  if (group === "core") return modulePath
  const prefix = `${group}/`
  return modulePath.startsWith(prefix) ? modulePath.slice(prefix.length) : modulePath
}
---

<BaseLayout
  title={`${moduleName} API Reference | Effect`}
  description={openGraph?.description}
  ogImageVersion={entry.data.revision}
>
  <Navigation activeSlug="api" wide />

  <div class="relative w-full">
    <ApiMobileNavigation
      version={entry.data.version}
      versions={mobileVersions}
      packages={mobilePackages}
      modules={mobileModules}
    />
    <div
      class="mx-auto grid w-full max-w-352 grid-cols-1 lg:grid-cols-[240px_1fr] xl:grid-cols-[240px_1fr_240px]"
    >
      <aside class="hidden border-r border-zinc-200 lg:block dark:border-zinc-800">
        <nav
          aria-label="API reference navigation"
          data-api-sidebar
          data-module-sidebar
          class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-8"
        >
          <header class="mb-4">
            <a
              href={`/docs/${entry.data.version}/api`}
              class="mb-4 block font-mono text-sm font-semibold tracking-widest text-zinc-900 uppercase hover:underline dark:text-white"
            >
              API Reference
            </a>

            <h2 class="mb-1 font-mono text-lg font-semibold tracking-tight">{displayName}</h2>
            <p class="font-mono text-xs text-zinc-600 dark:text-zinc-400">
              {entry.data.packageVersion}
            </p>
          </header>

          {
            showVersionSwitch && (
              <div
                role="group"
                aria-label="API reference version"
                class="mb-4 grid grid-cols-2 gap-1 rounded-md border border-zinc-200 p-1 dark:border-zinc-800"
              >
                {versionLinks.map(({ href, version }) => (
                  <a
                    href={href}
                    aria-current={version === entry.data.version ? "page" : undefined}
                    class:list={[
                      "rounded px-2 py-1 text-center font-mono text-xs transition-colors",
                      version === entry.data.version
                        ? "bg-zinc-200 font-semibold text-zinc-900 dark:bg-zinc-800 dark:text-white"
                        : "text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900/60 dark:hover:text-white",
                    ]}
                  >
                    {version}
                  </a>
                ))}
              </div>
            )
          }

          <ul class="flex flex-col">
            {
              sections.map((section) => (
                <Fragment>
                  {section.label !== undefined && (
                    <li class="mt-2 border-t border-zinc-200 pt-4 dark:border-zinc-800">
                      <p class="font-mono text-xs font-semibold tracking-wider text-amber-600 uppercase dark:text-amber-400">
                        {section.label}
                      </p>
                    </li>
                  )}
                  {section.groups.map(([group, modules]) => (
                    <li>
                      <details open={modules.some((candidate) => candidate.id === entry.id)}>
                        <summary class="flex cursor-pointer select-none list-none items-center justify-between rounded py-2 font-mono text-sm font-medium tracking-wider text-zinc-700 uppercase transition-colors hover:text-zinc-900 dark:text-zinc-300 dark:hover:text-white">
                          <span>{groupName(group)}</span>
                          <ChevronDown
                            aria-hidden="true"
                            class="size-4 transition-transform details-chevron"
                          />
                        </summary>
                        <ul class="flex flex-col">
                          {modules
                            .toSorted((left, right) =>
                              left.data.modulePath.localeCompare(right.data.modulePath),
                            )
                            .map((candidate) => (
                              <li>
                                <a
                                  href={moduleHref(candidate.data.modulePath)}
                                  aria-current={candidate.id === entry.id ? "page" : undefined}
                                  data-current-module={candidate.id === entry.id ? "" : undefined}
                                  class:list={[
                                    "block truncate rounded-md py-1 pl-3 font-mono text-sm transition-colors",
                                    candidate.id === entry.id
                                      ? "bg-zinc-200 font-semibold text-zinc-900 dark:bg-zinc-800 dark:text-white"
                                      : "text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900/60 dark:hover:text-white",
                                  ]}
                                >
                                  {sidebarModuleName(candidate.data.modulePath, group)}
                                </a>
                              </li>
                            ))}
                        </ul>
                      </details>
                    </li>
                  ))}
                </Fragment>
              ))
            }
          </ul>
        </nav>
      </aside>

      <main id={PAGE_TITLE_ID} class="min-w-0 px-6 pt-6 pb-12 lg:px-12 lg:py-16">
        <nav
          aria-label="Breadcrumb"
          class="mb-5 flex flex-wrap items-center gap-3 font-mono text-xs tracking-wider text-zinc-600 uppercase lg:mb-8 dark:text-zinc-400"
        >
          <a
            href={`/docs/${entry.data.version}/api`}
            class="text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            API Reference
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={`/docs/${entry.data.version}/api`}
            class="text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            {entry.data.version}
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={`/docs/${entry.data.version}/api/${entry.data.packageSlug}`}
            class="text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
          >
            {displayName}
          </a>
          <span aria-hidden="true">/</span>
          <span>{moduleName}</span>
        </nav>

        <article
          class="max-w-4xl prose prose-zinc dark:prose-invert prose-sm md:prose-base
                   prose-headings:font-semibold prose-headings:tracking-tight
                   prose-headings:mt-6 prose-headings:mb-3 prose-p:my-3 prose-p:text-[0.9375rem] prose-p:leading-6 prose-ul:my-3 prose-ol:my-3 prose-li:my-1
                   prose-code:bg-zinc-200 prose-code:text-zinc-700 dark:prose-code:bg-zinc-800 dark:prose-code:text-zinc-200 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
                   prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-700"
        >
          <header class="mb-8 lg:mb-12">
            <h1 class="mb-4! font-mono md:mb-6!">{moduleName}</h1>
            {apiModule.commentHtml && <div class="mb-6" set:html={apiModule.commentHtml} />}
            <div
              class="not-prose flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-sm text-zinc-600 dark:text-zinc-400"
            >
              <span>{apiModule.declarationCount} exports</span>
              {apiModule.since && <span>Added in v{apiModule.since}</span>}
              {
                apiModule.sourceUrl && (
                  <a
                    href={apiModule.sourceUrl}
                    target="_blank"
                    class="inline-flex items-center gap-2 transition-colors hover:text-zinc-900 dark:hover:text-white"
                  >
                    <i class="ri-github-fill text-base" aria-hidden="true" /> Source
                  </a>
                )
              }
            </div>
          </header>

          <div class="not-prose space-y-4">
            {
              apiModule.groups.map((group) => (
                <section id={group.slug} class="scroll-mt-24">
                  <h2 class="mb-0 text-3xl font-semibold tracking-tight">
                    <a
                      href={`#${group.slug}`}
                      class="group relative inline-block text-inherit no-underline!"
                    >
                      <LinkIcon
                        class="absolute top-1/2 right-full mr-2 size-4 -translate-y-1/2 text-zinc-400 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                        aria-hidden="true"
                      />
                      {group.name}
                    </a>
                  </h2>
                  <div>
                    {group.declarations.map((declaration) => (
                      <ApiDeclaration declaration={declaration} />
                    ))}
                  </div>
                </section>
              ))
            }
          </div>
        </article>
      </main>

      <aside class="hidden border-l border-zinc-200 xl:block dark:border-zinc-800">
        <nav
          aria-label="On this page"
          class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto px-6 py-8"
        >
          <p class="mb-4 font-mono text-sm font-semibold tracking-[0.14em] uppercase">
            On this page
          </p>
          <div class="mb-5 h-px bg-zinc-200 dark:bg-zinc-800"></div>
          <ul class="space-y-5">
            {
              apiModule.groups.map((group) => (
                <li>
                  <a
                    href={`#${group.slug}`}
                    data-toc-link={group.slug}
                    data-toc-group
                    class="block text-sm font-semibold transition-colors hover:text-zinc-950 dark:hover:text-white"
                  >
                    {group.name}
                  </a>
                  <ul class="mt-2 space-y-2 pl-3">
                    {group.declarations.map((declaration) => (
                      <li>
                        <a
                          href={`#${declaration.anchor}`}
                          data-toc-link={declaration.anchor}
                          data-toc-export
                          title={`${declaration.name}${declaration.typeKind === undefined ? "" : ` (${declaration.typeKind})`}`}
                          class="flex min-w-0 items-baseline gap-1 font-mono text-xs text-zinc-600 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white"
                        >
                          <span class="truncate">{declaration.name}</span>
                          {declaration.typeKind && (
                            <span class="shrink-0">({declaration.typeKind})</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
    </div>

    <Footer />
  </div>
</BaseLayout>

<style>
  details[open] > summary .details-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const moduleSidebar = document.querySelector<HTMLElement>("[data-module-sidebar]")
  const currentModuleLink = moduleSidebar?.querySelector<HTMLElement>("[data-current-module]")

  if (moduleSidebar !== null && currentModuleLink !== undefined && currentModuleLink !== null) {
    const details = currentModuleLink.closest("details")
    if (details instanceof HTMLDetailsElement) details.open = true

    requestAnimationFrame(() => {
      const sidebarBounds = moduleSidebar.getBoundingClientRect()
      const linkBounds = currentModuleLink.getBoundingClientRect()
      const isVisible =
        linkBounds.top >= sidebarBounds.top && linkBounds.bottom <= sidebarBounds.bottom
      if (isVisible) return

      moduleSidebar.scrollTop +=
        linkBounds.top - sidebarBounds.top - (moduleSidebar.clientHeight - linkBounds.height) / 2
    })
  }

  function observeTableOfContents(selector: string) {
    const links = document.querySelectorAll<HTMLAnchorElement>(selector)
    const targets = [...links].flatMap((link) => {
      const id = link.dataset.tocLink
      const target = id === undefined ? null : document.getElementById(id)
      return target === null ? [] : [{ link, target }]
    })
    if (targets.length === 0) return

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((candidate) => candidate.isIntersecting)
        if (visible === undefined) return
        for (const { link, target } of targets) {
          const active = target === visible.target
          link.classList.toggle("font-semibold", active)
          link.classList.toggle("text-zinc-950", active)
          link.classList.toggle("dark:text-white", active)
        }
      },
      { rootMargin: "-15% 0px -75%" },
    )
    for (const { target } of targets) observer.observe(target)
  }

  observeTableOfContents("[data-toc-group]")
  observeTableOfContents("[data-toc-export]")
</script>
