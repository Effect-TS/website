---
import { Link as LinkIcon } from "@lucide/astro"
import { Code } from "astro-expressive-code/components"

import GitHubLogo from "@/assets/icons/fa7-brands/github.svg"
import { API_JSDOC_CLASS, type ApiDeclaration } from "./ApiReference"
import ApiBadge from "./ApiBadge.astro"
import ApiCodeExample from "./ApiCodeExample.astro"
import ApiSectionHeading from "./ApiSectionHeading.astro"
import ApiStabilityBadge from "./ApiStabilityBadge.astro"
import { splitComment } from "./comment-sections"

interface Props {
  declaration: ApiDeclaration
}

const { declaration } = Astro.props
const comment = declaration.commentHtml ? splitComment(declaration.commentHtml) : undefined
---

<section
  id={declaration.anchor}
  class="@container scroll-mt-12 border-t border-border py-8 first:border-t-0"
>
  <div
    class="mb-2 grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 gap-y-2 @max-[30rem]:grid-cols-1"
  >
    <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
      <h3
        class="m-0! min-w-0 font-mono text-xl! font-semibold tracking-tight wrap-anywhere text-foreground"
      >
        <a
          href={`#${declaration.anchor}`}
          class="group relative inline-block text-inherit no-underline!"
        >
          <LinkIcon
            class="absolute top-1/2 right-full mr-2 size-3.5 -translate-y-1/2 text-subtle-foreground opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
            aria-hidden="true"
          />
          {declaration.name}
        </a>
      </h3>
      {declaration.typeKind && <ApiBadge>{declaration.typeKind}</ApiBadge>}
      <ApiStabilityBadge stability={declaration.stability} />
    </div>
    {
      (declaration.since || declaration.sourceUrl) && (
        <div class="not-prose flex h-[34px] shrink-0 items-center gap-3 font-mono text-xs text-muted-foreground @max-[30rem]:h-auto">
          {declaration.since && <span>Since v{declaration.since}</span>}
          {declaration.sourceUrl && (
            <a
              href={declaration.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground focus-visible:text-foreground"
              aria-label={`View source for ${declaration.name} (opens in new tab)`}
              title="View source"
            >
              <GitHubLogo class="size-4" aria-hidden="true" />
              <span class="hidden @max-[30rem]:inline">Source</span>
            </a>
          )}
        </div>
      )
    }
  </div>

  {
    comment && comment.summary !== "" && (
      <div
        class:list={[API_JSDOC_CLASS, "prose prose-effect mt-2 max-w-none"]}
        set:html={comment.summary}
      />
    )
  }

  {
    comment && comment.sections !== "" && (
      <div
        class:list={[API_JSDOC_CLASS, "prose prose-effect max-w-none [&_h4+*]:mt-0!"]}
        set:html={comment.sections}
      />
    )
  }

  {
    declaration.signature && (
      <div class="not-prose">
        <ApiSectionHeading>Signature</ApiSectionHeading>
        <div class="pt-1.5">
          <Code
            code={declaration.signature}
            lang="typescript"
            meta="showLineNumbers=false playground=false"
          />
        </div>
      </div>
    )
  }

  {
    declaration.examples.length > 0 && (
      <div class="not-prose space-y-6">
        {declaration.examples.map((example) => (
          <ApiCodeExample example={example} />
        ))}
      </div>
    )
  }
</section>
