---
import "../styles/global.css"

import { Font } from "astro:assets"
import { SEO } from "astro-seo"
import { PUBLIC_POSTHOG_API_HOST, PUBLIC_POSTHOG_KEY } from "astro:env/client"

import SkipLink from "@/components/SkipLink.astro"
import {
  OPENGRAPH_IMAGE_HEIGHT,
  OPENGRAPH_IMAGE_WIDTH,
} from "@/features/open-graph/constants"

interface Props {
  readonly title?: string | undefined
  readonly description?: string | undefined
  readonly forceDark?: boolean | undefined
  readonly ogImageVersion?: string | undefined
}

const {
  title = "Effect | Production Grade TypeScript",
  description,
  forceDark = false,
  ogImageVersion,
} = Astro.props

const getOgImagePath = () => {
  const pathname = Astro.url.pathname
  let slug = pathname.replace(/^\//, "").replace(/\/$/, "")
  if (slug.length === 0) slug = "index"
  return `/og/${slug}.png`
}

const ogImagePath = getOgImagePath()
const ogImageUrl = new URL(ogImagePath, Astro.url.origin)
if (ogImageVersion !== undefined) ogImageUrl.searchParams.set("v", ogImageVersion)

const pagePathname = Astro.url.pathname.replace(/\/$/, "")
const canonicalUrl = new URL(pagePathname, Astro.site)
---

<!doctype html>
<html lang="en" class:list={[{ dark: forceDark }]} {...forceDark ? { "data-force-dark": "" } : {}}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    {/* Tint Firefox's initial canvas before first paint (bug 1488384). */}
    <meta name="color-scheme" content={forceDark ? "dark" : "light dark"} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />

    {/* Critical paint styles applied before the bundle loads. */}
    <style is:inline>
      html {
        background: oklch(1 0 0);
        font-family: var(--font-inter, ui-sans-serif, system-ui, sans-serif);
      }
      html.dark {
        background: oklch(0.141 0.005 285.823);
        color-scheme: dark;
      }
      [data-skip-link] {
        transform: translateY(-200%);
      }
    </style>

    {
      PUBLIC_POSTHOG_KEY && (
        <>
          <script is:inline define:vars={{ PUBLIC_POSTHOG_KEY }}>
            ;(function () {
              var token = PUBLIC_POSTHOG_KEY.replace(/\+/g, "PL")
                .replace(/\//g, "SL")
                .replace(/=/g, "EQ")
              var key = "ph_" + token + "_posthog"
              var keys = [key, key + "__flags", key + "__surveys"]

              for (var i = 0; i < keys.length; i++) {
                try {
                  localStorage.removeItem(keys[i])
                  sessionStorage.removeItem(keys[i])
                } catch (_) {}
              }

              var expired = "=; Max-Age=0; Path=/; SameSite=Lax"
              document.cookie = key + expired
              var parts = location.hostname.split(".")
              for (var j = 0; j < parts.length - 1; j++) {
                document.cookie = key + expired + "; Domain=." + parts.slice(j).join(".")
              }
            })()
          </script>
          <script is:inline define:vars={{ PUBLIC_POSTHOG_API_HOST, PUBLIC_POSTHOG_KEY }}>
            // oxlint-disable-next-line no-unused-expressions oxc/number-arg-out-of-range
            !function(t,e){"use strict";var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
            posthog.init(PUBLIC_POSTHOG_KEY, {api_host:PUBLIC_POSTHOG_API_HOST, ui_host:'https://us.posthog.com', defaults:'2026-05-30', cookieless_mode:'always'})
          </script>
        </>
      )
    }

    <script is:inline>
      ;(function () {
        var force = document.documentElement.hasAttribute("data-force-dark")
        if (force) {
          document.documentElement.classList.add("dark")
          document.documentElement.dataset.theme = "dark"
          return
        }
        var stored = localStorage.getItem("theme")
        if (stored) { try { stored = JSON.parse(stored) } catch (_) {} }
        var isDark
        if (stored === "light") {
          isDark = false
        } else if (stored === "dark") {
          isDark = true
        } else if (stored === "system") {
          isDark = window.matchMedia("(prefers-color-scheme: dark)").matches
        } else {
          isDark = true
        }
        document.documentElement.classList.toggle("dark", isDark)
        document.documentElement.dataset.theme = isDark ? "dark" : "light"
        new MutationObserver(function () {
          var dark = document.documentElement.classList.contains("dark")
          document.documentElement.dataset.theme = dark ? "dark" : "light"
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        })
      })()
    </script>

    <SEO
      title={title}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          type: "website",
          url: canonicalUrl,
          title,
          image: ogImageUrl.toString(),
        },
        image: {
          height: OPENGRAPH_IMAGE_HEIGHT,
          width: OPENGRAPH_IMAGE_WIDTH,
        },
        optional: {
          siteName: "Effect",
          ...(description ? { description } : undefined),
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        image: ogImageUrl,
        ...(description ? { description } : undefined),
      }}
      extend={{
        link: [{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" }],
      }}
      {...description ? { description } : undefined}
    />

    {/* Hide the announcement banner before first paint for a visitor who
        dismissed it, so it never flashes. Shown by default otherwise. */}
    <script is:inline>
      try {
        if (localStorage.getItem("effect-days-2026-banner-dismissed")) {
          document.documentElement.classList.add("announcement-dismissed")
        }
      } catch (_) {}
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <SkipLink />
    <slot />
  </body>
</html>
