<canvas data-hero-grid-pulse aria-hidden="true" class="pointer-events-none fixed left-0 z-5 hidden"
></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-grid-pulse]")
  const hero = canvas?.closest("section")
  const ctx = canvas?.getContext("2d")

  const run = (canvas: HTMLCanvasElement, hero: HTMLElement, ctx: CanvasRenderingContext2D) => {
    const W = document.documentElement.clientWidth
    const rect = hero.getBoundingClientRect()
    const H = rect.height

    // Canvas covers the hero only (not the viewport) to keep the fill cost low.
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    canvas.style.top = `${rect.top}px`
    canvas.style.width = `${W}px`
    canvas.style.height = `${H}px`
    canvas.classList.remove("hidden")
    canvas.width = W * dpr
    canvas.height = H * dpr
    ctx.scale(dpr, dpr)

    const rem = Number.parseFloat(getComputedStyle(document.documentElement).fontSize)
    const CELL_W = (73.75 * rem) / 6
    const CELL_H = 194
    const anchorX = W / 2 + 0.5

    const gridPath = new Path2D()
    const firstCol = Math.floor(-anchorX / CELL_W) - 1
    const lastCol = Math.ceil((W - anchorX) / CELL_W) + 1
    for (let col = firstCol; col <= lastCol; col++) {
      const x = anchorX + col * CELL_W
      gridPath.moveTo(x, 0)
      gridPath.lineTo(x, H)
    }
    for (let row = 0; row <= Math.floor(H / CELL_H); row++) {
      const y = row * CELL_H + 0.5
      gridPath.moveTo(0, y)
      gridPath.lineTo(W, y)
    }

    const originX = W / 2
    const originY = window.innerHeight / 2 - rect.top
    const maxDist = Math.max(Math.hypot(originX, originY), Math.hypot(originX, H - originY))

    const BAND = 150
    const DURATION = 3000
    const WAVE_TIME = 2300

    const ring = (inner: number, outer: number, peak: number) => {
      const gradient = ctx.createRadialGradient(originX, originY, inner, originX, originY, outer)
      gradient.addColorStop(0, "rgba(255, 255, 255, 0)")
      gradient.addColorStop(0.7, `rgba(255, 255, 255, ${peak})`)
      gradient.addColorStop(1, "rgba(255, 255, 255, 0)")
      return gradient
    }

    let start: number | undefined
    const tick = (now: number) => {
      // Clock starts on the first painted frame so load work can't skip the ring ahead.
      start ??= now
      const elapsed = now - start
      ctx.clearRect(0, 0, W, H)

      const r = (elapsed / WAVE_TIME) * (maxDist + BAND)
      const fade = elapsed > DURATION - 600 ? Math.max(0, (DURATION - elapsed) / 600) : 1

      if (fade > 0 && r > 0) {
        const inner = Math.max(0, r - BAND)
        const outer = r + BAND * 0.4

        ctx.strokeStyle = ring(inner, outer, 0.35 * fade)
        ctx.lineWidth = 1
        ctx.stroke(gridPath)

        ctx.fillStyle = ring(inner, outer, 0.03 * fade)
        ctx.fillRect(0, 0, W, H)
      }

      if (elapsed < DURATION) {
        requestAnimationFrame(tick)
      } else {
        canvas.style.display = "none"
        document.dispatchEvent(new CustomEvent("hero-grid-pulse-complete"))
      }
    }

    requestAnimationFrame(tick)
  }

  if (canvas && hero && ctx && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // Wait for load, then one idle slot, so hydration and image decode don't compete with frames.
    const start = () =>
      (window.requestIdleCallback ?? window.setTimeout)(() => run(canvas, hero, ctx))
    if (document.readyState === "complete") start()
    else window.addEventListener("load", start, { once: true })
  }
</script>
