---
interface Props {
  stats: Array<{
    value: string
    label: string
  }>
}

const { stats } = Astro.props
---

<dl
  class:list={[
    "m-0 grid divide-x divide-border border-t border-border",
    stats.length === 2 ? "grid-cols-2" : "grid-cols-3",
  ]}
>
  {
    stats.map(({ value, label }) => (
      <div class="flex flex-col gap-2 px-4 py-6 sm:px-6">
        <dt class="order-2 text-[15px] leading-snug text-muted-foreground">{label}</dt>
        <dd class="m-0 text-3xl leading-none font-semibold tracking-tight text-foreground tabular-nums sm:text-[36px]">
          {value}
        </dd>
      </div>
    ))
  }
</dl>
