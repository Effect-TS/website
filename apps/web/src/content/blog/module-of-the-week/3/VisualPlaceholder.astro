---
// Draft-only stand-in for an interactive visual that hasn't been built yet.
interface Props {
  name: string
}

const { name } = Astro.props
---

<div
  class="not-prose my-8 rounded-lg border-2 border-dashed border-border bg-card/40 px-5 py-4 text-sm leading-relaxed text-muted-foreground"
>
  <p class="m-0 mb-1 font-mono text-xs uppercase tracking-wide">TODO visual: {name}</p>
  <slot />
</div>
