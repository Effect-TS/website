---
interface Props {
  readonly tone?: "breaking" | "latest" | undefined
  readonly class?: string | undefined
}

const { tone = "breaking", class: className } = Astro.props

const tones = {
  breaking: {
    class: "bg-destructive/10 text-destructive",
    title: "This release contains breaking changes.",
  },
  latest: {
    class: "text-muted-foreground ring-1 ring-border ring-inset",
    title: "This is the latest release.",
  },
}
---

<span
  class:list={[
    "inline-flex items-center rounded px-1.5 py-0.5 text-[10px] leading-none font-medium tracking-wider uppercase",
    tones[tone].class,
    className,
  ]}
  title={tones[tone].title}
>
  <slot />
</span>
