---
import { ChevronDown } from "@lucide/astro"

import DocsMobileBar from "@/components/docs/DocsMobileBar.astro"
import DocsSectionSwitch from "@/components/docs/DocsSectionSwitch.astro"
import type { DocsVersionLink } from "@/lib/versions"

export interface ApiMobileNavigationItem {
  readonly disabled?: boolean
  readonly href: string
  readonly label: string
  readonly selected?: boolean
}

interface Props {
  readonly version: string
  readonly versionLinks: ReadonlyArray<DocsVersionLink>
  readonly packages?: ReadonlyArray<ApiMobileNavigationItem>
  readonly modules?: ReadonlyArray<ApiMobileNavigationItem>
}

const { version, versionLinks, packages = [], modules = [] } = Astro.props

const selects = [
  { label: "Package", items: packages },
  { label: "Module", items: modules },
].filter(({ items }) => items.length > 0)
---

<DocsMobileBar versionLinks={versionLinks}>
  <DocsSectionSwitch section="api" version={version} orientation="horizontal" />
</DocsMobileBar>

{/* Scrolls away with the page, so only the section bar stays pinned. */}
<nav aria-label="API reference mobile navigation" class="border-b border-border lg:hidden">
  <div class="mx-auto flex h-12 max-w-352 items-center gap-2 px-4">
    {
      selects.map(({ label, items }) => (
        <label class="relative block min-w-0 flex-1">
          <span class="sr-only">{label}</span>
          <select
            aria-label={label}
            data-api-navigation-select
            class="h-8 w-full appearance-none truncate rounded-md border border-border bg-card py-1 pr-7 pl-2 font-mono text-xs text-foreground outline-none transition-colors hover:border-border-strong focus:border-border-strong"
          >
            {items.map((item) => (
              <option value={item.href} selected={item.selected} disabled={item.disabled}>
                {item.label}
              </option>
            ))}
          </select>
          <ChevronDown
            class="pointer-events-none absolute top-1/2 right-2 size-3 -translate-y-1/2 text-muted-foreground"
            aria-hidden="true"
          />
        </label>
      ))
    }
  </div>
</nav>

<script>
  function initializeApiNavigation() {
    for (const select of document.querySelectorAll<HTMLSelectElement>(
      "[data-api-navigation-select]",
    )) {
      if (select.dataset.initialized === "true") continue
      select.dataset.initialized = "true"
      select.addEventListener("change", () => {
        window.location.assign(select.value)
      })
    }
  }

  initializeApiNavigation()
  document.addEventListener("astro:page-load", initializeApiNavigation)
</script>
