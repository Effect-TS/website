---
/**
 * The v3/v4 segmented version switch shown at the top of every API Reference
 * sidebar. Each page builds the per-target hrefs; this holds the shared markup.
 */
interface Props {
  readonly versions: ReadonlyArray<{
    readonly href: string
    readonly label: string
    readonly active: boolean
  }>
}

const { versions } = Astro.props
---

<div
  role="group"
  aria-label="API reference version"
  class="mb-4 grid grid-cols-2 gap-1 rounded-md border border-border p-1"
>
  {
    versions.map(({ href, label, active }) => (
      <a
        href={href}
        aria-current={active ? "page" : undefined}
        class:list={[
          "rounded px-2 py-1 text-center font-mono text-xs transition-colors",
          active
            ? "bg-accent font-semibold text-foreground"
            : "text-muted-foreground hover:bg-muted hover:text-foreground",
        ]}
      >
        {label}
      </a>
    ))
  }
</div>
