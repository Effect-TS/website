---
import { getDocsFamiliesByPath, type DocsFamily } from "@/lib/docs/diataxis"

interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href, class: className, ...props } = Astro.props

async function getDestinationFamily(href: string | undefined): Promise<DocsFamily | undefined> {
  if (href === undefined || /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(href)) {
    return undefined
  }

  const pathname = new URL(href, Astro.url).pathname.replace(/\/$/, "")

  if (/^\/docs\/[^/]+\/api(?:\/|$)/.test(pathname)) {
    return "reference"
  }

  return (await getDocsFamiliesByPath()).get(pathname)
}

const destinationFamily = await getDestinationFamily(href)
const destinationClass =
  destinationFamily === undefined ? undefined : `docs-link-${destinationFamily}`
---

<a
  {...props}
  href={href}
  class:list={[className, destinationClass]}
  data-doc-destination={destinationFamily}
>
  <slot />
</a>
