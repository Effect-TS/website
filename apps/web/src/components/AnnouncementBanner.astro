---
import { ArrowRight } from "@lucide/astro"

// Permanent site-wide banner sharing the navbar's sticky wrapper. Not
// dismissible. Its bottom-border glow expands once on load and stays visible.
---

<effect-announcement
  data-announcement
  role="region"
  aria-label="Announcement"
  class="group relative flex min-h-10 items-center justify-center border-b border-zinc-700/60 bg-zinc-900 px-10 py-2 text-zinc-100 transition-colors has-[a:hover]:bg-zinc-800"
>
  <span
    aria-hidden="true"
    class="announcement-glow pointer-events-none absolute inset-x-0 -bottom-px h-px"
  ></span>

  <a
    href="/effect-days"
    aria-label="Effect Days 2026: December 9–11 in Livorno, Italy"
    class="absolute inset-0"></a>

  <div
    class="pointer-events-none flex min-w-0 items-center justify-center gap-2 font-mono text-[12.5px] font-medium tracking-wider uppercase"
  >
    <span class="text-center">// EFFECT DAYS 2026 · LIVORNO DEC 9-11</span>
    <ArrowRight
      size={16}
      class="shrink-0 transition-transform group-hover:translate-x-0.5"
      aria-hidden="true"
    />
  </div>
</effect-announcement>

<style is:global>
  @keyframes announcement-glow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  [data-announcement] .announcement-glow {
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.9) 50%, transparent 100%);
    transform-origin: center;
    animation: announcement-glow 1200ms ease-in-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-announcement] .announcement-glow {
      animation: none;
    }
  }
</style>

<script>
  class AnnouncementElement extends HTMLElement {
    #resize = new ResizeObserver(() => {
      const height = this.getBoundingClientRect().height
      document.documentElement.style.setProperty("--announcement-height", `${height}px`)
      document.documentElement.style.setProperty(
        "--sticky-header-height",
        `calc(4rem + ${height}px)`,
      )
    })

    connectedCallback() {
      this.#resize.observe(this)
    }

    disconnectedCallback() {
      this.#resize.disconnect()
    }
  }

  if (!customElements.get("effect-announcement")) {
    customElements.define("effect-announcement", AnnouncementElement)
  }
</script>
