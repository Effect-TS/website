---
type TutorialId =
  | "handle-failures-without-guessing"
  | "keep-concurrent-work-under-control"
  | "clean-up-resources-reliably"
  | "send-rich-domain-models-over-the-wire"
  | "keep-dependencies-explicit-without-manual-wiring"
  | "catch-ai-slop-before-it-ships"
  | "instrument-applications-for-opentelemetry-without-the-plumbing"

type ArchitectureNodeId =
  | "owned-client"
  | "external-client"
  | "domain-model"
  | "http-routes"
  | "quote-order"
  | "place-order"
  | "import-orders"
  | "catalog"
  | "shipping"
  | "inventory"
  | "payment"
  | "order-repository"
  | "service-setup"
  | "tracing"
  | "development-tools"

interface Props {
  active?: TutorialId
  compact?: boolean
}

interface ArchitectureNode {
  readonly id: ArchitectureNodeId
  readonly label: string
  readonly type: string
  readonly detail: string
  readonly area:
    "client" | "contract" | "boundary" | "operation" | "service" | "support" | "development"
  readonly tutorials: ReadonlyArray<TutorialId>
}

interface ArchitectureRelationship {
  readonly from: ArchitectureNodeId
  readonly to: ArchitectureNodeId
  readonly label: string
  readonly kind: "runtime" | "contract" | "support" | "development"
  readonly tutorials: ReadonlyArray<TutorialId>
}

interface FocusStep {
  readonly type: string
  readonly label: string
  readonly relation?: string
}

interface DynamicStep {
  readonly label: string
  readonly detail: string
  readonly relation?: string
}

const { active, compact = false } = Astro.props

const tutorials: ReadonlyArray<{
  readonly id: TutorialId
  readonly title: string
  readonly pain: string
  readonly href: string
}> = [
  {
    id: "handle-failures-without-guessing",
    title: "Handle failures without guessing",
    pain: "Thrown values and Promise rejections hide which failures callers should handle.",
    href: "/docs/v4/tutorials/handle-failures-without-guessing",
  },
  {
    id: "keep-concurrent-work-under-control",
    title: "Keep concurrent work under control",
    pain: "Safe concurrent work normally requires limits, deadlines, cancellation, and glue code.",
    href: "/docs/v4/tutorials/keep-concurrent-work-under-control",
  },
  {
    id: "clean-up-resources-reliably",
    title: "Clean up resources reliably",
    pain: "Resources can outlive work that fails or is cancelled.",
    href: "/docs/v4/tutorials/clean-up-resources-reliably",
  },
  {
    id: "send-rich-domain-models-over-the-wire",
    title: "Send rich domain models over the wire",
    pain: "Rich domain models require duplicate response types and conversion code to cross JSON boundaries.",
    href: "/docs/v4/tutorials/send-rich-domain-models-over-the-wire",
  },
  {
    id: "keep-dependencies-explicit-without-manual-wiring",
    title: "Keep dependencies explicit without manual wiring",
    pain: "Dependency injection often trades visible plumbing for runtime magic.",
    href: "/docs/v4/tutorials/keep-dependencies-explicit-without-manual-wiring",
  },
  {
    id: "catch-ai-slop-before-it-ships",
    title: "Catch AI slop before it ships",
    pain: "LLMs produce plausible-looking code that can hide structural mistakes.",
    href: "/docs/v4/tutorials/catch-ai-slop-before-it-ships",
  },
  {
    id: "instrument-applications-for-opentelemetry-without-the-plumbing",
    title: "Instrument applications for OpenTelemetry without the plumbing",
    pain: "Correct tracing normally requires manual span and context management.",
    href: "/docs/v4/tutorials/instrument-applications-for-opentelemetry-without-the-plumbing",
  },
]

const nodes: ReadonlyArray<ArchitectureNode> = [
  {
    id: "owned-client",
    label: "Owned client",
    type: "API client",
    detail: "Shares the Order Schema",
    area: "client",
    tutorials: ["send-rich-domain-models-over-the-wire"],
  },
  {
    id: "external-client",
    label: "External client",
    type: "API client",
    detail: "Requires a fixed JSON contract",
    area: "client",
    tutorials: ["send-rich-domain-models-over-the-wire"],
  },
  {
    id: "domain-model",
    label: "Order domain model",
    type: "Shared contract",
    detail: "Connects rich values to JSON representations",
    area: "contract",
    tutorials: ["send-rich-domain-models-over-the-wire", "catch-ai-slop-before-it-ships"],
  },
  {
    id: "http-routes",
    label: "HTTP routes",
    type: "HTTP boundary",
    detail: "Decode requests and encode responses",
    area: "boundary",
    tutorials: [
      "handle-failures-without-guessing",
      "keep-concurrent-work-under-control",
      "send-rich-domain-models-over-the-wire",
      "keep-dependencies-explicit-without-manual-wiring",
      "catch-ai-slop-before-it-ships",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "quote-order",
    label: "Quote order",
    type: "Application operation",
    detail: "Price Order Lines and shipping",
    area: "operation",
    tutorials: [
      "keep-concurrent-work-under-control",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "place-order",
    label: "Place order",
    type: "Application operation",
    detail: "Reserve, pay, and store",
    area: "operation",
    tutorials: [
      "handle-failures-without-guessing",
      "clean-up-resources-reliably",
      "keep-dependencies-explicit-without-manual-wiring",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "import-orders",
    label: "Import orders",
    type: "Application operation",
    detail: "Validate external records",
    area: "operation",
    tutorials: ["catch-ai-slop-before-it-ships"],
  },
  {
    id: "catalog",
    label: "Catalog",
    type: "Backend service",
    detail: "Price an Order Line",
    area: "service",
    tutorials: [
      "keep-concurrent-work-under-control",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "shipping",
    label: "Shipping",
    type: "Backend service",
    detail: "Quote delivery",
    area: "service",
    tutorials: [
      "keep-concurrent-work-under-control",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "inventory",
    label: "Inventory",
    type: "Backend service",
    detail: "Reserve stock",
    area: "service",
    tutorials: [
      "clean-up-resources-reliably",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "payment",
    label: "Payment",
    type: "Backend service",
    detail: "Authorize payment",
    area: "service",
    tutorials: [
      "handle-failures-without-guessing",
      "keep-dependencies-explicit-without-manual-wiring",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "order-repository",
    label: "Order repository",
    type: "Backend service",
    detail: "Store Accepted Orders",
    area: "service",
    tutorials: [
      "clean-up-resources-reliably",
      "keep-dependencies-explicit-without-manual-wiring",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    id: "service-setup",
    label: "Service setup",
    type: "Composition",
    detail: "Select and share implementations",
    area: "support",
    tutorials: ["keep-dependencies-explicit-without-manual-wiring"],
  },
  {
    id: "tracing",
    label: "Tracing",
    type: "Observability",
    detail: "Observe named operations",
    area: "support",
    tutorials: ["instrument-applications-for-opentelemetry-without-the-plumbing"],
  },
  {
    id: "development-tools",
    label: "Development tools",
    type: "Quality gate",
    detail: "Check code before it runs",
    area: "development",
    tutorials: ["catch-ai-slop-before-it-ships"],
  },
]

const relationships: ReadonlyArray<ArchitectureRelationship> = [
  {
    from: "owned-client",
    to: "http-routes",
    label: "HTTP",
    kind: "runtime",
    tutorials: ["send-rich-domain-models-over-the-wire"],
  },
  {
    from: "external-client",
    to: "http-routes",
    label: "HTTP",
    kind: "runtime",
    tutorials: ["send-rich-domain-models-over-the-wire"],
  },
  {
    from: "domain-model",
    to: "http-routes",
    label: "decodes and encodes",
    kind: "contract",
    tutorials: ["send-rich-domain-models-over-the-wire", "catch-ai-slop-before-it-ships"],
  },
  {
    from: "http-routes",
    to: "quote-order",
    label: "runs",
    kind: "runtime",
    tutorials: [
      "keep-concurrent-work-under-control",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "http-routes",
    to: "place-order",
    label: "runs",
    kind: "runtime",
    tutorials: [
      "handle-failures-without-guessing",
      "clean-up-resources-reliably",
      "keep-dependencies-explicit-without-manual-wiring",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "http-routes",
    to: "import-orders",
    label: "runs",
    kind: "runtime",
    tutorials: ["catch-ai-slop-before-it-ships"],
  },
  {
    from: "place-order",
    to: "quote-order",
    label: "gets quote",
    kind: "runtime",
    tutorials: ["instrument-applications-for-opentelemetry-without-the-plumbing"],
  },
  {
    from: "quote-order",
    to: "catalog",
    label: "prices lines",
    kind: "runtime",
    tutorials: [
      "keep-concurrent-work-under-control",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "quote-order",
    to: "shipping",
    label: "quotes delivery",
    kind: "runtime",
    tutorials: [
      "keep-concurrent-work-under-control",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "place-order",
    to: "inventory",
    label: "reserves stock",
    kind: "runtime",
    tutorials: [
      "clean-up-resources-reliably",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "place-order",
    to: "payment",
    label: "authorizes",
    kind: "runtime",
    tutorials: [
      "handle-failures-without-guessing",
      "keep-dependencies-explicit-without-manual-wiring",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "place-order",
    to: "order-repository",
    label: "stores",
    kind: "runtime",
    tutorials: [
      "clean-up-resources-reliably",
      "keep-dependencies-explicit-without-manual-wiring",
      "instrument-applications-for-opentelemetry-without-the-plumbing",
    ],
  },
  {
    from: "import-orders",
    to: "domain-model",
    label: "validates",
    kind: "contract",
    tutorials: ["catch-ai-slop-before-it-ships"],
  },
]

const focusByTutorial: Record<TutorialId, ReadonlyArray<FocusStep>> = {
  "handle-failures-without-guessing": [
    { type: "HTTP boundary", label: "HTTP routes" },
    { type: "Application operation", label: "Place order", relation: "runs" },
    { type: "Backend service", label: "Payment", relation: "authorizes" },
  ],
  "keep-concurrent-work-under-control": [
    { type: "HTTP boundary", label: "HTTP routes" },
    { type: "Application operation", label: "Quote order", relation: "runs" },
    { type: "Backend services", label: "Catalog and Shipping", relation: "calls concurrently" },
  ],
  "clean-up-resources-reliably": [
    { type: "Application operation", label: "Place order" },
    {
      type: "Backend services",
      label: "Inventory and Order repository",
      relation: "uses resources from",
    },
  ],
  "send-rich-domain-models-over-the-wire": [
    { type: "Shared contract", label: "Order domain model" },
    { type: "HTTP boundary", label: "HTTP routes", relation: "encodes at" },
    { type: "API clients", label: "Owned and external clients", relation: "sends to" },
  ],
  "keep-dependencies-explicit-without-manual-wiring": [
    { type: "Application operation", label: "Place order" },
    { type: "Backend services", label: "Payment and repository", relation: "requires" },
    { type: "Runtime support", label: "Service setup", relation: "configured by" },
  ],
  "catch-ai-slop-before-it-ships": [
    { type: "Development time", label: "Development tools" },
    { type: "Application operation", label: "Import orders", relation: "checks" },
    { type: "Shared contract", label: "Order domain model", relation: "validates against" },
  ],
  "instrument-applications-for-opentelemetry-without-the-plumbing": [
    { type: "Runtime support", label: "Tracing" },
    { type: "HTTP boundary", label: "HTTP routes", relation: "observes" },
    {
      type: "Application and services",
      label: "Place order and its services",
      relation: "follows",
    },
  ],
}

const dynamicByTutorial: Partial<Record<TutorialId, ReadonlyArray<DynamicStep>>> = {
  "handle-failures-without-guessing": [
    { label: "Order request", detail: "POST /orders" },
    { label: "HTTP route", detail: "Runs the operation", relation: "enters" },
    { label: "Place order", detail: "Applies the payment policy", relation: "calls" },
    { label: "Payment", detail: "Returns success or a typed failure", relation: "authorizes" },
    { label: "HTTP result", detail: "Uses the known outcome", relation: "maps to" },
  ],
  "keep-concurrent-work-under-control": [
    { label: "Quote request", detail: "POST /quotes" },
    { label: "Quote order", detail: "Coordinates the work", relation: "enters" },
    { label: "Catalog and Shipping", detail: "Run concurrently", relation: "starts together" },
    { label: "Quote response", detail: "Keeps stable result order", relation: "joins as" },
  ],
  "clean-up-resources-reliably": [
    { label: "Order request", detail: "POST /orders" },
    { label: "Acquire resources", detail: "Connection, then inventory lock", relation: "enters" },
    { label: "Store order", detail: "Uses both resources", relation: "continues with" },
    { label: "Release resources", detail: "Runs after every outcome", relation: "always reaches" },
  ],
  "instrument-applications-for-opentelemetry-without-the-plumbing": [
    { label: "Order request", detail: "POST /orders" },
    { label: "HTTP span", detail: "Covers the whole request", relation: "opens" },
    {
      label: "Operation spans",
      detail: "Follow Place order and its services",
      relation: "contains",
    },
    {
      label: "Trace waterfall",
      detail: "Shows timing and parent relationships",
      relation: "records",
    },
  ],
}

const isRelated = (related: ReadonlyArray<TutorialId>) =>
  active === undefined || related.includes(active)

const activeFocus = active === undefined ? undefined : focusByTutorial[active]
const activeDynamic = active === undefined ? undefined : dynamicByTutorial[active]
const markerSuffix = active ?? "overview"
---

<tutorial-architecture-map
  class="not-prose my-8 block"
  data-active={active ?? "all"}
  data-compact={compact ? "true" : "false"}
  data-filtered={active === undefined ? "false" : "true"}
  data-marker-suffix={markerSuffix}
>
  <section
    class="architecture-frame"
    aria-label={compact ? "Tutorial architecture focus" : "Order-processing system architecture"}
  >
    <header class="architecture-header">
      <div>
        <p class="architecture-eyebrow">System structure</p>
        <p class="architecture-title">The order-processing system</p>
        <p class="architecture-subtitle">
          Components, contracts, and the relationships between them
        </p>
      </div>
      {
        compact && (
          <a class="architecture-link" href="/docs/v4/tutorials/introduction">
            View the complete architecture
          </a>
        )
      }
    </header>

    {
      !compact && (
        <div class="architecture-explorer">
          <label class="architecture-select-label">
            <span>Tutorial focus</span>
            <select data-tutorial-select>
              <option value="all">Complete system</option>
              {tutorials.map((tutorial) => (
                <option
                  value={tutorial.id}
                  data-tutorial-pain={tutorial.pain}
                  data-tutorial-href={tutorial.href}
                >
                  {tutorial.title}
                </option>
              ))}
            </select>
          </label>

          <div class="architecture-selection" data-selection hidden>
            <div>
              <p class="architecture-selection-title" data-selection-title />
              <p class="architecture-selection-pain" data-selection-pain />
            </div>
            <a class="tutorial-link" data-selection-link>
              Open tutorial
            </a>
          </div>
        </div>
      )
    }

    <div class="architecture-legend" aria-label="Diagram key">
      <span><i class="legend-line" aria-hidden="true"></i> Runtime call</span>
      <span><i class="legend-line is-dashed" aria-hidden="true"></i> Contract relationship</span>
      <span><i class="legend-focus" aria-hidden="true"></i> Tutorial focus</span>
    </div>

    <div class="architecture-canvas-scroll">
      <div class="architecture-canvas" data-architecture-canvas>
        <section class="architecture-clients" aria-label="API clients">
          <p class="architecture-group-label">API clients</p>
          {
            nodes
              .filter((node) => node.area === "client")
              .map((node) => (
                <article
                  class="architecture-node"
                  data-architecture-node
                  data-node-id={node.id}
                  data-related={node.tutorials.join(" ")}
                  data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                >
                  <p class="architecture-node-type">{node.type}</p>
                  <p class="architecture-node-title">{node.label}</p>
                  <p class="architecture-node-detail">{node.detail}</p>
                </article>
              ))
          }
        </section>

        <section class="application-boundary" aria-label="Order application">
          <p class="architecture-boundary-label">Order application</p>

          {
            nodes
              .filter((node) => node.area === "contract")
              .map((node) => (
                <article
                  class="architecture-node architecture-contract"
                  data-architecture-node
                  data-node-id={node.id}
                  data-related={node.tutorials.join(" ")}
                  data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                >
                  <p class="architecture-node-type">{node.type}</p>
                  <p class="architecture-node-title">{node.label}</p>
                  <p class="architecture-node-detail">{node.detail}</p>
                </article>
              ))
          }

          <div class="architecture-runtime">
            <section class="architecture-column architecture-entry" aria-label="HTTP boundary">
              <p class="architecture-group-label">HTTP boundary</p>
              {
                nodes
                  .filter((node) => node.area === "boundary")
                  .map((node) => (
                    <article
                      class="architecture-node"
                      data-architecture-node
                      data-node-id={node.id}
                      data-related={node.tutorials.join(" ")}
                      data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                    >
                      <p class="architecture-node-type">{node.type}</p>
                      <p class="architecture-node-title">{node.label}</p>
                      <p class="architecture-node-detail">{node.detail}</p>
                    </article>
                  ))
              }
            </section>

            <section
              class="architecture-column architecture-operations"
              aria-label="Application operations"
            >
              <p class="architecture-group-label">Application operations</p>
              {
                nodes
                  .filter((node) => node.area === "operation")
                  .map((node) => (
                    <article
                      class="architecture-node"
                      data-architecture-node
                      data-node-id={node.id}
                      data-related={node.tutorials.join(" ")}
                      data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                    >
                      <p class="architecture-node-type">{node.type}</p>
                      <p class="architecture-node-title">{node.label}</p>
                      <p class="architecture-node-detail">{node.detail}</p>
                    </article>
                  ))
              }
            </section>

            <section
              class="architecture-column architecture-services"
              aria-label="Backend services"
            >
              <p class="architecture-group-label">Backend services</p>
              <div class="architecture-service-grid">
                {
                  nodes
                    .filter((node) => node.area === "service")
                    .map((node) => (
                      <article
                        class="architecture-node"
                        data-architecture-node
                        data-node-id={node.id}
                        data-related={node.tutorials.join(" ")}
                        data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                      >
                        <p class="architecture-node-type">{node.type}</p>
                        <p class="architecture-node-title">{node.label}</p>
                        <p class="architecture-node-detail">{node.detail}</p>
                      </article>
                    ))
                }
              </div>
            </section>
          </div>

          <section class="architecture-support" aria-label="Runtime support">
            <p class="architecture-group-label">Runtime support</p>
            <div class="architecture-support-grid">
              {
                nodes
                  .filter((node) => node.area === "support")
                  .map((node) => (
                    <article
                      class="architecture-node"
                      data-architecture-node
                      data-node-id={node.id}
                      data-related={node.tutorials.join(" ")}
                      data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                    >
                      <p class="architecture-node-type">{node.type}</p>
                      <p class="architecture-node-title">{node.label}</p>
                      <p class="architecture-node-detail">{node.detail}</p>
                    </article>
                  ))
              }
            </div>
          </section>
        </section>

        <section class="architecture-development" aria-label="Development time">
          <p class="architecture-group-label">Development time</p>
          {
            nodes
              .filter((node) => node.area === "development")
              .map((node) => (
                <article
                  class="architecture-node"
                  data-architecture-node
                  data-node-id={node.id}
                  data-related={node.tutorials.join(" ")}
                  data-highlighted={isRelated(node.tutorials) ? "true" : "false"}
                >
                  <p class="architecture-node-type">{node.type}</p>
                  <p class="architecture-node-title">{node.label}</p>
                  <p class="architecture-node-detail">{node.detail}</p>
                </article>
              ))
          }
        </section>

        <svg class="architecture-connectors" data-architecture-connectors aria-hidden="true">
          <defs>
            <marker
              id={`architecture-arrow-${markerSuffix}`}
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              markerUnits="strokeWidth"
            >
              <path d="M 0 0 L 8 4 L 0 8 z"></path>
            </marker>
            <marker
              id={`architecture-arrow-active-${markerSuffix}`}
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              markerUnits="strokeWidth"
            >
              <path d="M 0 0 L 8 4 L 0 8 z"></path>
            </marker>
          </defs>
          {
            relationships.map((relationship) => (
              <g
                class="architecture-relationship"
                data-architecture-relationship
                data-from={relationship.from}
                data-to={relationship.to}
                data-kind={relationship.kind}
                data-related={relationship.tutorials.join(" ")}
                data-highlighted={isRelated(relationship.tutorials) ? "true" : "false"}
              >
                <path
                  data-relationship-path
                  marker-end={`url(#architecture-arrow-${markerSuffix})`}
                />
                <text data-relationship-label>{relationship.label}</text>
              </g>
            ))
          }
        </svg>
      </div>
    </div>

    {
      compact && activeFocus && (
        <section class="architecture-focus-strip" aria-label="Components in this tutorial">
          <p class="architecture-strip-label">Tutorial focus</p>
          <ol style={`--step-count: ${activeFocus.length}`}>
            {activeFocus.map((step, index) => (
              <li>
                {index > 0 && (
                  <div class="architecture-focus-connector" aria-hidden="true">
                    <span>{step.relation}</span>
                    <i />
                  </div>
                )}
                <div class="architecture-focus-node">
                  <span>{step.type}</span>
                  <strong>{step.label}</strong>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      compact && activeDynamic && (
        <section class="architecture-dynamic" aria-label="Request flow">
          <div class="architecture-dynamic-heading">
            <p class="architecture-strip-label">Request flow</p>
            <p>Numbered interactions show what happens during this tutorial's scenario.</p>
          </div>
          <ol style={`--dynamic-columns: ${activeDynamic.length}`}>
            {activeDynamic.map((step, index) => (
              <li>
                {index > 0 && (
                  <div class="architecture-dynamic-connector" aria-hidden="true">
                    <span>{step.relation}</span>
                    <i />
                  </div>
                )}
                <div class="architecture-dynamic-step">
                  <span class="architecture-step-number">{index + 1}</span>
                  <div>
                    <strong>{step.label}</strong>
                    <span>{step.detail}</span>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </section>
</tutorial-architecture-map>

<script>
  class TutorialArchitectureMap extends HTMLElement {
    resizeObserver?: ResizeObserver
    drawFrame?: number

    connectedCallback() {
      this.addEventListener("change", this.onChange)
      this.applySelection(this.dataset.active ?? "all")
      this.resizeObserver = new ResizeObserver(this.scheduleDraw)
      const canvas = this.querySelector<HTMLElement>("[data-architecture-canvas]")
      if (canvas !== null) this.resizeObserver.observe(canvas)
      this.scheduleDraw()
    }

    disconnectedCallback() {
      this.removeEventListener("change", this.onChange)
      this.resizeObserver?.disconnect()
      if (this.drawFrame !== undefined) cancelAnimationFrame(this.drawFrame)
    }

    onChange = (event: Event) => {
      const select = event.target
      if (!(select instanceof HTMLSelectElement) || !select.matches("[data-tutorial-select]")) {
        return
      }
      this.applySelection(select.value)
    }

    scheduleDraw = () => {
      if (this.drawFrame !== undefined) cancelAnimationFrame(this.drawFrame)
      this.drawFrame = requestAnimationFrame(() => this.drawRelationships())
    }

    applySelection(tutorial: string) {
      this.dataset.active = tutorial
      this.dataset.filtered = tutorial === "all" ? "false" : "true"

      this.querySelectorAll<HTMLElement>("[data-architecture-node]").forEach((node) => {
        const related = node.dataset.related?.split(" ") ?? []
        node.dataset.highlighted = String(tutorial === "all" || related.includes(tutorial))
      })

      this.querySelectorAll<SVGElement>("[data-architecture-relationship]").forEach(
        (relationship) => {
          const related = relationship.dataset.related?.split(" ") ?? []
          const highlighted = tutorial === "all" || related.includes(tutorial)
          relationship.dataset.highlighted = String(highlighted)
          const path = relationship.querySelector<SVGPathElement>("[data-relationship-path]")
          if (path === null) return
          const suffix = this.dataset.markerSuffix ?? "overview"
          path.setAttribute(
            "marker-end",
            `url(#architecture-arrow${highlighted && tutorial !== "all" ? "-active" : ""}-${suffix})`,
          )
        },
      )

      const select = this.querySelector<HTMLSelectElement>("[data-tutorial-select]")
      if (select !== null) select.value = tutorial

      const option = select?.selectedOptions.item(0)
      const selectedTutorial = option === null || option?.value === "all" ? undefined : tutorial
      const selection = this.querySelector<HTMLElement>("[data-selection]")
      if (selection !== null) selection.hidden = selectedTutorial === undefined

      if (selectedTutorial !== undefined) {
        const title = selection?.querySelector<HTMLElement>("[data-selection-title]")
        const pain = selection?.querySelector<HTMLElement>("[data-selection-pain]")
        const link = selection?.querySelector<HTMLAnchorElement>("[data-selection-link]")
        if (title !== null && title !== undefined) title.textContent = option?.textContent ?? ""
        if (pain !== null && pain !== undefined) {
          pain.textContent = option?.dataset.tutorialPain ?? ""
        }
        if (link !== null && link !== undefined) {
          link.href = option?.dataset.tutorialHref ?? ""
        }
      }

      this.scheduleDraw()
    }

    drawRelationships() {
      const canvas = this.querySelector<HTMLElement>("[data-architecture-canvas]")
      const svg = this.querySelector<SVGSVGElement>("[data-architecture-connectors]")
      if (canvas === null || svg === null) return

      const canvasRect = canvas.getBoundingClientRect()
      svg.setAttribute("viewBox", `0 0 ${canvasRect.width} ${canvasRect.height}`)

      this.querySelectorAll<SVGGElement>("[data-architecture-relationship]").forEach(
        (relationship) => {
          const fromId = relationship.dataset.from
          const toId = relationship.dataset.to
          if (fromId === undefined || toId === undefined) return

          const from = this.querySelector<HTMLElement>(`[data-node-id="${CSS.escape(fromId)}"]`)
          const to = this.querySelector<HTMLElement>(`[data-node-id="${CSS.escape(toId)}"]`)
          const path = relationship.querySelector<SVGPathElement>("[data-relationship-path]")
          const label = relationship.querySelector<SVGTextElement>("[data-relationship-label]")
          if (from === null || to === null || path === null || label === null) return

          const fromRect = from.getBoundingClientRect()
          const toRect = to.getBoundingClientRect()
          const fromCenterX = fromRect.left - canvasRect.left + fromRect.width / 2
          const fromCenterY = fromRect.top - canvasRect.top + fromRect.height / 2
          const toCenterX = toRect.left - canvasRect.left + toRect.width / 2
          const toCenterY = toRect.top - canvasRect.top + toRect.height / 2

          let d: string
          let labelX: number
          let labelY: number

          if (fromId === "import-orders" && toId === "domain-model") {
            const startX = fromRect.left - canvasRect.left
            const startY = fromCenterY
            const routeX = startX - 36
            const endY = toRect.bottom - canvasRect.top
            d = `M ${startX} ${startY} H ${routeX} V ${endY}`
            labelX = (startX + routeX) / 2
            labelY = startY - 7
          } else if (Math.abs(toCenterX - fromCenterX) < 90) {
            const movingDown = toCenterY > fromCenterY
            const startX = fromCenterX
            const startY = movingDown
              ? fromRect.bottom - canvasRect.top
              : fromRect.top - canvasRect.top
            const endX = toCenterX
            const endY = movingDown ? toRect.top - canvasRect.top : toRect.bottom - canvasRect.top
            const middleY = (startY + endY) / 2
            d = `M ${startX} ${startY} C ${startX} ${middleY}, ${endX} ${middleY}, ${endX} ${endY}`
            labelX = startX + 8
            labelY = middleY - 5
          } else {
            const movingRight = toCenterX > fromCenterX
            const startX = movingRight
              ? fromRect.right - canvasRect.left
              : fromRect.left - canvasRect.left
            const endX = movingRight
              ? toRect.left - canvasRect.left
              : toRect.right - canvasRect.left
            const middleX = (startX + endX) / 2
            d = `M ${startX} ${fromCenterY} C ${middleX} ${fromCenterY}, ${middleX} ${toCenterY}, ${endX} ${toCenterY}`
            labelX = middleX
            labelY = (fromCenterY + toCenterY) / 2 - 7
          }

          path.setAttribute("d", d)
          label.setAttribute("x", String(labelX))
          label.setAttribute("y", String(labelY))
        },
      )
    }
  }

  if (!customElements.get("tutorial-architecture-map")) {
    customElements.define("tutorial-architecture-map", TutorialArchitectureMap)
  }
</script>

