// What `pnpm check` typechecks: tsconfig.json without the Part 1 start files,
// which a learner edits in place, and the end of lesson 8, which fails by
// design. The editor still uses tsconfig.json, and `pnpm test:course`
// typechecks the lesson files as shipped.
{
  "extends": "./tsconfig.json",
  "exclude": [
    "lessons/part1/*/start",
    "lessons/part1/08-*/solution"
  ]
}
