---
/**
 * Sidebar section label — the small amber status label used for the API
 * Reference "Unstable" section.
 */
interface Props {
  readonly class?: string
}

const { class: className } = Astro.props
---

<p
  class:list={[
    "font-mono text-xs font-semibold tracking-wider text-warning-foreground uppercase",
    className,
  ]}
>
  <slot />
</p>
