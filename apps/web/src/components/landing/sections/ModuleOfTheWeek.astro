---
import { ArrowRight, Play } from "@lucide/astro"
import ModuleSummary from "@/components/landing/blocks/ModuleSummary.astro"
import type { Module } from "@/features/module-of-the-week/domain"
import { getLatestModules } from "@/features/module-of-the-week/http"
import { blogPostMetadata } from "@/lib/blog-post"
import { openGraphImagePath } from "@/lib/open-graph-image"

const [latest, ...older] = await getLatestModules()
const recent = older.slice(0, 4)

// Modules get their video a while after the blog post, so fall back to the
// post's Open Graph image (and link to the post) until the video is out.
const thumbnailOf = async ({ post, title }: Module) => {
  const video = post.data.video
  return video !== undefined
    ? {
        src: `https://i.ytimg.com/vi/${video.youtubeId}/sddefault.jpg`,
        href: `https://www.youtube.com/watch?v=${video.youtubeId}`,
        label: `Watch ${title} on YouTube (opens in a new tab)`,
        external: true,
        duration: video.duration,
      }
    : {
        src: await openGraphImagePath(`/blog/${post.id}`, blogPostMetadata(post)),
        href: `/blog/${post.id}`,
        label: `Read ${title}`,
        external: false,
        duration: undefined,
      }
}

const thumbnail = latest === undefined ? undefined : await thumbnailOf(latest)
---

{
  latest !== undefined && thumbnail !== undefined && (
    <section
      id="module-of-the-week"
      aria-labelledby="module-of-the-week-heading"
      class="relative w-full py-24 md:pt-40 md:pb-24"
    >
      <div class="mx-auto w-full max-w-295 px-4">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="mb-3 font-mono text-sm font-medium tracking-wider text-zinc-400 uppercase">
              // Module of the Week
            </p>
            <h2
              id="module-of-the-week-heading"
              class="text-2xl leading-tighter font-semibold text-white md:text-3xl"
            >
              One Effect module, every week
            </h2>
          </div>
          <a
            href="/module-of-the-week"
            class="group inline-flex items-center gap-2 self-start rounded-md border border-zinc-700 bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:border-zinc-500 hover:bg-zinc-800 hover:no-underline lg:self-auto"
          >
            All modules
            <ArrowRight
              class="size-4 transition-transform motion-safe:group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </a>
        </div>
        <div
          class:list={[
            "mt-12 grid grid-cols-1 gap-px border border-zinc-800 bg-zinc-800",
            recent.length > 0 && "lg:grid-cols-2",
          ]}
        >
          <article class="flex min-w-0 flex-col bg-zinc-950">
            <a
              href={thumbnail.href}
              {...(thumbnail.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              aria-label={thumbnail.label}
              class="group relative block aspect-video overflow-hidden bg-zinc-900"
            >
              <img
                src={thumbnail.src}
                alt=""
                loading="lazy"
                width="1280"
                height="720"
                class="h-full w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-[1.02]"
              />
              {thumbnail.duration !== undefined && (
                <span class="absolute right-2 bottom-2 inline-flex items-center gap-1 rounded-sm bg-zinc-950/80 py-0.5 pr-1.5 pl-1 font-mono text-xs text-white tabular-nums transition-colors group-hover:bg-zinc-950">
                  <Play class="size-3 fill-current" aria-hidden="true" />
                  {thumbnail.duration}
                </span>
              )}
            </a>
            <div class="flex flex-1 flex-col gap-4 border-t border-zinc-800 p-5 lg:px-6">
              <ModuleSummary module={latest} featured />
            </div>
          </article>
          {recent.length > 0 && (
            <div class="grid min-w-0 grid-cols-1 gap-px bg-zinc-800 lg:auto-rows-fr">
              {recent.map((module) => (
                <article class="flex flex-col justify-between gap-3 bg-zinc-950 p-5 lg:px-6">
                  <ModuleSummary module={module} />
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
