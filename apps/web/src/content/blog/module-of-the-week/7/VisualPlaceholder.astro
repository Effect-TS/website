---
// Stand-in for an interactive visual that hasn't been built yet. Shows the
// visual's name and what it should do, so the draft reads end to end.
// Delete once every visual in this post is real.

interface Props {
  name: string
}

const { name } = Astro.props
---

<figure class="not-prose my-8 rounded-lg border-2 border-dashed border-border bg-card/40 px-5 py-4">
  <figcaption class="font-mono text-sm font-semibold text-prose-foreground">
    TODO: &lt;{name} /&gt;
  </figcaption>
  <div class="mt-2 text-sm leading-relaxed text-muted-foreground">
    <slot />
  </div>
</figure>
