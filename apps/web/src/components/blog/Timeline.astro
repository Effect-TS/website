---
import ChartCard from "@/components/blog/ChartCard.astro"

interface Props {
  title: string
  sections: Array<{
    label: string
    ticks: Array<string>
    tracks: Array<{
      label: string
      /** Fraction of the axis the track covers, from 0 to 1. */
      span: number
      text: string
    }>
  }>
  note?: string
}

const { title, sections, note } = Astro.props
const position = (index: number, count: number) => (count > 1 ? (index / (count - 1)) * 100 : 0)
---

<ChartCard title={title} note={note}>
  {
    sections.map((section) => (
      <div class="border-t border-border px-5 py-6">
        <p class="m-0 mb-4 text-sm font-medium text-foreground">{section.label}</p>
        <div class="grid grid-cols-[7rem_1fr] items-center gap-x-4 gap-y-2.5 sm:grid-cols-[10rem_1fr]">
          <span />
          <div class="relative h-4" aria-hidden="true">
            {section.ticks.map((tick, index) => (
              <span
                class:list={[
                  "absolute top-0 font-mono text-xs whitespace-nowrap text-muted-foreground",
                  index === section.ticks.length - 1
                    ? "-translate-x-full"
                    : index > 0 && "-translate-x-1/2",
                ]}
                style={{ left: `${position(index, section.ticks.length)}%` }}
              >
                {tick}
              </span>
            ))}
          </div>
          {section.tracks.map((track) => (
            <>
              <span class="text-sm text-muted-foreground">{track.label}</span>
              <div class="relative h-7 overflow-hidden rounded-md bg-muted">
                {section.ticks.slice(1, -1).map((_, index) => (
                  <span
                    class="absolute inset-y-0 w-px bg-border"
                    style={{ left: `${position(index + 1, section.ticks.length)}%` }}
                    aria-hidden="true"
                  />
                ))}
                <span
                  class="fill absolute inset-y-0 left-0 flex items-center rounded-md px-3 font-mono text-xs font-medium whitespace-nowrap"
                  style={{ width: `${track.span * 100}%` }}
                >
                  {track.text}
                </span>
              </div>
            </>
          ))}
        </div>
      </div>
    ))
  }
</ChartCard>

<style>
  .fill {
    background-color: color-mix(in srgb, var(--brand) 60%, var(--foreground));
    color: var(--background);
  }
</style>
