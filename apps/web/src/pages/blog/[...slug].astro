---
import { Image } from "astro:assets"
import { getCollection, getEntries, render } from "astro:content"
import { ArrowRightIcon, ArrowUpRightIcon, ChevronLeftIcon, ChevronRightIcon } from "@lucide/astro"
import LinkedInLogo from "@/assets/logos/linkedin/LinkedIn.svg"
import TwitterLogo from "@/assets/logos/twitter/TwitterWhite.svg"
import CopyLinkButton from "@/components/blog/CopyLinkButton"
import GridBackground from "@/components/GridBackground.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"
import TableOfContents from "@/components/ui/toc/TableOfContents.astro"
import PageLayout from "@/layouts/PageLayout.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const tocItems = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text,
    indent: heading.depth === 3,
    class: "text-sm leading-snug",
  }))

const [tags, authors, allPosts] = await Promise.all([
  getEntries(post.data.tags),
  getEntries(post.data.authors),
  getCollection("blog"),
])

const avatars = import.meta.glob<{ default: ImageMetadata }>("../../assets/authors/*.png", {
  eager: true,
})

const sortedPosts = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id)
const prevPost =
  currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null

const sortedTags = [...tags].sort((a, b) => a.data.name.localeCompare(b.data.name))

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
}

function authorAvatar(id: string): ImageMetadata | undefined {
  return avatars[`../../assets/authors/${id}.png`]?.default
}

const shareShellClass =
  "inline-flex h-8 w-8 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground"
---

<PageLayout
  title={`${post.data.title} | Effect Blog`}
  description={post.data.excerpt}
  activeSlug="blog"
  themeable
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <div class="blog-post-grid-offset relative h-full">
        <GridBackground />
      </div>

      <div aria-hidden="true" class="absolute inset-0">
        <div
          class="absolute inset-0 opacity-100 transition-opacity duration-[250ms] ease-out dark:opacity-0"
          style="background: linear-gradient(to bottom, #ffffff 0%, transparent 20%, transparent 60%, #ffffff 100%);"
        >
        </div>
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-[250ms] ease-out dark:opacity-100"
          style="background: linear-gradient(to bottom, #09090b 0%, transparent 20%, transparent 60%, #09090b 100%);"
        >
        </div>
      </div>

      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-[400px] opacity-0 dark:opacity-100"
        style="background: radial-gradient(ellipse 50% 80% at 70% -20%, rgb(255 255 255 / 0.12) 0%, transparent 50%);"
      >
      </div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-295 px-4">
      <nav
        aria-label="Breadcrumb"
        class="flex flex-wrap items-center gap-x-3 gap-y-2 pt-16 pb-1 font-mono text-sm tracking-wider uppercase md:pt-24"
      >
        <a href="/blog" class="text-muted-foreground transition-colors hover:text-foreground"
          >Blog</a
        >
        <span class="text-subtle-foreground" aria-hidden="true">//</span>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          {
            sortedTags.map((tag) => (
              <a
                href={`/blog?category=${tag.id}`}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {tag.data.name}
              </a>
            ))
          }
        </div>
      </nav>

      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-x-6">
        <div class="pt-3 pb-20 md:col-span-8">
          <h1 class="leading-tighter text-3xl font-bold tracking-tight text-foreground md:text-4xl">
            {post.data.title}
          </h1>
          <p class="mt-4 text-base leading-relaxed text-muted-foreground md:text-lg">
            {post.data.excerpt}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4 md:hidden">
            {
              authors.map((author) => {
                const avatar = authorAvatar(author.id)
                return (
                  <a
                    href={author.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/byline flex items-center gap-3 no-underline"
                  >
                    {avatar && (
                      <Image
                        src={avatar}
                        alt={author.data.name}
                        class="h-10 w-10 rounded-md object-cover"
                      />
                    )}
                    <span class="flex min-w-0 flex-col">
                      <span class="truncate text-base font-medium text-foreground group-hover/byline:underline">
                        {author.data.name}
                      </span>
                      <span class="mt-0.5 truncate text-xs text-muted-foreground">
                        {author.data.title}
                      </span>
                    </span>
                  </a>
                )
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="h-px w-full bg-border"></div>

  <section class="relative">
    <div class="mx-auto w-full max-w-295 px-4">
      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-x-6">
        <aside class="hidden md:col-start-10 md:col-span-3 md:row-start-1 md:block md:pt-8">
          <div class="mb-8 flex flex-col gap-4">
            {
              authors.map((author) => {
                const avatar = authorAvatar(author.id)
                return (
                  <a
                    href={author.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/byline flex items-center gap-3 no-underline"
                  >
                    {avatar && (
                      <Image
                        src={avatar}
                        alt={author.data.name}
                        class="h-12 w-12 rounded-md object-cover"
                      />
                    )}
                    <span class="flex min-w-0 flex-col">
                      <span class="truncate text-base font-medium text-foreground group-hover/byline:underline">
                        {author.data.name}
                      </span>
                      <span class="mt-0.5 truncate text-sm text-muted-foreground">
                        {author.data.title}
                      </span>
                    </span>
                  </a>
                )
              })
            }
          </div>

          <div class="sticky top-[var(--sticky-header-height)]">
            <TableOfContents
              items={tocItems}
              class="rounded-md border border-border bg-card/40 p-5"
            />

            <div class="mt-6">
              <div class="flex items-center gap-3">
                <Eyebrow as="span" class="text-xs">Share</Eyebrow>
                <div class="flex items-center gap-2">
                  <a
                    href={xUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on X"
                    class={shareShellClass}
                  >
                    <TwitterLogo class="size-4" />
                  </a>
                  <a
                    href={linkedInUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Share on LinkedIn"
                    class={shareShellClass}
                  >
                    <LinkedInLogo class="size-4" />
                  </a>
                  <CopyLinkButton client:load />
                </div>
              </div>
              <div class="mt-5 border-t border-border pt-5"></div>
              <p class="flex flex-col gap-0.5">
                <span
                  class="font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase"
                >
                  Last updated
                </span>
                <time class="font-mono text-xs text-muted-foreground tabular-nums">
                  {formatDate(post.data.date)}
                </time>
              </p>
            </div>
          </div>
        </aside>

        <article class="min-w-0 pb-20 md:col-span-8 md:row-start-1">
          <div class="mt-10 mb-10 block md:hidden">
            <TableOfContents
              items={tocItems}
              class="rounded-md border border-border bg-card/40 p-5"
            />
          </div>

          <div class="prose prose-effect max-w-none blog-article mt-8">
            <Content />
          </div>

          <div class="mt-12 flex flex-col gap-6 border-t border-border pt-8 md:hidden">
            <div class="flex items-center gap-3">
              <Eyebrow as="span" class="text-xs">Share</Eyebrow>
              <div class="flex items-center gap-2">
                <a
                  href={xUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on X"
                  class={shareShellClass}
                >
                  <TwitterLogo class="size-4" />
                </a>
                <a
                  href={linkedInUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on LinkedIn"
                  class={shareShellClass}
                >
                  <LinkedInLogo class="size-4" />
                </a>
                <CopyLinkButton client:load />
              </div>
            </div>
            <p class="flex flex-col gap-0.5">
              <span class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
                Last updated
              </span>
              <time class="font-mono text-xs text-muted-foreground tabular-nums">
                {formatDate(post.data.date)}
              </time>
            </p>
          </div>

          {
            (prevPost || nextPost) && (
              <div class="mt-16 grid grid-cols-1 gap-4 border-t border-border pt-10 sm:grid-cols-2">
                {prevPost ? (
                  <a
                    href={`/blog/${prevPost.id}`}
                    class="group flex flex-col rounded-md border border-border p-4 transition-colors duration-200 hover:border-border-strong"
                  >
                    <span class="flex items-center gap-1.5 font-mono text-xs tracking-wider text-muted-foreground uppercase">
                      <ChevronLeftIcon class="size-3.5 transition-transform duration-200 group-hover:-translate-x-0.5" />
                      Previous
                    </span>
                    <span class="mt-1.5 line-clamp-1 text-sm font-medium text-muted-foreground transition-colors group-hover:text-foreground">
                      {prevPost.data.title}
                    </span>
                  </a>
                ) : (
                  <div />
                )}
                {nextPost ? (
                  <a
                    href={`/blog/${nextPost.id}`}
                    class="group flex flex-col items-end rounded-md border border-border p-4 text-right transition-colors duration-200 hover:border-border-strong"
                  >
                    <span class="flex items-center gap-1.5 font-mono text-xs tracking-wider text-muted-foreground uppercase">
                      Next
                      <ChevronRightIcon class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
                    </span>
                    <span class="mt-1.5 line-clamp-1 text-sm font-medium text-muted-foreground transition-colors group-hover:text-foreground">
                      {nextPost.data.title}
                    </span>
                  </a>
                ) : (
                  <div />
                )}
              </div>
            )
          }
        </article>
      </div>
    </div>
  </section>

  <div class="h-px w-full bg-border"></div>

  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <div class="blog-cta-grid-offset relative h-full">
        <GridBackground />
      </div>

      <div aria-hidden="true" class="absolute inset-0">
        <div
          class="absolute inset-0 opacity-100 transition-opacity duration-[250ms] ease-out dark:opacity-0"
          style="background: linear-gradient(to bottom, #ffffff 0%, transparent 20%, transparent 60%, #ffffff 100%);"
        >
        </div>
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-[250ms] ease-out dark:opacity-100"
          style="background: linear-gradient(to bottom, #09090b 0%, transparent 20%, transparent 60%, #09090b 100%);"
        >
        </div>
      </div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-295 px-4">
      <div
        class="grid grid-cols-1 items-center gap-6 py-12 md:grid-cols-12 md:gap-x-6 md:gap-y-8 md:py-20"
      >
        <div class="md:col-span-8">
          <Eyebrow class="mb-3">// Effect Community</Eyebrow>
          <h2 class="text-xl font-semibold tracking-tight text-foreground md:text-2xl">
            Join the conversation on Discord
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            Meet engineers running Effect in production.
          </p>
        </div>
        <div class="md:col-start-9 md:col-span-4">
          <div
            class="relative mx-auto flex max-w-xs flex-col items-center gap-3 px-6 py-6 md:max-w-none"
          >
            <span class="absolute top-0 left-0 h-3 w-3 border-t border-l border-border-strong"
            ></span>
            <span class="absolute top-0 right-0 h-3 w-3 border-t border-r border-border-strong"
            ></span>
            <span class="absolute bottom-0 left-0 h-3 w-3 border-b border-l border-border-strong"
            ></span>
            <span class="absolute right-0 bottom-0 h-3 w-3 border-r border-b border-border-strong"
            ></span>
            <a
              href="https://discord.gg/effect-ts"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
            >
              Join the Discord
              <ArrowRightIcon class="size-4" />
            </a>
            <a
              href="https://discord.gg/effect-ts"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground"
            >
              discord.gg/effect-ts
              <ArrowUpRightIcon class="size-3.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .blog-post-grid-offset {
    transform: translateY(-1rem);
  }

  .blog-cta-grid-offset :global(.grid-bg) {
    background-position-y: 147px;
  }
</style>
