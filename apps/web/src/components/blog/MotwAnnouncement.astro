---
import { getCollection, getEntries } from "astro:content"

interface Props {
  slug: string
}

const { slug } = Astro.props
const series = (await getCollection("blog", ({ id }) => id.startsWith("module-of-the-week/"))).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
)
const post = /^\d+$/.test(slug) ? series[Number(slug) - 1] : series.find((p) => p.id === slug)
if (!post) throw new Error(`MotwAnnouncement: no module "${slug}"`)
const authors = await getEntries(post.data.authors)
const names = authors.map((a) => a.data.name).join(", ")
---

<aside class="not-prose my-8 rounded-lg border border-zinc-800 p-6">
  <h3 class="m-0 text-sm font-semibold uppercase tracking-wide text-zinc-400">
    Module of the Week
  </h3>
  <p class="mt-3 mb-0 text-lg font-semibold">
    <a href={`/blog/${post.id}`} class="hover:underline">{post.data.title}</a>
  </p>
  <p class="mt-2 mb-0 text-zinc-400">{post.data.excerpt}</p>
  <p class="mt-3 mb-0 text-sm text-zinc-500">
    By {names} ·
    <a href={`/blog/${post.id}`} class="hover:underline">Read the post</a> ·
    <a href="/module-of-the-week" class="hover:underline">All modules</a>
  </p>
</aside>
