---
import AdoptionGuide from "@/components/enterprise/sections/AdoptionGuide.astro"
import Contact from "@/components/enterprise/sections/Contact.astro"
import ContactDialog from "@/components/enterprise/contact/ContactDialog"
import Facts from "@/components/enterprise/sections/Facts.astro"
import Faq from "@/components/enterprise/sections/Faq.astro"
import Hero from "@/components/enterprise/sections/Hero.astro"
import RealWorld from "@/components/enterprise/sections/RealWorld.astro"
import ReleaseManagement from "@/components/enterprise/sections/ReleaseManagement.astro"
import Security from "@/components/enterprise/sections/Security.astro"
import Support from "@/components/enterprise/sections/Support.astro"
import { loadEnterprisePage } from "@/features/enterprise/page"
import PageLayout from "@/layouts/PageLayout.astro"

const { members, currentVersion, downloads } = await loadEnterprisePage()
---

<PageLayout
  title="Effect for enterprise"
  description="Evaluate Effect with your team, plan your adoption, and get help from the people building it."
>
  <Hero members={members} />
  <Facts currentVersion={currentVersion} />
  <ReleaseManagement />
  <RealWorld downloads={downloads} />
  <Support members={members} />
  <Security />
  <AdoptionGuide />
  <Faq />
  <Contact members={members} />
  <ContactDialog client:load />
</PageLayout>
