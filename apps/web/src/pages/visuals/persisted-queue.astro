---
import PersistedQueueDemo from "@/components/blog/module-of-the-week/persisted-queue/PersistedQueueDemo"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>PersistedQueue · Module of the week</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">EFFECT OFFICE HOURS <span>/</span> MODULE OF THE WEEK</p>
        <h1>Work across processes.</h1>
        <p class="intro">
          One shared queue connects independent producers and consumers.<br />Follow three image
          jobs from upload to thumbnail.
        </p>
      </header>
      <PersistedQueueDemo client:load />
      <footer>
        <span>01 / PersistedQueue</span><span>Follow the jobs. Switch topology to compare.</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #12120f;
    color: #eeede5;
    font-family: system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 64px 24px 40px;
  }
  header {
    margin-bottom: 36px;
  }
  .eyebrow {
    font:
      10px ui-monospace,
      monospace;
    letter-spacing: 1.5px;
    color: #a09e91;
    margin: 0 0 26px;
  }
  .eyebrow span {
    margin: 0 12px;
    color: #605e53;
  }
  h1 {
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 450;
    letter-spacing: -1.5px;
    margin: 0 0 16px;
  }
  .intro {
    color: #aaa89b;
    font-size: 16px;
    line-height: 1.65;
    margin: 0;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    color: #8d8b7e;
    font:
      11px ui-monospace,
      monospace;
  }
  @media (max-width: 600px) {
    main {
      padding: 36px 16px;
    }
    footer {
      flex-direction: column;
    }
  }
</style>
