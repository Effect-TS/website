---
import { getEntry, render } from "astro:content"
import DocsNavigation from "@/components/navigation/DocsNavigation.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { PAGE_TITLE_ID } from "@/lib/constants/skip-link"
import { cacheKey, digest } from "@/lib/cache-key"
import { TutorialApp } from "@/features/tutorial/components/TutorialApp"
import { TutorialShell } from "@/features/tutorial/components/TutorialShell"
import { getLessons } from "@/features/tutorial/lessons"
import { buildOutline, lessonCode } from "@/features/tutorial/model"

export const prerender = true

export async function getStaticPaths() {
  const lessons = await getLessons()
  const outline = buildOutline(lessons)
  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
    props: { lesson, outline },
    cacheKey: cacheKey(digest({ lessons })),
  }))
}

const { lesson, outline } = Astro.props
const entry = await getEntry("tutorial", lesson.id.replace(/\/index$/, ""))
if (entry === undefined) throw new Error(`Missing tutorial entry ${lesson.id}`)
const { Content } = await render(entry)
---

<BaseLayout
  title={`${lesson.title} | Effect Tutorial`}
  description={`Interactive Effect tutorial: ${lesson.title}`}
>
  <div class="flex h-dvh flex-col overflow-hidden">
    <DocsNavigation section="guides" />

    <main id={PAGE_TITLE_ID} class="min-h-0 flex-1">
      <TutorialApp
        client:only="react"
        outline={outline}
        initialSlug={lesson.slug}
        initialCode={lessonCode(lesson)}
      >
        <h1 class="mt-0!">{lesson.title}</h1>
        <Content />
        <TutorialShell slot="fallback" outline={outline} slug={lesson.slug}>
          <h1 class="mt-0!">{lesson.title}</h1>
          <Content />
        </TutorialShell>
      </TutorialApp>
    </main>
  </div>
</BaseLayout>
