---
// Two servers behind a round-robin load balancer, each with its own copy of the
// Hendersons' dad. Leo works through a fixed conversation. Each dad answers
// based on what *he* remembers, and each only remembers the messages he got.
// The load balancer alternates, so every follow-up goes to the dad who never
// heard the first question.

const script = [
  {
    text: "Can I have a cookie?",
    topic: "cookie",
    known: "You already had one. Nice try, smart cookie.",
    unknown: "Sure, have one. That's the way the cookie crumbles.",
  },
  {
    text: "Can I have another one?",
    topic: "cookie",
    known: "You already had one. Nice try, smart cookie.",
    unknown: "Another one? You haven't had one yet. Sure, go ahead.",
    twice: "Two cookies",
  },
  {
    text: "Can I stay up late?",
    topic: "stay up",
    known: "You already got thirty minutes. Bed. I'm not losing any sleep over this.",
    unknown: "Thirty more minutes. Time flies when you're having fun.",
  },
  {
    text: "Can I stay up a little later?",
    topic: "stay up",
    known: "You already got thirty minutes. Bed. I'm not losing any sleep over this.",
    unknown: "Later than what? Sure, thirty more minutes.",
    twice: "An hour past bedtime",
  },
]

const server = { x: 196, w: 228, h: 120, header: 30 }
const servers = [
  { name: "Server 1", y: 16, color: "var(--td-blue)" },
  { name: "Server 2", y: 164, color: "var(--td-purple)" },
]
const lb = { x: 60, y: 124, w: 72, h: 52 }
const lbMid = lb.y + lb.h / 2
const bodyMid = (y: number) => y + server.header + (server.h - server.header) / 2
const inbound = `M0 ${lbMid} H${lb.x}`
const routes = servers.map(
  (s) =>
    `M${lb.x + lb.w} ${lbMid} C${lb.x + lb.w + 40} ${lbMid} ${server.x - 40} ${bodyMid(s.y)} ${server.x} ${bodyMid(s.y)}`,
)
---

<figure class="td" data-two-dads>
  <svg width="0" height="0" class="td-defs" aria-hidden="true">
    <defs>
      <symbol id="td-dad" viewBox="-10 -10 20 20" overflow="visible">
        <circle r="9" style="fill: var(--td-skin); stroke: var(--td-dad-ink); stroke-width: 1.2"
        ></circle>
        <path
          style="fill: none; stroke: var(--td-dad-ink); stroke-width: 1.2; stroke-linecap: round"
          d="M-7.4 -4.6 Q-4 -9.6 0 -8.2 Q4 -9.6 7.4 -4.6"></path>
        <circle cx="-3.2" cy="-1.6" r="1.15" style="fill: var(--td-dad-ink)"></circle>
        <circle cx="3.2" cy="-1.6" r="1.15" style="fill: var(--td-dad-ink)"></circle>
        <path
          style="fill: var(--td-dad-ink)"
          d="M-5.2 3.4 Q-2.6 1.2 0 2.8 Q2.6 1.2 5.2 3.4 Q2.6 5.6 0 4.2 Q-2.6 5.6 -5.2 3.4Z"></path>
      </symbol>
    </defs>
  </svg>

  <div class="td-body">
    <div class="td-chat">
      <p class="td-chat-title">Hendersons family chat</p>
      <ol class="td-messages" data-messages aria-live="polite">
        <li class="td-empty" data-empty>Leo hasn't said anything yet.</li>
      </ol>
    </div>

    <svg
      viewBox="0 0 440 300"
      class="td-diagram"
      role="img"
      aria-label="Messages from the family chat go through a load balancer, which takes turns sending them to server 1 and server 2. Each server has its own copy of the Hendersons' dad, and each dad only remembers the messages he received."
    >
      <path d={inbound} class="td-wire"></path>
      {
        routes.map((d, i) => (
          <path
            d={d}
            class={i === 0 ? "td-wire td-route is-next" : "td-wire td-route"}
            data-route={i}
          />
        ))
      }

      <g class="td-lb">
        <rect x={lb.x} y={lb.y} width={lb.w} height={lb.h} rx="10"></rect>
        <g transform={`translate(${lb.x + lb.w / 2} ${lbMid})`}>
          <path d="M-9 -3 A10 10 0 0 1 9 -3" class="td-cycle"></path>
          <path d="M9 3 A10 10 0 0 1 -9 3" class="td-cycle"></path>
          <path d="M9 -3 l-5 -1 M9 -3 l1 -5" class="td-cycle"></path>
          <path d="M-9 3 l5 1 M-9 3 l-1 5" class="td-cycle"></path>
        </g>
        <text
          x={lb.x + lb.w / 2}
          y={lb.y + lb.h + 18}
          text-anchor="middle"
          class="td-label td-muted"
        >
          Load balancer
        </text>
      </g>

      {
        servers.map((s, i) => (
          <g class="td-server" style={`--c: ${s.color}`} data-server={i}>
            <rect
              x={server.x + 24}
              y={s.y + server.h - 2}
              width="18"
              height="8"
              rx="2"
              class="td-foot"
            />
            <rect
              x={server.x + server.w - 42}
              y={s.y + server.h - 2}
              width="18"
              height="8"
              rx="2"
              class="td-foot"
            />
            <rect
              x={server.x}
              y={s.y}
              width={server.w}
              height={server.h}
              rx="12"
              class="td-chassis"
            />
            <path
              d={`M${server.x} ${s.y + server.header} H${server.x + server.w}`}
              class="td-rule"
            />
            {[0, 1, 2].map((k) => (
              <circle
                cx={server.x + 16 + k * 12}
                cy={s.y + 15}
                r="3.5"
                class={k === 0 ? "td-led td-led-on" : "td-led"}
              />
            ))}
            <text x={server.x + 58} y={s.y + 20} class="td-label td-strong">
              {s.name}
            </text>
            <g class="td-dad" style={`transform-origin: ${server.x + 46}px ${bodyMid(s.y)}px`}>
              <use href="#td-dad" x={server.x + 20} y={bodyMid(s.y) - 26} width="52" height="52" />
            </g>
            <text x={server.x + 86} y={bodyMid(s.y) - 14} class="td-label td-strong">
              Hendersons' dad
            </text>
            <text x={server.x + 86} y={bodyMid(s.y) + 6} class="td-label td-muted">
              Said yes to:
            </text>
            <text x={server.x + 86} y={bodyMid(s.y) + 24} class="td-label" data-memory>
              nothing yet
            </text>
          </g>
        ))
      }

      <g class="td-envelope" data-envelope opacity="0">
        <rect x="-9" y="-6.5" width="18" height="13" rx="2"></rect>
        <path d="M-9 -5 L0 1.5 L9 -5"></path>
      </g>
    </svg>
  </div>

  <div class="td-controls">
    <button type="button" class="td-button td-primary" data-send>Send message</button>
    <button type="button" class="td-button" data-reset>Reset</button>
  </div>
  <script type="application/json" data-script set:html={JSON.stringify(script)} />
</figure>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2)
  const escape = (text: string) =>
    text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")

  type Step = { text: string; topic: string; known: string; unknown: string; twice?: string }

  for (const root of document.querySelectorAll<HTMLElement>("[data-two-dads]")) {
    const script: Array<Step> = JSON.parse(root.querySelector("[data-script]")!.textContent!)
    const messages = root.querySelector<HTMLOListElement>("[data-messages]")!
    const empty = root.querySelector<HTMLLIElement>("[data-empty]")!
    const send = root.querySelector<HTMLButtonElement>("[data-send]")!
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")!
    const envelope = root.querySelector<SVGGElement>("[data-envelope]")!
    const inbound = root.querySelector<SVGPathElement>(".td-wire:not(.td-route)")!
    const routes = root.querySelectorAll<SVGPathElement>("[data-route]")
    const servers = root.querySelectorAll<SVGGElement>("[data-server]")

    let step = 0
    let next = 0
    // What each dad remembers saying yes to. Each dad only knows his own.
    let memory = [new Set<string>(), new Set<string>()]
    // Bumped on reset so an in-flight delivery knows to stop.
    let generation = 0

    const say = (className: string, html: string) => {
      empty.hidden = true
      const item = document.createElement("li")
      item.className = className
      item.innerHTML = html
      messages.append(item)
      while (messages.querySelectorAll("li:not([data-empty])").length > 8) {
        messages.querySelector("li:not([data-empty])")!.remove()
      }
      messages.scrollTop = messages.scrollHeight
    }

    const showMemory = (server: number) => {
      const items = [...memory[server]].join(", ")
      servers[server].querySelector("[data-memory]")!.textContent = items || "nothing yet"
    }

    const travel = (path: SVGPathElement, duration: number) =>
      new Promise<void>((resolve) => {
        const length = path.getTotalLength()
        const start = performance.now()
        const step = (now: number) => {
          const t = reduceMotion ? 1 : Math.min(1, (now - start) / duration)
          const p = path.getPointAtLength(length * ease(t))
          envelope.setAttribute("transform", `translate(${p.x} ${p.y})`)
          if (t < 1) requestAnimationFrame(step)
          else resolve()
        }
        requestAnimationFrame(step)
      })

    const updateSend = () => {
      const done = step >= script.length
      send.disabled = done
      send.textContent = done ? "Leo is out of questions" : "Send message"
    }

    send.addEventListener("click", async () => {
      const line = script[step]
      const run = generation
      step++
      send.disabled = true
      say("td-me", `<span class="td-sender">Leo</span>${escape(line.text)}`)

      const target = next
      next = 1 - next
      routes.forEach((r, i) => r.classList.toggle("is-next", i === next))

      envelope.setAttribute("opacity", "1")
      await travel(inbound, 300)
      if (run !== generation) return
      await travel(routes[target], 500)
      if (run !== generation) return
      envelope.setAttribute("opacity", "0")

      const dad = servers[target].querySelector<SVGGElement>(".td-dad")!
      dad.classList.remove("is-bouncing")
      void dad.getBoundingClientRect()
      dad.classList.add("is-bouncing")

      const knows = memory[target].has(line.topic)
      memory[target].add(line.topic)
      showMemory(target)
      // The other dad already said yes to this, so now Leo has it twice.
      const doubled = !knows && line.twice !== undefined && memory[1 - target].has(line.topic)
      say(
        `td-dad-msg td-from-${target}`,
        `<span class="td-sender">Dad on Server ${target + 1}</span>${escape(
          knows ? line.known : line.unknown,
        )}${doubled ? `<span class="td-again">${line.twice}</span>` : ""}`,
      )
      updateSend()
    })

    reset.addEventListener("click", () => {
      generation++
      step = 0
      next = 0
      memory = [new Set(), new Set()]
      envelope.setAttribute("opacity", "0")
      routes.forEach((r, i) => r.classList.toggle("is-next", i === 0))
      showMemory(0)
      showMemory(1)
      for (const item of messages.querySelectorAll("li:not([data-empty])")) item.remove()
      empty.hidden = false
      updateSend()
    })
  }
</script>

<style is:global>
  .td {
    --td-blue: #2563eb;
    --td-purple: #7c3aed;
    --td-ink: #3f3f46;
    --td-muted: #71717a;
    --td-line: #a1a1aa;
    --td-surface: #ffffff;
    --td-skin: #fde7c8;
    --td-dad-ink: #3f3f46;
    --td-accent: #e11d48;
    margin: 1.5rem 0;
  }
  html.dark .td {
    --td-blue: #60a5fa;
    --td-purple: #a78bfa;
    --td-ink: #d4d4d8;
    --td-muted: #a1a1aa;
    --td-line: #52525b;
    --td-surface: #09090b;
    --td-skin: #f1d3ac;
    --td-dad-ink: #27272a;
    --td-accent: #fb7185;
  }
  .td-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .td-body {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }
  @media (max-width: 640px) {
    .td-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .td-chat {
    display: flex;
    flex-direction: column;
    height: 19rem;
    border: 1.5px solid var(--td-ink);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--td-ink) 4%, var(--td-surface));
    overflow: hidden;
  }
  .td .td-chat-title {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid color-mix(in oklab, var(--td-ink) 25%, transparent);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--td-ink);
    text-align: center;
  }
  .td .td-messages {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0.6rem;
    list-style: none;
    overflow-y: auto;
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .td .td-messages > li {
    margin: 0;
    padding: 0.4rem 0.6rem;
    border-radius: 0.75rem;
    max-width: 88%;
  }
  .td .td-messages > li::before,
  .td .td-messages > li::marker {
    content: none;
  }
  .td .td-empty {
    align-self: center;
    color: var(--td-muted);
    font-style: italic;
  }
  .td .td-me .td-sender {
    color: color-mix(in oklab, var(--td-surface) 70%, transparent);
  }
  .td .td-me {
    align-self: flex-end;
    background: var(--td-ink);
    color: var(--td-surface);
    border-bottom-right-radius: 0.2rem;
  }
  .td .td-dad-msg {
    align-self: flex-start;
    background: color-mix(in oklab, var(--c) 14%, var(--td-surface));
    border: 1px solid color-mix(in oklab, var(--c) 55%, transparent);
    color: var(--td-ink);
    border-bottom-left-radius: 0.2rem;
  }
  .td .td-from-0 {
    --c: var(--td-blue);
  }
  .td .td-from-1 {
    --c: var(--td-purple);
  }
  .td .td-sender {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--c);
  }
  .td .td-again {
    display: inline-block;
    margin-left: 0.35rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--td-accent);
    color: var(--td-surface);
    font-size: 0.65rem;
    font-weight: 600;
    vertical-align: 1px;
  }

  .td-diagram {
    display: block;
    width: 100%;
    height: auto;
  }
  .td .td-label {
    font:
      12px system-ui,
      sans-serif;
    fill: var(--td-ink);
  }
  .td .td-strong {
    font-weight: 600;
  }
  .td .td-muted {
    fill: var(--td-muted);
  }
  .td .td-wire {
    fill: none;
    stroke: var(--td-line);
    stroke-width: 2;
  }
  .td .td-route.is-next {
    stroke: var(--td-ink);
    stroke-dasharray: 5 4;
  }
  .td .td-lb rect {
    fill: var(--td-surface);
    stroke: var(--td-ink);
    stroke-width: 2;
  }
  .td .td-cycle {
    fill: none;
    stroke: var(--td-ink);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .td .td-chassis {
    fill: color-mix(in oklab, var(--c) 8%, var(--td-surface));
    stroke: var(--td-ink);
    stroke-width: 2;
  }
  .td .td-rule {
    stroke: var(--td-ink);
    stroke-width: 1.5;
    opacity: 0.3;
  }
  .td .td-foot {
    fill: var(--td-ink);
  }
  .td .td-led {
    fill: var(--td-line);
  }
  .td .td-led-on {
    fill: #22c55e;
  }
  .td .td-dad.is-bouncing {
    animation: td-bounce 450ms ease;
  }
  @keyframes td-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-8px);
    }
    70% {
      transform: translateY(1px);
    }
  }
  .td .td-envelope rect {
    fill: var(--td-accent);
  }
  .td .td-envelope path {
    fill: none;
    stroke: var(--td-surface);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .td-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .td .td-button {
    padding: 0.4rem 0.9rem;
    border: 1.5px solid var(--td-ink);
    border-radius: 0.5rem;
    font-size: 0.8rem;
    color: var(--td-ink);
    cursor: pointer;
  }
  .td .td-button.td-primary {
    background: var(--td-ink);
    color: var(--td-surface);
  }
  .td .td-button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .td .td-dad.is-bouncing {
      animation: none;
    }
  }
</style>
