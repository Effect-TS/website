---
import { ExternalLink, Link as LinkIcon } from "@lucide/astro"
import { Code } from "astro-expressive-code/components"

import type { ApiDeclaration } from "./ApiReference"
import ApiCodeExample from "./ApiCodeExample.astro"

interface Props {
  declaration: ApiDeclaration
}

const { declaration } = Astro.props
---

<section id={declaration.anchor} class="scroll-mt-12 py-8">
  <div class="mb-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <h3
      class="m-0! flex items-center gap-3 font-mono text-xl! font-semibold tracking-tight text-foreground"
    >
      <a
        href={`#${declaration.anchor}`}
        class="group relative inline-block text-inherit no-underline!"
      >
        <LinkIcon
          class="absolute top-1/2 right-full mr-2 size-3.5 -translate-y-1/2 text-subtle-foreground opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
          aria-hidden="true"
        />
        {declaration.name}
      </a>
      {
        declaration.typeKind && (
          <span class="rounded border border-border-strong px-1.5 py-0.5 text-[10px] leading-none font-medium tracking-wider text-muted-foreground uppercase">
            {declaration.typeKind}
          </span>
        )
      }
    </h3>
    {
      (declaration.since || declaration.sourceUrl) && (
        <div class="not-prose flex shrink-0 items-center gap-2 font-mono text-xs text-muted-foreground">
          {declaration.since && <span>Added in v{declaration.since}</span>}
          {declaration.sourceUrl && (
            <a
              href={declaration.sourceUrl}
              target="_blank"
              class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 transition-colors hover:text-foreground focus-visible:text-foreground"
            >
              Source <ExternalLink class="size-3" aria-hidden="true" />
            </a>
          )}
        </div>
      )
    }
  </div>

  {
    declaration.commentHtml && (
      <div class="prose prose-effect mt-2 max-w-none" set:html={declaration.commentHtml} />
    )
  }

  {
    declaration.signature && (
      <div class="not-prose mt-3">
        <h4 class="mb-1.5 text-base font-semibold text-foreground">Signature</h4>
        <Code
          code={declaration.signature}
          lang="typescript"
          meta="showLineNumbers=false playground=false"
        />
      </div>
    )
  }

  {
    declaration.examples.length > 0 && (
      <div class="not-prose mt-4 space-y-6">
        {declaration.examples.map((example) => (
          <ApiCodeExample example={example} />
        ))}
      </div>
    )
  }
</section>
