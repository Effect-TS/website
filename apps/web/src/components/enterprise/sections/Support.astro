---
import BorderedGrid from "@/components/enterprise/BorderedGrid.astro"
import CardBody from "@/components/enterprise/CardBody.astro"
import CardTitle from "@/components/enterprise/CardTitle.astro"
import ContactMenu from "@/components/enterprise/contact/ContactMenu"
import EnterpriseSection from "@/components/enterprise/EnterpriseSection.astro"
import Icon from "@/components/enterprise/Icon.astro"
import SupportFlow from "@/components/enterprise/SupportFlow.astro"
import { CONTACT_HREF, SUPPORT_OPTIONS } from "@/features/enterprise/copy"
import type { ContactMember } from "@/features/enterprise/domain"

interface Props {
  readonly members: ReadonlyArray<ContactMember>
}

const { members } = Astro.props
---

<EnterpriseSection id="support" eyebrow="Support" title="Support for your company">
  <ContactMenu slot="action" client:load members={members} emailHref={CONTACT_HREF} />
  <BorderedGrid class="grid-cols-1 lg:grid-cols-3">
    {
      SUPPORT_OPTIONS.map((option) => (
        <li class="flex flex-col bg-background p-6 md:p-8">
          <Icon name={option.icon} size={24} />
          <CardTitle class="mt-6">{option.title}</CardTitle>
          <CardBody class="mt-3">{option.body}</CardBody>
        </li>
      ))
    }
  </BorderedGrid>
  <div class="mt-16">
    <SupportFlow />
  </div>
</EnterpriseSection>
