---
import PageLayout from "@/layouts/PageLayout.astro"
import Eyebrow from "@/components/ui/Eyebrow.astro"

interface Credit {
  readonly name: string
  readonly owner: string
  readonly source: { readonly label: string; readonly href: string }
  readonly licence: { readonly label: string; readonly href: string }
  readonly note: string
}

// Third-party marks shown on this site. Each entry names where the artwork
// came from, the terms it was published under, and whether we changed it.
// The full text of every licence that requires a notice follows the list.
// Trademarks belong to their owners; a licence on an artwork file is not a
// trademark permission, and showing a mark here does not imply endorsement.
const CREDITS: ReadonlyArray<Credit> = [
  {
    name: "Yarn kitten logo",
    owner: "Yarn contributors",
    source: {
      label: "github.com/yarnpkg/assets, yarn-kitten-circle.svg",
      href: "https://github.com/yarnpkg/assets/blob/master/yarn-kitten-circle.svg",
    },
    licence: {
      label: "Creative Commons Attribution 4.0 International (CC BY 4.0)",
      href: "https://creativecommons.org/licenses/by/4.0/",
    },
    note: "Used unmodified.",
  },
  {
    name: "OpenCode wordmark",
    owner: "Anomaly",
    source: { label: "opencode.ai/brand", href: "https://opencode.ai/brand" },
    licence: {
      label: "MIT (anomalyco/opencode); brand guidelines apply",
      href: "https://github.com/anomalyco/opencode/blob/dev/LICENSE",
    },
    note: "Light and dark variants used unmodified, each on the background it is published for.",
  },
  {
    name: "Astro logo",
    owner: "Astro",
    source: { label: "astro.build/press", href: "https://astro.build/press/" },
    licence: { label: "Astro press kit usage guidance", href: "https://astro.build/press/" },
    note: "“Logo on light” and “Gradient logo on dark” variants used unmodified, at the 24px minimum size.",
  },
  {
    name: "Cloudflare logo",
    owner: "Cloudflare, Inc.",
    source: {
      label: "cloudflare.com/press-kit (single-colour white SVG and full-colour PNG)",
      href: "https://www.cloudflare.com/press-kit/",
    },
    licence: {
      label: "Cloudflare brand guidelines",
      href: "https://www.cloudflare.com/trademark/",
    },
    note: "Artwork and colours unchanged. In the white SVG the CSS classes were rewritten as inline fill attributes.",
  },
  {
    name: "T3 logo",
    owner: "T3 OSS (Shoubhit Dash)",
    source: {
      label: "github.com/t3-oss/create-t3-app, www/public/images",
      href: "https://github.com/t3-oss/create-t3-app/tree/main/www/public/images",
    },
    licence: { label: "MIT", href: "https://github.com/t3-oss/create-t3-app/blob/main/LICENSE" },
    note: "Light and dark variants used unmodified.",
  },
  {
    name: "Union logo",
    owner: "Union.fi Labs, Inc.",
    source: {
      label: "github.com/unionlabs/union, site/public",
      href: "https://github.com/unionlabs/union/tree/main/site/public",
    },
    licence: {
      label: "MIT (from the MIT / Apache-2.0 dual licence)",
      href: "https://github.com/unionlabs/union/blob/main/LICENSE-MIT",
    },
    note: "Black and white variants used unmodified.",
  },
  {
    name: "Vercel logotype",
    owner: "Vercel, Inc.",
    source: { label: "vercel.com/brand press kit", href: "https://vercel.com/brand" },
    licence: { label: "Vercel brand guidelines", href: "https://vercel.com/brand" },
    note: "Light and dark variants used unmodified.",
  },
  {
    name: "Spiko wordmark",
    owner: "Spiko",
    source: { label: "spiko.io/spiko-logo.svg", href: "https://www.spiko.io/spiko-logo.svg" },
    licence: { label: "Spiko", href: "https://www.spiko.io/" },
    note: "Used unmodified; the mark is published as currentColor and takes the page text colour.",
  },
  {
    name: "X logo",
    owner: "X Corp.",
    source: { label: "X brand toolkit", href: "https://about.x.com/en/who-we-are/brand-toolkit" },
    licence: { label: "X brand toolkit", href: "https://about.x.com/en/who-we-are/brand-toolkit" },
    note: "Published black/white glyph drawn in the page text colour, black on light and white on dark.",
  },
  {
    name: "Brand icons (GitHub, Discord, X, YouTube, LinkedIn, Bluesky, Spotify, npm)",
    owner: "Font Awesome Free, Brands set",
    source: {
      label: "fontawesome.com, via the iconify fa7-brands set",
      href: "https://github.com/iconify/icon-sets",
    },
    licence: {
      label: "Creative Commons Attribution 4.0 International (CC BY 4.0)",
      href: "https://creativecommons.org/licenses/by/4.0/",
    },
    note: "Paths unmodified; drawn in the page text colour.",
  },
  {
    name: "MasterClass wordmark",
    owner: "MasterClass",
    source: { label: "masterclass.com", href: "https://www.masterclass.com/" },
    licence: { label: "MasterClass", href: "https://www.masterclass.com/" },
    note: "The white wordmark is shown in dark mode only. No published light-background variant has been obtained, so light mode shows the name as text rather than a recoloured mark.",
  },
  {
    name: "Total TypeScript mark",
    owner: "Matt Pocock",
    source: { label: "totaltypescript.com", href: "https://www.totaltypescript.com/" },
    licence: { label: "Total TypeScript", href: "https://www.totaltypescript.com/" },
    note: "Used unmodified in both themes.",
  },
  {
    name: "Bun, pnpm and Deno marks",
    owner: "Respective projects",
    source: { label: "bun.sh, pnpm.io, deno.com", href: "https://bun.sh" },
    licence: { label: "Respective brand guidelines", href: "https://bun.sh" },
    note: "Paths and colours unchanged; a full-canvas clip path with no visual effect was removed from each file.",
  },
]

const mitLicence = (holder: string) => `MIT License

Copyright (c) ${holder}

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.`

const NOTICES: ReadonlyArray<{ readonly title: string; readonly text: string }> = [
  {
    title: "Yarn kitten logo (CC BY 4.0)",
    text: "Yarn logo by the Yarn contributors, from https://github.com/yarnpkg/assets, licensed under the Creative Commons Attribution 4.0 International licence, https://creativecommons.org/licenses/by/4.0/. The file used is yarn-kitten-circle.svg with the artwork unmodified.",
  },
  {
    title: "Font Awesome Free brand icons (CC BY 4.0)",
    text: "Brand icons are from Font Awesome Free by Dave Gandy and Fonticons, Inc., https://fontawesome.com, licensed under the Creative Commons Attribution 4.0 International licence, https://creativecommons.org/licenses/by/4.0/. Paths unmodified.",
  },
  {
    title: "OpenCode wordmark (MIT)",
    text: `${mitLicence("2025 opencode")}

OpenCode and the OpenCode logo are trademarks of Anomaly; the MIT licence does not grant trademark rights. Usage follows https://opencode.ai/brand.`,
  },
  { title: "T3 logo (MIT)", text: mitLicence("2022 Shoubhit Dash") },
  {
    title: "Union logo (MIT, from the MIT / Apache-2.0 dual licence)",
    text: mitLicence("2024 Union.fi Labs, Inc."),
  },
]
---

<PageLayout
  title="Credits | Effect"
  description="Third-party logos and artwork shown on effect.website, with their sources, licences and notices."
  themeable
>
  <section class="relative pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="mx-auto w-full max-w-295 px-4">
      <Eyebrow class="mb-3">// Credits</Eyebrow>
      <h1 class="text-3xl leading-tighter font-bold text-foreground md:text-4xl">
        Third-party artwork
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">
        Logos shown on this site belong to their owners and are used to identify the companies and
        projects they refer to. This page records where each mark came from, the terms it was
        published under, whether we changed it, and the full text of every licence that asks for a
        notice.
      </p>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="mx-auto w-full max-w-295 px-4">
      <ul class="m-0 max-w-3xl list-none divide-y divide-border border-y border-border p-0">
        {
          CREDITS.map((credit) => (
            <li class="grid gap-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6">
              <div>
                <h2 class="text-base font-semibold text-foreground">{credit.name}</h2>
                <p class="text-sm text-muted-foreground">{credit.owner}</p>
              </div>
              <dl class="m-0 grid gap-1 text-sm">
                <div class="flex gap-2">
                  <dt class="shrink-0 text-muted-foreground">Source</dt>
                  <dd class="m-0">
                    <a href={credit.source.href} target="_blank" rel="noopener noreferrer">
                      {credit.source.label}
                    </a>
                  </dd>
                </div>
                <div class="flex gap-2">
                  <dt class="shrink-0 text-muted-foreground">Terms</dt>
                  <dd class="m-0">
                    <a href={credit.licence.href} target="_blank" rel="noopener noreferrer">
                      {credit.licence.label}
                    </a>
                  </dd>
                </div>
                <div class="flex gap-2">
                  <dt class="shrink-0 text-muted-foreground">Changes</dt>
                  <dd class="m-0 text-prose-foreground">{credit.note}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="notices" class="pb-24 md:pb-32">
    <div class="mx-auto w-full max-w-295 px-4">
      <h2 class="text-2xl leading-tighter font-semibold text-foreground">Licence notices</h2>
      <div class="mt-6 max-w-3xl space-y-4">
        {
          NOTICES.map((notice) => (
            <details class="group rounded-md border border-border bg-card">
              <summary class="cursor-pointer list-none px-5 py-4 text-base font-medium text-foreground">
                {notice.title}
              </summary>
              <pre class="m-0 overflow-x-auto border-t border-border px-5 py-4 font-mono text-xs leading-relaxed whitespace-pre-wrap text-prose-foreground">
                {notice.text}
              </pre>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>
