+[package]
+name = "ets_wasm_lsp"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish.workspace = true
+description = "Prototype: tsrs's single-threaded wasm32-wasip1 language server (tsrs_wasm_lsp ABI) with the Effect checker, execute and language-service hooks"
+
+[lints]
+workspace = true
+
+# cdylib only, as tsrs_wasm_lsp: cargo skips LTO for a crate that is also an rlib.
+[lib]
+crate-type = ["cdylib"]
+test = false
+
+# The host is tsrs_wasm's own source (src/lib.rs includes it by #[path]), so the module keeps tsrs_wasm_lsp's ABI.
+# The tsrs crates are path dependencies, like ets_shim's, so every type unifies.
+[dependencies]
+ets_etscheckerhooks.workspace = true
+ets_etsexecutehooks.workspace = true
+ets_etslshooks.workspace = true
+tsrs_core = { path = "../../tsrs/crates/tsrs_core" }
+tsrs_vfs = { path = "../../tsrs/crates/tsrs_vfs" }
+tsrs_lsp = { path = "../../tsrs/crates/tsrs_lsp" }
+tsrs_compiler = { path = "../../tsrs/crates/tsrs_compiler" }
diff --git a/crates/ets_wasm_lsp/build.rs b/crates/ets_wasm_lsp/build.rs
new file mode 100644
index 0000000..00fc98e
--- /dev/null
+++ b/crates/ets_wasm_lsp/build.rs
@@ -0,0 +1,17 @@
+// The module's shadow stack, as crates/tsrs_wasm/build.rs (80 MiB; TSRS_WASM_STACK_SIZE overrides it, in bytes).
+// Without it the linker's default is 1 MiB.
+
+const STACK_SIZE: u64 = 80 << 20;
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-env-changed=TSRS_WASM_STACK_SIZE");
+    let family = std::env::var("CARGO_CFG_TARGET_FAMILY").unwrap_or_default();
+    if family.split(',').any(|f| f == "wasm") {
+        let size = std::env::var("TSRS_WASM_STACK_SIZE")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .unwrap_or(STACK_SIZE);
+        println!("cargo:rustc-cdylib-link-arg=-zstack-size={size}");
+    }
+}
diff --git a/crates/ets_wasm_lsp/src/lib.rs b/crates/ets_wasm_lsp/src/lib.rs
