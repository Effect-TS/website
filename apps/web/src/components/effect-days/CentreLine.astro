---
/**
 * Dashed vertical line down the container's centre, sitting behind the content
 * (lg+). Used by the layout for full-page runs and by About Livorno to scope
 * the line to the area below its hero.
 */
---

<div class="pointer-events-none absolute inset-0 z-0 hidden lg:block" aria-hidden="true">
  <div class="relative mx-auto h-full w-full max-w-295">
    <div
      class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 text-zinc-800"
      style="width: 1px; background-image: repeating-linear-gradient(to bottom, currentColor 0px, currentColor 2px, transparent 2px, transparent 4px)"
    >
    </div>
  </div>
</div>
