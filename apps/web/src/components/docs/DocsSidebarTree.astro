---
import type { CollectionEntry } from "astro:content"

import type { DocsSidebarItem } from "@/lib/docs-sections"
import SidebarGroup from "@/components/ui/sidebar/SidebarGroup.astro"
import SidebarLink from "@/components/ui/sidebar/SidebarLink.astro"

/**
 * Documentation sidebar tree — one source for the mobile disclosure and the
 * desktop rail. Active state is `aria-current` driven (handled in `SidebarLink`).
 */
interface Props {
  readonly items: ReadonlyArray<DocsSidebarItem>
  readonly currentId: string
}

const { items, currentId } = Astro.props

const entryLabel = (e: CollectionEntry<"docs">): string => e.data.sidebar?.label ?? e.data.title
const entryHref = (e: CollectionEntry<"docs">): string => `/docs/${e.id.replace(/\/index$/, "")}`
---

<ul class="flex flex-col gap-0.5">
  {
    items.map((item) =>
      item.kind === "entry" ? (
        <li>
          <SidebarLink
            href={entryHref(item.entry)}
            active={item.entry.id === currentId}
            class="-mx-2 flex items-center justify-between px-2 py-2.5 font-mono text-sm font-medium tracking-wider uppercase"
          >
            {entryLabel(item.entry)}
          </SidebarLink>
        </li>
      ) : item.kind === "group" ? (
        <li class="mb-1 last:mb-0">
          <SidebarGroup label={item.label} open={item.open}>
            {item.entries.map((e) => (
              <li>
                <SidebarLink
                  href={entryHref(e)}
                  active={e.id === currentId}
                  class="py-1.5 pl-3 text-sm"
                >
                  {entryLabel(e)}
                </SidebarLink>
              </li>
            ))}
          </SidebarGroup>
        </li>
      ) : (
        <li class="mb-1 last:mb-0">
          <SidebarGroup label={item.label} open>
            {item.links.map((link) => (
              <li>
                <SidebarLink href={link.href} class="py-1.5 pl-3 text-sm">
                  {link.label}
                </SidebarLink>
              </li>
            ))}
          </SidebarGroup>
        </li>
      ),
    )
  }
</ul>
